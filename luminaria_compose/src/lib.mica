// luminaria_compose: the Vulkan renderer, on vk_compose. Each output is a
// scene the placement list (back to front, output pixels) is diffed into in
// O(N) time: what moved, appeared or changed becomes damage, opaque views
// and hardware overlay planes skip drawing into the primary target, and
// only the primary damage is redrawn, in one pass. The renderer owns the
// device and every texture, each under the caller's key: 1..4 plane client
// dmabufs imported once, single-pixel buffers as one texel, one texture
// per shm surface that commits upload merged damage into once before the
// next frame, compositor images, render targets (exported as multi-plane
// dmabufs), and zero-copy dmabuf / offscreen captures.

import std.collections.map
import std.mem
import vk_gpu as gpu
import vk_draw2d as draw2d
import vk_compose as vc
import luminaria_types as types
pub import format

pub type Placement = types.Placement
pub type Rect = types.Rect

/// Per-view cached state in an output's stable slot array.
struct OutSlot {
    key: u64 = 0
    id: u32 = 0
    tex_ver: u64 = 0
    seen_gen: u64 = 0
    p: Placement = Placement {}
    alive: bool = false
}

struct Output {
    scene: vc.Scene
    width: u32 = 1
    height: u32 = 1
    background: vec4 = zeroed()
    dst_color: u32 = 0
    sdr_nits: f32 = 203.0
    max_nits: f32 = 1000.0
    alive: bool = true
    /// Placement key -> stable index in `slots`.
    by_key: map.Map[u64, u32]
    slots: List[OutSlot] = []
    free_slots: List[u32] = []
    /// Slot indices in the last applied back-to-front order.
    cur_order: List[u32] = []
    gen: u64 = 0
    /// `Compositor.tex_ver` at the last full layout sync on this output.
    tex_ver: u64 = 0
}

fn blank() -> Output {
    return Output { scene: vc.Scene.new(1, 1, vec4(0.0)), alive: false, by_key: map.Map.new() }
}

fn same_visual(a: Placement, b: Placement) -> bool {
    return a.tex == b.tex and a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h and a.src == b.src and a.transform == b.transform and a.opacity == b.opacity and a.radius == b.radius and a.shadow == b.shadow and a.opaque == b.opaque and a.color_space == b.color_space
}

fn Output.alloc_slot(mut self, take sl: OutSlot) -> u32 {
    if let Some(i) = self.free_slots.pop() {
        self.slots[int(i)] = sl
        return i
    }
    let i = u32(self.slots.len())
    self.slots.push(sl)
    return i
}

fn Output.slot_for_id(self, id: u32) -> int {
    var i = self.cur_order.len() - 1
    while i >= 0 {
        let si = int(self.cur_order[i])
        if self.slots[si].id == id {
            return si
        }
        i -= 1
    }
    return -1
}

/// The damage of an shm texture still to upload (x0, y0 to x1, y1; none
/// when x0 >= x1), and its fourcc.
struct Shm {
    format: u32
    x0: i32 = 0
    y0: i32 = 0
    x1: i32 = 0
    y1: i32 = 0
}

pub struct Compositor {
    dev: gpu.Device
    validation: bool = false
    want_priority: gpu.Priority = gpu.Priority.Realtime
    resets: int = 0
    canvas: Option[draw2d.Canvas] = None
    /// Lazily built canvases for non-BGRA8 target formats (RGBA8, 10-bit HDR, FP16).
    extra_canvases: List[(gpu.Format, draw2d.Canvas)] = []
    outputs: List[Output] = []
    /// Uploads waiting for the next frame (recorded once, before any draw).
    uploads: Option[gpu.Encoder] = None
    /// Textures by key; shm ones also have their pending damage.
    texs: map.Map[u64, gpu.Texture]
    shms: map.Map[u64, Shm]
    /// Monotonic version bumped whenever any texture is inserted, replaced or forgotten.
    tex_ver: u64 = 1
    /// Render targets by key.
    targets: map.Map[u64, gpu.Texture]
    next_target: u64 = 1
    /// Reusable scratch lists for O(N) layout diff & overlay updates.
    order: List[u32] = []
    next_slots: List[u32] = []
    rm_ids: List[u32] = []
    ov_ids: List[u32] = []
}

/// The renderer on a GPU of its own choosing (`validation` loads the
/// Vulkan validation layer; requests `Realtime` global queue priority and
/// falls back automatically if unsupported or unpermitted).
@noinline
@cold
pub fn Compositor.open(validation: bool) -> Result[Compositor, str] {
    let dev = try gpu.Device.open(gpu.Options { headless: true, validation, priority: gpu.Priority.Realtime })
    var c = try Compositor.with(dev)
    c.validation = validation
    c.want_priority = gpu.Priority.Realtime
    return Ok(c)
}

@noinline
@cold
pub fn Compositor.with(take dev: gpu.Device) -> Result[Compositor, str] {
    let prio = dev.priority()
    var c = Compositor { dev, want_priority: prio, texs: map.Map.new(), shms: map.Map.new(), targets: map.Map.new() }
    c.canvas = Some(try draw2d.Canvas.create(mut c.dev, gpu.Format.B8G8R8A8_UNORM))
    return Ok(c)
}

/// Every fourcc and modifier clients may hand over as dmabufs.
pub fn Compositor.formats(self) -> List[(u32, u64)] {
    return format.dmabuf_formats(self.dev)
}

/// Every fourcc and modifier writable as a GPU dmabuf capture target.
pub fn Compositor.capture_formats(self) -> List[(u32, u64)] {
    return format.capture_formats(self.dev)
}

/// The GPU's DRM node (major, minor), for linux-dmabuf and drm_syncobj.
pub fn Compositor.render_node(self) -> Option[(i64, i64)] {
    return self.dev.drm_node()
}

/// Granted Vulkan global queue priority (`VK_QUEUE_GLOBAL_PRIORITY_*`, 0 if default).
pub fn Compositor.gpu_priority(self) -> i32 {
    return self.dev.priority().as_i32()
}

/// True if the Vulkan device reported `VK_ERROR_DEVICE_LOST`.
pub fn Compositor.device_lost(self) -> bool {
    return self.dev.lost()
}

/// Mark the GPU device lost (used by device-lost recovery tests).
pub fn Compositor.mark_lost(mut self) {
    self.dev.mark_lost()
}

/// Number of completed GPU device-lost recoveries.
pub fn Compositor.resets(self) -> int {
    return self.resets
}

/// Add the renderer's GPU priority and reset counters to `s`.
pub fn Compositor.stats(self, mut s: types.Stats) {
    s.gpu_priority = self.dev.priority().as_i32()
    s.gpu_resets = self.resets
}

/// Rebuild the Vulkan device, canvases and output scenes after device loss.
/// Caller (`Display`) re-imports client textures and re-acquires output targets.
@noinline
@cold
pub fn Compositor.recover(mut self) -> Result[(), str] {
    var new_dev = try gpu.Device.open(gpu.Options { headless: true, validation: self.validation, priority: self.want_priority })
    let new_canvas = try draw2d.Canvas.create(mut new_dev, gpu.Format.B8G8R8A8_UNORM)
    if let Some(u) = self.uploads.take() {
        var enc = u
        self.dev.cancel(take enc)
    }
    if not self.dev.lost() {
        discard self.dev.idle()
    }
    self.texs.clear()
    self.shms.clear()
    self.targets.clear()
    self.tex_ver += 1
    discard self.canvas.take()
    self.extra_canvases.clear()
    self.dev = new_dev
    self.canvas = Some(new_canvas)
    for o in 0..self.outputs.len() {
        let prev = mem.replace(mut self.outputs[o], blank())
        if prev.alive {
            var sc = vc.Scene.new(prev.width, prev.height, prev.background)
            sc.set_output_color(prev.dst_color, prev.sdr_nits, prev.max_nits)
            self.outputs[o] = Output {
                scene: sc,
                width: prev.width,
                height: prev.height,
                background: prev.background,
                dst_color: prev.dst_color,
                sdr_nits: prev.sdr_nits,
                max_nits: prev.max_nits,
                alive: true,
                by_key: map.Map.new(),
            }
        }
    }
    self.resets += 1
    return Ok(())
}

/// Output `o` (the output's index) is `width` x `height`.
pub fn Compositor.add_output(mut self, o: int, width: u32, height: u32, background: vec4) {
    while self.outputs.len() <= o {
        self.outputs.push(blank())
    }
    self.outputs[o] = Output {
        scene: vc.Scene.new(width, height, background),
        width,
        height,
        background,
        alive: true,
        by_key: map.Map.new(),
    }
}

pub fn Compositor.resize(mut self, o: int, width: u32, height: u32) {
    if o < self.outputs.len() {
        self.outputs[o].width = width
        self.outputs[o].height = height
        self.outputs[o].scene.resize(width, height)
    }
}

pub fn Compositor.remove_output(mut self, o: int) {
    if o < self.outputs.len() {
        self.outputs[o].alive = false
        self.outputs[o].by_key.clear()
        self.outputs[o].slots.clear()
        self.outputs[o].free_slots.clear()
        self.outputs[o].cur_order.clear()
    }
}

/// Set the target color space and luminance parameters for output `o`.
pub fn Compositor.set_output_color(mut self, o: int, dst_color: u32, sdr_nits: f32, max_nits: f32) {
    guard o >= 0 and o < self.outputs.len() else {
        return
    }
    self.outputs[o].dst_color = dst_color
    self.outputs[o].sdr_nits = sdr_nits
    self.outputs[o].max_nits = max_nits
    self.outputs[o].scene.set_output_color(dst_color, sdr_nits, max_nits)
}

fn view(p: Placement, t: gpu.Texture) -> vc.View {
    let src = vc.Rect { x: p.src.x, y: p.src.y, w: p.src.w, h: p.src.h }
    let opaque = vc.Rect { x: p.opaque.x, y: p.opaque.y, w: p.opaque.w, h: p.opaque.h }
    return vc.View {
        tex: t,
        x: p.x,
        y: p.y,
        w: p.w,
        h: p.h,
        src,
        transform: vc.Transform(p.transform),
        opacity: p.opacity,
        radius: p.radius,
        shadow: p.shadow,
        opaque,
        color_space: p.color_space,
    }
}

/// Show `ps` (back to front) on output `o` from the next frame: views are
/// added, changed, restacked and removed by key in O(N) time, and only what
/// changed is damaged.
pub fn Compositor.layout(mut self, o: int, placements: Slice[Placement]) {
    guard o < self.outputs.len() and self.outputs[o].alive else {
        return
    }
    var out = mem.replace(mut self.outputs[o], blank())
    let tver = self.tex_ver
    // Fast path: identical key list and no texture table changes since the last sync.
    if out.tex_ver == tver and placements.len() == out.cur_order.len() {
        var same_order = true
        for i in 0..placements.len() {
            if out.slots[int(out.cur_order[i])].key != placements[i].key {
                same_order = false
                break
            }
        }
        if same_order {
            for i in 0..placements.len() {
                let si = int(out.cur_order[i])
                let p = placements[i]
                if not same_visual(out.slots[si].p, p) {
                    if let Some(t) = self.texs.get(p.tex) {
                        out.scene.set(out.slots[si].id, view(p, t))
                        out.slots[si].p = p
                    }
                }
            }
            self.outputs[o] = out
            return
        }
    }
    out.gen += 1
    let gen = out.gen
    var order = mem.replace(mut self.order, [])
    var next_slots = mem.replace(mut self.next_slots, [])
    order.clear()
    next_slots.clear()
    var seen_count = 0
    for p in placements {
        if let Some(si_u32) = out.by_key.get(p.key) {
            let si = int(si_u32)
            if out.slots[si].seen_gen == gen {
                continue
            }
            if out.slots[si].tex_ver == tver and same_visual(out.slots[si].p, p) {
                out.slots[si].seen_gen = gen
                seen_count += 1
                next_slots.push(si_u32)
                order.push(out.slots[si].id)
                continue
            }
            guard let Some(t) = self.texs.get(p.tex) else {
                continue
            }
            let id = out.slots[si].id
            out.scene.set(id, view(p, t))
            out.slots[si].tex_ver = tver
            out.slots[si].seen_gen = gen
            out.slots[si].p = p
            seen_count += 1
            next_slots.push(si_u32)
            order.push(id)
        } else {
            guard let Some(t) = self.texs.get(p.tex) else {
                continue
            }
            let id = out.scene.add(view(p, t))
            let si_u32 = out.alloc_slot(OutSlot { key: p.key, id, tex_ver: tver, seen_gen: gen, p, alive: true })
            discard out.by_key.insert(p.key, si_u32)
            next_slots.push(si_u32)
            order.push(id)
        }
    }
    if seen_count < out.cur_order.len() {
        var rm_ids = mem.replace(mut self.rm_ids, [])
        rm_ids.clear()
        for idx in 0..out.cur_order.len() {
            let si_u32 = out.cur_order[idx]
            let si = int(si_u32)
            if out.slots[si].seen_gen != gen {
                rm_ids.push(out.slots[si].id)
                discard out.by_key.remove(out.slots[si].key)
                out.slots[si].alive = false
                out.free_slots.push(si_u32)
            }
        }
        if not rm_ids.is_empty() {
            out.scene.remove_many(rm_ids)
        }
        self.rm_ids = rm_ids
    }
    out.scene.reorder(order)
    out.tex_ver = tver
    var old_order = mem.replace(mut out.cur_order, next_slots)
    old_order.clear()
    self.next_slots = old_order
    self.order = order
    self.outputs[o] = out
}

/// The client drew into key `key`'s texture: `rects` in texture pixels
/// (empty: all of it). Damages every output showing it.
pub fn Compositor.commit(mut self, key: u64, rects: Slice[(i32, i32, i32, i32)]) {
    for o in 0..self.outputs.len() {
        guard let Some(si) = self.outputs[o].by_key.get(key) else {
            continue
        }
        let id = self.outputs[o].slots[int(si)].id
        if rects.is_empty() {
            self.outputs[o].scene.commit(id, None)
        }
        for r in rects {
            self.outputs[o].scene.commit(id, Some(vc.Rect { x: f32(r.0), y: f32(r.1), w: f32(r.2), h: f32(r.3) }))
        }
    }
}

/// Redraw every output whole next frame (the background or a scale
/// changed).
pub fn Compositor.damage_all(mut self) {
    for o in 0..self.outputs.len() {
        self.outputs[o].scene.damage_all()
    }
}

/// Whether output `o` has nothing new to show.
pub fn Compositor.idle(self, o: int) -> bool {
    return o >= self.outputs.len() or not self.outputs[o].alive or self.outputs[o].scene.idle()
}

/// Whether key `key` shows on output `o` (not hidden by opaque views).
pub fn Compositor.visible(self, o: int, key: u64) -> bool {
    guard o < self.outputs.len() else {
        return false
    }
    guard let Some(si) = self.outputs[o].by_key.get(key) else {
        return false
    }
    return self.outputs[o].scene.visible(self.outputs[o].slots[int(si)].id)
}

/// The key of the view that alone fills output `o` as it is, when one
/// does (scan its buffer out instead of composing).
pub fn Compositor.scanout(self, o: int) -> Option[u64] {
    guard o < self.outputs.len() else {
        return None
    }
    guard let Some(id) = self.outputs[o].scene.scanout() else {
        return None
    }
    let si = self.outputs[o].slot_for_id(id)
    return if si >= 0 { Some(self.outputs[o].slots[si].key) } else { None }
}

/// Up to `max_count` placement candidates eligible for hardware overlay
/// planes above the primary plane on output `o` (top to bottom).
@noinline
pub fn Compositor.overlay_candidates(self, o: int, max_count: int) -> List[types.OverlayCand] {
    var out: List[types.OverlayCand] = []
    guard o < self.outputs.len() and self.outputs[o].alive else {
        return out
    }
    for id in self.outputs[o].scene.overlay_candidates(max_count) {
        let si = self.outputs[o].slot_for_id(id)
        guard si >= 0 else {
            continue
        }
        let key = self.outputs[o].slots[si].key
        let tex = self.outputs[o].slots[si].p.tex
        guard let Some(v) = self.outputs[o].scene.get(id) else {
            continue
        }
        let w = if v.w > 0.0 { v.w } else if not v.src.is_empty() { v.src.w } else { f32(v.tex.width()) }
        let h = if v.h > 0.0 { v.h } else if not v.src.is_empty() { v.src.h } else { f32(v.tex.height()) }
        let src = types.Rect { x: v.src.x, y: v.src.y, w: v.src.w, h: v.src.h }
        let opaque = v.tex.opaque() or (v.opaque.w >= w and v.opaque.h >= h)
        out.push(types.OverlayCand {
            key,
            tex,
            x: i32(v.x),
            y: i32(v.y),
            w: i32(w),
            h: i32(h),
            src,
            transform: u32(v.transform),
            opaque,
        })
    }
    return out
}

/// Mark placements `keys` as hardware-promoted overlays on output `o` so
/// primary composition skips them while damaging primary on transitions.
pub fn Compositor.set_overlays(mut self, o: int, keys: Slice[u64]) {
    guard o < self.outputs.len() and self.outputs[o].alive else {
        return
    }
    var ids = mem.replace(mut self.ov_ids, [])
    ids.clear()
    for key in keys {
        if let Some(si) = self.outputs[o].by_key.get(key) {
            ids.push(self.outputs[o].slots[int(si)].id)
        }
    }
    self.outputs[o].scene.set_overlays(ids)
    self.ov_ids = ids
}

// ------------------------------------------------------------- textures

fn Compositor.encoder(mut self) -> Result[gpu.Encoder, str] {
    if let Some(e) = self.uploads.take() {
        return Ok(e)
    }
    return self.dev.encoder()
}

fn Compositor.put(mut self, key: u64, t: gpu.Texture) {
    self.tex_ver += 1
    if let Some(old) = self.texs.insert(key, t) {
        self.dev.destroy_texture(old)
    }
}

/// Whether texture `key` exists.
pub fn Compositor.has(self, key: u64) -> bool {
    return self.texs.contains(key)
}

/// Free texture `key` (nothing shows it any more).
pub fn Compositor.forget(mut self, key: u64) {
    if let Some(t) = self.texs.remove(key) {
        self.tex_ver += 1
        self.dev.destroy_texture(t)
    }
    discard self.shms.remove(key)
}

/// Texture `key` is a 1..4 plane dmabuf (the plane fds stay the
/// caller's); false when the GPU cannot sample it.
pub fn Compositor.import_dmabuf(mut self, key: u64, d: types.Dmabuf) -> bool {
    guard d.planes >= 1 and d.planes <= 4 else {
        return false
    }
    guard let Ok(t) = format.import_dmabuf(mut self.dev, d) else {
        return false
    }
    self.put(key, t)
    return true
}

/// Texture `key` is one premultiplied pixel (32 bits a channel),
/// stretched by its viewport.
pub fn Compositor.solid(mut self, key: u64, rgba: [4]u32) -> bool {
    let px: [4]u8 = [u8(rgba[0] >> 24), u8(rgba[1] >> 24), u8(rgba[2] >> 24), u8(rgba[3] >> 24)]
    let fourcc = if rgba[3] == 0xFFFFFFFF { types.buffer.xbgr8888 } else { types.buffer.abgr8888 }
    return self.image(key, 1, 1, fourcc, px, 4)
}

/// Texture `key` holds `pixels` (`width` x `height` of `fourcc`, rows
/// `stride` bytes apart), made again only when the size or format changes;
/// the copy is recorded for the next frame. False when the format is not
/// supported.
pub fn Compositor.image(mut self, key: u64, width: i32, height: i32, fourcc: u32, pixels: Slice[u8], stride: int) -> bool {
    guard self.target(key, width, height, fourcc) else {
        return false
    }
    let none: List[(i32, i32, i32, i32)] = []
    return self.write(key, pixels, stride, none)
}

/// Copy `rects` (texture pixels) of `pixels` into texture `key`.
pub fn Compositor.update(mut self, key: u64, pixels: Slice[u8], stride: int, rects: Slice[(i32, i32, i32, i32)]) -> bool {
    return self.texs.contains(key) and self.write(key, pixels, stride, rects)
}

/// Make sure texture `key` is `width` x `height` of `fourcc`.
fn Compositor.target(mut self, key: u64, width: i32, height: i32, fourcc: u32) -> bool {
    if let Some(t) = self.texs.get(key) {
        let same = i32(t.width()) == width and i32(t.height()) == height and self.shms.get(key).map(fn(s) => s.format).unwrap_or(0) == fourcc
        if same {
            return true
        }
    }
    guard let Ok(t) = format.shm_texture(mut self.dev, width, height, fourcc) else {
        self.forget(key)
        return false
    }
    self.put(key, t)
    discard self.shms.insert(key, Shm { format: fourcc, x1: width, y1: height })
    return true
}

@noinline
fn Compositor.write(mut self, key: u64, pixels: Slice[u8], stride: int, rects: Slice[(i32, i32, i32, i32)]) -> bool {
    guard let Some(t) = self.texs.get(key) else {
        return false
    }
    guard let Ok(got) = self.encoder() else {
        return false
    }
    var e = got
    let ok = format.upload(mut self.dev, mut e, t, pixels, stride, rects).is_ok()
    self.uploads = Some(e)
    if let Some(s) = self.shms.get(key) {
        discard self.shms.insert(key, Shm { format: s.format })
    }
    return ok
}

/// Surface `key` committed a `width` x `height` shm buffer of `fourcc`
/// with `rects` damaged (buffer pixels; empty: all). Its texture is made
/// again when the size or format changed; the damage merges with what is
/// not uploaded yet and waits for `shm_upload`. False when the format is
/// not supported.
pub fn Compositor.shm_commit(mut self, key: u64, width: i32, height: i32, fourcc: u32, rects: Slice[(i32, i32, i32, i32)]) -> bool {
    guard self.target(key, width, height, fourcc) else {
        return false
    }
    var s = self.shms.get(key).unwrap()
    if rects.is_empty() {
        s.x0 = 0
        s.y0 = 0
        s.x1 = width
        s.y1 = height
    }
    for r in rects {
        if s.x0 >= s.x1 {
            s.x0 = r.0
            s.y0 = r.1
            s.x1 = r.0 + r.2
            s.y1 = r.1 + r.3
        } else {
            s.x0 = min(s.x0, r.0)
            s.y0 = min(s.y0, r.1)
            s.x1 = max(s.x1, r.0 + r.2)
            s.y1 = max(s.y1, r.1 + r.3)
        }
    }
    discard self.shms.insert(key, s)
    return true
}

/// Record surface `key`'s merged damage from the shm pixels `bytes`; the
/// bytes may go back to the client after this returns.
pub fn Compositor.shm_upload(mut self, key: u64, bytes: Slice[u8], stride: int) -> bool {
    guard let Some(s) = self.shms.get(key) else {
        return false
    }
    guard s.x0 < s.x1 and s.y0 < s.y1 else {
        return true
    }
    let rect: [1](i32, i32, i32, i32) = [(s.x0, s.y0, s.x1 - s.x0, s.y1 - s.y0)]
    return self.write(key, bytes, stride, rect)
}

// -------------------------------------------------------------- targets & capture

fn Compositor.flush_uploads(mut self) -> Result[(), str] {
    if let Some(u) = self.uploads.take() {
        var enc = u
        discard try self.dev.submit(take enc)
    }
    return Ok(())
}

/// Render targets an output asked for.
@noinline
@cold
pub fn Compositor.targets(mut self, w: types.Want) -> Result[List[types.Target], str] {
    guard let Some((vf, _)) = format.vk_format(w.format) else {
        return Err("render target format {w.format:08x} is not supported")
    }
    let desc = gpu.TextureDesc { width: u32(w.width), height: u32(w.height), format: vf, target: true }
    let do_export = w.export and self.dev.can_export_dmabuf()
    var mods: List[u64] = []
    if do_export {
        let gpu_mods = self.dev.dmabuf_modifiers(vf, true)
        for m in gpu_mods {
            if w.modifiers.is_empty() or w.modifiers.contains(m) {
                mods.push(m)
            }
        }
        if mods.is_empty() {
            mods.push(0)
        }
    }
    var out: List[types.Target] = []
    for _ in 0..w.count {
        let key = self.next_target
        self.next_target += 1
        if do_export {
            let (t, b) = try self.dev.export_dmabuf_with(desc, mods)
            discard self.targets.insert(key, t)
            let n = b.plane_count()
            var buf = types.Dmabuf { width: w.width, height: w.height, format: w.format, modifier: b.modifier, planes: n }
            for i in 0..n {
                let p = b.plane(i)
                buf.plane[i] = types.Plane { fd: int(p.fd), offset: u32(p.offset), stride: u32(p.stride) }
            }
            out.push(types.Target { key, buf })
        } else {
            discard self.targets.insert(key, try self.dev.texture(desc))
            out.push(types.Target { key })
        }
    }
    return Ok(out)
}

/// Free render target `key` (its output let it go).
pub fn Compositor.drop_target(mut self, key: u64) {
    if let Some(t) = self.targets.remove(key) {
        self.dev.destroy_texture(t)
    }
}

@noinline
fn Compositor.take_canvas(mut self, fmt: gpu.Format) -> Result[draw2d.Canvas, str] {
    if fmt == gpu.Format.B8G8R8A8_UNORM {
        guard let Some(cv) = self.canvas.take() else {
            return Err("no canvas")
        }
        return Ok(cv)
    }
    for i in 0..self.extra_canvases.len() {
        if self.extra_canvases[i].0 == fmt {
            let (_, cv) = self.extra_canvases.remove(i)
            return Ok(cv)
        }
    }
    return draw2d.Canvas.create(mut self.dev, fmt)
}

@noinline
fn Compositor.put_canvas(mut self, fmt: gpu.Format, take cv: draw2d.Canvas) {
    if fmt == gpu.Format.B8G8R8A8_UNORM {
        self.canvas = Some(cv)
    } else {
        self.extra_canvases.push((fmt, cv))
    }
}

/// Draw what output `o` needs into target `key`, whose content is `age`
/// frames old: the sync_file fence of the drawing, or None when the image
/// is already up to date.
pub fn Compositor.render(mut self, o: int, key: u64, age: u32) -> Result[Option[int], str] {
    try self.flush_uploads()
    guard o < self.outputs.len() else {
        return Ok(None)
    }
    guard let Some(t) = self.targets.get(key) else {
        return Err("no render target {key}")
    }
    let fmt = t.format()
    var canvas = try self.take_canvas(fmt)
    var e = match self.dev.encoder() {
        Ok(e) => e
        Err(err) => {
            self.put_canvas(fmt, canvas)
            return Err(err)
        }
    }
    var out = mem.replace(mut self.outputs[o], blank())
    let r = out.scene.render(mut self.dev, mut canvas, mut e, gpu.Frame.new(t, age))
    self.outputs[o] = out
    self.put_canvas(fmt, canvas)
    guard let Ok(drew) = r else {
        self.dev.cancel(take e)
        return Err(r.unwrap_err())
    }
    guard drew else {
        self.dev.cancel(take e)
        return Ok(None)
    }
    if self.dev.can_export_sync_file() {
        let (_, fence) = try self.dev.submit_sync_file(take e)
        return Ok(Some(int(fence)))
    }
    let ticket = try self.dev.submit(take e)
    try self.dev.wait(ticket)
    return Ok(Some(-1))
}

/// The pixels of target `key` (B8G8R8A8), once the GPU is done with it.
@noinline
@cold
pub fn Compositor.read(mut self, key: u64) -> Result[List[u8], str] {
    guard let Some(t) = self.targets.get(key) else {
        return Err("no render target {key}")
    }
    return self.dev.read_texture(t)
}

@noinline
@cold
fn Compositor.draw_placements(mut self, mut cv: draw2d.Canvas, mut e: gpu.Encoder, dst: gpu.Texture, ps: Slice[Placement]) -> Result[(), str] {
    cv.clear()
    cv.set_output_color(types.dst_sdr, 203.0, 1000.0)
    let w = dst.width()
    let h = dst.height()
    cv.rect(draw2d.Rect { w: f32(w), h: f32(h) }, vec4(0.0))
    for p in ps {
        guard let Some(t) = self.texs.get(p.tex) else {
            continue
        }
        let v = view(p, t)
        let pw = if v.w > 0.0 { v.w } else if not v.src.is_empty() { v.src.w } else { f32(t.width()) }
        let ph = if v.h > 0.0 { v.h } else if not v.src.is_empty() { v.src.h } else { f32(t.height()) }
        let r = draw2d.Rect { x: v.x, y: v.y, w: pw, h: ph }
        let src_rect = if v.src.is_empty() {
            draw2d.Rect { w: 1.0, h: 1.0 }
        } else {
            let tw = f32(t.width())
            let th = f32(t.height())
            let pic = if v.transform.swaps() { vec2(th, tw) } else { vec2(tw, th) }
            draw2d.Rect { x: v.src.x / pic.x, y: v.src.y / pic.y, w: v.src.w / pic.x, h: v.src.h / pic.y }
        }
        if v.shadow > 0.0 {
            cv.shadow(r, vec4(0.0, 0.0, 0.0, 0.45 * v.opacity), v.radius, v.shadow)
        }
        cv.texture_color(t, r, src_rect, v.transform, vec4(1.0, 1.0, 1.0, v.opacity), v.radius, v.color_space)
        e.acquire(t)
    }
    let none: List[draw2d.Rect] = []
    try cv.draw(mut self.dev, mut e, gpu.Pass { target: dst, load: gpu.Load.Clear, clear: [0.0, 0.0, 0.0, 0.0] }, none)
    for p in ps {
        if let Some(t) = self.texs.get(p.tex) {
            e.release(t)
        }
    }
    return Ok(())
}

/// Zero-copy GPU copy from render target `target_key` into a client's capture
/// dmabuf `dst_buf`, returning the completion sync_file fd (or -1 if already signaled).
@noinline
@cold
pub fn Compositor.copy_dmabuf(mut self, target_key: u64, dst_buf: types.Dmabuf, sx: i32, sy: i32, w: i32, h: i32) -> Result[int, str] {
    try self.flush_uploads()
    guard let Some(src) = self.targets.get(target_key) else {
        return Err("no render target {target_key}")
    }
    guard w > 0 and h > 0 and w <= dst_buf.width and h <= dst_buf.height else {
        return Err("invalid capture copy rect {w}x{h} into {dst_buf.width}x{dst_buf.height}")
    }
    let dst = try format.import_dmabuf_target(mut self.dev, dst_buf)
    guard src.format() == dst.format() else {
        self.dev.destroy_texture(dst)
        return Err("capture dmabuf format differs from render target")
    }
    var e = match self.dev.encoder() {
        Ok(e) => e
        Err(err) => {
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    e.acquire(dst)
    e.copy_texture(src, dst, sx, sy, 0, 0, u32(w), u32(h))
    e.release(dst)
    let res = self.dev.submit_sync_file(take e)
    self.dev.destroy_texture(dst)
    let (_, fence) = try res
    return Ok(int(fence))
}

/// Render `ps` into an offscreen `width` x `height` B8G8R8A8 target and return pixels.
@noinline
@cold
pub fn Compositor.render_offscreen(mut self, width: u32, height: u32, ps: Slice[Placement]) -> Result[List[u8], str] {
    try self.flush_uploads()
    guard width > 0 and height > 0 else {
        return Err("invalid offscreen capture size {width}x{height}")
    }
    let dst = try self.dev.texture(gpu.TextureDesc { width, height, format: gpu.Format.B8G8R8A8_UNORM, target: true })
    var canvas = match self.take_canvas(gpu.Format.B8G8R8A8_UNORM) {
        Ok(c) => c
        Err(err) => {
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    var e = match self.dev.encoder() {
        Ok(e) => e
        Err(err) => {
            self.put_canvas(gpu.Format.B8G8R8A8_UNORM, canvas)
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    let r = self.draw_placements(mut canvas, mut e, dst, ps)
    self.put_canvas(gpu.Format.B8G8R8A8_UNORM, canvas)
    guard r.is_ok() else {
        self.dev.cancel(take e)
        self.dev.destroy_texture(dst)
        return Err(r.unwrap_err())
    }
    let ticket = match self.dev.submit(take e) {
        Ok(t) => t
        Err(err) => {
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    if let Err(err) = self.dev.wait(ticket) {
        self.dev.destroy_texture(dst)
        return Err(err)
    }
    let px = self.dev.read_texture(dst)
    self.dev.destroy_texture(dst)
    return px
}

/// Render `ps` directly into (or copy into) a client's capture dmabuf `dst_buf`,
/// returning the completion sync_file fd (or -1 if already signaled).
@noinline
@cold
pub fn Compositor.render_offscreen_dmabuf(mut self, dst_buf: types.Dmabuf, ps: Slice[Placement]) -> Result[int, str] {
    try self.flush_uploads()
    guard let Some((vf, _)) = format.vk_format(dst_buf.format) else {
        return Err("capture format {dst_buf.format:08x} is not supported")
    }
    let dst = try format.import_dmabuf_target(mut self.dev, dst_buf)
    let cv_fmt = if dst.can_target() { vf } else { gpu.Format.B8G8R8A8_UNORM }
    var cv = match self.take_canvas(cv_fmt) {
        Ok(c) => c
        Err(err) => {
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    var e = match self.dev.encoder() {
        Ok(e) => e
        Err(err) => {
            self.put_canvas(cv_fmt, cv)
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    if dst.can_target() {
        e.acquire(dst)
        let r = self.draw_placements(mut cv, mut e, dst, ps)
        self.put_canvas(cv_fmt, cv)
        guard r.is_ok() else {
            self.dev.cancel(take e)
            self.dev.destroy_texture(dst)
            return Err(r.unwrap_err())
        }
        e.release(dst)
        let res = self.dev.submit_sync_file(take e)
        self.dev.destroy_texture(dst)
        let (_, fence) = try res
        return Ok(int(fence))
    }
    // Modifier supports TRANSFER_DST only: render offscreen then copy/blit to dmabuf.
    let tmp = match self.dev.texture(gpu.TextureDesc { width: dst.width(), height: dst.height(), format: gpu.Format.B8G8R8A8_UNORM, target: true }) {
        Ok(t) => t
        Err(err) => {
            self.put_canvas(cv_fmt, cv)
            self.dev.cancel(take e)
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    let r = self.draw_placements(mut cv, mut e, tmp, ps)
    self.put_canvas(cv_fmt, cv)
    guard r.is_ok() else {
        self.dev.cancel(take e)
        self.dev.destroy_texture(tmp)
        self.dev.destroy_texture(dst)
        return Err(r.unwrap_err())
    }
    e.acquire(dst)
    e.copy_texture(tmp, dst, 0, 0, 0, 0, dst.width(), dst.height())
    e.release(dst)
    let res = self.dev.submit_sync_file(take e)
    self.dev.destroy_texture(tmp)
    self.dev.destroy_texture(dst)
    let (_, fence) = try res
    return Ok(int(fence))
}

/// What the last frame of output `o` changed (damage for KMS and parents).
pub fn Compositor.changed(self, o: int, mut out: List[(i32, i32, i32, i32)]) {
    guard o < self.outputs.len() else {
        return
    }
    for r in self.outputs[o].scene.changed() {
        out.push((i32(r.x), i32(r.y), i32(r.w), i32(r.h)))
    }
}

/// Free everything (after the outputs let go of their targets).
@noinline
@cold
pub fn Compositor.close(mut self) {
    if not self.dev.lost() {
        discard self.dev.idle()
    }
    if let Some(u) = self.uploads.take() {
        var enc = u
        self.dev.cancel(take enc)
    }
    var ts: List[gpu.Texture] = []
    self.texs.each(fn(_, t) {
        ts.push(t)
    })
    self.targets.each(fn(_, t) {
        ts.push(t)
    })
    for t in ts {
        self.dev.destroy_texture(t)
    }
    self.texs.clear()
    self.targets.clear()
    self.shms.clear()
    if let Some(c) = self.canvas.take() {
        c.destroy(mut self.dev)
    }
    let extras = mem.replace(mut self.extra_canvases, [])
    for (_, c) in take extras {
        c.destroy(mut self.dev)
    }
}
