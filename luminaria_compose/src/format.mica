// Client buffers as textures: DRM fourcc formats mapped to Vulkan formats
// (X formats read alpha as 1), dmabufs imported once, shm buffers kept in
// one texture per surface that commits upload only their damage into.

import vk_gpu as gpu

pub let argb8888: u32 = 0x34325241
pub let xrgb8888: u32 = 0x34325258
pub let abgr8888: u32 = 0x34324241
pub let xbgr8888: u32 = 0x34324258

/// The Vulkan format a fourcc samples as, and whether alpha is ignored.
pub fn vk_format(fourcc: u32) -> Option[(gpu.Format, bool)] {
    if fourcc == argb8888 or fourcc == xrgb8888 {
        return Some((gpu.Format.B8G8R8A8_UNORM, fourcc == xrgb8888))
    }
    if fourcc == abgr8888 or fourcc == xbgr8888 {
        return Some((gpu.Format.R8G8B8A8_UNORM, fourcc == xbgr8888))
    }
    return None
}

/// Every fourcc and modifier the GPU samples dmabufs of (linux-dmabuf's
/// format table).
pub fn dmabuf_formats(dev: gpu.Device) -> List[(u32, u64)] {
    var out: List[(u32, u64)] = []
    for f in [argb8888, xrgb8888, abgr8888, xbgr8888] {
        if let Some((vf, _)) = vk_format(f) {
            for m in dev.dmabuf_modifiers(vf, false) {
                out.push((f, m))
            }
        }
    }
    return out
}

/// Import a single-plane dmabuf (the fd stays the caller's).
pub fn import_dmabuf(mut dev: gpu.Device, fd: int, width: i32, height: i32, fourcc: u32, modifier: u64, offset: u32, stride: u32) -> Result[gpu.Texture, str] {
    guard let Some((vf, opaque)) = vk_format(fourcc) else {
        return Err("dmabuf format {fourcc:08x} is not supported")
    }
    let d = gpu.Dmabuf { fd: i32(fd), width: u32(width), height: u32(height), format: vf, modifier, offset: u64(offset), stride: u64(stride), opaque }
    return dev.import_dmabuf(d)
}

/// A texture for an shm surface of this size and format.
pub fn shm_texture(mut dev: gpu.Device, width: i32, height: i32, fourcc: u32) -> Result[gpu.Texture, str] {
    guard let Some((vf, opaque)) = vk_format(fourcc) else {
        return Err("shm format {fourcc:08x} is not supported")
    }
    return dev.texture(gpu.TextureDesc { width: u32(width), height: u32(height), format: vf, opaque })
}

/// Copy damaged rectangles (buffer pixels; empty means all) of shm pixels
/// into `tex`.
pub fn upload(mut dev: gpu.Device, mut e: gpu.Encoder, tex: gpu.Texture, bytes: &[u8], stride: int, rects: &[(i32, i32, i32, i32)]) -> Result[(), str] {
    let w = i32(tex.width())
    let h = i32(tex.height())
    if rects.is_empty() {
        return dev.write_texture_rect(mut e, tex, 0, 0, u32(w), u32(h), bytes, u32(stride))
    }
    for r in rects {
        let x0 = max(r.0, 0)
        let y0 = max(r.1, 0)
        let x1 = min(r.0 + r.2, w)
        let y1 = min(r.1 + r.3, h)
        if x1 > x0 and y1 > y0 {
            try dev.write_texture_rect(mut e, tex, u32(x0), u32(y0), u32(x1 - x0), u32(y1 - y0), bytes, u32(stride))
        }
    }
    return Ok(())
}
