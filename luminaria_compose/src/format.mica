// Buffer formats: DRM fourcc formats mapped to Vulkan formats (X formats
// read alpha as 1), the dmabuf format tables, and safe 1..4 plane import
// and shm upload helpers for client textures and capture targets.

import std.os
import vk_gpu as gpu
import luminaria_types as types
import luminaria_types.buffer as fourcc

pub let argb8888 = fourcc.argb8888
pub let xrgb8888 = fourcc.xrgb8888
pub let abgr8888 = fourcc.abgr8888
pub let xbgr8888 = fourcc.xbgr8888
pub let argb2101010 = fourcc.argb2101010
pub let xrgb2101010 = fourcc.xrgb2101010
pub let abgr2101010 = fourcc.abgr2101010
pub let xbgr2101010 = fourcc.xbgr2101010
pub let abgr16161616f = fourcc.abgr16161616f
pub let xbgr16161616f = fourcc.xbgr16161616f

/// The Vulkan format a fourcc samples as, and whether alpha is ignored.
pub fn vk_format(fourcc: u32) -> Option[(gpu.Format, bool)] {
    if fourcc == argb8888 or fourcc == xrgb8888 {
        return Some((gpu.Format.B8G8R8A8_UNORM, fourcc == xrgb8888))
    }
    if fourcc == abgr8888 or fourcc == xbgr8888 {
        return Some((gpu.Format.R8G8B8A8_UNORM, fourcc == xbgr8888))
    }
    if fourcc == argb2101010 or fourcc == xrgb2101010 {
        return Some((gpu.Format.A2R10G10B10_UNORM_PACK32, fourcc == xrgb2101010))
    }
    if fourcc == abgr2101010 or fourcc == xbgr2101010 {
        return Some((gpu.Format.A2B10G10R10_UNORM_PACK32, fourcc == xbgr2101010))
    }
    if fourcc == abgr16161616f or fourcc == xbgr16161616f {
        return Some((gpu.Format.R16G16B16A16_SFLOAT, fourcc == xbgr16161616f))
    }
    return None
}

/// Every fourcc and modifier the GPU samples dmabufs of (linux-dmabuf's
/// format table).
@noinline
@cold
pub fn dmabuf_formats(dev: gpu.Device) -> List[(u32, u64)] {
    var out: List[(u32, u64)] = []
    for f in [argb8888, xrgb8888, abgr8888, xbgr8888, argb2101010, xrgb2101010, abgr2101010, xbgr2101010, abgr16161616f, xbgr16161616f] {
        if let Some((vf, _)) = vk_format(f) {
            for m in dev.dmabuf_modifiers(vf, false) {
                out.push((f, m))
            }
        }
    }
    return out
}

/// Every fourcc and modifier writable as a GPU dmabuf capture destination.
@noinline
@cold
pub fn capture_formats(dev: gpu.Device) -> List[(u32, u64)] {
    var out: List[(u32, u64)] = []
    for f in [argb8888, xrgb8888, abgr8888, xbgr8888] {
        if let Some((vf, _)) = vk_format(f) {
            for m in dev.dmabuf_capture_modifiers(vf) {
                out.push((f, m))
            }
        }
    }
    return out
}

@noinline
@cold
fn to_gpu_dmabuf(d: types.Dmabuf, vf: gpu.Format, opaque: bool, mut dup_fds: List[i32]) -> Result[gpu.Dmabuf, str] {
    guard d.width > 0 and d.height > 0 and d.planes >= 1 and d.planes <= 4 else {
        return Err("dmabuf {d.width}x{d.height} planes {d.planes}")
    }
    var planes: [4]gpu.Plane = [gpu.Plane {}, gpu.Plane {}, gpu.Plane {}, gpu.Plane {}]
    for i in 0..d.planes {
        let p = d.plane[i]
        guard p.fd >= 0 else {
            for fd in dup_fds {
                os.close(int(fd))
            }
            dup_fds.clear()
            return Err("dmabuf plane {i} has negative fd")
        }
        guard let Ok(dup_fd) = os.dup(p.fd) else {
            for fd in dup_fds {
                os.close(int(fd))
            }
            dup_fds.clear()
            return Err("dup dmabuf plane {i} fd failed")
        }
        dup_fds.push(i32(dup_fd))
        planes[i] = gpu.Plane { fd: i32(dup_fd), offset: u64(p.offset), stride: u64(p.stride) }
    }
    return Ok(gpu.Dmabuf {
        fd: planes[0].fd,
        width: u32(d.width),
        height: u32(d.height),
        format: vf,
        modifier: d.modifier,
        offset: planes[0].offset,
        stride: planes[0].stride,
        opaque,
        num_planes: d.planes,
        planes,
    })
}

/// Import a 1..4 plane dmabuf for sampling; the caller keeps ownership of all
/// plane file descriptors (every descriptor passed to Vulkan is duplicated).
pub fn import_dmabuf(mut dev: gpu.Device, d: types.Dmabuf) -> Result[gpu.Texture, str] {
    guard let Some((vf, opaque)) = vk_format(d.format) else {
        return Err("dmabuf format {d.format:08x} is not supported")
    }
    var dup_fds: List[i32] = []
    let gd = try to_gpu_dmabuf(d, vf, opaque, mut dup_fds)
    return match dev.import_dmabuf(gd) {
        Ok(t) => Ok(t)
        Err(e) => {
            for fd in dup_fds {
                os.close(int(fd))
            }
            Err(e)
        }
    }
}

/// Import a 1..4 plane dmabuf as a writable capture target; the caller keeps
/// ownership of all plane file descriptors.
pub fn import_dmabuf_target(mut dev: gpu.Device, d: types.Dmabuf) -> Result[gpu.Texture, str] {
    guard let Some((vf, _)) = vk_format(d.format) else {
        return Err("dmabuf capture format {d.format:08x} is not supported")
    }
    var dup_fds: List[i32] = []
    let gd = try to_gpu_dmabuf(d, vf, false, mut dup_fds)
    return match dev.import_dmabuf_target(gd) {
        Ok(t) => Ok(t)
        Err(e) => {
            for fd in dup_fds {
                os.close(int(fd))
            }
            Err(e)
        }
    }
}

/// A texture for an shm surface of this size and format.
pub fn shm_texture(mut dev: gpu.Device, width: i32, height: i32, fourcc: u32) -> Result[gpu.Texture, str] {
    guard let Some((vf, opaque)) = vk_format(fourcc) else {
        return Err("shm format {fourcc:08x} is not supported")
    }
    return dev.texture(gpu.TextureDesc { width: u32(width), height: u32(height), format: vf, opaque })
}

/// Copy damaged rectangles (buffer pixels; empty means all) of shm pixels
/// into `tex`.
pub fn upload(mut dev: gpu.Device, mut e: gpu.Encoder, tex: gpu.Texture, bytes: Slice[u8], stride: int, rects: Slice[(i32, i32, i32, i32)]) -> Result[(), str] {
    let w = i32(tex.width())
    let h = i32(tex.height())
    if rects.is_empty() {
        return dev.write_texture_rect(mut e, tex, 0, 0, u32(w), u32(h), bytes, u32(stride))
    }
    for r in rects {
        let x0 = max(r.0, 0)
        let y0 = max(r.1, 0)
        let x1 = min(r.0 + r.2, w)
        let y1 = min(r.1 + r.3, h)
        if x1 > x0 and y1 > y0 {
            try dev.write_texture_rect(mut e, tex, u32(x0), u32(y0), u32(x1 - x0), u32(y1 - y0), bytes, u32(stride))
        }
    }
    return Ok(())
}
