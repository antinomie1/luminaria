// The Vulkan renderer on the real device: placement lists diffed by key
// into damage, restacking, shm damage uploads, client textures, render
// targets and dmabuf formats.

import std.os
import vk_gpu as gpu
import luminaria_types as types
import luminaria_compose as compose

fn fill(rgba: [4]u8, n: int) -> List[u8] {
    var px: List[u8] = []
    for _ in 0..n {
        for b in rgba {
            px.push(b)
        }
    }
    return px
}

/// A renderer with output 0 of `size` x `size` and one render target.
fn open(size: i32) -> Option[(compose.Compositor, u64)] {
    guard let Ok(c) = compose.Compositor.open(true) else {
        return None
    }
    var r = c
    r.add_output(0, u32(size), u32(size), vec4(0.0, 0.0, 0.0, 1.0))
    let ts = r.targets(types.Want { width: size, height: size, count: 1, export: false }).unwrap()
    return Some((r, ts[0].key))
}

fn draw(mut c: compose.Compositor, t: u64) -> List[u8] {
    if let Some(fence) = c.render(0, t, 0).unwrap() {
        os.close(fence)
    }
    return c.read(t).unwrap()
}

fn px(img: List[u8], size: int, x: int, y: int) -> (u8, u8, u8) {
    let i = (y * size + x) * 4
    return (img[i], img[i + 1], img[i + 2])
}

test "placement lists diff into damage and order" {
    guard let Some((cc, t)) = open(16) else {
        return
    }
    var c = cc
    assert(c.image(101, 8, 8, types.buffer.xbgr8888, fill([255, 0, 0, 255], 64), 32))
    assert(c.image(102, 8, 8, types.buffer.xbgr8888, fill([0, 255, 0, 255], 64), 32))
    let a = types.Placement { key: 1, tex: 101, w: 8.0, h: 8.0 }
    let b = types.Placement { key: 2, tex: 102, x: 4.0, y: 4.0, w: 8.0, h: 8.0 }
    c.layout(0, [a, b])
    var img = draw(mut c, t)
    // B8G8R8A8: blue, green, red.
    assert_eq(px(img, 16, 1, 1), (u8(0), u8(0), u8(255)))
    assert_eq(px(img, 16, 6, 6), (u8(0), u8(255), u8(0)))
    // The same list again: nothing to draw.
    c.layout(0, [a, b])
    assert(c.idle(0))
    // Red on top now.
    c.layout(0, [b, a])
    assert(not c.idle(0))
    img = draw(mut c, t)
    assert_eq(px(img, 16, 6, 6), (u8(0), u8(0), u8(255)))
    // Green gone; a placement without a texture shows nothing.
    c.layout(0, [a, types.Placement { key: 3, tex: 999, w: 16.0, h: 16.0 }])
    img = draw(mut c, t)
    assert_eq(px(img, 16, 10, 10), (u8(0), u8(0), u8(0)))
    assert(c.visible(0, 1))
    assert(not c.visible(0, 2))
    assert(not c.visible(0, 3))
    c.close()
}

test "shm damage uploads only the rectangles" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true, validation: true }) else {
        return
    }
    var dev = d
    let t = compose.format.shm_texture(mut dev, 8, 8, compose.format.abgr8888).unwrap()
    var e = dev.encoder().unwrap()
    let none: List[(i32, i32, i32, i32)] = []
    compose.format.upload(mut dev, mut e, t, fill([0, 0, 0, 255], 64), 32, none).unwrap()
    let rects: List[(i32, i32, i32, i32)] = [(2, 2, 2, 2), (-4, -4, 5, 5)]
    compose.format.upload(mut dev, mut e, t, fill([9, 8, 7, 255], 64), 32, rects).unwrap()
    discard dev.submit(take e).unwrap()
    let got = dev.read_texture(t).unwrap()
    let at = fn(x: int, y: int) => got[(y * 8 + x) * 4]
    assert_eq(at(2, 2), u8(9))
    assert_eq(at(3, 3), u8(9))
    assert_eq(at(0, 0), u8(9))
    assert_eq(at(5, 5), u8(0))
    assert(compose.format.vk_format(0x30303030).is_none())
    assert_eq(compose.format.vk_format(compose.format.xrgb8888), Some((gpu.Format.B8G8R8A8_UNORM, true)))
    assert(not compose.format.dmabuf_formats(dev).is_empty())
}

test "client textures: shm damage merges until uploaded, single pixels" {
    guard let Some((cc, t)) = open(8) else {
        return
    }
    var c = cc
    let fmt = types.buffer.xbgr8888
    let all: List[(i32, i32, i32, i32)] = []
    assert(c.shm_commit(7, 8, 8, fmt, all))
    assert(c.shm_upload(7, fill([0, 0, 0, 255], 64), 32))
    c.layout(0, [types.Placement { key: 1, tex: 7, w: 8.0, h: 8.0 }])
    discard draw(mut c, t)
    // Two commits before the next frame: their damage is uploaded once,
    // from the newest pixels.
    let a: List[(i32, i32, i32, i32)] = [(1, 1, 1, 1)]
    let b: List[(i32, i32, i32, i32)] = [(3, 3, 1, 1)]
    assert(c.shm_commit(7, 8, 8, fmt, a))
    assert(c.shm_commit(7, 8, 8, fmt, b))
    assert(c.shm_upload(7, fill([255, 255, 255, 255], 64), 32))
    c.commit(1, all)
    let got = draw(mut c, t)
    assert_eq(px(got, 8, 1, 1), (u8(255), u8(255), u8(255)))
    assert_eq(px(got, 8, 2, 2), (u8(255), u8(255), u8(255)))
    assert_eq(px(got, 8, 3, 3), (u8(255), u8(255), u8(255)))
    assert_eq(px(got, 8, 0, 0), (u8(0), u8(0), u8(0)))
    assert_eq(px(got, 8, 5, 5), (u8(0), u8(0), u8(0)))
    // An unknown format makes no texture.
    assert(not c.shm_commit(8, 4, 4, 0x30303030, all))
    assert(not c.has(8))
    c.forget(7)
    assert(not c.has(7))
    // One premultiplied pixel, 32 bits a channel, stretched.
    assert(c.solid(2, [0xFFFFFFFF, 0, 0x80000000, 0xFFFFFFFF]))
    c.layout(0, [types.Placement { key: 2, tex: 2, w: 8.0, h: 8.0 }])
    let s = draw(mut c, t)
    assert_eq(px(s, 8, 4, 4), (u8(128), u8(0), u8(255)))
    c.close()
}

test "exported render targets are dmabufs" {
    guard let Ok(cc) = compose.Compositor.open(true) else {
        return
    }
    var c = cc
    assert(not c.formats().is_empty())
    let ts = c.targets(types.Want { width: 64, height: 32, count: 2 }).unwrap()
    assert_eq(ts.len(), 2)
    assert(ts[0].key != ts[1].key)
    for x in ts {
        assert_eq(x.buf.planes, 1)
        assert(x.buf.plane[0].fd >= 0)
        assert(x.buf.plane[0].stride >= 64 * 4)
        c.drop_target(x.key)
    }
    c.close()
}
