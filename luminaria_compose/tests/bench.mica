// A 1920x1080 frame with 50 windows while one 300x200 window moves: CPU
// time to record and submit, and time until the GPU is done. Run with
// --release on the target device.

import std.io
import std.time
import vk_gpu as gpu
import luminaria_compose as compose

test "frame cost with damage and occlusion" {
    guard let Ok(d) = gpu.Device.open(gpu.Options { headless: true }) else {
        return
    }
    var dev = d
    var out = gpu.Offscreen.create(mut dev, 1920, 1080, gpu.Format.B8G8R8A8_UNORM).unwrap()
    var c = compose.Compositor.new(mut dev).unwrap()
    c.add_output(0, 1920, 1080, 60000, vec4(0.1, 0.1, 0.1, 1.0))
    let tex = compose.format.shm_texture(mut dev, 300, 200, compose.format.xrgb8888).unwrap()
    var ps: List[compose.Placement] = []
    for i in 0..50 {
        ps.push(compose.Placement { key: u64(i + 1), tex, x: f32((i % 10) * 180), y: f32((i / 10) * 200), w: 300.0, h: 200.0, radius: 8.0, shadow: 16.0 })
    }
    c.layout(0, ps)
    let frames = 300
    var cpu = 0
    var total = 0
    for k in 0..frames {
        ps[49].x = f32(k % 600)
        c.layout(0, ps)
        let t0 = time.now_ns()
        let f = out.acquire(mut dev).unwrap().unwrap()
        var e = dev.encoder().unwrap()
        discard c.render(0, mut dev, mut e, f).unwrap()
        let ticket = out.present(mut dev, f, take e).unwrap()
        let t1 = time.now_ns()
        dev.wait(ticket).unwrap()
        cpu += t1 - t0
        total += time.now_ns() - t0
    }
    io.print("frame, 50 windows, one moving: {cpu / frames / 1000} us CPU, {total / frames / 1000} us until the GPU is done")
}
