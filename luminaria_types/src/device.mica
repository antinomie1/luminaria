// What an output and its input devices report, and the frame targets an
// output and a renderer trade. Plain data.

import buffer

/// Which of luminaria_backend's outputs to open.
pub enum OutputKind {
    /// Nested when WAYLAND_DISPLAY is set, else DRM.
    Auto
    Drm
    Nested
    Headless
}

/// Rules, model, layout, variant and options, as XKB_DEFAULT_* names them;
/// empty means the system default.
pub struct Names {
    pub rules: str = ""
    pub model: str = ""
    pub layout: str = ""
    pub variant: str = ""
    pub options: str = ""
}

/// Modifiers in effect.
pub struct Mods {
    pub shift: bool = false
    pub ctrl: bool = false
    pub alt: bool = false
    pub logo: bool = false
    pub caps: bool = false
    pub num: bool = false
}

/// Settings of an input device.
pub struct InputConfig {
    pub tap: bool = true
    pub natural_scroll: bool = false
    /// -1..1, 0 is the default speed.
    pub accel: f64 = 0.0
    pub left_handed: bool = false
    /// Disable the device (send no events).
    pub disabled: bool = false
}

pub struct Mode {
    pub width: i32 = 0
    pub height: i32 = 0
    pub refresh_mhz: i32 = 60000
    pub preferred: bool = false
}

/// An output as the hardware (or parent compositor) describes it.
pub struct OutputDesc {
    /// Connector name ("DP-1", "eDP-1", "WL-1", "HEADLESS-1").
    pub name: str = ""
    pub make: str = ""
    pub model: str = ""
    pub width_mm: i32 = 0
    pub height_mm: i32 = 0
    pub modes: List[Mode] = []
    pub mode: Mode = Mode {}
    /// Supports variable refresh rate.
    pub vrr: bool = false
    /// Internal panel (laptop): lid and backlight belong to it.
    pub internal: bool = false
}

pub enum AxisSource {
    Wheel
    Finger
    Continuous
    WheelTilt
}

/// A device's capabilities and identity.
pub struct DeviceDesc {
    pub name: str = ""
    pub keyboard: bool = false
    pub pointer: bool = false
    pub touch: bool = false
    pub touchpad: bool = false
}

/// Input, time in milliseconds of CLOCK_MONOTONIC.
pub enum Input {
    /// evdev code, pressed; keysym, text and modifiers after xkb.
    Key(u32, u32, bool, u32, str)
    /// The serialized modifiers changed: depressed, latched, locked, group.
    Modifiers(u32, u32, u32, u32)
    /// Relative motion: time, dx, dy (accelerated), dx, dy (raw).
    Motion(u32, f64, f64, f64, f64)
    /// Absolute motion on an output: time, output, x, y in 0..1.
    MotionAbsolute(u32, u32, f64, f64)
    /// time, evdev button code, pressed.
    Button(u32, u32, bool)
    /// time, source, dx, dy (pixels), wheel clicks x, y (120ths), inverted.
    Axis(u32, AxisSource, f64, f64, i32, i32, bool)
    /// time, touch id, output, x, y in 0..1.
    TouchDown(u32, i32, u32, f64, f64)
    TouchMotion(u32, i32, u32, f64, f64)
    TouchUp(u32, i32)
    TouchFrame
    TouchCancel
    /// Gestures: time, fingers; updates: dx, dy (and scale, rotation).
    SwipeBegin(u32, i32)
    SwipeUpdate(u32, f64, f64)
    SwipeEnd(u32, bool)
    PinchBegin(u32, i32)
    PinchUpdate(u32, f64, f64, f64, f64)
    PinchEnd(u32, bool)
    HoldBegin(u32, i32)
    HoldEnd(u32, bool)
    DeviceAdded(u32, DeviceDesc)
    DeviceRemoved(u32)
}

pub enum Event {
    OutputAdded(u32)
    OutputRemoved(u32)
    /// The output's mode or size changed (a parent window resized).
    OutputChanged(u32)
    /// A frame reached the screen: output, sequence, CLOCK_MONOTONIC ns,
    /// presentation flags (wp_presentation kinds).
    Presented(u32, u64, int, u32)
    /// A buffer the parent held is free again: a frame that found every
    /// buffer in use can go now.
    Released(u32)
    /// A frame never reached the screen (its commit failed): draw all of
    /// the output again.
    Dropped(u32)
    Input(Input)
    /// Input targeted at a named seat (multi-seat backends).
    InputOn(str, Input)
    /// The session became active (true) or was switched away.
    Session(bool)
    /// The keymap changed: clients need the new memfd.
    Keymap
    /// The keymap on a named seat changed.
    KeymapOn(str)
    /// The backend cannot go on (the parent compositor closed us).
    Closed
}

/// wp_presentation_feedback kinds.
pub let presented_vsync: u32 = 1
pub let presented_hw_clock: u32 = 2
pub let presented_hw_completion: u32 = 4
pub let presented_zero_copy: u32 = 8

/// Render targets an output asks the renderer for: `count` images of
/// this size and fourcc, with one of `modifiers` (empty: any), exported as
/// dmabufs when `export` (a display or parent compositor shows them).
pub struct Want {
    pub width: i32 = 0
    pub height: i32 = 0
    pub format: u32 = buffer.xrgb8888
    pub modifiers: List[u64] = []
    pub count: int = 2
    pub export: bool = true
}

/// A render target the renderer made: its key and, when exported, its
/// dmabuf.
pub struct Target {
    pub key: u64 = 0
    pub buf: buffer.Dmabuf = buffer.Dmabuf {}
}

pub enum Acquire {
    /// Draw into target `key`; its content is `age` frames old (0: none).
    Draw(u64, u32)
    /// Every target is in use: try again after the next Presented or
    /// Released.
    Busy
    /// The output needs targets first (`give` them).
    Need(Want)
}
