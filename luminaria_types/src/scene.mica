// What a renderer shows: placements, back to front, in output pixels.
// Textures are named by key; the renderer owns them.

import buffer

pub struct Rect {
    pub x: f32 = 0.0
    pub y: f32 = 0.0
    pub w: f32 = 0.0
    pub h: f32 = 0.0
}

/// Source color space identifiers matching `vk_draw2d` (`color_*`).
pub let color_sdr: u32 = 0
pub let color_scrgb: u32 = 1
pub let color_bt2020_pq: u32 = 2
pub let color_bt2020_hlg: u32 = 3

/// Output color space identifiers matching `vk_draw2d` (`dst_*`).
pub let dst_sdr: u32 = 0
pub let dst_hdr_pq: u32 = 1
pub let dst_hdr_scrgb: u32 = 2

/// One thing to show: a texture placed on an output.
pub struct Placement {
    /// Stable identity (a surface, a compositor image): a key keeps its
    /// view, so only what changes is damaged.
    pub key: u64 = 0
    /// The texture's key (a client buffer, an shm surface, an image).
    pub tex: u64 = 0
    /// Where, in output pixels.
    pub x: f32 = 0.0
    pub y: f32 = 0.0
    pub w: f32 = 0.0
    pub h: f32 = 0.0
    /// Part of the texture (pixels of the upright picture); empty: all.
    pub src: Rect = Rect {}
    /// wl_output.transform the texture is turned by.
    pub transform: u32 = 0
    pub opacity: f32 = 1.0
    pub radius: f32 = 0.0
    pub shadow: f32 = 0.0
    /// Opaque part, relative to x, y.
    pub opaque: Rect = Rect {}
    /// Source color space (`color_sdr`, `color_scrgb`, `color_bt2020_pq`, `color_bt2020_hlg`).
    pub color_space: u32 = 0
}

/// A placement eligible for hardware overlay scanout on an output.
pub struct OverlayCand {
    pub key: u64 = 0
    pub tex: u64 = 0
    pub x: i32 = 0
    pub y: i32 = 0
    pub w: i32 = 0
    pub h: i32 = 0
    /// Part of the texture (pixels of the upright picture); empty: all.
    pub src: Rect = Rect {}
    pub transform: u32 = 0
    pub opaque: bool = false
}

/// An overlay plane assignment: destination rectangle and source dmabuf.
pub struct Overlay {
    pub key: u64 = 0
    pub buf_key: u64 = 0
    pub x: i32 = 0
    pub y: i32 = 0
    pub w: i32 = 0
    pub h: i32 = 0
    /// Part of the texture (pixels of the upright picture); empty: all.
    pub src: Rect = Rect {}
    pub buf: buffer.Dmabuf = buffer.Dmabuf {}
}
