// What the server keeps per object. Every record names its client slot and
// protocol id so requests and teardown find it; slots of other records are
// `none` when unset.

import std.os
import luminaria_types as types
import luminaria_wire as wire
import ids
import positioner

let none: u32 = 0xFFFFFFFF

struct ClientData {
    pid: int = 0
    uid: int = 0
    gid: int = 0
    /// Its last xdg_wm_base (0: none), the serial of the ping it has not
    /// answered yet (0: none) and when that went out (ns).
    wm_base: u32 = 0
    ping: u32 = 0
    ping_ns: int = 0
    /// Object id -> slot in its kind's slab, for ids below server_base.
    objs: List[u32] = []
    /// Ids from server_base (data offers) -> slot.
    high: List[u32] = []
    registries: List[u32] = []
    /// Transactions of this client, oldest first: applied in order.
    txns: List[u32] = []
    /// Connected through a wp_security_context_v1 listener: privileged
    /// globals are hidden; what the sandbox said about it.
    sandboxed: bool = false
    engine: str = ""
    app_id: str = ""
    instance_id: str = ""
}

/// A global's kind: static ones by interface, outputs and seats by slot.
enum GlobalKind {
    Static
    Output(u32)
    Seat(u32)
    /// A protocol extension (its index).
    Ext(u32)
}

struct Global {
    iface: u16
    version: u32
    kind: GlobalKind
    alive: bool = true
}

/// Double-buffered surface state: what a commit carries.
struct State {
    /// A buffer was attached (`buffer` None detaches).
    attached: bool = false
    buffer: Option[ids.Id] = None
    dx: i32 = 0
    dy: i32 = 0
    damage: List[ids.Rect] = []
    bdamage: List[ids.Rect] = []
    opaque_set: bool = false
    opaque: List[ids.Rect] = []
    input_set: bool = false
    /// None is infinite (the whole surface).
    input: Option[List[ids.Rect]] = None
    transform_set: bool = false
    transform: u32 = 0
    scale_set: bool = false
    scale: i32 = 1
    viewport_set: bool = false
    /// wp_viewport source (x, y, w, h); w < 0 unset.
    src: [4]f64 = [-1.0, -1.0, -1.0, -1.0]
    /// wp_viewport destination; w < 0 unset.
    dst_w: i32 = -1
    dst_h: i32 = -1
    frames: List[u32] = []
    feedbacks: List[u32] = []
    acquire_set: bool = false
    acquire: u32 = 0xFFFFFFFF
    acquire_point: u64 = 0
    release_set: bool = false
    release: u32 = 0xFFFFFFFF
    release_point: u64 = 0
    fifo_barrier: bool = false
    fifo_wait: bool = false
    target_ns: int = 0
    tearing_set: bool = false
    tearing: bool = false
    geometry_set: bool = false
    geometry: ids.Rect = ids.Rect {}
    min_set: bool = false
    min_w: i32 = 0
    min_h: i32 = 0
    max_set: bool = false
    max_w: i32 = 0
    max_h: i32 = 0
    acked: u32 = 0
    /// Subsurface positions set on this (parent) surface: child slot, x, y.
    moves: List[(u32, i32, i32)] = []
    /// New stacking order of this surface and its subsurfaces.
    order_set: bool = false
    order: List[u32] = []
    /// wp_alpha_modifier multiplier (0xFFFFFFFF opaque).
    alpha_set: bool = false
    alpha: u32 = 0xFFFFFFFF
    /// wp_content_type type.
    content_set: bool = false
    content: u32 = 0
    /// wp_color_management_surface_v1 committed color space (`types.scene.color_*`).
    color_set: bool = false
    color_space: u32 = 0
    /// zwlr_layer_surface state set since the last commit.
    layer_set: bool = false
    layer: LayerState = LayerState {}
}

/// A layer surface's double-buffered state.
pub struct LayerState {
    /// Requested size; 0 stretches between opposite anchors.
    pub width: i32 = 0
    pub height: i32 = 0
    /// Anchored edges: top 1, bottom 2, left 4, right 8.
    pub anchor: u32 = 0
    /// Space kept free for it along its edge; -1 ignores other zones.
    pub exclusive: i32 = 0
    /// The edge the zone applies to when anchored to a corner (0: implied).
    pub exclusive_edge: u32 = 0
    /// Margins: top, right, bottom, left.
    pub margin: [4]i32 = [0, 0, 0, 0]
    /// Keyboard: none 0, exclusive 1, on demand 2.
    pub keyboard: u32 = 0
    /// Background 0, bottom 1, top 2, overlay 3.
    pub layer: u32 = 0
}

enum Role {
    Plain
    Toplevel(u32)
    Popup(u32)
    Sub
    Cursor
    Layer(u32)
    Lock(u32)
    /// zwp_input_popup_surface_v2 of an input method.
    ImePopup(u32)
    /// A wl_surface given to xdg_toplevel_icon (shown nowhere).
    Icon
    /// The image under the pointer during a drag (gets no input).
    DragIcon
}

struct SurfaceData {
    client: u32 = 0
    obj: u32 = 0
    role: Role = Role.Plain
    /// xdg_surface id when it has one.
    xdg: u32 = 0
    pending: State = State {}
    cached: State = State {}
    has_cached: bool = false
    current: State = State {}
    /// Surface size in surface coordinates, after scale, transform and
    /// viewport; 0 without a buffer.
    width: i32 = 0
    height: i32 = 0
    buffer_w: i32 = 0
    buffer_h: i32 = 0
    /// Subsurface tree: parent slot, position, synchronized mode.
    parent: u32 = 0xFFFFFFFF
    sub_obj: u32 = 0
    sub_x: i32 = 0
    sub_y: i32 = 0
    synced: bool = true
    /// This surface and its subsurfaces, bottom to top.
    stack: List[u32] = []
    frames: List[u32] = []
    feedbacks: List[u32] = []
    viewport: u32 = 0
    fractional: u32 = 0
    syncobj: u32 = 0
    fifo: u32 = 0
    timer: u32 = 0
    tearing: u32 = 0
    alpha_obj: u32 = 0
    content_obj: u32 = 0
    color_obj: u32 = 0
    /// Output slots it is on (bit per slot below 64).
    outputs: u64 = 0
    /// Mapped: has a buffer and (with a role) the role allows showing it.
    mapped: bool = false
    /// The last applied commit's damage, merged until `take_damage`.
    applied_damage: List[ids.Rect] = []
    applied_bdamage: List[ids.Rect] = []
    /// What the last applied commits changed (`changed_*` bits).
    changed: u32 = 0
    /// A wp_fifo barrier is set and not yet cleared by a presentation.
    barrier: bool = false
    /// Release point of the current buffer (explicit sync).
    release: u32 = 0xFFFFFFFF
    release_point: u64 = 0
    /// Buffers and release points later commits replaced before
    /// `take_changes` saw them (the compositor never read them).
    superseded: List[Superseded] = []
}

/// A replaced commit's buffer and release point (timeline slot, point).
struct Superseded {
    buffer: Option[ids.Id] = None
    release: u32 = 0xFFFFFFFF
    point: u64 = 0
}

/// Replaced commits kept per surface; past this the buffers go back at
/// once and their release points are dropped (a client gone wild).
let superseded_max: int = 256

/// Bits of `SurfaceData.changed`.
pub let changed_buffer: u32 = 1
pub let changed_damage: u32 = 2
pub let changed_geometry: u32 = 4
pub let changed_opaque: u32 = 8
pub let changed_input: u32 = 16
pub let changed_tree: u32 = 32

enum BufferKind {
    Shm
    Dmabuf
    /// wp_single_pixel_buffer: one premultiplied RGBA pixel.
    SinglePixel
}

/// One plane of a dmabuf.
struct Plane {
    fd: wire.Fd
    offset: u32
    stride: u32
}

struct BufferData {
    client: u32 = 0
    obj: u32 = 0
    kind: BufferKind = BufferKind.Shm
    width: i32 = 0
    height: i32 = 0
    /// DRM fourcc.
    format: u32 = 0
    /// shm: pool slot, byte offset and stride.
    pool: u32 = 0xFFFFFFFF
    offset: int = 0
    stride: int = 0
    planes: List[Plane] = []
    modifier: u64 = 0
    /// The facade still needs it (until `release_buffer`).
    busy: bool = false
    /// zwp_linux_buffer_params id awaiting created / failed (dmabuf `create`).
    params_obj: u32 = 0
    /// Single-pixel colour, premultiplied, 0..0xFFFFFFFF per channel.
    color: [4]u32 = [0, 0, 0, 0]
}

struct PoolData {
    client: u32 = 0
    obj: u32 = 0
    fd: Option[wire.Fd] = None
    map: Option[os.Map] = None
    /// Mapped writable (screen captures write into its buffers).
    writable: bool = false
    size: int = 0
    /// The pool object (while not destroyed) and each buffer.
    refs: int = 0
}

struct RegionData {
    client: u32 = 0
    rects: List[ids.Rect] = []
}

/// A configure the client has not acked yet.
struct Configure {
    serial: u32
    width: i32
    height: i32
}

struct WindowData {
    surface: u32 = 0
    client: u32 = 0
    obj: u32 = 0
    title: str = ""
    app_id: str = ""
    parent: u32 = 0xFFFFFFFF
    /// The initial commit happened (WindowNew sent).
    initial: bool = false
    configured: bool = false
    mapped: bool = false
    configures: List[Configure] = []
    /// zxdg_toplevel_decoration_v1 id (0: none) and the mode the client
    /// wants (0 none, 1 client side, 2 server side), the mode granted.
    decoration: u32 = 0
    deco_wanted: u32 = 0
    deco_mode: u32 = 1
    icon: Icon = Icon {}
    tag: str = ""
    description: str = ""
    dialog: u32 = 0
    modal: bool = false
    /// ext_foreign_toplevel_handle_v1 objects: client slot, id.
    handles: List[(u32, u32)] = []
    /// ext-foreign-toplevel-list identifier.
    identifier: str = ""
    /// zwlr_foreign_toplevel_handle_v1 objects (client slot, id) and the
    /// state bits they were last sent.
    bars: List[(u32, u32)] = []
    bar_state: u32 = 0
}

/// One image of a toplevel icon: ARGB8888 premultiplied pixels.
pub struct IconImage {
    pub size: i32 = 0
    pub scale: i32 = 1
    pub pixels: List[u8] = []
}

/// A toplevel's icon: a theme name, images, or both.
pub struct Icon {
    pub name: str = ""
    pub images: List[IconImage] = []
}

struct IconData {
    client: u32 = 0
    icon: Icon = Icon {}
    /// set_icon happened: the icon is immutable.
    used: bool = false
}

struct PopupData {
    surface: u32 = 0
    client: u32 = 0
    obj: u32 = 0
    /// Parent surface slot.
    parent: u32 = 0xFFFFFFFF
    pos: positioner.Positioner = positioner.Positioner {}
    /// Position relative to the parent's window geometry, and size.
    geometry: ids.Rect = ids.Rect {}
    initial: bool = false
    mapped: bool = false
    configures: List[Configure] = []
    /// A reposition request's token, sent with the next configure.
    token: u32 = 0
    repositioned: bool = false
}

struct PositionerData {
    client: u32 = 0
    pos: positioner.Positioner = positioner.Positioner {}
}

/// Output data compositors fill in (wl_output, xdg_output-like).
pub struct OutputInfo {
    pub name: str = ""
    pub description: str = ""
    pub make: str = ""
    pub model: str = ""
    /// Position in the global layout, logical pixels.
    pub x: i32 = 0
    pub y: i32 = 0
    /// Current mode, physical pixels.
    pub width: i32 = 0
    pub height: i32 = 0
    pub refresh_mhz: i32 = 60000
    pub width_mm: i32 = 0
    pub height_mm: i32 = 0
    /// Fractional scale in 120ths (120 = 1.0).
    pub scale120: i32 = 120
    pub transform: u32 = 0
    /// The modes it can run (width, height, mHz, preferred), for output
    /// configuration tools.
    pub modes: List[(i32, i32, i32, bool)] = []
    pub enabled: bool = true
    /// Variable refresh: supported, on.
    pub vrr_capable: bool = false
    pub vrr: bool = false
    /// Hardware CRTC gamma LUT size (0 if unsupported).
    pub gamma_size: u32 = 0
    /// HDR output enabled and target luminance metadata.
    pub hdr: bool = false
    pub sdr_nits: f32 = 203.0
    pub max_nits: f32 = 1000.0
    /// Monotonic identity for wp_color_management_v1 output/feedback descriptions.
    pub color_identity: u32 = 0
}

struct OutputData {
    name: u32 = 0
    info: OutputInfo = OutputInfo {}
    /// Bound wl_output objects: client slot, id, version.
    binds: List[(u32, u32, u32)] = []
    /// zxdg_output_v1 objects: client slot, id, version.
    xdg: List[(u32, u32, u32)] = []
    /// Active zwlr_gamma_control_v1 owner slot (or `none`).
    gamma_owner: u32 = 0xFFFFFFFF
}

/// A per-client input object of a seat: client slot, id, version.
struct Res {
    client: u32
    id: u32
    version: u32
}

struct SeatData {
    name: str = ""
    global: u32 = 0
    caps: u32 = 0
    seats: List[Res] = []
    keyboards: List[Res] = []
    pointers: List[Res] = []
    touches: List[Res] = []
    devices: List[Res] = []
    kb_focus: u32 = 0xFFFFFFFF
    ptr_focus: u32 = 0xFFFFFFFF
    /// The active pointer constraint (slot), or none.
    constraint: u32 = 0xFFFFFFFF
    /// The client owed a wl_pointer.frame after relative motion, or none.
    frame_owed: u32 = 0xFFFFFFFF
    /// Pointer enter serial last sent on this seat (cursor requests must name it).
    enter_serial: u32 = 0
    /// Last input timestamp on this seat (CLOCK_MONOTONIC ns).
    last_input: int = 0
    keymap: Option[wire.Fd] = None
    keymap_size: u32 = 0
    rate: i32 = 25
    delay: i32 = 600
    pressed: List[u32] = []
    mods: [4]u32 = [0, 0, 0, 0]
    /// Current selection source slot.
    selection: u32 = 0xFFFFFFFF
    /// Touch points down: id and surface slot.
    touch_points: List[(i32, u32)] = []
    /// Primary selection source slot, its devices; data-control devices
    /// (see every selection, any client).
    primary: u32 = 0xFFFFFFFF
    primary_devices: List[Res] = []
    control_devices: List[Res] = []
    /// zwp_relative_pointer_v1 objects (by client).
    relatives: List[Res] = []
    /// Gesture objects: swipe, pinch, hold.
    swipes: List[Res] = []
    pinches: List[Res] = []
    holds: List[Res] = []
    /// A gesture in progress went to this surface slot.
    gesture_surface: u32 = 0xFFFFFFFF
    /// The input method (zwp_input_method_v2, client and id; id 0: none),
    /// its keyboard grab and popup surfaces.
    im_client: u32 = 0
    im: u32 = 0
    grab_client: u32 = 0
    grab: u32 = 0
    /// What the input method committed, applied on its commit.
    im_preedit: str = ""
    im_preedit_begin: i32 = 0
    im_preedit_end: i32 = 0
    im_commit: str = ""
    im_delete_before: u32 = 0
    im_delete_after: u32 = 0
    /// The text input the input method serves (slot), or none.
    im_active: u32 = 0xFFFFFFFF
    /// Input method popups: client, id, surface slot.
    im_popups: List[(u32, u32, u32)] = []
    /// The keymap clients last got: 0 the seat's, k + 1 virtual keyboard
    /// slot k. Content hashes avoid resending equal keymaps.
    keymap_from: u32 = 0
    keymap_hash: u64 = 0
    /// Pointer buttons held (a drag drops when the last goes up), and
    /// where the pointer is on its focus.
    buttons: int = 0
    ptr_x: f64 = 0.0
    ptr_y: f64 = 0.0
    drag: DragData = DragData {}
}

/// A drag and drop in progress (wl_data_device.start_drag).
struct DragData {
    active: bool = false
    /// Source slot (none: a drag inside one client) and the client.
    source: u32 = 0xFFFFFFFF
    client: u32 = 0
    icon: u32 = 0xFFFFFFFF
    /// The surface under the pointer; the one the drag entered (its
    /// client takes the data) and the offer it got; where.
    under: u32 = 0xFFFFFFFF
    focus: u32 = 0xFFFFFFFF
    offer: u32 = 0xFFFFFFFF
    x: f64 = 0.0
    y: f64 = 0.0
    /// The icon's position from the pointer: the sum of its attach offsets.
    icon_x: i32 = 0
    icon_y: i32 = 0
}

/// zwp_virtual_keyboard_v1 (input methods, on-screen keyboards, wtype).
struct VirtualKeyboardData {
    client: u32 = 0
    obj: u32 = 0
    seat: u32 = 0
    keymap: Option[wire.Fd] = None
    size: u32 = 0
    hash: u64 = 0
}

/// zwp_text_input_v3: what a client's text field says about itself.
struct TextState {
    enabled: bool = false
    surrounding: str = ""
    cursor: i32 = 0
    anchor: i32 = 0
    cause: u32 = 0
    hint: u32 = 0
    purpose: u32 = 0
    /// Cursor rectangle in surface coordinates.
    rect: ids.Rect = ids.Rect {}
}

struct TextInputData {
    client: u32 = 0
    obj: u32 = 0
    seat: u32 = 0
    /// Surface slot it entered (keyboard focus), or none.
    focus: u32 = 0xFFFFFFFF
    pending: TextState = TextState {}
    current: TextState = TextState {}
    /// Number of commits (the serial of `done`).
    commits: u32 = 0
}

struct LayerData {
    surface: u32 = 0
    client: u32 = 0
    obj: u32 = 0
    /// Output slot it asked for, or none (the compositor picks).
    output: u32 = 0xFFFFFFFF
    namespace: str = ""
    current: LayerState = LayerState {}
    initial: bool = false
    configured: bool = false
    mapped: bool = false
    configures: List[Configure] = []
    /// Size of the last configure sent.
    width: i32 = 0
    height: i32 = 0
}

struct LockSurfaceData {
    surface: u32 = 0
    client: u32 = 0
    obj: u32 = 0
    output: u32 = 0xFFFFFFFF
    configured: bool = false
    mapped: bool = false
    configures: List[Configure] = []
}

/// zwp_pointer_constraints_v1 lock or confinement.
struct ConstraintData {
    client: u32 = 0
    obj: u32 = 0
    surface: u32 = 0
    seat: u32 = 0
    lock: bool = true
    region: Option[List[ids.Rect]] = None
    oneshot: bool = true
    /// A oneshot constraint that ended: inert.
    dead: bool = false
    hint_set: bool = false
    hint_x: f64 = 0.0
    hint_y: f64 = 0.0
}

/// ext_idle_notification_v1.
struct IdleData {
    client: u32 = 0
    obj: u32 = 0
    seat: u32 = 0xFFFFFFFF
    timeout_ms: int = 0
    /// get_input_idle_notification: inhibitors do not hold it back.
    input_only: bool = false
    idle: bool = false
}

/// Which protocol a data source or offer belongs to.
enum DataKind {
    /// wl_data_device_manager.
    Data
    /// zwp_primary_selection_device_manager_v1.
    Primary
    /// ext_data_control_manager_v1.
    Control
}

struct SourceData {
    client: u32 = 0
    obj: u32 = 0
    kind: DataKind = DataKind.Data
    mimes: List[str] = []
    /// Drag and drop actions it offers (copy 1, move 2, ask 4), the one
    /// chosen with the target.
    actions: u32 = 0
    action: u32 = 0
    /// Its xdg_toplevel_drag_v1 (0: none), the window attached to it and
    /// where the pointer holds that window (geometry coordinates).
    tdrag: u32 = 0
    tdrag_win: u32 = 0xFFFFFFFF
    tdrag_x: i32 = 0
    tdrag_y: i32 = 0
}

struct OfferData {
    client: u32 = 0
    obj: u32 = 0
    kind: DataKind = DataKind.Data
    source: u32 = 0xFFFFFFFF
    /// A drag offer: the target's actions, preferred one and whether it
    /// accepts a type.
    dnd: bool = false
    actions: u32 = 0
    preferred: u32 = 0
    accepted: bool = false
}

enum CaptureTargetKind {
    None
    Output
    Window
}

/// ext_image_capture_source_v1 backing target (output or toplevel window).
struct CaptureSourceData {
    kind: CaptureTargetKind = CaptureTargetKind.None
    target: u32 = 0xFFFFFFFF
}

/// ext_image_copy_capture_session_v1 on an output or window, and its frame.
struct CaptureData {
    client: u32 = 0
    obj: u32 = 0
    kind: CaptureTargetKind = CaptureTargetKind.None
    target: u32 = 0xFFFFFFFF
    paint_cursors: bool = false
    width: i32 = 0
    height: i32 = 0
    /// The frame (0: none), the buffer attached to it, and whether it
    /// waits for the next image or has a dmabuf capture in flight on GPU.
    frame: u32 = 0
    buffer: u32 = 0xFFFFFFFF
    waiting: bool = false
    in_flight: bool = false
    /// A frame was delivered: later ones wait for new content.
    shot: bool = false
}

/// A wp_security_context_v1 listener: clients connecting to `listen` are
/// sandboxed with this metadata until `close` hangs up.
struct ContextData {
    client: u32 = 0
    obj: u32 = 0
    listen: Option[wire.Fd] = None
    close: Option[wire.Fd] = None
    engine: str = ""
    app_id: str = ""
    instance_id: str = ""
    committed: bool = false
}

/// zwlr_output_head_v1 a manager announced: output slot, head id, mode
/// ids (as in `OutputInfo.modes`).
struct Head {
    output: u32
    id: u32
    modes: List[u32] = []
}

/// A bound zwlr_output_manager_v1.
struct OutmanData {
    client: u32 = 0
    obj: u32 = 0
    heads: List[Head] = []
    stopped: bool = false
}

/// What a zwlr_output_configuration_v1 asks of one output.
pub struct HeadConfig {
    pub output: ids.Output = ids.Output { id: ids.Id {} }
    pub enabled: bool = true
    /// Width, height, mHz (0: any refresh).
    pub mode: Option[(i32, i32, i32)] = None
    pub position: Option[(i32, i32)] = None
    pub transform: Option[u32] = None
    pub scale: Option[f64] = None
    pub vrr: Option[bool] = None
}

struct ConfigData {
    client: u32 = 0
    obj: u32 = 0
    serial: u32 = 0
    heads: List[HeadConfig] = []
    /// zwlr_output_configuration_head_v1 ids, as `heads`.
    head_objs: List[u32] = []
    used: bool = false
}

struct ParamsData {
    client: u32 = 0
    planes: [4]Option[Plane] = [None, None, None, None]
    seen: u8 = 0
    modifier: u64 = 0
    has_mod: bool = false
    used: bool = false
}

struct TimelineData {
    client: u32 = 0
    fd: Option[wire.Fd] = None
}

/// What a transaction waits for before it can apply.
pub enum Wait {
    /// A dmabuf's implicit fence: export a sync_file from this plane fd.
    Implicit(ids.Buffer, int)
    /// A drm_syncobj timeline fd and point to reach.
    Timeline(int, u64)
    /// The next presentation of this surface's output (wp_fifo).
    Fifo(ids.Surface)
    /// Present no earlier than this CLOCK_MONOTONIC time (commit-timing).
    Time(int)
}

struct TxnData {
    client: u32 = 0
    /// Surfaces and the states they apply.
    surfaces: List[ids.Id] = []
    states: List[State] = []
    waits: List[Wait] = []
    ready: bool = false
}

/// zwlr_virtual_pointer_v1 device state.
struct VirtualPointerData {
    client: u32 = 0
    obj: u32 = 0
    seat: u32 = 0xFFFFFFFF
    output: u32 = 0xFFFFFFFF
    time: u32 = 0
    has_motion: bool = false
    dx: f64 = 0.0
    dy: f64 = 0.0
    has_abs: bool = false
    abs_x: f64 = 0.0
    abs_y: f64 = 0.0
    has_axis: bool = false
    axis_src: types.AxisSource = types.AxisSource.Wheel
    axis_dx: f64 = 0.0
    axis_dy: f64 = 0.0
    axis_cx: i32 = 0
    axis_cy: i32 = 0
}

/// zwlr_gamma_control_v1 exclusive handle for an output.
struct GammaData {
    client: u32 = 0
    obj: u32 = 0
    output: u32 = 0xFFFFFFFF
    active: bool = false
}

/// wp_image_description_v1 immutable colorimetric description.
struct ColorDescData {
    client: u32 = 0
    obj: u32 = 0
    color_space: u32 = 0
    primaries: u32 = 1
    tf: u32 = 9
    min_lum: u32 = 2000
    max_lum: u32 = 203
    ref_lum: u32 = 203
    ready: bool = false
