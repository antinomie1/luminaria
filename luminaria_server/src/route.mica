// Routing: each decoded request to its module, and teardown of each kind
// of object when its id goes away.

import luminaria_wire as wire
import luminaria_proto as proto
import luminaria_proto.wayland as wl
import luminaria_proto.ifaces as ifaces
import state
import server
import surface
import buffer
import xdg
import ext
import seat
import output
import data
import extra
import shell
import ime
import pointer
import toplevel
import inhibit
import capture
import security
import outman

/// Object `id` (interface `iface`) of client `ci` went away: free what it
/// owned.
fn destroyed(mut srv: server.Server, ci: u32, id: u32, iface: u16) {
    let slot = srv.slot(ci, id)
    srv.unbind(ci, id)
    if iface == wl.registry_iface {
        srv.clients.items[int(ci)].registries.retain(fn(r) => r != id)
        return
    }
    guard slot != state.none else {
        return
    }
    if iface == wl.surface_iface {
        surface.destroy(mut srv, slot)
    } else if iface == wl.buffer_iface {
        buffer.destroy_buffer(mut srv, slot)
    } else if iface == wl.shm_pool_iface {
        buffer.unref_pool(mut srv, slot)
    } else if iface == wl.region_iface {
        srv.regions.remove(slot, state.RegionData {})
    } else if iface == wl.subsurface_iface {
        surface.destroy_subsurface(mut srv, slot)
    } else if iface == proto.xdg_shell.toplevel_iface {
        xdg.destroy_toplevel(mut srv, slot)
    } else if iface == proto.xdg_shell.popup_iface {
        xdg.destroy_popup(mut srv, slot)
    } else if iface == proto.xdg_shell.surface_iface {
        xdg.destroy_xdg_surface(mut srv, slot)
    } else if iface == proto.xdg_shell.positioner_iface {
        srv.positioners.remove(slot, state.PositionerData {})
    } else if iface == wl.data_source_iface {
        data.destroy_source(mut srv, slot)
    } else if iface == wl.data_offer_iface {
        srv.offers.remove(slot, state.OfferData {})
    } else if iface == proto.linux_dmabuf.buffer_params_iface {
        srv.params.remove(slot, state.ParamsData {})
    } else if iface == proto.linux_drm_syncobj.timeline_iface {
        srv.timelines.remove(slot, state.TimelineData {})
    } else if iface == wl.keyboard_iface or iface == wl.pointer_iface or iface == wl.touch_iface or iface == wl.seat_iface or iface == wl.data_device_iface {
        seat.drop_resource(mut srv, slot, ci, id)
    } else if iface == wl.output_iface or iface == proto.xdg_output_unstable.output_iface {
        output.drop_bind(mut srv, slot, ci, id)
    } else if iface == proto.primary_selection_unstable.source_iface or iface == proto.ext_data_control.source_iface {
        data.destroy_source(mut srv, slot)
    } else if iface == proto.primary_selection_unstable.offer_iface or iface == proto.ext_data_control.offer_iface {
        srv.offers.remove(slot, state.OfferData {})
    } else if iface == proto.primary_selection_unstable.device_iface or iface == proto.ext_data_control.device_iface {
        seat.drop_resource(mut srv, slot, ci, id)
    } else if shell.destroyed(mut srv, ci, slot, iface, id) or ime.destroyed(mut srv, ci, slot, iface, id) or pointer.destroyed(mut srv, ci, slot, iface, id) or toplevel.destroyed(mut srv, ci, slot, iface, id) or inhibit.destroyed(mut srv, ci, slot, iface, id) or capture.destroyed(mut srv, ci, slot, iface, id) or security.destroyed(mut srv, ci, slot, iface, id) or outman.destroyed(mut srv, ci, slot, iface, id) {
        return
    } else {
        extra.destroyed(mut srv, ci, slot, iface)
    }
}

fn handle(mut srv: server.Server, ci: u32, take r: proto.Request) {
    match take r {
        Extension(m) => ext.request(mut srv, ci, m)
        WlDisplay(_, req) => display(mut srv, ci, req)
        WlRegistry(reg, req) => registry(mut srv, ci, reg, req)
        WlFixes(_, req) => {
            match req {
                DestroyRegistry(reg) => {
                    srv.clients.items[int(ci)].registries.retain(fn(x) => x != reg.id)
                    srv.conns[int(ci)].remove(reg.id)
                }
                _ => {}
            }
        }
        WlCompositor(_, req) => surface.compositor(mut srv, ci, req)
        WlSurface(s, req) => surface.request(mut srv, ci, s, req)
        WlRegion(rg, req) => surface.region(mut srv, ci, rg, req)
        WlSubcompositor(_, req) => surface.subcompositor(mut srv, ci, req)
        WlSubsurface(sub, req) => surface.subsurface(mut srv, ci, sub, req)
        WlShm(_, req) => buffer.shm(mut srv, ci, req)
        WlShmPool(p, req) => buffer.pool(mut srv, ci, p, req)
        WlBuffer(b, req) => {}
        XdgWmBase(w, req) => xdg.wm_base(mut srv, ci, w, req)
        XdgPositioner(p, req) => xdg.positioner_request(mut srv, ci, p, req)
        XdgSurface(x, req) => xdg.surface_request(mut srv, ci, x, req)
        XdgToplevel(t, req) => xdg.toplevel(mut srv, ci, t, req)
        XdgPopup(p, req) => xdg.popup(mut srv, ci, p, req)
        WlSeat(st, req) => seat.request(mut srv, ci, st, req)
        WlPointer(p, req) => seat.pointer_request(mut srv, ci, p, req)
        WlKeyboard(_, req) => {}
        WlTouch(_, req) => {}
        WlOutput(_, req) => {}
        WlDataDeviceManager(_, req) => data.manager(mut srv, ci, req)
        WlDataDevice(d, req) => data.device(mut srv, ci, d, req)
        WlDataSource(src, req) => data.source(mut srv, ci, src, req)
        WlDataOffer(o, req) => data.offer(mut srv, ci, o, req)
        ZwpLinuxDmabuf(_, req) => buffer.dmabuf(mut srv, ci, req)
        ZwpLinuxBufferParams(p, req) => buffer.params(mut srv, ci, p, req)
        ZwpLinuxDmabufFeedback(_, req) => {}
        WpLinuxDrmSyncobjManager(_, req) => extra.syncobj_manager(mut srv, ci, req)
        WpLinuxDrmSyncobjTimeline(_, req) => {}
        WpLinuxDrmSyncobjSurface(o, req) => extra.syncobj_surface(mut srv, ci, o, req)
        WpPresentation(_, req) => extra.presentation(mut srv, ci, req)
        WpViewporter(_, req) => extra.viewporter(mut srv, ci, req)
        WpViewport(v, req) => extra.viewport(mut srv, ci, v, req)
        WpFractionalScaleManager(_, req) => extra.fractional_manager(mut srv, ci, req)
        WpFractionalScale(_, req) => {}
        WpFifoManager(_, req) => extra.fifo_manager(mut srv, ci, req)
        WpFifo(f, req) => extra.fifo(mut srv, ci, f, req)
        WpCommitTimingManager(_, req) => extra.timing_manager(mut srv, ci, req)
        WpCommitTimer(t, req) => extra.timer(mut srv, ci, t, req)
        WpTearingControlManager(_, req) => extra.tearing_manager(mut srv, ci, req)
        WpTearingControl(t, req) => extra.tearing(mut srv, ci, t, req)
        WpAlphaModifier(_, req) => extra.alpha_manager(mut srv, ci, req)
        WpAlphaModifierSurface(m, req) => extra.alpha_surface(mut srv, ci, m, req)
        WpContentTypeManager(_, req) => extra.content_manager(mut srv, ci, req)
        WpContentType(t, req) => extra.content(mut srv, ci, t, req)
        WpSinglePixelBufferManager(_, req) => buffer.single_pixel(mut srv, ci, req)
        ZwpPrimarySelectionDeviceManager(_, req) => data.primary_manager(mut srv, ci, req)
        ZwpPrimarySelectionDevice(d, req) => data.primary_device(mut srv, ci, d, req)
        ZwpPrimarySelectionSource(s, req) => data.primary_source(mut srv, ci, s, req)
        ZwpPrimarySelectionOffer(o, req) => data.primary_offer(mut srv, ci, o, req)
        ExtDataControlManager(_, req) => data.control_manager(mut srv, ci, req)
        ExtDataControlDevice(d, req) => data.control_device(mut srv, ci, d, req)
        ExtDataControlSource(s, req) => data.control_source(mut srv, ci, s, req)
        ExtDataControlOffer(o, req) => data.control_offer(mut srv, ci, o, req)
        ZwlrLayerShell(_, req) => shell.layer_shell(mut srv, ci, req)
        ZwlrLayerSurface(l, req) => shell.layer_surface(mut srv, ci, l, req)
        ExtSessionLockManager(_, req) => shell.lock_manager(mut srv, ci, req)
        ExtSessionLock(l, req) => shell.session_lock(mut srv, ci, l, req)
        ExtSessionLockSurface(l, req) => shell.lock_surface(mut srv, ci, l, req)
        ZwpTextInputManager(_, req) => ime.text_manager(mut srv, ci, req)
        ZwpTextInput(t, req) => ime.text_input(mut srv, ci, t, req)
        ZwpInputMethodManager(_, req) => ime.method_manager(mut srv, ci, req)
        ZwpInputMethod(m, req) => ime.input_method(mut srv, ci, m, req)
        ZwpInputPopupSurface(p, req) => ime.popup(mut srv, ci, p, req)
        ZwpInputMethodKeyboardGrab(g, req) => ime.grab_request(mut srv, ci, g, req)
        ZwpVirtualKeyboardManager(_, req) => ime.keyboard_manager(mut srv, ci, req)
        ZwpVirtualKeyboard(k, req) => ime.virtual_keyboard(mut srv, ci, k, req)
        ZwpRelativePointerManager(_, req) => pointer.relative_manager(mut srv, ci, req)
        ZwpRelativePointer(r, req) => pointer.relative(mut srv, ci, r, req)
        ZwpPointerConstraints(_, req) => pointer.constraints(mut srv, ci, req)
        ZwpLockedPointer(l, req) => pointer.locked_pointer(mut srv, ci, l, req)
        ZwpConfinedPointer(c, req) => pointer.confined_pointer(mut srv, ci, c, req)
        ZwpPointerGestures(_, req) => pointer.gestures(mut srv, ci, req)
        ZwpPointerGestureSwipe(g, req) => pointer.gesture_object(mut srv, ci, g.id)
        ZwpPointerGesturePinch(g, req) => pointer.gesture_object(mut srv, ci, g.id)
        ZwpPointerGestureHold(g, req) => pointer.gesture_object(mut srv, ci, g.id)
        WpCursorShapeManager(_, req) => pointer.shape_manager(mut srv, ci, req)
        WpCursorShapeDevice(d, req) => pointer.shape_device(mut srv, ci, d, req)
        ZxdgDecorationManager(_, req) => toplevel.decoration_manager(mut srv, ci, req)
        ZxdgToplevelDecoration(d, req) => toplevel.decoration(mut srv, ci, d, req)
        XdgToplevelIconManager(_, req) => toplevel.icon_manager(mut srv, ci, req)
        XdgToplevelIcon(i, req) => toplevel.icon(mut srv, ci, i, req)
        XdgToplevelTagManager(_, req) => toplevel.tag_manager(mut srv, ci, req)
        XdgWmDialog(_, req) => toplevel.dialog_manager(mut srv, ci, req)
        XdgDialog(d, req) => toplevel.dialog(mut srv, ci, d, req)
        XdgActivation(_, req) => toplevel.activation(mut srv, ci, req)
        XdgActivationToken(t, req) => toplevel.activation_token(mut srv, ci, t, req)
        ZxdgExporter(_, req) => toplevel.exporter(mut srv, ci, req)
        ZxdgExported(e, req) => toplevel.exported(mut srv, ci, e, req)
        ZxdgImporter(_, req) => toplevel.importer(mut srv, ci, req)
        ZxdgImported(i, req) => toplevel.imported(mut srv, ci, i, req)
        ExtForeignToplevelList(l, req) => toplevel.toplevel_list(mut srv, ci, l, req)
        ExtForeignToplevelHandle(h, req) => toplevel.toplevel_handle(mut srv, ci, h, req)
        XdgSystemBell(_, req) => toplevel.system_bell(mut srv, ci, req)
        ZwpIdleInhibitManager(_, req) => inhibit.inhibit_manager(mut srv, ci, req)
        ZwpIdleInhibitor(i, req) => inhibit.inhibitor(mut srv, ci, i, req)
        ExtIdleNotifier(_, req) => inhibit.notifier(mut srv, ci, req)
        ExtIdleNotification(n, req) => inhibit.notification(mut srv, ci, n, req)
        ZwpKeyboardShortcutsInhibitManager(_, req) => inhibit.shortcuts_manager(mut srv, ci, req)
        ZwpKeyboardShortcutsInhibitor(i, req) => inhibit.shortcuts_inhibitor(mut srv, ci, i, req)
        ZxdgOutputManager(_, req) => output.xdg_manager(mut srv, ci, req)
        ZxdgOutput(x, req) => output.xdg_output(mut srv, ci, x, req)
        ExtOutputImageCaptureSourceManager(_, req) => capture.source_manager(mut srv, ci, req)
        ExtForeignToplevelImageCaptureSourceManager(_, req) => capture.toplevel_source_manager(mut srv, ci, req)
        ExtImageCaptureSource(src, req) => capture.source_destroy(mut srv, ci, src.id)
        ExtImageCopyCaptureManager(_, req) => capture.manager(mut srv, ci, req)
        ExtImageCopyCaptureSession(sess, req) => capture.session(mut srv, ci, sess, req)
        ExtImageCopyCaptureFrame(f, req) => capture.frame(mut srv, ci, f, req)
        ExtImageCopyCaptureCursorSession(c, req) => capture.cursor_session(mut srv, ci, c, req)
        WpSecurityContextManager(_, req) => security.manager(mut srv, ci, req)
        WpSecurityContext(c, req) => security.context(mut srv, ci, c, req)
        ZwlrOutputManager(m, req) => outman.manager(mut srv, ci, m, req)
        ZwlrOutputHead(h, req) => outman.head(mut srv, ci, h, req)
        ZwlrOutputMode(m, req) => outman.mode(mut srv, ci, m, req)
        ZwlrOutputConfiguration(c, req) => outman.configuration(mut srv, ci, c, req)
        ZwlrOutputConfigurationHead(h, req) => outman.config_head(mut srv, ci, h, req)
        _ => {}
    }
}

fn display(mut srv: server.Server, ci: u32, take req: wl.DisplayRequest) {
    match req {
        Sync(cb) => {
            let s = srv.next_serial()
            cb.done(mut srv.conns[int(ci)], s)
        }
        GetRegistry(reg) => {
            srv.clients.items[int(ci)].registries.push(reg.id)
            for i in 0..srv.globals.len() {
                let g = srv.globals[i]
                if g.alive and srv.sees(ci, g.iface) {
                    reg.global(mut srv.conns[int(ci)], u32(i + 1), ext.name(srv, g.iface), g.version)
                }
            }
        }
    }
}

fn registry(mut srv: server.Server, ci: u32, reg: wl.Registry, take req: wl.RegistryRequest) {
    match req {
        Bind(name, obj) => {
            guard name > 0 and int(name) <= srv.globals.len() else {
                srv.fail(ci, reg.id, wire.invalid_object, "no global {name}")
                return
            }
            let g = srv.globals[int(name - 1)]
            guard srv.sees(ci, g.iface) else {
                srv.fail(ci, reg.id, wire.invalid_object, "no global {name}")
                return
            }
            guard obj.iface == g.iface and obj.version >= 1 and obj.version <= g.version else {
                srv.fail(ci, reg.id, wire.invalid_object, "bind of global {name} as {ext.name(srv, obj.iface)} v{obj.version}")
                return
            }
            guard g.alive else {
                // Removed meanwhile: an inert object, as libwayland does.
                return
            }
            match g.kind {
                Output(slot) => output.bound(mut srv, ci, slot, obj.id, obj.version)
                Seat(slot) => seat.bound(mut srv, ci, slot, obj.id, obj.version)
                Ext(k) => ext.bound(mut srv, ci, int(k), obj.id, obj.version)
                Static => {
                    if g.iface == wl.shm_iface {
                        buffer.shm_bound(mut srv, ci, obj.id)
                    } else if g.iface == proto.linux_dmabuf.dmabuf_iface {
                        buffer.dmabuf_bound(mut srv, ci, obj.id, obj.version)
                    } else if g.iface == proto.presentation_time.presentation_iface {
                        extra.presentation_bound(mut srv, ci, obj.id)
                    } else if g.iface == proto.xdg_toplevel_icon.icon_manager_iface {
                        toplevel.icon_manager_bound(mut srv, ci, obj.id)
                    } else if g.iface == proto.ext_foreign_toplevel_list.toplevel_list_iface {
                        toplevel.list_bound(mut srv, ci, obj.id, obj.version)
                    } else if g.iface == proto.wlr_output_management_unstable.manager_iface {
                        outman.bound(mut srv, ci, obj.id)
                    }
                }
            }
        }
    }
}
