// Routing: each decoded request to its module, and teardown of each kind
// of object when its id goes away.

import luminaria_wire as wire
import luminaria_proto as proto
import luminaria_proto.wayland as wl
import luminaria_proto.ifaces as ifaces
import state
import server
import surface
import buffer
import xdg
import ext
import seat
import output
import data
import extra
import shell
import ime
import pointer
import toplevel
import taskbar
import inhibit
import capture
import security
import outman
import vptr
import gamma
import color

/// Object `id` (interface `iface`) of client `ci` went away: free what it
/// owned.
fn destroyed(mut srv: server.Server, ci: u32, id: u32, iface: u16) {
    let slot = srv.slot(ci, id)
    srv.unbind(ci, id)
    if iface == wl.registry_iface {
        srv.clients.items[int(ci)].registries.retain(fn(r) => r != id)
        return
    }
    guard slot != state.none else {
        return
    }
    if iface == wl.surface_iface {
        surface.destroy(mut srv, slot)
    } else if iface == wl.buffer_iface {
        buffer.destroy_buffer(mut srv, slot)
    } else if iface == wl.shm_pool_iface {
        buffer.unref_pool(mut srv, slot)
    } else if iface == wl.region_iface {
        srv.regions.remove(slot, state.RegionData {})
    } else if iface == wl.subsurface_iface {
        surface.destroy_subsurface(mut srv, slot)
    } else if iface == proto.xdg_shell.toplevel_iface {
        xdg.destroy_toplevel(mut srv, slot)
    } else if iface == proto.xdg_shell.popup_iface {
        xdg.destroy_popup(mut srv, slot)
    } else if iface == proto.xdg_shell.surface_iface {
        xdg.destroy_xdg_surface(mut srv, slot)
    } else if iface == proto.xdg_shell.positioner_iface {
        srv.positioners.remove(slot, state.PositionerData {})
    } else if iface == wl.data_source_iface {
        data.destroy_source(mut srv, slot)
    } else if iface == proto.xdg_toplevel_drag.drag_iface {
        data.toplevel_drag_destroyed(mut srv, slot, id)
    } else if iface == wl.data_offer_iface {
        srv.offers.remove(slot, state.OfferData {})
    } else if iface == proto.linux_dmabuf.buffer_params_iface {
        srv.params.remove(slot, state.ParamsData {})
    } else if iface == proto.linux_drm_syncobj.timeline_iface {
        srv.timelines.remove(slot, state.TimelineData {})
    } else if iface == wl.keyboard_iface or iface == wl.pointer_iface or iface == wl.touch_iface or iface == wl.seat_iface or iface == wl.data_device_iface {
        seat.drop_resource(mut srv, slot, ci, id)
    } else if iface == wl.output_iface or iface == proto.xdg_output_unstable.output_iface {
        output.drop_bind(mut srv, slot, ci, id)
    } else if iface == proto.primary_selection_unstable.source_iface or iface == proto.ext_data_control.source_iface {
        data.destroy_source(mut srv, slot)
    } else if iface == proto.primary_selection_unstable.offer_iface or iface == proto.ext_data_control.offer_iface {
        srv.offers.remove(slot, state.OfferData {})
    } else if iface == proto.primary_selection_unstable.device_iface or iface == proto.ext_data_control.device_iface {
        seat.drop_resource(mut srv, slot, ci, id)
    } else if shell.destroyed(mut srv, ci, slot, iface, id) or ime.destroyed(mut srv, ci, slot, iface, id) or pointer.destroyed(mut srv, ci, slot, iface, id) or toplevel.destroyed(mut srv, ci, slot, iface, id) or taskbar.destroyed(mut srv, ci, slot, iface, id) or inhibit.destroyed(mut srv, ci, slot, iface, id) or capture.destroyed(mut srv, ci, slot, iface, id) or security.destroyed(mut srv, ci, slot, iface, id) or outman.destroyed(mut srv, ci, slot, iface, id) or vptr.destroyed(mut srv, ci, slot, iface, id) or gamma.destroyed(mut srv, ci, slot, iface, id) or color.destroyed(mut srv, ci, slot, iface, id) {
        return
    } else {
        extra.destroyed(mut srv, ci, slot, iface)
    }
}

/// Decode and dispatch one received wire message directly without boxing
/// into `proto.Request` (keeps the hot path compact and drops unadvertised
/// protocol decoders from server binaries).
fn dispatch(mut srv: server.Server, ci: u32, m: wire.Msg) -> Result[(), wire.Error] {
    let iface = m.iface
    let c = int(ci)
    if iface == wl.surface_iface {
        let req = try wl.decode_surface(mut srv.conns[c], m)
        surface.request(mut srv, ci, wl.Surface { id: m.id }, req)
    } else if iface == wl.buffer_iface {
        discard try wl.decode_buffer(mut srv.conns[c], m)
    } else if iface == wl.region_iface {
        let req = try wl.decode_region(mut srv.conns[c], m)
        surface.region(mut srv, ci, wl.Region { id: m.id }, req)
    } else if iface == wl.subsurface_iface {
        let req = try wl.decode_subsurface(mut srv.conns[c], m)
        surface.subsurface(mut srv, ci, wl.Subsurface { id: m.id }, req)
    } else if iface == wl.compositor_iface {
        let req = try wl.decode_compositor(mut srv.conns[c], m)
        surface.compositor(mut srv, ci, req)
    } else if iface == wl.shm_pool_iface {
        let req = try wl.decode_shm_pool(mut srv.conns[c], m)
        buffer.pool(mut srv, ci, wl.ShmPool { id: m.id }, req)
    } else if iface == wl.shm_iface {
        let req = try wl.decode_shm(mut srv.conns[c], m)
        buffer.shm(mut srv, ci, req)
    } else if iface == proto.xdg_shell.surface_iface {
        let req = try proto.xdg_shell.decode_surface(mut srv.conns[c], m)
        xdg.surface_request(mut srv, ci, proto.xdg_shell.Surface { id: m.id }, req)
    } else if iface == proto.xdg_shell.toplevel_iface {
        let req = try proto.xdg_shell.decode_toplevel(mut srv.conns[c], m)
        xdg.toplevel(mut srv, ci, proto.xdg_shell.Toplevel { id: m.id }, req)
    } else if iface == proto.xdg_shell.popup_iface {
        let req = try proto.xdg_shell.decode_popup(mut srv.conns[c], m)
        xdg.popup(mut srv, ci, proto.xdg_shell.Popup { id: m.id }, req)
    } else if iface == proto.xdg_shell.wm_base_iface {
        let req = try proto.xdg_shell.decode_wm_base(mut srv.conns[c], m)
        xdg.wm_base(mut srv, ci, proto.xdg_shell.WmBase { id: m.id }, req)
    } else if iface == proto.xdg_shell.positioner_iface {
        let req = try proto.xdg_shell.decode_positioner(mut srv.conns[c], m)
        xdg.positioner_request(mut srv, ci, proto.xdg_shell.Positioner { id: m.id }, req)
    } else if iface == wl.display_iface {
        let req = try wl.decode_display(mut srv.conns[c], m)
        display(mut srv, ci, req)
    } else if iface == wl.registry_iface {
        let req = try wl.decode_registry(mut srv.conns[c], m)
        registry(mut srv, ci, wl.Registry { id: m.id }, req)
    } else if iface == wl.pointer_iface {
        let req = try wl.decode_pointer(mut srv.conns[c], m)
        seat.pointer_request(mut srv, ci, wl.Pointer { id: m.id }, req)
    } else if iface == wl.seat_iface {
        let req = try wl.decode_seat(mut srv.conns[c], m)
        seat.request(mut srv, ci, wl.Seat { id: m.id }, req)
    } else if iface == wl.subcompositor_iface {
        let req = try wl.decode_subcompositor(mut srv.conns[c], m)
        surface.subcompositor(mut srv, ci, req)
    } else if iface == proto.linux_dmabuf.dmabuf_iface {
        let req = try proto.linux_dmabuf.decode_dmabuf(mut srv.conns[c], m)
        buffer.dmabuf(mut srv, ci, req)
    } else if iface == proto.linux_dmabuf.buffer_params_iface {
        let req = try proto.linux_dmabuf.decode_buffer_params(mut srv.conns[c], m)
        buffer.params(mut srv, ci, proto.linux_dmabuf.BufferParams { id: m.id }, req)
    } else if iface == proto.linux_drm_syncobj.surface_iface {
        let req = try proto.linux_drm_syncobj.decode_surface(mut srv.conns[c], m)
        extra.syncobj_surface(mut srv, ci, proto.linux_drm_syncobj.Surface { id: m.id }, req)
    } else if iface == proto.viewporter.viewport_iface {
        let req = try proto.viewporter.decode_viewport(mut srv.conns[c], m)
        extra.viewport(mut srv, ci, proto.viewporter.Viewport { id: m.id }, req)
    } else if iface == proto.fifo.fifo_iface {
        let req = try proto.fifo.decode_fifo(mut srv.conns[c], m)
        extra.fifo(mut srv, ci, proto.fifo.Fifo { id: m.id }, req)
    } else {
        return dispatch_ext(mut srv, ci, m)
    }
    return Ok(())
}

@noinline
fn dispatch_ext(mut srv: server.Server, ci: u32, m: wire.Msg) -> Result[(), wire.Error] {
    let iface = m.iface
    let c = int(ci)
    if iface > ifaces.count {
        ext.request(mut srv, ci, m)
    } else if iface == wl.fixes_iface {
        match try wl.decode_fixes(mut srv.conns[c], m) {
            DestroyRegistry(reg) => {
                srv.clients.items[c].registries.retain(fn(x) => x != reg.id)
                srv.conns[c].remove(reg.id)
            }
            _ => {}
        }
    } else if iface == wl.keyboard_iface {
        discard try wl.decode_keyboard(mut srv.conns[c], m)
    } else if iface == wl.touch_iface {
        discard try wl.decode_touch(mut srv.conns[c], m)
    } else if iface == wl.output_iface {
        discard try wl.decode_output(mut srv.conns[c], m)
    } else if iface == wl.data_device_manager_iface {
        let req = try wl.decode_data_device_manager(mut srv.conns[c], m)
        data.manager(mut srv, ci, req)
    } else if iface == wl.data_device_iface {
        let req = try wl.decode_data_device(mut srv.conns[c], m)
        data.device(mut srv, ci, wl.DataDevice { id: m.id }, req)
    } else if iface == wl.data_source_iface {
        let req = try wl.decode_data_source(mut srv.conns[c], m)
        data.source(mut srv, ci, wl.DataSource { id: m.id }, req)
    } else if iface == wl.data_offer_iface {
        let req = try wl.decode_data_offer(mut srv.conns[c], m)
        data.offer(mut srv, ci, wl.DataOffer { id: m.id }, req)
    } else if iface == proto.linux_dmabuf.dmabuf_feedback_iface {
        discard try proto.linux_dmabuf.decode_dmabuf_feedback(mut srv.conns[c], m)
    } else if iface == proto.linux_drm_syncobj.manager_iface {
        let req = try proto.linux_drm_syncobj.decode_manager(mut srv.conns[c], m)
        extra.syncobj_manager(mut srv, ci, req)
    } else if iface == proto.linux_drm_syncobj.timeline_iface {
        discard try proto.linux_drm_syncobj.decode_timeline(mut srv.conns[c], m)
    } else if iface == proto.presentation_time.presentation_iface {
        let req = try proto.presentation_time.decode_presentation(mut srv.conns[c], m)
        extra.presentation(mut srv, ci, req)
    } else if iface == proto.viewporter.viewporter_iface {
        let req = try proto.viewporter.decode_viewporter(mut srv.conns[c], m)
        extra.viewporter(mut srv, ci, req)
    } else if iface == proto.fractional_scale.scale_manager_iface {
        let req = try proto.fractional_scale.decode_scale_manager(mut srv.conns[c], m)
        extra.fractional_manager(mut srv, ci, req)
    } else if iface == proto.fractional_scale.scale_iface {
        discard try proto.fractional_scale.decode_scale(mut srv.conns[c], m)
    } else if iface == proto.fifo.fifo_manager_iface {
        let req = try proto.fifo.decode_fifo_manager(mut srv.conns[c], m)
        extra.fifo_manager(mut srv, ci, req)
    } else if iface == proto.commit_timing.timing_manager_iface {
        let req = try proto.commit_timing.decode_timing_manager(mut srv.conns[c], m)
        extra.timing_manager(mut srv, ci, req)
    } else if iface == proto.commit_timing.timer_iface {
        let req = try proto.commit_timing.decode_timer(mut srv.conns[c], m)
        extra.timer(mut srv, ci, proto.commit_timing.Timer { id: m.id }, req)
    } else if iface == proto.tearing_control.control_manager_iface {
        let req = try proto.tearing_control.decode_control_manager(mut srv.conns[c], m)
        extra.tearing_manager(mut srv, ci, req)
    } else if iface == proto.tearing_control.control_iface {
        let req = try proto.tearing_control.decode_control(mut srv.conns[c], m)
        extra.tearing(mut srv, ci, proto.tearing_control.Control { id: m.id }, req)
    } else if iface == proto.alpha_modifier.modifier_iface {
        let req = try proto.alpha_modifier.decode_modifier(mut srv.conns[c], m)
        extra.alpha_manager(mut srv, ci, req)
    } else if iface == proto.alpha_modifier.modifier_surface_iface {
        let req = try proto.alpha_modifier.decode_modifier_surface(mut srv.conns[c], m)
        extra.alpha_surface(mut srv, ci, proto.alpha_modifier.ModifierSurface { id: m.id }, req)
    } else if iface == proto.content_type.type_manager_iface {
        let req = try proto.content_type.decode_type_manager(mut srv.conns[c], m)
        extra.content_manager(mut srv, ci, req)
    } else if iface == proto.content_type.type_iface {
        let req = try proto.content_type.decode_type(mut srv.conns[c], m)
        extra.content(mut srv, ci, proto.content_type.Type { id: m.id }, req)
    } else if iface == proto.single_pixel_buffer.single_pixel_buffer_manager_iface {
        let req = try proto.single_pixel_buffer.decode_single_pixel_buffer_manager(mut srv.conns[c], m)
        buffer.single_pixel(mut srv, ci, req)
    } else if iface == proto.primary_selection_unstable.device_manager_iface {
        let req = try proto.primary_selection_unstable.decode_device_manager(mut srv.conns[c], m)
        data.primary_manager(mut srv, ci, req)
    } else if iface == proto.primary_selection_unstable.device_iface {
        let req = try proto.primary_selection_unstable.decode_device(mut srv.conns[c], m)
        data.primary_device(mut srv, ci, proto.primary_selection_unstable.Device { id: m.id }, req)
    } else if iface == proto.primary_selection_unstable.source_iface {
        let req = try proto.primary_selection_unstable.decode_source(mut srv.conns[c], m)
        data.primary_source(mut srv, ci, proto.primary_selection_unstable.Source { id: m.id }, req)
    } else if iface == proto.primary_selection_unstable.offer_iface {
        let req = try proto.primary_selection_unstable.decode_offer(mut srv.conns[c], m)
        data.primary_offer(mut srv, ci, proto.primary_selection_unstable.Offer { id: m.id }, req)
    } else if iface == proto.ext_data_control.manager_iface {
        let req = try proto.ext_data_control.decode_manager(mut srv.conns[c], m)
        data.control_manager(mut srv, ci, req)
    } else if iface == proto.ext_data_control.device_iface {
        let req = try proto.ext_data_control.decode_device(mut srv.conns[c], m)
        data.control_device(mut srv, ci, proto.ext_data_control.Device { id: m.id }, req)
    } else if iface == proto.ext_data_control.source_iface {
        let req = try proto.ext_data_control.decode_source(mut srv.conns[c], m)
        data.control_source(mut srv, ci, proto.ext_data_control.Source { id: m.id }, req)
    } else if iface == proto.ext_data_control.offer_iface {
        let req = try proto.ext_data_control.decode_offer(mut srv.conns[c], m)
        data.control_offer(mut srv, ci, proto.ext_data_control.Offer { id: m.id }, req)
    } else if iface == proto.wlr_layer_shell_unstable.shell_iface {
        let req = try proto.wlr_layer_shell_unstable.decode_shell(mut srv.conns[c], m)
        shell.layer_shell(mut srv, ci, req)
    } else if iface == proto.wlr_layer_shell_unstable.surface_iface {
        let req = try proto.wlr_layer_shell_unstable.decode_surface(mut srv.conns[c], m)
        shell.layer_surface(mut srv, ci, proto.wlr_layer_shell_unstable.Surface { id: m.id }, req)
    } else if iface == proto.ext_session_lock.lock_manager_iface {
        let req = try proto.ext_session_lock.decode_lock_manager(mut srv.conns[c], m)
        shell.lock_manager(mut srv, ci, req)
    } else if iface == proto.ext_session_lock.lock_iface {
        let req = try proto.ext_session_lock.decode_lock(mut srv.conns[c], m)
        shell.session_lock(mut srv, ci, proto.ext_session_lock.Lock { id: m.id }, req)
    } else if iface == proto.ext_session_lock.lock_surface_iface {
        let req = try proto.ext_session_lock.decode_lock_surface(mut srv.conns[c], m)
        shell.lock_surface(mut srv, ci, proto.ext_session_lock.LockSurface { id: m.id }, req)
    } else if iface == proto.text_input_unstable.input_manager_iface {
        let req = try proto.text_input_unstable.decode_input_manager(mut srv.conns[c], m)
        ime.text_manager(mut srv, ci, req)
    } else if iface == proto.text_input_unstable.input_iface {
        let req = try proto.text_input_unstable.decode_input(mut srv.conns[c], m)
        ime.text_input(mut srv, ci, proto.text_input_unstable.Input { id: m.id }, req)
    } else if iface == proto.input_method_unstable.method_manager_iface {
        let req = try proto.input_method_unstable.decode_method_manager(mut srv.conns[c], m)
        ime.method_manager(mut srv, ci, req)
    } else if iface == proto.input_method_unstable.method_iface {
        let req = try proto.input_method_unstable.decode_method(mut srv.conns[c], m)
        ime.input_method(mut srv, ci, proto.input_method_unstable.Method { id: m.id }, req)
    } else if iface == proto.input_method_unstable.popup_surface_iface {
        let req = try proto.input_method_unstable.decode_popup_surface(mut srv.conns[c], m)
        ime.popup(mut srv, ci, proto.input_method_unstable.PopupSurface { id: m.id }, req)
    } else if iface == proto.input_method_unstable.method_keyboard_grab_iface {
        let req = try proto.input_method_unstable.decode_method_keyboard_grab(mut srv.conns[c], m)
        ime.grab_request(mut srv, ci, proto.input_method_unstable.MethodKeyboardGrab { id: m.id }, req)
    } else if iface == proto.virtual_keyboard_unstable.keyboard_manager_iface {
        let req = try proto.virtual_keyboard_unstable.decode_keyboard_manager(mut srv.conns[c], m)
        ime.keyboard_manager(mut srv, ci, req)
    } else if iface == proto.virtual_keyboard_unstable.keyboard_iface {
        let req = try proto.virtual_keyboard_unstable.decode_keyboard(mut srv.conns[c], m)
        ime.virtual_keyboard(mut srv, ci, proto.virtual_keyboard_unstable.Keyboard { id: m.id }, req)
    } else if iface == proto.relative_pointer_unstable.pointer_manager_iface {
        let req = try proto.relative_pointer_unstable.decode_pointer_manager(mut srv.conns[c], m)
        pointer.relative_manager(mut srv, ci, req)
    } else if iface == proto.relative_pointer_unstable.pointer_iface {
        let req = try proto.relative_pointer_unstable.decode_pointer(mut srv.conns[c], m)
        pointer.relative(mut srv, ci, proto.relative_pointer_unstable.Pointer { id: m.id }, req)
    } else if iface == proto.pointer_constraints_unstable.pointer_constraints_iface {
        let req = try proto.pointer_constraints_unstable.decode_pointer_constraints(mut srv.conns[c], m)
        pointer.constraints(mut srv, ci, req)
    } else if iface == proto.pointer_constraints_unstable.locked_pointer_iface {
        let req = try proto.pointer_constraints_unstable.decode_locked_pointer(mut srv.conns[c], m)
        pointer.locked_pointer(mut srv, ci, proto.pointer_constraints_unstable.LockedPointer { id: m.id }, req)
    } else if iface == proto.pointer_constraints_unstable.confined_pointer_iface {
        let req = try proto.pointer_constraints_unstable.decode_confined_pointer(mut srv.conns[c], m)
        pointer.confined_pointer(mut srv, ci, proto.pointer_constraints_unstable.ConfinedPointer { id: m.id }, req)
    } else if iface == proto.pointer_gestures_unstable.gestures_iface {
        let req = try proto.pointer_gestures_unstable.decode_gestures(mut srv.conns[c], m)
        pointer.gestures(mut srv, ci, req)
    } else if iface == proto.pointer_gestures_unstable.gesture_swipe_iface {
        discard try proto.pointer_gestures_unstable.decode_gesture_swipe(mut srv.conns[c], m)
        pointer.gesture_object(mut srv, ci, m.id)
    } else if iface == proto.pointer_gestures_unstable.gesture_pinch_iface {
        discard try proto.pointer_gestures_unstable.decode_gesture_pinch(mut srv.conns[c], m)
        pointer.gesture_object(mut srv, ci, m.id)
    } else if iface == proto.pointer_gestures_unstable.gesture_hold_iface {
        discard try proto.pointer_gestures_unstable.decode_gesture_hold(mut srv.conns[c], m)
        pointer.gesture_object(mut srv, ci, m.id)
    } else if iface == proto.cursor_shape.manager_iface {
        let req = try proto.cursor_shape.decode_manager(mut srv.conns[c], m)
        pointer.shape_manager(mut srv, ci, req)
    } else if iface == proto.cursor_shape.device_iface {
        let req = try proto.cursor_shape.decode_device(mut srv.conns[c], m)
        pointer.shape_device(mut srv, ci, proto.cursor_shape.Device { id: m.id }, req)
    } else if iface == proto.xdg_decoration_unstable.decoration_manager_iface {
        let req = try proto.xdg_decoration_unstable.decode_decoration_manager(mut srv.conns[c], m)
        toplevel.decoration_manager(mut srv, ci, req)
    } else if iface == proto.xdg_decoration_unstable.toplevel_decoration_iface {
        let req = try proto.xdg_decoration_unstable.decode_toplevel_decoration(mut srv.conns[c], m)
        toplevel.decoration(mut srv, ci, proto.xdg_decoration_unstable.ToplevelDecoration { id: m.id }, req)
    } else if iface == proto.xdg_toplevel_icon.icon_manager_iface {
        let req = try proto.xdg_toplevel_icon.decode_icon_manager(mut srv.conns[c], m)
        toplevel.icon_manager(mut srv, ci, req)
    } else if iface == proto.xdg_toplevel_icon.icon_iface {
        let req = try proto.xdg_toplevel_icon.decode_icon(mut srv.conns[c], m)
        toplevel.icon(mut srv, ci, proto.xdg_toplevel_icon.Icon { id: m.id }, req)
    } else if iface == proto.xdg_toplevel_tag.toplevel_tag_manager_iface {
        let req = try proto.xdg_toplevel_tag.decode_toplevel_tag_manager(mut srv.conns[c], m)
        toplevel.tag_manager(mut srv, ci, req)
    } else if iface == proto.xdg_dialog.wm_dialog_iface {
        let req = try proto.xdg_dialog.decode_wm_dialog(mut srv.conns[c], m)
        toplevel.dialog_manager(mut srv, ci, req)
    } else if iface == proto.xdg_dialog.dialog_iface {
        let req = try proto.xdg_dialog.decode_dialog(mut srv.conns[c], m)
