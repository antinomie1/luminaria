        let req = try proto.color_management.decode_image_description(mut srv.conns[c], m)
        color.image_description(mut srv, ci, proto.color_management.ImageDescription { id: m.id }, req)
    } else {
        return Err(srv.conns[c].no_messages(m, false))
    }
    return Ok(())
}

fn display(mut srv: server.Server, ci: u32, take req: wl.DisplayRequest) {
    match req {
        Sync(cb) => {
            let s = srv.next_serial()
            cb.done(mut srv.conns[int(ci)], s)
        }
        GetRegistry(reg) => {
            srv.clients.items[int(ci)].registries.push(reg.id)
            for i in 0..srv.globals.len() {
                let g = srv.globals[i]
                if g.alive and srv.sees(ci, g.iface) {
                    reg.global(mut srv.conns[int(ci)], u32(i + 1), ext.name(srv, g.iface), g.version)
                }
            }
        }
    }
}

fn registry(mut srv: server.Server, ci: u32, reg: wl.Registry, take req: wl.RegistryRequest) {
    match req {
        Bind(name, obj) => {
            guard name > 0 and int(name) <= srv.globals.len() else {
                srv.fail(ci, reg.id, wire.invalid_object, "no global {name}")
                return
            }
            let g = srv.globals[int(name - 1)]
            guard srv.sees(ci, g.iface) else {
                srv.fail(ci, reg.id, wire.invalid_object, "no global {name}")
                return
            }
            guard obj.iface == g.iface and obj.version >= 1 and obj.version <= g.version else {
                srv.fail(ci, reg.id, wire.invalid_object, "bind of global {name} as {ext.name(srv, obj.iface)} v{obj.version}")
                return
            }
            guard g.alive else {
                // Removed meanwhile: an inert object, as libwayland does.
                return
            }
            match g.kind {
                Output(slot) => output.bound(mut srv, ci, slot, obj.id, obj.version)
                Seat(slot) => seat.bound(mut srv, ci, slot, obj.id, obj.version)
                Ext(k) => ext.bound(mut srv, ci, int(k), obj.id, obj.version)
                Static => {
                    if g.iface == wl.shm_iface {
                        buffer.shm_bound(mut srv, ci, obj.id)
                    } else if g.iface == proto.linux_dmabuf.dmabuf_iface {
                        buffer.dmabuf_bound(mut srv, ci, obj.id, obj.version)
                    } else if g.iface == proto.presentation_time.presentation_iface {
                        extra.presentation_bound(mut srv, ci, obj.id)
                    } else if g.iface == proto.xdg_toplevel_icon.icon_manager_iface {
                        toplevel.icon_manager_bound(mut srv, ci, obj.id)
                    } else if g.iface == proto.ext_foreign_toplevel_list.toplevel_list_iface {
                        toplevel.list_bound(mut srv, ci, obj.id, obj.version)
                    } else if g.iface == proto.wlr_foreign_toplevel_management_unstable.manager_iface {
                        taskbar.bound(mut srv, ci, obj.id, obj.version)
                    } else if g.iface == proto.wlr_output_management_unstable.manager_iface {
                        outman.bound(mut srv, ci, obj.id)
                    } else if g.iface == proto.color_management.color_manager_iface {
                        color.manager_bound(mut srv, ci, obj.id)
                    }
                }
            }
        }
    }
}
