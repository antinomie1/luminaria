// The server: the listening socket, clients and every protocol object.
// `dispatch` reads a client and handles its requests; requests that change
// what is shown or need a decision come out of `next` as events, and the
// compositor answers through the methods here and in the other modules.
// Nothing blocks and nothing allocates per request in steady state.

import std.mem
import std.net
import luminaria_wire as wire
import luminaria_proto as proto
import luminaria_proto.wayland as wl
import luminaria_proto.ifaces as ifaces
import ids
import state
import surface
import buffer
import xdg
import seat
import output
import data
import extra
import route
import shell
import ime
import pointer
import toplevel
import inhibit
import capture
import security
import outman

/// What happened, for the compositor (and luminaria's glue) to act on.
pub enum Event {
    ClientNew(ids.Client)
    ClientGone(ids.Client)
    /// A wl_buffer exists: import it now (dmabuf) or wait for its first
    /// commit (shm).
    BufferNew(ids.Buffer)
    BufferGone(ids.Buffer)
    /// A commit waits: resolve `waits(txn)`, then `ready(txn)`.
    Committed(ids.Txn)
    /// A commit became current: `changes(surface)` says what changed.
    Applied(ids.Surface)
    SurfaceGone(ids.Surface)
    /// A toplevel's initial commit: title and app id are set; configure it.
    WindowNew(ids.Window)
    WindowMapped(ids.Window)
    WindowUnmapped(ids.Window)
    WindowClosed(ids.Window)
    WindowTitle(ids.Window)
    WindowAppId(ids.Window)
    WindowParent(ids.Window)
    WindowRequest(ids.Window, Request)
    /// The client acked a configure of this size and committed with it.
    WindowAcked(ids.Window, i32, i32)
    PopupNew(ids.Popup)
    PopupMapped(ids.Popup)
    PopupGone(ids.Popup)
    PopupGrab(ids.Popup, ids.Seat)
    /// The client asked for a new position (reposition): configure again.
    PopupReposition(ids.Popup)
    /// wl_pointer.set_cursor from the focused client: surface (None
    /// hides), hotspot.
    Cursor(ids.Seat, Option[ids.Surface], i32, i32)
    /// wp_cursor_shape from the focused client: `cursor_name(shape)`.
    CursorShape(ids.Seat, u32)
    /// A layer surface's initial commit: arrange and configure it.
    LayerNew(ids.Layer)
    /// Mapped, unmapped, or its anchors, size, zone or layer changed.
    LayerChanged(ids.Layer)
    LayerGone(ids.Layer)
    /// A client asks to lock the session: hide everything, then
    /// `lock_done`.
    LockRequest
    /// The locker unlocked the session.
    Unlock
    /// A lock surface for an output: configure it to the output's size.
    LockSurfaceNew(ids.LockSurface)
    /// Mapped, unmapped or gone.
    LockSurfaceChanged(ids.LockSurface)
    /// The client wants a decoration mode (`decoration`): answer with
    /// `set_decoration` and a configure.
    WindowDecoration(ids.Window)
    WindowIcon(ids.Window)
    /// xdg-activation with a valid token: the window wants focus.
    Activate(ids.Window)
    Bell(Option[ids.Surface])
    /// The input method's popups or the text cursor moved.
    ImeChanged(ids.Seat)
    /// Idle notifications were added: `idle_check` again.
    IdleChanged
    /// A drag started or ended on the seat (`drag_icon` follows the
    /// pointer meanwhile).
    Drag(ids.Seat)
    /// A screen capture of the output waits: draw a frame now, even
    /// without damage, and hand it to `capture`.
    Capture(ids.Output)
    /// A sandbox listener is ready: poll `listener_fds(k)` and accept
    /// with `accept_from`, close with `close_listener` when the second
    /// one hangs up.
    Listen(u32)
    /// A tool asks for this output configuration (`output_config`):
    /// test it only (true) or apply it, then `output_config_done`.
    OutputConfig(ids.OutputConfig, bool)
}

/// A toplevel's request for a decision.
pub enum Request {
    Move(ids.Seat, u32)
    /// Edges as xdg_toplevel.resize_edge.
    Resize(ids.Seat, u32, u32)
    Maximize(bool)
    Fullscreen(bool, Option[ids.Output])
    Minimize
    Menu(ids.Seat, i32, i32)
}

/// linux-dmabuf setup: what the GPU imports, which device it is.
pub struct Dmabuf {
    /// dev_t of the main device.
    pub device: u64 = 0
    /// DRM fourcc and modifier pairs the compositor can sample.
    pub formats: List[(u32, u64)] = []
    /// The subset KMS can scan out of directly (a scanout tranche).
    pub scanout: List[(u32, u64)] = []
    pub scanout_device: u64 = 0
}

pub struct Server {
    pub listener: wire.Listener
    clients: ids.Slab[state.ClientData] = ids.Slab {}
    conns: List[wire.Conn] = []
    globals: List[state.Global] = []
    surfaces: ids.Slab[state.SurfaceData] = ids.Slab {}
    buffers: ids.Slab[state.BufferData] = ids.Slab {}
    pools: ids.Slab[state.PoolData] = ids.Slab {}
    regions: ids.Slab[state.RegionData] = ids.Slab {}
    windows: ids.Slab[state.WindowData] = ids.Slab {}
    popups: ids.Slab[state.PopupData] = ids.Slab {}
    positioners: ids.Slab[state.PositionerData] = ids.Slab {}
    outputs: ids.Slab[state.OutputData] = ids.Slab {}
    seats: ids.Slab[state.SeatData] = ids.Slab {}
    sources: ids.Slab[state.SourceData] = ids.Slab {}
    offers: ids.Slab[state.OfferData] = ids.Slab {}
    params: ids.Slab[state.ParamsData] = ids.Slab {}
    timelines: ids.Slab[state.TimelineData] = ids.Slab {}
    txns: ids.Slab[state.TxnData] = ids.Slab {}
    icons: ids.Slab[state.IconData] = ids.Slab {}
    text_inputs: ids.Slab[state.TextInputData] = ids.Slab {}
    layers: ids.Slab[state.LayerData] = ids.Slab {}
    lock_surfaces: ids.Slab[state.LockSurfaceData] = ids.Slab {}
    constraints: ids.Slab[state.ConstraintData] = ids.Slab {}
    idles: ids.Slab[state.IdleData] = ids.Slab {}
    vkeys: ids.Slab[state.VirtualKeyboardData] = ids.Slab {}
    captures: ids.Slab[state.CaptureData] = ids.Slab {}
    contexts: ids.Slab[state.ContextData] = ids.Slab {}
    outmans: ids.Slab[state.OutmanData] = ids.Slab {}
    configs: ids.Slab[state.ConfigData] = ids.Slab {}
    /// wlr-output-management serial: bumped by every output change.
    out_serial: u32 = 1
    /// The session lock: its client and ext_session_lock_v1 id (0: none);
    /// whether the session is locked (it stays locked when the locker dies).
    lock_client: u32 = 0
    lock_obj: u32 = 0
    locked: bool = false
    /// xdg-activation tokens handed out: token, client slot.
    tokens: List[(str, u32)] = []
    token_count: u64 = 0
    /// xdg-foreign: exported handle, window slot, client, zxdg_exported id;
    /// imports: client, id, handle.
    exported: List[(str, u32, u32, u32)] = []
    imported: List[(u32, u32, str)] = []
    /// ext_foreign_toplevel_list_v1 objects.
    toplevel_lists: List[state.Res] = []
    /// Keyboard shortcut inhibitors: client, id, surface slot, seat slot,
    /// active.
    shortcut_inhibitors: List[(u32, u32, u32, u32, bool)] = []
    /// Idle inhibitors: client, id, surface slot.
    idle_inhibitors: List[(u32, u32, u32)] = []
    /// When the seat last saw input (CLOCK_MONOTONIC ns).
    last_input: int = 0
    /// Events queued; `next` reads from `head`.
    events: List[Event] = []
    head: int = 0
    serial: u32 = 0
    dmabuf: Option[Dmabuf] = None
    /// linux-dmabuf format table (memfd) and size.
    table_fd: int = -1
    table_size: u32 = 0
    syncobj: bool = false
    no_waits: List[state.Wait] = []
}

/// Listen on `name` ("" for the first free wayland-N) with the core
/// globals; add outputs, seats, dmabuf and syncobj support afterwards.
pub fn Server.open(name: str) -> Result[Server, str] {
    let l = try wire.listen(name)
    var s = Server { listener: l }
    s.add_global(wl.compositor_iface, 6)
    s.add_global(wl.subcompositor_iface, 1)
    s.add_global(wl.shm_iface, 2)
    s.add_global(wl.data_device_manager_iface, 3)
    s.add_global(proto.xdg_shell.wm_base_iface, 6)
    s.add_global(proto.presentation_time.presentation_iface, 1)
    s.add_global(proto.viewporter.viewporter_iface, 1)
    s.add_global(proto.fractional_scale.scale_manager_iface, 1)
    s.add_global(proto.fifo.fifo_manager_iface, 1)
    s.add_global(proto.commit_timing.timing_manager_iface, 1)
    s.add_global(proto.tearing_control.control_manager_iface, 1)
    s.add_global(wl.fixes_iface, 1)
    s.add_global(proto.xdg_decoration_unstable.decoration_manager_iface, 1)
    s.add_global(proto.xdg_activation.activation_iface, 1)
    s.add_global(proto.xdg_toplevel_icon.icon_manager_iface, 1)
    s.add_global(proto.xdg_toplevel_tag.toplevel_tag_manager_iface, 1)
    s.add_global(proto.xdg_dialog.wm_dialog_iface, 1)
    s.add_global(proto.xdg_system_bell.system_bell_iface, 1)
    s.add_global(proto.xdg_foreign_unstable.exporter_iface, 1)
    s.add_global(proto.xdg_foreign_unstable.importer_iface, 1)
    s.add_global(proto.xdg_output_unstable.output_manager_iface, 3)
    s.add_global(proto.ext_foreign_toplevel_list.toplevel_list_iface, 1)
    s.add_global(proto.wlr_layer_shell_unstable.shell_iface, 5)
    s.add_global(proto.ext_session_lock.lock_manager_iface, 1)
    s.add_global(proto.primary_selection_unstable.device_manager_iface, 1)
    s.add_global(proto.ext_data_control.manager_iface, 1)
    s.add_global(proto.text_input_unstable.input_manager_iface, 1)
    s.add_global(proto.input_method_unstable.method_manager_iface, 1)
    s.add_global(proto.virtual_keyboard_unstable.keyboard_manager_iface, 1)
    s.add_global(proto.relative_pointer_unstable.pointer_manager_iface, 1)
    s.add_global(proto.pointer_constraints_unstable.pointer_constraints_iface, 1)
    s.add_global(proto.pointer_gestures_unstable.gestures_iface, 3)
    s.add_global(proto.cursor_shape.manager_iface, 2)
    s.add_global(proto.idle_inhibit_unstable.inhibit_manager_iface, 1)
    s.add_global(proto.ext_idle_notify.notifier_iface, 2)
    s.add_global(proto.keyboard_shortcuts_inhibit_unstable.inhibit_manager_iface, 1)
    s.add_global(proto.single_pixel_buffer.single_pixel_buffer_manager_iface, 1)
    s.add_global(proto.alpha_modifier.modifier_iface, 1)
    s.add_global(proto.content_type.type_manager_iface, 1)
    s.add_global(proto.ext_image_capture_source.output_image_capture_source_manager_iface, 1)
    s.add_global(proto.ext_image_copy_capture.manager_iface, 1)
    s.add_global(proto.security_context.context_manager_iface, 1)
    s.add_global(proto.wlr_output_management_unstable.manager_iface, 4)
    return Ok(s)
}

/// The socket name clients connect to (WAYLAND_DISPLAY).
pub fn Server.name(self) -> str {
    return self.listener.name.clone()
}

/// Advertise linux-dmabuf with this setup.
pub fn Server.enable_dmabuf(mut self, take d: Dmabuf) -> Result[(), str] {
    try buffer.make_table(mut self, d)
    self.dmabuf = Some(d)
    self.add_global(proto.linux_dmabuf.dmabuf_iface, 4)
    return Ok(())
}

/// Advertise linux-drm-syncobj (the compositor waits on and signals the
/// timelines).
pub fn Server.enable_syncobj(mut self) {
    guard not self.syncobj else {
        return
    }
    self.syncobj = true
    self.add_global(proto.linux_drm_syncobj.manager_iface, 1)
}

fn Server.add_global(mut self, iface: u16, version: u32) {
    self.globals.push(state.Global { iface, version: min(version, ifaces.version(iface)), kind: state.GlobalKind.Static })
    self.announce(u32(self.globals.len()))
}

/// Add a global of `kind`; its name.
fn Server.add_dynamic(mut self, iface: u16, version: u32, kind: state.GlobalKind) -> u32 {
    self.globals.push(state.Global { iface, version: min(version, ifaces.version(iface)), kind })
    let name = u32(self.globals.len())
    self.announce(name)
    return name
}

/// Tell every registry about global `name`.
fn Server.announce(mut self, name: u32) {
    let g = self.globals[int(name - 1)]
    let iface = ifaces.name(g.iface)
    for ci in 0..self.clients.items.len() {
        guard self.clients.used(ci) and self.sees(u32(ci), g.iface) else {
            continue
        }
        for r in self.clients.items[ci].registries.clone() {
            wl.Registry { id: r }.global(mut self.conns[ci], name, iface, g.version)
        }
    }
}

fn Server.remove_global(mut self, name: u32) {
    guard name > 0 and int(name) <= self.globals.len() else {
        return
    }
    self.globals[int(name - 1)].alive = false
    let gi = self.globals[int(name - 1)].iface
    for ci in 0..self.clients.items.len() {
        guard self.clients.used(ci) and self.sees(u32(ci), gi) else {
            continue
        }
        for r in self.clients.items[ci].registries.clone() {
            wl.Registry { id: r }.global_remove(mut self.conns[ci], name)
        }
    }
}

/// Whether client `ci` may see globals of `iface` (sandboxed clients do
/// not see privileged ones).
fn Server.sees(self, ci: u32, iface: u16) -> bool {
    return not self.clients.items[int(ci)].sandboxed or not security.privileged(iface)
}

fn Server.push(mut self, e: Event) {
    self.events.push(e)
}

/// The next event, oldest first.
pub fn Server.next(mut self) -> Option[Event] {
    guard self.head < self.events.len() else {
        self.events.clear()
        self.head = 0
        return None
    }
    let e = self.events[self.head]
    self.head += 1
    return Some(e)
}

fn Server.next_serial(mut self) -> u32 {
    self.serial += 1
    return self.serial
}

// ------------------------------------------------------------- clients

/// Accept a waiting client: its handle and socket (to poll for reading).
pub fn Server.accept(mut self) -> Result[Option[(ids.Client, int)], str] {
    let got = self.listener.accept().map_err(fn(e) => "{e}")
    guard let Some(conn) = try got else {
        return Ok(None)
    }
    return Ok(Some(self.add_client(conn, state.none)))
}

/// Accept a waiting client of sandbox listener `k`; it is sandboxed.
pub fn Server.accept_from(mut self, k: u32) -> Option[(ids.Client, int)] {
    guard self.contexts.used(int(k)) else {
        return None
    }
    let (fd, _) = self.listener_fds(k)
    guard fd >= 0 else {
        return None
    }
    guard let Ok(Some(conn)) = wire.socket.accept_on(fd) else {
        return None
    }
    return Some(self.add_client(conn, k))
}

/// The descriptors of sandbox listener `k`: the socket to accept on and
/// the one whose hangup ends it.
pub fn Server.listener_fds(self, k: u32) -> (int, int) {
    guard self.contexts.used(int(k)) else {
        return (-1, -1)
    }
    var out = (-1, -1)
    if let Some(l) = self.contexts.items[int(k)].listen {
        out.0 = l.raw()
    }
    if let Some(c) = self.contexts.items[int(k)].close {
        out.1 = c.raw()
    }
    return out
}

/// Stop sandbox listener `k` (its clients stay).
pub fn Server.close_listener(mut self, k: u32) {
    guard self.contexts.used(int(k)) else {
        return
    }
    let c = self.contexts.items[int(k)].client
    let obj = self.contexts.items[int(k)].obj
    if obj != 0 and self.clients.used(int(c)) {
        self.unbind(c, obj)
    }
    self.contexts.remove(k, state.ContextData {})
}

/// The sandbox a client connected through: engine, app id, instance id
/// (None: not sandboxed).
pub fn Server.sandbox(self, c: ids.Client) -> Option[(str, str, str)] {
    guard self.clients.live(c.id) and self.clients.items[int(c.id.index)].sandboxed else {
        return None
    }
    let i = int(c.id.index)
    return Some((self.clients.items[i].engine.clone(), self.clients.items[i].app_id.clone(), self.clients.items[i].instance_id.clone()))
}

fn Server.add_client(mut self, take conn: wire.Conn, k: u32) -> (ids.Client, int) {
    let fd = conn.fd
    var cd = state.ClientData {}
    if k != state.none {
        cd.sandboxed = true
        cd.engine = self.contexts.items[int(k)].engine.clone()
        cd.app_id = self.contexts.items[int(k)].app_id.clone()
        cd.instance_id = self.contexts.items[int(k)].instance_id.clone()
    }
    let sock = net.Conn { fd }
    if let Ok(cred) = sock.peer_cred() {
        cd.pid = cred.pid
        cd.uid = cred.uid
        cd.gid = cred.gid
    }
    let id = self.clients.add(cd)
    while self.conns.len() <= int(id.index) {
        self.conns.push(wire.Conn.closed())
    }
    self.conns[int(id.index)] = conn
    let c = ids.Client { id }
    self.push(Event.ClientNew(c))
    return (c, fd)
}

/// The generation of client slot `index` (to rebuild a handle from a
/// poller token).
pub fn Server.client_gen(self, index: u32) -> u32 {
    guard int(index) < self.clients.gens.len() else {
        return 0
    }
    return self.clients.gens[int(index)]
}

pub fn Server.client_fd(self, c: ids.Client) -> int {
    guard self.clients.live(c.id) else {
        return -1
    }
    return self.conns[int(c.id.index)].fd
}

/// The client's process id, user and group (from the socket).
pub fn Server.credentials(self, c: ids.Client) -> (int, int, int) {
    guard self.clients.live(c.id) else {
        return (0, 0, 0)
    }
    let i = int(c.id.index)
    return (self.clients.items[i].pid, self.clients.items[i].uid, self.clients.items[i].gid)
}

pub fn Server.client_of(self, s: ids.Surface) -> ids.Client {
    guard self.surfaces.live(s.id) else {
        return ids.Client { id: ids.Id {} }
    }
    let ci = self.surfaces.items[int(s.id.index)].client
    return ids.Client { id: self.clients.id(ci) }
}

/// Read and handle what client `c` sent. False when it is gone (call
/// `disconnect` after removing its socket from the poller).
pub fn Server.dispatch(mut self, c: ids.Client) -> bool {
    guard self.clients.live(c.id) else {
        return false
    }
    let ci = c.id.index
    while true {
        match self.conns[int(ci)].read() {
            Ok(true) => {}
            Ok(false) => {
                return true
            }
            Err => {
                return false
            }
        }
        while true {
            match proto.next(mut self.conns[int(ci)]) {
                Ok(Some(r)) => {
                    route.handle(mut self, ci, r)
                    // A destructor its handler left alone is torn down like
                    // at disconnect, so nothing stays behind for the next
                    // object with the same id.
                    if self.conns[int(ci)].removed_pending() {
                        var gone: List[(u32, u16)] = []
                        self.conns[int(ci)].take_removed(mut gone)
                        for (id, iface) in gone {
                            if self.slot(ci, id) != state.none {
                                route.destroyed(mut self, ci, id, iface)
                            }
                        }
                    }
                }
                Ok(None) => {
                    break
                }
                Err => {
                    return false
                }
            }
        }
    }
}

/// Send what is queued for every client; the clients that must go (they
/// stopped reading, or broke the protocol).
pub fn Server.flush(mut self, mut gone: List[ids.Client]) {
    for ci in 0..self.conns.len() {
        guard self.clients.used(ci) and self.conns[ci].pending() else {
            continue
        }
        match self.conns[ci].flush() {
            Err => gone.push(ids.Client { id: self.clients.id(u32(ci)) })
            Ok => {}
        }
    }
}

/// Protocol error `code` on `obj`: the client is told and dropped after
/// the next flush.
fn Server.fail(mut self, ci: u32, obj: u32, code: u32, msg: &str) {
    discard self.conns[int(ci)].error(obj, code, msg)
}

/// Remember that id `id` of client `ci` is slot `slot` of its kind.
fn Server.bind(mut self, ci: u32, id: u32, slot: u32) {
    if id >= wire.server_base {
        let k = int(id - wire.server_base)
        while self.clients.items[int(ci)].high.len() <= k {
            self.clients.items[int(ci)].high.push(state.none)
        }
        self.clients.items[int(ci)].high[k] = slot
        return
    }
    while self.clients.items[int(ci)].objs.len() <= int(id) {
        self.clients.items[int(ci)].objs.push(state.none)
    }
    self.clients.items[int(ci)].objs[int(id)] = slot
}

/// The slot id `id` of client `ci` names, `none` when unbound.
fn Server.slot(self, ci: u32, id: u32) -> u32 {
    if id >= wire.server_base {
        let k = int(id - wire.server_base)
        guard k < self.clients.items[int(ci)].high.len() else {
            return state.none
        }
        return self.clients.items[int(ci)].high[k]
    }
    guard int(id) < self.clients.items[int(ci)].objs.len() else {
        return state.none
    }
    return self.clients.items[int(ci)].objs[int(id)]
}

fn Server.unbind(mut self, ci: u32, id: u32) {
    self.bind(ci, id, state.none)
}

/// Drop client `c` and everything it made.
pub fn Server.disconnect(mut self, c: ids.Client) {
    guard self.clients.live(c.id) else {
        return
    }
    let ci = c.id.index
    let limit = self.conns[int(ci)].id_limit()
    // Children before parents: destroy in reverse creation order.
    var id = limit
    while id > 1 {
        id -= 1
        let iface = self.conns[int(ci)].iface(id)
        if iface != 0 {
            route.destroyed(mut self, ci, id, iface)
        }
    }
    let highs = self.clients.items[int(ci)].high.len()
    for k in 0..highs {
        let hid = wire.server_base + u32(k)
        let iface = self.conns[int(ci)].iface(hid)
        if iface != 0 {
            route.destroyed(mut self, ci, hid, iface)
        }
    }
    for t in self.clients.items[int(ci)].txns.clone() {
        self.txns.remove(t, state.TxnData {})
    }
    // Records not tied to a slot.
    self.toplevel_lists.retain(fn(r) => r.client != ci)
    self.tokens.retain(fn(t) => t.1 != ci)
    self.imported.retain(fn(i) => i.0 != ci)
    toplevel.unexport(mut self, fn(x) => x.2 == ci)
    self.idle_inhibitors.retain(fn(x) => x.0 != ci)
    self.shortcut_inhibitors.retain(fn(x) => x.0 != ci)
    if self.lock_obj != 0 and self.lock_client == ci {
        // The session stays locked: the next locker takes over.
        self.lock_obj = 0
    }
    self.conns[int(ci)] = wire.Conn.closed()
    self.clients.remove(ci, state.ClientData {})
    self.push(Event.ClientGone(c))
}

// ------------------------------------------------------------- surfaces

/// A surface's current state, as the last applied commit left it.
pub struct SurfaceInfo {
    pub buffer: Option[ids.Buffer] = None
    /// Size in surface coordinates (after scale, transform and viewport).
    pub width: i32 = 0
    pub height: i32 = 0
    pub buffer_width: i32 = 0
    pub buffer_height: i32 = 0
    pub scale: i32 = 1
    /// wl_output.transform value.
    pub transform: u32 = 0
    /// wp_viewport source in buffer coordinates after transform and scale
    /// (x, y, w, h); w < 0 is unset.
    pub src: [4]f64 = [-1.0, -1.0, -1.0, -1.0]
    /// Offset the last commit moved the content by.
    pub dx: i32 = 0
    pub dy: i32 = 0
    /// The client allows tearing (wp_tearing_control async).
    pub tearing: bool = false
    pub mapped: bool = false
    /// Window geometry (xdg), or the whole surface.
    pub geometry: ids.Rect = ids.Rect {}
    /// wp_alpha_modifier: multiply the surface's alpha by this.
    pub alpha: f32 = 1.0
    /// wp_content_type: none 0, photo 1, video 2, game 3.
    pub content: u32 = 0
}

pub fn Server.surface_alive(self, s: ids.Surface) -> bool {
    return self.surfaces.live(s.id)
}

pub fn Server.info(self, s: ids.Surface) -> SurfaceInfo {
    guard self.surfaces.live(s.id) else {
        return SurfaceInfo {}
    }
    let i = int(s.id.index)
    var geo = ids.Rect { w: self.surfaces.items[i].width, h: self.surfaces.items[i].height }
    if self.surfaces.items[i].current.geometry_set {
        geo = self.surfaces.items[i].current.geometry
    }
    return SurfaceInfo {
        buffer: match self.surfaces.items[i].current.buffer {
            Some(b) => Some(ids.Buffer { id: b })
            None => None
        },
        width: self.surfaces.items[i].width,
        height: self.surfaces.items[i].height,
        buffer_width: self.surfaces.items[i].buffer_w,
        buffer_height: self.surfaces.items[i].buffer_h,
        scale: self.surfaces.items[i].current.scale,
        transform: self.surfaces.items[i].current.transform,
        src: self.surfaces.items[i].current.src,
        dx: self.surfaces.items[i].current.dx,
        dy: self.surfaces.items[i].current.dy,
        tearing: self.surfaces.items[i].current.tearing,
        alpha: f32(f64(self.surfaces.items[i].current.alpha) / 4294967295.0),
        content: self.surfaces.items[i].current.content,
        mapped: self.surfaces.items[i].mapped,
        geometry: geo,
    }
}

/// What applied commits changed since the last call (`changed_*` bits),
/// moving their damage (surface and buffer coordinates) into the lists.
pub fn Server.take_changes(mut self, s: ids.Surface, mut damage: List[ids.Rect], mut buffer_damage: List[ids.Rect]) -> u32 {
    guard self.surfaces.live(s.id) else {
        return 0
    }
    let i = int(s.id.index)
    damage.extend(mem.replace(mut self.surfaces.items[i].applied_damage, []))
    buffer_damage.extend(mem.replace(mut self.surfaces.items[i].applied_bdamage, []))
    let c = self.surfaces.items[i].changed
    self.surfaces.items[i].changed = 0
    return c
}

/// The largest rectangle of the opaque region (surface coordinates).
pub fn Server.opaque(self, s: ids.Surface) -> ids.Rect {
    guard self.surfaces.live(s.id) else {
        return ids.Rect {}
    }
    return ids.region_largest(self.surfaces.items[int(s.id.index)].current.opaque)
}

/// Whether surface-local `x, y` is inside the surface and its input region.
pub fn Server.accepts(self, s: ids.Surface, x: f64, y: f64) -> bool {
    guard self.surfaces.live(s.id) else {
        return false
    }
    let i = int(s.id.index)
    guard x >= 0.0 and y >= 0.0 and x < f64(self.surfaces.items[i].width) and y < f64(self.surfaces.items[i].height) and self.surfaces.items[i].role != state.Role.DragIcon else {
        return false
    }
    return match self.surfaces.items[i].current.input {
        Some(rs) => ids.region_contains(rs, x, y)
        None => true
    }
}

/// The mapped surfaces of `s`'s subsurface tree, bottom to top, with
/// their offsets from `s`.
pub fn Server.tree(self, s: ids.Surface, mut out: List[(ids.Surface, i32, i32)]) {
    guard self.surfaces.live(s.id) else {
        return
    }
    surface.tree(self, s.id.index, 0, 0, mut out)
}

/// The surface's frame callbacks fire (it was shown, or the compositor
/// lets a hidden one go on); `ms` is the frame time.
pub fn Server.frame_done(mut self, s: ids.Surface, ms: u32) {
    if self.surfaces.live(s.id) {
        surface.frame_done(mut self, s.id.index, ms)
    }
}

/// Whether the surface waits for a frame callback.
pub fn Server.wants_frame(self, s: ids.Surface) -> bool {
    return self.surfaces.live(s.id) and not self.surfaces.items[int(s.id.index)].frames.is_empty()
}

/// wp_presentation: the last commit was shown on `o` at `ns`.
pub fn Server.presented(mut self, s: ids.Surface, o: ids.Output, ns: int, refresh_ns: int, seq: u64, flags: u32) {
    if self.surfaces.live(s.id) {
        extra.presented(mut self, s.id.index, o.id.index, ns, refresh_ns, seq, flags)
    }
}

pub fn Server.discarded(mut self, s: ids.Surface) {
    if self.surfaces.live(s.id) {
        extra.discard_feedbacks(mut self, s.id.index)
    }
}

/// The surface's content was latched for display: its fifo barrier clears.
pub fn Server.latch(mut self, s: ids.Surface) {
    if self.surfaces.live(s.id) {
        self.surfaces.items[int(s.id.index)].barrier = false
    }
}

/// The outputs the surface is on (bit per output slot index).
pub fn Server.set_outputs(mut self, s: ids.Surface, mask: u64) {
    if self.surfaces.live(s.id) {
        output.set_outputs(mut self, s.id.index, mask)
    }
}

pub fn Server.preferred(mut self, s: ids.Surface, scale120: i32, transform: u32) {
    if self.surfaces.live(s.id) {
        output.preferred(mut self, s.id.index, scale120, transform)
    }
}

/// Release point (timeline fd, point) of the surface's current buffer
/// when the client uses explicit sync.
pub fn Server.release_point(self, s: ids.Surface) -> Option[(int, u64)] {
    guard self.surfaces.live(s.id) else {
        return None
    }
    let t = self.surfaces.items[int(s.id.index)].release
    guard t != state.none and self.timelines.used(int(t)) else {
        return None
    }
    if let Some(f) = self.timelines.items[int(t)].fd {
        return Some((f.raw(), self.surfaces.items[int(s.id.index)].release_point))
    }
    return None
}

// ------------------------------------------------------------- buffers

pub enum BufferKind {
    Shm
    Dmabuf
    /// One premultiplied RGBA pixel (`color`).
    SinglePixel
}

pub struct BufferInfo {
    pub kind: BufferKind = BufferKind.Shm
    pub width: i32 = 0
    pub height: i32 = 0
    /// DRM fourcc.
    pub format: u32 = 0
    pub modifier: u64 = 0
    pub planes: int = 0
    /// shm row pitch in bytes.
    pub stride: int = 0
    pub client: ids.Client = ids.Client { id: ids.Id {} }
    /// Single-pixel colour, premultiplied, 0..0xFFFFFFFF per channel.
    pub color: [4]u32 = [0, 0, 0, 0]
}

pub fn Server.buffer_alive(self, b: ids.Buffer) -> bool {
    return self.buffers.live(b.id)
}

pub fn Server.buffer(self, b: ids.Buffer) -> BufferInfo {
    guard self.buffers.live(b.id) else {
        return BufferInfo {}
    }
    let i = int(b.id.index)
    let k = match self.buffers.items[i].kind {
        Dmabuf => BufferKind.Dmabuf
        SinglePixel => BufferKind.SinglePixel
        Shm => BufferKind.Shm
    }
    let ci = self.buffers.items[i].client
    return BufferInfo {
        kind: k,
        width: self.buffers.items[i].width,
        height: self.buffers.items[i].height,
        format: self.buffers.items[i].format,
        modifier: self.buffers.items[i].modifier,
        planes: self.buffers.items[i].planes.len(),
        stride: self.buffers.items[i].stride,
        client: ids.Client { id: self.clients.id(ci) },
        color: self.buffers.items[i].color,
    }
}

/// Plane `k` of a dmabuf: fd (still the server's), offset, stride.
pub fn Server.plane(self, b: ids.Buffer, k: int) -> (int, u32, u32) {
    guard self.buffers.live(b.id) and k < self.buffers.items[int(b.id.index)].planes.len() else {
        return (-1, 0, 0)
    }
    let i = int(b.id.index)
    return (self.buffers.items[i].planes[k].fd.raw(), self.buffers.items[i].planes[k].offset, self.buffers.items[i].planes[k].stride)
}

/// Lend `f` the shm buffer's bytes and stride (SIGBUS-safe); false when
/// the client broke the buffer.
pub fn Server.with_shm(self, b: ids.Buffer, f: fn(&[u8], int)) -> bool {
    guard self.buffers.live(b.id) else {
        return false
    }
    return buffer.with_shm(self, b.id.index, f)
}

/// Reading an shm buffer: its bytes from the first pixel and row stride,
/// valid until `shm_end`.
pub unsafe struct Shm {
    ptr: Ptr[u8]
    len: int
    pub stride: int
    pool: u32
}

pub fn Shm.bytes(self) -> &[u8] {
    unsafe {
        return Ptr.slice(self.ptr, self.len)
    }
}

/// Start reading shm buffer `b` (a client shrinking the pool meanwhile
/// cannot crash us); None when it is not an intact shm buffer.
pub fn Server.shm_begin(self, b: ids.Buffer) -> Option[Shm] {
    guard self.buffers.live(b.id) and self.buffers.items[int(b.id.index)].kind == state.BufferKind.Shm else {
        return None
    }
    let i = int(b.id.index)
    let pi = self.buffers.items[i].pool
    let off = self.buffers.items[i].offset
    let stride = self.buffers.items[i].stride
    let len = stride * int(self.buffers.items[i].height)
    if let Some(m) = self.pools.items[int(pi)].map {
        guard off + len <= m.len else {
            return None
        }
        discard m.begin_access()
        unsafe {
            return Some(Shm { ptr: m.ptr.offset(off), len, stride, pool: pi })
        }
    }
    return None
}

/// Done reading: false when the client truncated the pool meanwhile (what
/// was read is zeros).
pub fn Server.shm_end(self, s: Shm) -> bool {
    if self.pools.used(int(s.pool)) {
        if let Some(m) = self.pools.items[int(s.pool)].map {
            return not m.end_access()
        }
    }
    return false
}

/// The compositor is done reading the buffer: wl_buffer.release once no
/// surface shows it either.
pub fn Server.release(mut self, b: ids.Buffer) {
    guard self.buffers.live(b.id) else {
        return
    }
    let i = int(b.id.index)
    guard self.buffers.items[i].busy else {
        return
    }
    self.buffers.items[i].busy = false
    let ci = self.buffers.items[i].client
    let obj = self.buffers.items[i].obj
    if obj != 0 {
        wl.Buffer { id: obj }.release(mut self.conns[int(ci)])
    }
}

/// The result of importing a dmabuf the compositor got as BufferNew.
pub fn Server.imported(mut self, b: ids.Buffer, ok: bool) {
    if self.buffers.live(b.id) {
        buffer.imported(mut self, b.id.index, ok)
    }
}

// --------------------------------------------------------- transactions

pub fn Server.waits(self, t: ids.Txn) -> &[state.Wait] {
    guard self.txns.live(t.id) else {
        return self.no_waits[0..0]
    }
    return self.txns.items[int(t.id.index)].waits
}

/// Every wait of `t` is over: apply it (and what queued behind it).
pub fn Server.ready(mut self, t: ids.Txn) {
    surface.ready(mut self, t)
}

// ------------------------------------------------------------- windows

pub fn Server.window_alive(self, w: ids.Window) -> bool {
    return self.windows.live(w.id)
}

pub fn Server.window_surface(self, w: ids.Window) -> ids.Surface {
    guard self.windows.live(w.id) else {
        return ids.Surface { id: ids.Id {} }
    }
    return ids.Surface { id: self.surfaces.id(self.windows.items[int(w.id.index)].surface) }
}

pub fn Server.window_client(self, w: ids.Window) -> ids.Client {
    return self.client_of(self.window_surface(w))
}

/// The window a surface is the toplevel of.
pub fn Server.window_of(self, s: ids.Surface) -> Option[ids.Window] {
    guard self.surfaces.live(s.id) else {
        return None
    }
    return match self.surfaces.items[int(s.id.index)].role {
        Toplevel(w) => Some(ids.Window { id: self.windows.id(w) })
        _ => None
    }
}

pub fn Server.title(self, w: ids.Window) -> &str {
    guard self.windows.live(w.id) else {
        return ""
    }
    return self.windows.items[int(w.id.index)].title
}

pub fn Server.app_id(self, w: ids.Window) -> &str {
    guard self.windows.live(w.id) else {
        return ""
    }
    return self.windows.items[int(w.id.index)].app_id
}

pub fn Server.parent(self, w: ids.Window) -> Option[ids.Window] {
    guard self.windows.live(w.id) else {
        return None
    }
    let p = self.windows.items[int(w.id.index)].parent
    return if p == state.none or not self.windows.used(int(p)) { None } else { Some(ids.Window { id: self.windows.id(p) }) }
}

/// Minimum and maximum size the client asked for (0: none).
pub fn Server.size_hints(self, w: ids.Window) -> (i32, i32, i32, i32) {
    guard self.windows.live(w.id) else {
        return (0, 0, 0, 0)
    }
    let si = int(self.windows.items[int(w.id.index)].surface)
    let c = int(si)
    return (self.surfaces.items[c].current.min_w, self.surfaces.items[c].current.min_h, self.surfaces.items[c].current.max_w, self.surfaces.items[c].current.max_h)
}

pub fn Server.mapped(self, w: ids.Window) -> bool {
    return self.windows.live(w.id) and self.windows.items[int(w.id.index)].mapped
}

/// Configure a window: size (0 lets the client choose) and states. The
/// serial the client will ack.
pub fn Server.configure(mut self, w: ids.Window, width: i32, height: i32, st: xdg.States) -> u32 {
    guard self.windows.live(w.id) else {
        return 0
    }
    return xdg.configure_toplevel(mut self, w.id.index, width, height, st)
}

/// Ask the window to close (xdg_toplevel.close).
pub fn Server.close(mut self, w: ids.Window) {
    if self.windows.live(w.id) {
        xdg.close_toplevel(mut self, w.id.index)
    }
}

// -------------------------------------------------------------- popups

pub fn Server.popup_surface(self, p: ids.Popup) -> ids.Surface {
    guard self.popups.live(p.id) else {
        return ids.Surface { id: ids.Id {} }
    }
    return ids.Surface { id: self.surfaces.id(self.popups.items[int(p.id.index)].surface) }
}

/// The surface a popup is placed relative to.
pub fn Server.popup_parent(self, p: ids.Popup) -> Option[ids.Surface] {
    guard self.popups.live(p.id) else {
        return None
    }
    let ps = self.popups.items[int(p.id.index)].parent
    return if ps == state.none or not self.surfaces.used(int(ps)) { None } else { Some(ids.Surface { id: self.surfaces.id(ps) }) }
}

/// Position (relative to the parent's window geometry) and size.
pub fn Server.popup_geometry(self, p: ids.Popup) -> ids.Rect {
    guard self.popups.live(p.id) else {
        return ids.Rect {}
    }
    return self.popups.items[int(p.id.index)].geometry
}

/// Configure a popup kept inside `bounds` (relative to the parent's window
/// geometry; empty for none); its geometry.
pub fn Server.configure_popup(mut self, p: ids.Popup, bounds: ids.Rect) -> ids.Rect {
    guard self.popups.live(p.id) else {
        return ids.Rect {}
    }
    return xdg.configure_popup(mut self, p.id.index, bounds)
}

/// Dismiss a popup (xdg_popup.popup_done).
pub fn Server.dismiss(mut self, p: ids.Popup) {
    if self.popups.live(p.id) {
        xdg.popup_done(mut self, p.id.index)
    }
}

/// The popup a surface is the role of.
pub fn Server.popup_of(self, s: ids.Surface) -> Option[ids.Popup] {
    guard self.surfaces.live(s.id) else {
        return None
    }
    return match self.surfaces.items[int(s.id.index)].role {
        Popup(p) => Some(ids.Popup { id: self.popups.id(p) })
        _ => None
    }
}

// ------------------------------------------------------------- outputs

pub fn Server.add_output(mut self, take info: state.OutputInfo) -> ids.Output {
    return output.add(mut self, info)
}

pub fn Server.update_output(mut self, o: ids.Output, take info: state.OutputInfo) {
    if self.outputs.live(o.id) {
        output.update(mut self, o.id.index, info)
    }
}

pub fn Server.remove_output(mut self, o: ids.Output) {
    if self.outputs.live(o.id) {
        output.remove(mut self, o.id.index)
    }
}

// --------------------------------------------------------------- seats

pub fn Server.add_seat(mut self, take name: str) -> ids.Seat {
    return seat.add(mut self, name)
}

/// Pointer 1, keyboard 2, touch 4.
pub fn Server.set_capabilities(mut self, s: ids.Seat, caps: u32) {
    if self.seats.live(s.id) {
        seat.set_caps(mut self, s.id.index, caps)
    }
}

/// Keymap text in a sealed memfd (`fd` is taken) of `size` bytes.
pub fn Server.set_keymap(mut self, s: ids.Seat, fd: int, size: u32) {
    if self.seats.live(s.id) {
        seat.set_keymap(mut self, s.id.index, fd, size)
    }
}

pub fn Server.set_repeat(mut self, s: ids.Seat, rate: i32, delay: i32) {
    if self.seats.live(s.id) {
        seat.set_repeat(mut self, s.id.index, rate, delay)
    }
}

fn Server.slot_of(self, s: Option[ids.Surface]) -> u32 {
    guard let Some(x) = s else {
        return state.none
    }
    return if self.surfaces.live(x.id) { x.id.index } else { state.none }
}

pub fn Server.keyboard_focus(mut self, s: ids.Seat, target: Option[ids.Surface]) {
    if self.seats.live(s.id) {
        let slot = self.slot_of(target)
        seat.keyboard_focus(mut self, s.id.index, slot)
    }
}

pub fn Server.keyboard_focused(self, s: ids.Seat) -> Option[ids.Surface] {
    guard self.seats.live(s.id) else {
        return None
    }
    let f = self.seats.items[int(s.id.index)].kb_focus
    return if f == state.none or not self.surfaces.used(int(f)) { None } else { Some(ids.Surface { id: self.surfaces.id(f) }) }
}

/// A key (evdev code) to the keyboard focus; its serial.
pub fn Server.key(mut self, s: ids.Seat, time_ms: u32, code: u32, pressed: bool) -> u32 {
    guard self.seats.live(s.id) else {
        return 0
    }
    return seat.key(mut self, s.id.index, time_ms, code, pressed)
}

pub fn Server.modifiers(mut self, s: ids.Seat, depressed: u32, latched: u32, locked: u32, group: u32) {
    if self.seats.live(s.id) {
        seat.modifiers(mut self, s.id.index, depressed, latched, locked, group)
    }
}

/// The pointer is over `target` at surface-local `x, y` (None: no client).
pub fn Server.pointer_focus(mut self, s: ids.Seat, target: Option[ids.Surface], x: f64, y: f64) {
    if self.seats.live(s.id) {
        let slot = self.slot_of(target)
        seat.pointer_focus(mut self, s.id.index, slot, x, y)
    }
}

pub fn Server.pointer_focused(self, s: ids.Seat) -> Option[ids.Surface] {
    guard self.seats.live(s.id) else {
        return None
    }
    let f = self.seats.items[int(s.id.index)].ptr_focus
    return if f == state.none or not self.surfaces.used(int(f)) { None } else { Some(ids.Surface { id: self.surfaces.id(f) }) }
}

pub fn Server.pointer_motion(mut self, s: ids.Seat, time_ms: u32, x: f64, y: f64) {
    if self.seats.live(s.id) {
        seat.pointer_motion(mut self, s.id.index, time_ms, x, y)
    }
}

pub fn Server.pointer_button(mut self, s: ids.Seat, time_ms: u32, button: u32, pressed: bool) -> u32 {
    guard self.seats.live(s.id) else {
        return 0
    }
    return seat.pointer_button(mut self, s.id.index, time_ms, button, pressed)
}

/// Scroll: `dx, dy` in surface pixels, wheel clicks in 120ths, source as
/// wl_pointer.axis_source; all zero ends a finger scroll.
pub fn Server.pointer_axis(mut self, s: ids.Seat, time_ms: u32, source: u32, dx: f64, dy: f64, v120x: i32, v120y: i32, inverted: bool) {
    if self.seats.live(s.id) {
        seat.pointer_axis(mut self, s.id.index, time_ms, source, dx, dy, v120x, v120y, inverted)
    }
}

pub fn Server.touch_down(mut self, s: ids.Seat, target: ids.Surface, time_ms: u32, id: i32, x: f64, y: f64) -> u32 {
    guard self.seats.live(s.id) and self.surfaces.live(target.id) else {
        return 0
    }
    return seat.touch_down(mut self, s.id.index, target.id.index, time_ms, id, x, y)
}

pub fn Server.touch_motion(mut self, s: ids.Seat, time_ms: u32, id: i32, x: f64, y: f64) {
    if self.seats.live(s.id) {
        seat.touch_motion(mut self, s.id.index, time_ms, id, x, y)
    }
}

pub fn Server.touch_up(mut self, s: ids.Seat, time_ms: u32, id: i32) -> u32 {
    guard self.seats.live(s.id) else {
        return 0
    }
    return seat.touch_up(mut self, s.id.index, time_ms, id)
}

/// The surface touch point `id` went down on.
pub fn Server.touch_target(self, s: ids.Seat, id: i32) -> Option[ids.Surface] {
    guard self.seats.live(s.id) else {
        return None
    }
    let t = seat.touch_surface(self, s.id.index, id)
    return if t == state.none or not self.surfaces.used(int(t)) { None } else { Some(ids.Surface { id: self.surfaces.id(t) }) }
}

pub fn Server.touch_frame(mut self, s: ids.Seat) {
    if self.seats.live(s.id) {
        seat.touch_frame(mut self, s.id.index, false)
    }
}

pub fn Server.touch_cancel(mut self, s: ids.Seat) {
    if self.seats.live(s.id) {
        seat.touch_frame(mut self, s.id.index, true)
    }
}

// ---------------------------------------------------------- toplevels

/// The decoration mode the client wants: 0 no preference (or no
/// decoration object), 1 client side, 2 server side.
pub fn Server.decoration(self, w: ids.Window) -> u32 {
    guard self.windows.live(w.id) and self.windows.items[int(w.id.index)].decoration != 0 else {
        return 0
    }
    return self.windows.items[int(w.id.index)].deco_wanted
}

/// Who draws the title bar from the next configure on: the compositor
/// (`server_side`) or the client.
pub fn Server.set_decoration(mut self, w: ids.Window, server_side: bool) {
    if self.windows.live(w.id) {
        self.windows.items[int(w.id.index)].deco_mode = if server_side { 2 } else { 1 }
    }
}

pub fn Server.icon(self, w: ids.Window) -> state.Icon {
    guard self.windows.live(w.id) else {
        return state.Icon {}
    }
    return self.windows.items[int(w.id.index)].icon.clone()
}

/// xdg-toplevel-tag: a name for the window that stays across restarts,
/// and a description of it.
pub fn Server.tag(self, w: ids.Window) -> (str, str) {
    guard self.windows.live(w.id) else {
        return ("", "")
    }
    let i = int(w.id.index)
    return (self.windows.items[i].tag.clone(), self.windows.items[i].description.clone())
}

/// xdg-dialog: the window is modal to its parent.
pub fn Server.modal(self, w: ids.Window) -> bool {
    return self.windows.live(w.id) and self.windows.items[int(w.id.index)].modal
}

/// An activation token for a program the compositor starts
/// (XDG_ACTIVATION_TOKEN): its first window may take focus.
pub fn Server.activation_token(mut self) -> str {
    return toplevel.new_token(mut self, state.none)
}

// ------------------------------------------------------------- layers

pub struct LayerInfo {
    pub surface: ids.Surface = ids.Surface { id: ids.Id {} }
    /// The output it asked for (None: the compositor picks).
    pub output: Option[ids.Output] = None
    pub namespace: str = ""
    pub state: state.LayerState = state.LayerState {}
    pub mapped: bool = false
    /// The size last configured.
    pub width: i32 = 0
    pub height: i32 = 0
}

pub fn Server.layers(self) -> List[ids.Layer] {
    var out: List[ids.Layer] = []
    for k in 0..self.layers.items.len() {
        if self.layers.used(k) {
            out.push(ids.Layer { id: self.layers.id(u32(k)) })
        }
    }
    return out
}

pub fn Server.layer(self, l: ids.Layer) -> LayerInfo {
    guard self.layers.live(l.id) else {
        return LayerInfo {}
    }
    let i = int(l.id.index)
    let o = self.layers.items[i].output
    return LayerInfo {
        surface: ids.Surface { id: self.surfaces.id(self.layers.items[i].surface) },
        output: if o != state.none and self.outputs.used(int(o)) { Some(ids.Output { id: self.outputs.id(o) }) } else { None },
        namespace: self.layers.items[i].namespace.clone(),
        state: self.layers.items[i].current,
        mapped: self.layers.items[i].mapped,
        width: self.layers.items[i].width,
        height: self.layers.items[i].height,
    }
}

pub fn Server.layer_of(self, s: ids.Surface) -> Option[ids.Layer] {
    guard self.surfaces.live(s.id) else {
        return None
    }
    return match self.surfaces.items[int(s.id.index)].role {
        Layer(l) => Some(ids.Layer { id: self.layers.id(l) })
        _ => None
    }
}

/// Configure a layer surface to this size; the serial.
pub fn Server.configure_layer(mut self, l: ids.Layer, width: i32, height: i32) -> u32 {
    guard self.layers.live(l.id) else {
        return 0
    }
    return shell.configure_layer(mut self, l.id.index, width, height)
}

/// The layer surface will not be shown (its output went away).
pub fn Server.close_layer(mut self, l: ids.Layer) {
    if self.layers.live(l.id) {
        shell.close_layer(mut self, l.id.index)
    }
}

// --------------------------------------------------------------- lock

pub fn Server.lock_surfaces(self) -> List[ids.LockSurface] {
    var out: List[ids.LockSurface] = []
    for k in 0..self.lock_surfaces.items.len() {
        if self.lock_surfaces.used(k) {
            out.push(ids.LockSurface { id: self.lock_surfaces.id(u32(k)) })
        }
    }
    return out
}

/// A lock surface: its surface, output and whether it is mapped.
pub fn Server.lock_surface(self, k: ids.LockSurface) -> (ids.Surface, Option[ids.Output], bool) {
    guard self.lock_surfaces.live(k.id) else {
        return (ids.Surface { id: ids.Id {} }, None, false)
    }
    let i = int(k.id.index)
    let o = self.lock_surfaces.items[i].output
    let out = if o != state.none and self.outputs.used(int(o)) { Some(ids.Output { id: self.outputs.id(o) }) } else { None }
    return (ids.Surface { id: self.surfaces.id(self.lock_surfaces.items[i].surface) }, out, self.lock_surfaces.items[i].mapped)
}

pub fn Server.configure_lock(mut self, k: ids.LockSurface, width: i32, height: i32) -> u32 {
    guard self.lock_surfaces.live(k.id) else {
        return 0
    }
    return shell.configure_lock(mut self, k.id.index, width, height)
}

/// Every output shows the lock (or nothing): the locker hears `locked`.
pub fn Server.lock_done(mut self) {
    shell.lock_done(mut self)
}

// ------------------------------------------------------------ pointer

/// A pointer lock or confinement of a surface.
pub struct Constraint {
    /// A lock (the pointer stays put), else a confinement.
    pub lock: bool = true
    /// Surface coordinates; None is the whole surface.
    pub region: Option[List[ids.Rect]] = None
    pub active: bool = false
    /// Where the client says the cursor is when a lock ends.
    pub hint: Option[(f64, f64)] = None
}

pub fn Server.constraint(self, st: ids.Seat, s: ids.Surface) -> Option[Constraint] {
    guard self.seats.live(st.id) and self.surfaces.live(s.id) else {
        return None
    }
    let k = pointer.constraint_of(self, s.id.index, st.id.index)
    guard k != state.none else {
        return None
    }
    let i = int(k)
    let hint = if self.constraints.items[i].hint_set { Some((self.constraints.items[i].hint_x, self.constraints.items[i].hint_y)) } else { None }
    return Some(Constraint { lock: self.constraints.items[i].lock, region: self.constraints.items[i].region.clone(), active: self.constraints.items[i].active, hint })
}

/// Turn the constraint of `s` on (the pointer is inside its region and
/// the surface has focus) or off.
pub fn Server.set_constraint(mut self, st: ids.Seat, s: ids.Surface, on: bool) {
    guard self.seats.live(st.id) and self.surfaces.live(s.id) else {
        return
    }
    let k = pointer.constraint_of(self, s.id.index, st.id.index)
    if k != state.none {
        pointer.activate(mut self, k, on)
    }
}

/// Unaccelerated and accelerated motion for zwp_relative_pointer
/// (microsecond timestamp).
pub fn Server.relative_motion(mut self, st: ids.Seat, time_us: u64, dx: f64, dy: f64, raw_dx: f64, raw_dy: f64) {
    if self.seats.live(st.id) {
        pointer.relative_motion(mut self, st.id.index, time_us, dx, dy, raw_dx, raw_dy)
    }
}

/// A touchpad gesture to the client under the pointer: `kind` swipe 0,
/// pinch 1, hold 2; `phase` begin 0, update 1, end 2.
pub fn Server.gesture(mut self, st: ids.Seat, kind: int, phase: int, time_ms: u32, fingers: u32, dx: f64, dy: f64, scale: f64, rotation: f64, cancelled: bool) {
    if self.seats.live(st.id) {
        pointer.gesture(mut self, st.id.index, kind, phase, time_ms, fingers, dx, dy, scale, rotation, cancelled)
    }
}

// ---------------------------------------------------------------- ime

/// The focused text field with an input method on it: its surface and
/// cursor rectangle (surface coordinates).
pub fn Server.text_cursor(self, st: ids.Seat) -> Option[(ids.Surface, ids.Rect)] {
    guard self.seats.live(st.id) else {
        return None
    }
    let k = self.seats.items[int(st.id.index)].im_active
    guard k != state.none and self.text_inputs.used(int(k)) else {
        return None
    }
    let f = self.text_inputs.items[int(k)].focus
    guard f != state.none and self.surfaces.used(int(f)) else {
        return None
    }
    return Some((ids.Surface { id: self.surfaces.id(f) }, self.text_inputs.items[int(k)].current.rect))
}

/// The input method's mapped popups (candidate lists).
pub fn Server.ime_popups(self, st: ids.Seat) -> List[ids.Surface] {
    var out: List[ids.Surface] = []
    guard self.seats.live(st.id) else {
        return out
    }
    for (_, _, ps) in self.seats.items[int(st.id.index)].im_popups {
        if self.surfaces.used(int(ps)) and self.surfaces.items[int(ps)].mapped {
            out.push(ids.Surface { id: self.surfaces.id(ps) })
        }
    }
    return out
}

// --------------------------------------------------------------- idle

/// The seat saw input at `now` (CLOCK_MONOTONIC ns).
pub fn Server.input_activity(mut self, now: int) {
    inhibit.activity(mut self, now)
}

/// Send the idle notifications that are due; the next deadline (0:
/// none, -1: some wait for the inhibitors to go). While `inhibited` only
/// input-idle notifications fire.
pub fn Server.idle_check(mut self, now: int, inhibited: bool) -> int {
    return inhibit.check(mut self, now, inhibited)
}

/// Surfaces whose clients want the screen kept on while they show.
pub fn Server.idle_inhibitors(self) -> List[ids.Surface] {
    var out: List[ids.Surface] = []
    for (_, _, si) in self.idle_inhibitors {
        if self.surfaces.used(int(si)) {
            out.push(ids.Surface { id: self.surfaces.id(si) })
        }
    }
    return out
}

/// The keyboard focus asked for the compositor's shortcuts (remote
/// desktop, VM): bindings should let keys through.
pub fn Server.shortcuts_inhibited(self, st: ids.Seat) -> bool {
    guard self.seats.live(st.id) else {
        return false
    }
    let f = self.seats.items[int(st.id.index)].kb_focus
    return f != state.none and self.shortcut_inhibitors.any(fn(x) => x.2 == f and x.4)
}

// --------------------------------------------------------------- drag

pub fn Server.dragging(self, st: ids.Seat) -> bool {
    return self.seats.live(st.id) and self.seats.items[int(st.id.index)].drag.active
}

/// The image a drag shows under the pointer.
pub fn Server.drag_icon(self, st: ids.Seat) -> Option[ids.Surface] {
    guard self.dragging(st) else {
        return None
    }
    let ic = self.seats.items[int(st.id.index)].drag.icon
    return if ic == state.none or not self.surfaces.used(int(ic)) { None } else { Some(ids.Surface { id: self.surfaces.id(ic) }) }
}

// ------------------------------------------------------------ capture

/// Whether a screen capture waits for the output's next image.
pub fn Server.capture_waiting(self, o: ids.Output) -> bool {
    return self.outputs.live(o.id) and capture.waiting(self, o.id.index)
}

/// What the output shows (BGRA8, rows packed), shown at `ns`
/// (CLOCK_MONOTONIC): the waiting captures get it.
pub fn Server.capture(mut self, o: ids.Output, pixels: &[u8], width: i32, height: i32, ns: int) {
    if self.outputs.live(o.id) {
        capture.deliver(mut self, o.id.index, pixels, width, height, ns)
    }
}

// ------------------------------------------------- output configuration

/// What a configuration asks of each output.
pub fn Server.output_config(self, c: ids.OutputConfig) -> List[state.HeadConfig] {
    guard self.configs.live(c.id) else {
        return []
    }
    return self.configs.items[int(c.id.index)].heads.clone()
}

/// The configuration was applied (or would apply, for a test): `ok`, or
/// it failed and nothing changed.
pub fn Server.output_config_done(mut self, c: ids.OutputConfig, ok: bool) {
    if self.configs.live(c.id) {
        outman.config_done(mut self, c.id.index, ok)
    }
}

/// The XCursor name of a wp_cursor_shape shape.
pub fn cursor_name(shape: u32) -> str {
    return pointer.shape_name(shape)
}
