// Selections, per seat: the clipboard (wl_data_device_manager), the
// primary selection (middle-click paste) and ext-data-control (clipboard
// managers, which see and set both from any client). A source client
// offers MIME types; the focused client (and every data-control client)
// gets an offer and asks for one type with a pipe, which goes straight to
// the source. The data never passes through the compositor. Drag and drop
// moves an offer with the pointer: the surface under it gets enter, motion
// and drop instead of pointer events, and source and target settle on an
// action (copy, move, ask) the way they prefer.

import luminaria_wire as wire
import luminaria_proto.wayland as wl
import luminaria_proto.primary_selection_unstable as ps
import luminaria_proto.ext_data_control as dc
import luminaria_proto.xdg_toplevel_drag as td
import ids
import state
import server
import seat

// ----------------------------------------------------------- clipboard

fn manager(mut srv: server.Server, ci: u32, take req: wl.DataDeviceManagerRequest) {
    match req {
        CreateDataSource(src) => add_source(mut srv, ci, src.id, state.DataKind.Data)
        GetDataDevice(dev, st) => add_device(mut srv, ci, dev.id, st.id, state.DataKind.Data)
        Release => {}
    }
}

fn source(mut srv: server.Server, ci: u32, src: wl.DataSource, take req: wl.DataSourceRequest) {
    match take req {
        Offer(mime) => offer_mime(mut srv, ci, src.id, mime)
        Destroy => drop_source(mut srv, ci, src.id)
        SetActions(a) => {
            let si = srv.slot(ci, src.id)
            guard si != state.none else {
                return
            }
            guard u32(a) & ~u32(7) == 0 else {
                srv.fail(ci, src.id, u32(wl.DataSourceError.InvalidActionMask), "dnd actions {u32(a)}")
                return
            }
            srv.sources.items[int(si)].actions = u32(a)
        }
    }
}

fn device(mut srv: server.Server, ci: u32, dev: wl.DataDevice, take req: wl.DataDeviceRequest) {
    let si = srv.slot(ci, dev.id)
    guard si != state.none else {
        return
    }
    match req {
        StartDrag(src, origin, icon, serial) => {
            let sid = match src {
                Some(x) => x.id
                None => 0
            }
            let iid = match icon {
                Some(x) => x.id
                None => 0
            }
            start_drag(mut srv, ci, si, dev.id, sid, origin.id, iid)
        }
        SetSelection(src, serial) => {
            let slot = source_slot(srv, ci, match src {
                Some(s) => s.id
                None => 0
            })
            set_selection(mut srv, si, slot, false)
        }
        Release => drop_device(mut srv, ci, dev.id)
    }
}

fn offer(mut srv: server.Server, ci: u32, o: wl.DataOffer, take req: wl.DataOfferRequest) {
    match take req {
        Receive(mime, f) => receive(mut srv, ci, o.id, mime, f)
        Destroy => drop_offer(mut srv, ci, o.id)
        Accept(serial, mime) => drag_accept(mut srv, ci, o.id, mime)
        SetActions(actions, preferred) => drag_actions(mut srv, ci, o.id, u32(actions), u32(preferred))
        Finish => {
            let oi = srv.slot(ci, o.id)
            guard oi != state.none and srv.offers.items[int(oi)].dnd else {
                return
            }
            let src = srv.offers.items[int(oi)].source
            if src != state.none and srv.sources.used(int(src)) {
                let sc = int(srv.sources.items[int(src)].client)
                wl.DataSource { id: srv.sources.items[int(src)].obj }.dnd_finished(mut srv.conns[sc])
            }
        }
    }
}

// ----------------------------------------------------------- primary

fn primary_manager(mut srv: server.Server, ci: u32, take req: ps.DeviceManagerRequest) {
    match req {
        CreateSource(src) => add_source(mut srv, ci, src.id, state.DataKind.Primary)
        GetDevice(dev, st) => add_device(mut srv, ci, dev.id, st.id, state.DataKind.Primary)
        Destroy => {}
    }
}

fn primary_device(mut srv: server.Server, ci: u32, dev: ps.Device, take req: ps.DeviceRequest) {
    let si = srv.slot(ci, dev.id)
    guard si != state.none else {
        return
    }
    match req {
        SetSelection(src, serial) => {
            let slot = source_slot(srv, ci, match src {
                Some(s) => s.id
                None => 0
            })
            set_selection(mut srv, si, slot, true)
        }
        Destroy => drop_device(mut srv, ci, dev.id)
    }
}

fn primary_source(mut srv: server.Server, ci: u32, src: ps.Source, take req: ps.SourceRequest) {
    match take req {
        Offer(mime) => offer_mime(mut srv, ci, src.id, mime)
        Destroy => drop_source(mut srv, ci, src.id)
    }
}

fn primary_offer(mut srv: server.Server, ci: u32, o: ps.Offer, take req: ps.OfferRequest) {
    match take req {
        Receive(mime, f) => receive(mut srv, ci, o.id, mime, f)
        Destroy => drop_offer(mut srv, ci, o.id)
    }
}

// ------------------------------------------------------- data control

fn control_manager(mut srv: server.Server, ci: u32, take req: dc.ManagerRequest) {
    match req {
        CreateDataSource(src) => add_source(mut srv, ci, src.id, state.DataKind.Control)
        GetDataDevice(dev, st) => add_device(mut srv, ci, dev.id, st.id, state.DataKind.Control)
        Destroy => {}
    }
}

fn control_device(mut srv: server.Server, ci: u32, dev: dc.Device, take req: dc.DeviceRequest) {
    let si = srv.slot(ci, dev.id)
    guard si != state.none else {
        return
    }
    match req {
        SetSelection(src) => {
            let slot = source_slot(srv, ci, match src {
                Some(s) => s.id
                None => 0
            })
            set_selection(mut srv, si, slot, false)
        }
        SetPrimarySelection(src) => {
            let slot = source_slot(srv, ci, match src {
                Some(s) => s.id
                None => 0
            })
            set_selection(mut srv, si, slot, true)
        }
        Destroy => drop_device(mut srv, ci, dev.id)
    }
}

fn control_source(mut srv: server.Server, ci: u32, src: dc.Source, take req: dc.SourceRequest) {
    match take req {
        Offer(mime) => offer_mime(mut srv, ci, src.id, mime)
        Destroy => drop_source(mut srv, ci, src.id)
    }
}

fn control_offer(mut srv: server.Server, ci: u32, o: dc.Offer, take req: dc.OfferRequest) {
    match take req {
        Receive(mime, f) => receive(mut srv, ci, o.id, mime, f)
        Destroy => drop_offer(mut srv, ci, o.id)
    }
}

// ------------------------------------------------------------ shared

fn add_source(mut srv: server.Server, ci: u32, id: u32, kind: state.DataKind) {
    let s = srv.sources.add(state.SourceData { client: ci, obj: id, kind })
    srv.bind(ci, id, s.index)
}

fn source_slot(srv: server.Server, ci: u32, id: u32) -> u32 {
    guard id != 0 else {
        return state.none
    }
    return srv.slot(ci, id)
}

fn offer_mime(mut srv: server.Server, ci: u32, id: u32, take mime: str) {
    let si = srv.slot(ci, id)
    if si != state.none {
        srv.sources.items[int(si)].mimes.push(mime)
    }
}

fn drop_source(mut srv: server.Server, ci: u32, id: u32) {
    let si = srv.slot(ci, id)
    srv.unbind(ci, id)
    if si != state.none {
        destroy_source(mut srv, si)
    }
}

fn add_device(mut srv: server.Server, ci: u32, dev: u32, seat: u32, kind: state.DataKind) {
    let si = srv.slot(ci, seat)
    guard si != state.none else {
        return
    }
    let i = int(si)
    let r = state.Res { client: ci, id: dev, version: srv.conns[int(ci)].version(dev) }
    srv.bind(ci, dev, si)
    match kind {
        Data => srv.seats.items[i].devices.push(r)
        Primary => srv.seats.items[i].primary_devices.push(r)
        Control => {
            srv.seats.items[i].control_devices.push(r)
            send_offer(mut srv, si, r, kind, false)
            send_offer(mut srv, si, r, kind, true)
            return
        }
    }
    let f = srv.seats.items[i].kb_focus
    if f != state.none and srv.surfaces.used(int(f)) and srv.surfaces.items[int(f)].client == ci {
        send_offer(mut srv, si, r, kind, kind == state.DataKind.Primary)
    }
}

fn drop_device(mut srv: server.Server, ci: u32, dev: u32) {
    let si = srv.slot(ci, dev)
    srv.unbind(ci, dev)
    guard si != state.none else {
        return
    }
    let i = int(si)
    srv.seats.items[i].devices.retain(fn(r) => not (r.client == ci and r.id == dev))
    srv.seats.items[i].primary_devices.retain(fn(r) => not (r.client == ci and r.id == dev))
    srv.seats.items[i].control_devices.retain(fn(r) => not (r.client == ci and r.id == dev))
}

fn receive(mut srv: server.Server, ci: u32, id: u32, take mime: str, f: wire.Fd) {
    let oi = srv.slot(ci, id)
    guard oi != state.none else {
        return
    }
    let src = srv.offers.items[int(oi)].source
    guard src != state.none and srv.sources.used(int(src)) else {
        return
    }
    let sc = int(srv.sources.items[int(src)].client)
    let sobj = srv.sources.items[int(src)].obj
    match srv.sources.items[int(src)].kind {
        Data => wl.DataSource { id: sobj }.send(mut srv.conns[sc], mime, f.raw())
        Primary => ps.Source { id: sobj }.send(mut srv.conns[sc], mime, f.raw())
        Control => dc.Source { id: sobj }.send(mut srv.conns[sc], mime, f.raw())
    }
}

fn drop_offer(mut srv: server.Server, ci: u32, id: u32) {
    let oi = srv.slot(ci, id)
    srv.unbind(ci, id)
    if oi != state.none {
        srv.offers.remove(oi, state.OfferData {})
    }
}

fn cancel(mut srv: server.Server, src: u32) {
    guard src != state.none and srv.sources.used(int(src)) else {
        return
    }
    let c = int(srv.sources.items[int(src)].client)
    let obj = srv.sources.items[int(src)].obj
    match srv.sources.items[int(src)].kind {
        Data => wl.DataSource { id: obj }.cancelled(mut srv.conns[c])
        Primary => ps.Source { id: obj }.cancelled(mut srv.conns[c])
        Control => dc.Source { id: obj }.cancelled(mut srv.conns[c])
    }
}

/// The selection (or primary selection) of seat `si` is now `src`.
fn set_selection(mut srv: server.Server, si: u32, src: u32, primary: bool) {
    let i = int(si)
    let old = if primary { srv.seats.items[i].primary } else { srv.seats.items[i].selection }
    guard old != src else {
        return
    }
    cancel(mut srv, old)
    if primary {
        srv.seats.items[i].primary = src
    } else {
        srv.seats.items[i].selection = src
    }
    changed(mut srv, si, primary)
}

/// Offer the selection to the focused client and every data-control client.
fn changed(mut srv: server.Server, si: u32, primary: bool) {
    let i = int(si)
    for r in srv.seats.items[i].control_devices.clone() {
        send_offer(mut srv, si, r, state.DataKind.Control, primary)
    }
    let f = srv.seats.items[i].kb_focus
    guard f != state.none and srv.surfaces.used(int(f)) else {
        return
    }
    let fc = srv.surfaces.items[int(f)].client
    let devs = if primary { srv.seats.items[i].primary_devices.clone() } else { srv.seats.items[i].devices.clone() }
    let kind = if primary { state.DataKind.Primary } else { state.DataKind.Data }
    for r in devs {
        if r.client == fc {
            send_offer(mut srv, si, r, kind, primary)
        }
    }
}

/// Keyboard focus moved: the new client sees both selections.
fn focus_changed(mut srv: server.Server, si: u32) {
    let i = int(si)
    let f = srv.seats.items[i].kb_focus
    guard f != state.none and srv.surfaces.used(int(f)) else {
        return
    }
    let fc = srv.surfaces.items[int(f)].client
    for r in srv.seats.items[i].devices.clone() {
        if r.client == fc {
            send_offer(mut srv, si, r, state.DataKind.Data, false)
        }
    }
    for r in srv.seats.items[i].primary_devices.clone() {
        if r.client == fc {
            send_offer(mut srv, si, r, state.DataKind.Primary, true)
        }
    }
}

/// Send device `r` (of protocol `kind`) an offer of the selection.
fn send_offer(mut srv: server.Server, si: u32, r: state.Res, kind: state.DataKind, primary: bool) {
    let src = if primary { srv.seats.items[int(si)].primary } else { srv.seats.items[int(si)].selection }
    let c = int(r.client)
    let live = src != state.none and srv.sources.used(int(src))
    var oid: u32 = 0
    if live {
        oid = match kind {
            Data => wl.DataDevice { id: r.id }.data_offer(mut srv.conns[c]).id
            Primary => ps.Device { id: r.id }.data_offer(mut srv.conns[c]).id
            Control => dc.Device { id: r.id }.data_offer(mut srv.conns[c]).id
        }
        let o = srv.offers.add(state.OfferData { client: r.client, obj: oid, kind, source: src })
        srv.bind(r.client, oid, o.index)
        for mime in srv.sources.items[int(src)].mimes.clone() {
            match kind {
                Data => wl.DataOffer { id: oid }.offer(mut srv.conns[c], mime)
                Primary => ps.Offer { id: oid }.offer(mut srv.conns[c], mime)
                Control => dc.Offer { id: oid }.offer(mut srv.conns[c], mime)
            }
        }
    }
    match kind {
        Data => wl.DataDevice { id: r.id }.selection(mut srv.conns[c], if live { Some(wl.DataOffer { id: oid }) } else { None })
        Primary => ps.Device { id: r.id }.selection(mut srv.conns[c], if live { Some(ps.Offer { id: oid }) } else { None })
        Control => {
            let d = dc.Device { id: r.id }
            if primary {
                d.primary_selection(mut srv.conns[c], if live { Some(dc.Offer { id: oid }) } else { None })
            } else {
                d.selection(mut srv.conns[c], if live { Some(dc.Offer { id: oid }) } else { None })
            }
        }
    }
}

fn destroy_source(mut srv: server.Server, si: u32) {
    guard srv.sources.used(int(si)) else {
        return
    }
    srv.sources.remove(si, state.SourceData {})
    for i in 0..srv.seats.items.len() {
        guard srv.seats.used(i) else {
            continue
        }
        // Its drag ends where it is.
        if srv.seats.items[i].drag.active and srv.seats.items[i].drag.source == si {
            srv.seats.items[i].drag.source = state.none
            drag_leave(mut srv, u32(i), false)
            end_drag(mut srv, u32(i))
        }
        if srv.seats.items[i].selection == si {
            srv.seats.items[i].selection = state.none
            changed(mut srv, u32(i), false)
        }
        if srv.seats.items[i].primary == si {
            srv.seats.items[i].primary = state.none
            changed(mut srv, u32(i), true)
        }
    }
    for k in 0..srv.offers.items.len() {
        if srv.offers.used(k) and srv.offers.items[k].source == si {
            srv.offers.items[k].source = state.none
        }
    }
}

// ------------------------------------------------------------- drag

/// wl_data_device.start_drag: only from the surface under the pointer
/// while a button is held; otherwise the source is cancelled.
fn start_drag(mut srv: server.Server, ci: u32, si: u32, dev: u32, src: u32, origin: u32, icon: u32) {
    let i = int(si)
    let os = srv.slot(ci, origin)
    let ss = source_slot(srv, ci, src)
    guard not srv.seats.items[i].drag.active and os != state.none and srv.seats.items[i].ptr_focus == os and srv.seats.items[i].buttons > 0 else {
        cancel(mut srv, ss)
        return
    }
    var ic = state.none
    if icon != 0 {
        ic = srv.slot(ci, icon)
        if ic != state.none {
            let role = srv.surfaces.items[int(ic)].role
            guard role == state.Role.Plain or role == state.Role.DragIcon else {
                srv.fail(ci, dev, u32(wl.DataDeviceError.Role), "drag icon has another role")
                return
            }
            srv.surfaces.items[int(ic)].role = state.Role.DragIcon
        }
    }
    let x = srv.seats.items[i].ptr_x
    let y = srv.seats.items[i].ptr_y
    // The pointer leaves the origin; the drag enters it.
    seat.pointer_focus(mut srv, si, state.none, 0.0, 0.0)
    srv.seats.items[i].drag = state.DragData { active: true, source: ss, client: ci, icon: ic, x, y }
    drag_focus(mut srv, si, os, x, y)
    srv.push(server.Event.Drag(ids.Seat { id: srv.seats.id(si) }))
}

/// The pointer is over `surf` (`none`: no client) during a drag.
fn drag_focus(mut srv: server.Server, si: u32, surf: u32, x: f64, y: f64) {
    let i = int(si)
    srv.seats.items[i].drag.x = x
    srv.seats.items[i].drag.y = y
    srv.seats.items[i].drag.under = surf
    guard srv.seats.items[i].drag.focus != surf else {
        return
    }
    drag_leave(mut srv, si, true)
    guard surf != state.none and srv.surfaces.used(int(surf)) else {
        return
    }
    let fc = srv.surfaces.items[int(surf)].client
    let src = srv.seats.items[i].drag.source
    let live = src != state.none and srv.sources.used(int(src))
    // A drag without a source stays inside its client.
    guard live or (src == state.none and fc == srv.seats.items[i].drag.client) else {
        return
    }
    srv.seats.items[i].drag.focus = surf
    let serial = srv.next_serial()
    let obj = srv.surfaces.items[int(surf)].obj
    let c = int(fc)
    for r in srv.seats.items[i].devices.clone() {
        guard r.client == fc else {
            continue
        }
        var offer: Option[wl.DataOffer] = None
        if live {
            let oid = wl.DataDevice { id: r.id }.data_offer(mut srv.conns[c]).id
            let o = srv.offers.add(state.OfferData { client: fc, obj: oid, kind: state.DataKind.Data, source: src, dnd: true })
            srv.bind(fc, oid, o.index)
            for mime in srv.sources.items[int(src)].mimes.clone() {
                wl.DataOffer { id: oid }.offer(mut srv.conns[c], mime)
            }
            wl.DataOffer { id: oid }.source_actions(mut srv.conns[c], wl.DataDeviceManagerDndAction(srv.sources.items[int(src)].actions))
            srv.seats.items[i].drag.offer = o.index
            offer = Some(wl.DataOffer { id: oid })
        }
        wl.DataDevice { id: r.id }.enter(mut srv.conns[c], serial, wl.Surface { id: obj }, x, y, offer)
    }
}

/// The drag leaves the surface it is over; `reset` tells the source that
/// nothing accepts it now.
fn drag_leave(mut srv: server.Server, si: u32, reset: bool) {
    let i = int(si)
    let f = srv.seats.items[i].drag.focus
    srv.seats.items[i].drag.focus = state.none
    srv.seats.items[i].drag.offer = state.none
    guard f != state.none and srv.surfaces.used(int(f)) else {
        return
    }
    let fc = srv.surfaces.items[int(f)].client
    for r in srv.seats.items[i].devices.clone() {
        if r.client == fc {
            wl.DataDevice { id: r.id }.leave(mut srv.conns[int(fc)])
        }
    }
    let src = srv.seats.items[i].drag.source
    if reset and src != state.none and srv.sources.used(int(src)) {
        let sc = int(srv.sources.items[int(src)].client)
        let sobj = wl.DataSource { id: srv.sources.items[int(src)].obj }
        sobj.target(mut srv.conns[sc], None)
        if srv.sources.items[int(src)].action != 0 {
            srv.sources.items[int(src)].action = 0
            sobj.action(mut srv.conns[sc], wl.DataDeviceManagerDndAction.None)
        }
    }
}

fn drag_motion(mut srv: server.Server, si: u32, time: u32, x: f64, y: f64) {
    let i = int(si)
    srv.seats.items[i].drag.x = x
    srv.seats.items[i].drag.y = y
    let f = srv.seats.items[i].drag.focus
    guard f != state.none and srv.surfaces.used(int(f)) else {
        return
    }
    let fc = srv.surfaces.items[int(f)].client
    for r in srv.seats.items[i].devices.clone() {
        if r.client == fc {
            wl.DataDevice { id: r.id }.motion(mut srv.conns[int(fc)], time, x, y)
        }
    }
}

/// The last button went up: drop on a target that accepts, else cancel.
fn drop(mut srv: server.Server, si: u32) {
    let i = int(si)
    let d = srv.seats.items[i].drag
    let src = d.source
    let live = src != state.none and srv.sources.used(int(src))
    var ok = d.focus != state.none and srv.surfaces.used(int(d.focus))
    if live {
        let o = d.offer
        let accepted = o != state.none and srv.offers.used(int(o)) and srv.offers.items[int(o)].accepted
        let sc = srv.sources.items[int(src)].client
        let old = srv.conns[int(sc)].version(srv.sources.items[int(src)].obj) < 3
        ok = ok and accepted and (old or srv.sources.items[int(src)].action != 0)
    }
    if ok {
        let fc = srv.surfaces.items[int(d.focus)].client
        for r in srv.seats.items[i].devices.clone() {
            if r.client == fc {
                wl.DataDevice { id: r.id }.drop_(mut srv.conns[int(fc)])
            }
        }
        if live {
            let sc = int(srv.sources.items[int(src)].client)
            wl.DataSource { id: srv.sources.items[int(src)].obj }.dnd_drop_performed(mut srv.conns[sc])
        }
    }
    drag_leave(mut srv, si, false)
    if not ok {
        cancel(mut srv, src)
    }
    end_drag(mut srv, si)
}

/// The drag is over: the pointer enters what it is over again.
fn end_drag(mut srv: server.Server, si: u32) {
    let i = int(si)
    let d = srv.seats.items[i].drag
    srv.seats.items[i].drag = state.DragData {}
    srv.push(server.Event.Drag(ids.Seat { id: srv.seats.id(si) }))
    if d.under != state.none and srv.surfaces.used(int(d.under)) {
        seat.pointer_focus(mut srv, si, d.under, d.x, d.y)
    }
}

fn drag_accept(mut srv: server.Server, ci: u32, id: u32, mime: Option[str]) {
    let oi = srv.slot(ci, id)
    guard oi != state.none and srv.offers.items[int(oi)].dnd else {
        return
    }
    srv.offers.items[int(oi)].accepted = mime.is_some()
    let src = srv.offers.items[int(oi)].source
    guard src != state.none and srv.sources.used(int(src)) else {
        return
    }
    let sc = int(srv.sources.items[int(src)].client)
    let sobj = wl.DataSource { id: srv.sources.items[int(src)].obj }
    match mime {
        Some(m) => sobj.target(mut srv.conns[sc], Some(m))
        None => sobj.target(mut srv.conns[sc], None)
    }
}

/// The target's actions: pick its preferred one when the source offers
/// it, else copy, move, ask in that order; both hear the choice.
fn drag_actions(mut srv: server.Server, ci: u32, id: u32, actions: u32, preferred: u32) {
    let oi = srv.slot(ci, id)
    guard oi != state.none and srv.offers.items[int(oi)].dnd else {
        return
    }
    guard actions & ~u32(7) == 0 else {
        srv.fail(ci, id, u32(wl.DataOfferError.InvalidActionMask), "dnd actions {actions}")
        return
    }
    guard preferred == 0 or preferred == 1 or preferred == 2 or preferred == 4 else {
        srv.fail(ci, id, u32(wl.DataOfferError.InvalidAction), "preferred action {preferred}")
        return
    }
    srv.offers.items[int(oi)].actions = actions
    srv.offers.items[int(oi)].preferred = preferred
    let src = srv.offers.items[int(oi)].source
    guard src != state.none and srv.sources.used(int(src)) else {
        return
    }
    let common = actions & srv.sources.items[int(src)].actions
    var a: u32 = 0
    if common & preferred != 0 {
        a = preferred
    } else {
        for bit in [u32(1), u32(2), u32(4)] {
            if common & bit != 0 {
                a = bit
                break
            }
        }
    }
    wl.DataOffer { id }.action(mut srv.conns[int(ci)], wl.DataDeviceManagerDndAction(a))
    if srv.sources.items[int(src)].action != a {
        srv.sources.items[int(src)].action = a
        let sc = int(srv.sources.items[int(src)].client)
        wl.DataSource { id: srv.sources.items[int(src)].obj }.action(mut srv.conns[sc], wl.DataDeviceManagerDndAction(a))
    }
}

// ---------------------------------------------------- toplevel drag

fn toplevel_drag_manager(mut srv: server.Server, ci: u32, m: td.DragManager, take req: td.DragManagerRequest) {
    match req {
        GetXdgToplevelDrag(d, src) => {
            let ss = source_slot(srv, ci, src.id)
            guard ss != state.none and srv.sources.items[int(ss)].kind == state.DataKind.Data else {
                return
            }
            guard srv.sources.items[int(ss)].tdrag == 0 else {
                srv.fail(ci, m.id, u32(td.DragManagerError.InvalidSource), "the data source has a toplevel drag")
                return
            }
            srv.sources.items[int(ss)].tdrag = d.id
            srv.bind(ci, d.id, ss)
        }
        Destroy => {}
    }
}

/// The seat whose drag uses source `ss`, or none.
fn drag_seat(srv: server.Server, ss: u32) -> u32 {
    for i in 0..srv.seats.items.len() {
        if srv.seats.used(i) and srv.seats.items[i].drag.active and srv.seats.items[i].drag.source == ss {
            return u32(i)
        }
    }
    return state.none
}

/// The window the drag of source `ss` carries changed: its seat hears.
fn drag_window_changed(mut srv: server.Server, ss: u32) {
    let si = drag_seat(srv, ss)
    if si != state.none {
        srv.push(server.Event.Drag(ids.Seat { id: srv.seats.id(si) }))
    }
}

fn toplevel_drag(mut srv: server.Server, ci: u32, d: td.Drag, take req: td.DragRequest) {
    let ss = srv.slot(ci, d.id)
    let live = ss != state.none and srv.sources.used(int(ss)) and srv.sources.items[int(ss)].tdrag == d.id
    match req {
        Attach(t, x, y) => {
            guard live else {
                return
            }
            let wi = srv.slot(ci, t.id)
            guard wi != state.none and srv.windows.used(int(wi)) else {
                return
            }
            let cur = srv.sources.items[int(ss)].tdrag_win
            guard cur == wi or cur == state.none or not srv.windows.used(int(cur)) or not srv.windows.items[int(cur)].mapped else {
                srv.fail(ci, d.id, u32(td.DragError.ToplevelAttached), "a mapped toplevel is attached")
                return
            }
            srv.sources.items[int(ss)].tdrag_win = wi
            srv.sources.items[int(ss)].tdrag_x = ids.clamp(x)
            srv.sources.items[int(ss)].tdrag_y = ids.clamp(y)
            drag_window_changed(mut srv, ss)
        }
        Destroy => {
            if live {
                guard drag_seat(srv, ss) == state.none else {
                    srv.fail(ci, d.id, u32(td.DragError.OngoingDrag), "the drag has not ended")
                    return
                }
                srv.sources.items[int(ss)].tdrag = 0
                srv.sources.items[int(ss)].tdrag_win = state.none
            }
            srv.unbind(ci, d.id)
        }
    }
}

/// Window `wi` was mapped (true) or unmapped or destroyed (false): a drag
/// carrying it starts showing it, or lets go of it.
fn toplevel_mapped(mut srv: server.Server, wi: u32, mapped: bool) {
    for k in 0..srv.sources.items.len() {
        guard srv.sources.used(k) and srv.sources.items[k].tdrag_win == wi else {
            continue
        }
        if not mapped {
            srv.sources.items[k].tdrag_win = state.none
        }
        drag_window_changed(mut srv, u32(k))
    }
}

/// Teardown of a toplevel drag object.
fn toplevel_drag_destroyed(mut srv: server.Server, slot: u32, id: u32) {
    if srv.sources.used(int(slot)) and srv.sources.items[int(slot)].tdrag == id {
        srv.sources.items[int(slot)].tdrag = 0
        srv.sources.items[int(slot)].tdrag_win = state.none
    }
}
