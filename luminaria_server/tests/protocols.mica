// The desktop protocols against the generated client API through a real
// socket: layer surfaces, the session lock, selections for clipboard
// managers, input methods, decorations and activation, the toplevel
// list, pointer constraints and relative motion, idle notification,
// single-pixel buffers, drag and drop, screen capture, sandboxes,
// output configuration and a keymap shorter than it claims.

import std.env
import std.fs
import std.net
import std.os
import luminaria_wire as wire
import luminaria_proto as proto
import luminaria_proto.wayland as wl
import luminaria_proto.xdg_shell as xdg
import luminaria_proto.wlr_layer_shell_unstable as ls
import luminaria_proto.ext_session_lock as sl
import luminaria_proto.primary_selection_unstable as ps
import luminaria_proto.ext_data_control as dc
import luminaria_proto.text_input_unstable as ti
import luminaria_proto.input_method_unstable as im
import luminaria_proto.xdg_decoration_unstable as xd
import luminaria_proto.xdg_activation as act
import luminaria_proto.ext_foreign_toplevel_list as ftl
import luminaria_proto.pointer_constraints_unstable as pc
import luminaria_proto.relative_pointer_unstable as rp
import luminaria_proto.ext_idle_notify as idle
import luminaria_proto.single_pixel_buffer as spb
import luminaria_proto.ext_image_capture_source as ics
import luminaria_proto.ext_image_copy_capture as icc
import luminaria_proto.security_context as sctx
import luminaria_proto.wlr_output_management_unstable as wom
import luminaria_proto.virtual_keyboard_unstable as vkb
import luminaria_proto.linux_dmabuf as dmab
import luminaria_server as server

struct Fx {
    srv: server.Server
    c: wire.Conn
    client: server.Client
    reg: wl.Registry = wl.Registry { id: 0 }
    globals: List[(u32, u16)] = []
}

fn setup() -> Fx {
    let dir = fs.create_temp_dir("luminaria-protocols").expect("temp dir")
    discard env.set("XDG_RUNTIME_DIR", dir)
    var srv = server.Server.open("").expect("listen")
    let c = wire.connect(srv.name()).expect("connect")
    for _ in 0..100 {
        if let Ok(Some((client, _))) = srv.accept() {
            return Fx { srv, c, client }
        }
    }
    panic("accept")
}

fn pump(mut f: Fx) -> List[proto.Event] {
    discard f.c.flush()
    for _ in 0..3 {
        assert(f.srv.dispatch(f.client))
    }
    var gone: List[server.Client] = []
    f.srv.flush(mut gone)
    assert(gone.is_empty())
    var out: List[proto.Event] = []
    for _ in 0..3 {
        discard f.c.read()
        while true {
            match proto.next_event(mut f.c) {
                Ok(Some(e)) => {
                    match e {
                        WlRegistry(_, Global(n, i, v)) => f.globals.push((n, proto.ifaces.by_name(i)))
                        _ => {}
                    }
                    out.push(e)
                }
                Ok(None) => {
                    break
                }
                Err(e) => panic("client: {e}")
            }
        }
    }
    return out
}

fn events(mut f: Fx) -> List[server.Event] {
    var out: List[server.Event] = []
    while true {
        guard let Some(e) = f.srv.next() else {
            break
        }
        out.push(e)
    }
    return out
}

fn bind(mut f: Fx, iface: u16, version: u32) -> u32 {
    if f.reg.id == 0 {
        f.reg = wl.Display { id: 1 }.get_registry(mut f.c)
        discard pump(mut f)
    }
    for _ in 0..2 {
        for (n, i) in f.globals.clone() {
            if i == iface {
                return f.reg.bind(mut f.c, n, iface, version)
            }
        }
        // Added since: announced on the next round trip.
        discard pump(mut f)
    }
    panic("no global {proto.ifaces.name(iface)}")
}

fn shm_buffer(mut f: Fx, w: i32, h: i32) -> wl.Buffer {
    let shm = wl.Shm { id: bind(mut f, wl.shm_iface, 1) }
    let size = w * h * 4
    let fd = os.memfd("t", int(size)).expect("memfd")
    let pool = shm.create_pool(mut f.c, fd, size)
    os.close(fd)
    return pool.create_buffer(mut f.c, 0, w, h, w * 4, wl.ShmFormat.Argb8888)
}

/// A mapped plain surface and its server handle.
fn plain_surface(mut f: Fx, comp: wl.Compositor) -> (wl.Surface, server.Surface) {
    let buf = shm_buffer(mut f, 4, 4)
    let surf = comp.create_surface(mut f.c)
    surf.attach(mut f.c, Some(buf), 0, 0)
    surf.commit(mut f.c)
    discard pump(mut f)
    var s: Option[server.Surface] = None
    for e in events(mut f) {
        match e {
            Applied(x) => s = Some(x)
            _ => {}
        }
    }
    return (surf, s.expect("applied"))
}

test "a layer surface is configured, maps, and keeps its zone" {
    var f = setup()
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let shell = ls.Shell { id: bind(mut f, ls.shell_iface, 5) }
    let surf = comp.create_surface(mut f.c)
    let l = shell.get_layer_surface(mut f.c, surf, None, ls.ShellLayer.Top, "panel")
    l.set_anchor(mut f.c, ls.SurfaceAnchor.Top | ls.SurfaceAnchor.Left | ls.SurfaceAnchor.Right)
    l.set_size(mut f.c, 0, 30)
    l.set_exclusive_zone(mut f.c, 30)
    l.set_keyboard_interactivity(mut f.c, ls.SurfaceKeyboardInteractivity.OnDemand)
    surf.commit(mut f.c)
    discard pump(mut f)
    var layer: Option[server.Layer] = None
    for e in events(mut f) {
        match e {
            LayerNew(x) => layer = Some(x)
            _ => {}
        }
    }
    let lh = layer.expect("LayerNew at the initial commit")
    let info = f.srv.layer(lh)
    assert_eq(info.namespace, "panel")
    assert_eq(info.state.anchor, u32(13))
    assert_eq(info.state.exclusive, i32(30))
    assert_eq(info.state.keyboard, u32(2))
    assert_eq(info.state.layer, u32(2))
    let serial = f.srv.configure_layer(lh, 800, 30)
    var got = (u32(0), u32(0), u32(0))
    for e in pump(mut f) {
        match e {
            ZwlrLayerSurface(_, Configure(s, w, h)) => got = (s, w, h)
            _ => {}
        }
    }
    assert_eq(got, (serial, u32(800), u32(30)))
    l.ack_configure(mut f.c, serial)
    surf.attach(mut f.c, Some(shm_buffer(mut f, 800, 30)), 0, 0)
    surf.commit(mut f.c)
    discard pump(mut f)
    var changed = false
    for e in events(mut f) {
        match e {
            LayerChanged(x) => changed = x == lh
            _ => {}
        }
    }
    assert(changed)
    assert(f.srv.layer(lh).mapped)
    assert_eq(f.srv.layer_of(f.srv.layer(lh).surface), Some(lh))
    l.destroy(mut f.c)
    discard pump(mut f)
    var gone = false
    for e in events(mut f) {
        match e {
            LayerGone(x) => gone = x == lh
            _ => {}
        }
    }
    assert(gone)
}

test "the session lock: lock surfaces, locked, unlock" {
    var f = setup()
    let o = f.srv.add_output(server.OutputInfo { name: "TEST-1", width: 640, height: 480 })
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let out = wl.Output { id: bind(mut f, wl.output_iface, 4) }
    let mgr = sl.LockManager { id: bind(mut f, sl.lock_manager_iface, 1) }
    let lock = mgr.lock(mut f.c)
    let surf = comp.create_surface(mut f.c)
    let lsurf = lock.get_lock_surface(mut f.c, surf, out)
    discard pump(mut f)
    var requested = false
    var ls_new: Option[server.LockSurface] = None
    for e in events(mut f) {
        match e {
            LockRequest => requested = true
            LockSurfaceNew(k) => ls_new = Some(k)
            _ => {}
        }
    }
    assert(requested)
    let k = ls_new.expect("LockSurfaceNew")
    let (_, so, _) = f.srv.lock_surface(k)
    assert_eq(so, Some(o))
    let serial = f.srv.configure_lock(k, 640, 480)
    f.srv.lock_done()
    var configured = false
    var locked = false
    for e in pump(mut f) {
        match e {
            ExtSessionLockSurface(_, Configure(s, 640, 480)) => configured = s == serial
            ExtSessionLock(_, Locked) => locked = true
            _ => {}
        }
    }
    assert(configured and locked)
    lsurf.ack_configure(mut f.c, serial)
    surf.attach(mut f.c, Some(shm_buffer(mut f, 640, 480)), 0, 0)
    surf.commit(mut f.c)
    discard pump(mut f)
    let (_, _, mapped) = f.srv.lock_surface(k)
    assert(mapped)
    // A second locker is turned away while the first holds the lock.
    let other = mgr.lock(mut f.c)
    var finished = false
    for e in pump(mut f) {
        match e {
            ExtSessionLock(l, Finished) => finished = l == other
            _ => {}
        }
    }
    assert(finished)
    lock.unlock_and_destroy(mut f.c)
    discard pump(mut f)
    var unlocked = false
    for e in events(mut f) {
        match e {
            Unlock => unlocked = true
            _ => {}
        }
    }
    assert(unlocked)
}

test "clipboard managers see and set the primary selection" {
    var f = setup()
    let seat = f.srv.add_seat("seat0")
    discard seat
    let ws = wl.Seat { id: bind(mut f, wl.seat_iface, 7) }
    let pmgr = ps.DeviceManager { id: bind(mut f, ps.device_manager_iface, 1) }
    let cmgr = dc.Manager { id: bind(mut f, dc.manager_iface, 1) }
    let cdev = cmgr.get_data_device(mut f.c, ws)
    let pdev = pmgr.get_device(mut f.c, ws)
    discard pump(mut f)
    let src = pmgr.create_source(mut f.c)
    src.offer(mut f.c, "text/plain")
    pdev.set_selection(mut f.c, Some(src), 1)
    var offer: Option[dc.Offer] = None
    var mime = ""
    var primary = false
    for e in pump(mut f) {
        match e {
            ExtDataControlDevice(_, DataOffer(o)) => offer = Some(o)
            ExtDataControlOffer(_, Offer(m)) => mime = m.clone()
            ExtDataControlDevice(d, PrimarySelection(Some(o))) => primary = d == cdev and Some(o) == offer
            _ => {}
        }
    }
    assert(primary)
    assert_eq(mime, "text/plain")
    // The manager takes over the clipboard: the old source is cancelled.
    let csrc = cmgr.create_data_source(mut f.c)
    csrc.offer(mut f.c, "text/plain")
    cdev.set_primary_selection(mut f.c, Some(csrc))
    var cancelled = false
    for e in pump(mut f) {
        match e {
            ZwpPrimarySelectionSource(s, Cancelled) => cancelled = s == src
            _ => {}
        }
    }
    assert(cancelled)
}

test "an input method serves the focused text field" {
    var f = setup()
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let seat = f.srv.add_seat("seat0")
    f.srv.set_capabilities(seat, 3)
    let ws = wl.Seat { id: bind(mut f, wl.seat_iface, 7) }
    let kb = ws.get_keyboard(mut f.c)
    let tim = ti.InputManager { id: bind(mut f, ti.input_manager_iface, 1) }
    let imm = im.MethodManager { id: bind(mut f, im.method_manager_iface, 1) }
    let (surf, target) = plain_surface(mut f, comp)
    let text = tim.get_text_input(mut f.c, ws)
    let m = imm.get_input_method(mut f.c, ws)
    discard pump(mut f)
    f.srv.keyboard_focus(seat, Some(target))
    var entered = false
    for e in pump(mut f) {
        match e {
            ZwpTextInput(t, Enter(s)) => entered = t == text and s == surf
            _ => {}
        }
    }
    assert(entered)
    text.enable(mut f.c)
    text.set_cursor_rectangle(mut f.c, 10, 20, 2, 16)
    text.commit(mut f.c)
    var active = false
    var done = false
    for e in pump(mut f) {
        match e {
            ZwpInputMethod(_, Activate) => active = true
            ZwpInputMethod(_, Done) => done = active
            _ => {}
        }
    }
    assert(active and done)
    let (cs, r) = f.srv.text_cursor(seat).expect("text cursor")
    assert_eq(cs, target)
    assert_eq(r, server.Rect { x: 10, y: 20, w: 2, h: 16 })
    m.commit_string(mut f.c, "你好")
    m.commit(mut f.c, 1)
    var committed = ""
    var serial: u32 = 0
    for e in pump(mut f) {
        match e {
            ZwpTextInput(_, CommitString(Some(t))) => committed = t.clone()
            ZwpTextInput(_, Done(s)) => serial = s
            _ => {}
        }
    }
    assert_eq(committed, "你好")
    assert_eq(serial, u32(1))
    // With a keyboard grab, keys go to the input method.
    let g = m.grab_keyboard(mut f.c)
    discard pump(mut f)
    discard f.srv.key(seat, 7, 30, true)
    var grabbed = false
    var direct = false
    for e in pump(mut f) {
        match e {
            ZwpInputMethodKeyboardGrab(x, Key(_, 7, 30, Pressed)) => grabbed = x == g
            WlKeyboard(k, Key(_, 7, 30, _)) => direct = k == kb
            _ => {}
        }
    }
    assert(grabbed and not direct)
}

test "decorations, activation and the toplevel list" {
    var f = setup()
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let wm = xdg.WmBase { id: bind(mut f, xdg.wm_base_iface, 6) }
    let dm = xd.DecorationManager { id: bind(mut f, xd.decoration_manager_iface, 1) }
    let activation = act.Activation { id: bind(mut f, act.activation_iface, 1) }
    let surf = comp.create_surface(mut f.c)
    let xs = wm.get_xdg_surface(mut f.c, surf)
    let top = xs.get_toplevel(mut f.c)
    top.set_title(mut f.c, "editor")
    let deco = dm.get_toplevel_decoration(mut f.c, top)
    deco.set_mode(mut f.c, xd.ToplevelDecorationMode.ServerSide)
    surf.commit(mut f.c)
    discard pump(mut f)
    var win: Option[server.Window] = None
    var asked = false
    for e in events(mut f) {
        match e {
            WindowNew(w) => win = Some(w)
            WindowDecoration => asked = true
            _ => {}
        }
    }
    let w = win.expect("WindowNew")
    assert(asked)
    assert_eq(f.srv.decoration(w), u32(2))
    f.srv.set_decoration(w, true)
    let serial = f.srv.configure(w, 0, 0, server.States {})
    var mode = 0
    var order_ok = false
    for e in pump(mut f) {
        match e {
            ZxdgToplevelDecoration(_, Configure(m)) => mode = int(u32(m))
            XdgSurface(_, Configure(s)) => order_ok = mode == 2 and s == serial
            _ => {}
        }
    }
    assert(order_ok)
    xs.ack_configure(mut f.c, serial)
    surf.attach(mut f.c, Some(shm_buffer(mut f, 4, 4)), 0, 0)
    surf.commit(mut f.c)
    discard pump(mut f)
    discard events(mut f)
    // A taskbar sees the mapped window.
    let list = ftl.ToplevelList { id: bind(mut f, ftl.toplevel_list_iface, 1) }
    discard list
    var title = ""
    var handle_done = false
    for e in pump(mut f) {
        match e {
            ExtForeignToplevelHandle(_, Title(t)) => title = t.clone()
            ExtForeignToplevelHandle(_, Done) => handle_done = true
            _ => {}
        }
    }
    assert_eq(title, "editor")
    assert(handle_done)
    // A token from the client brings its window forward.
    let tok = activation.get_activation_token(mut f.c)
    tok.commit(mut f.c)
    var token = ""
    for e in pump(mut f) {
        match e {
            XdgActivationToken(_, Done(t)) => token = t.clone()
            _ => {}
        }
    }
    assert(not token.is_empty())
    activation.activate(mut f.c, token, surf)
    discard pump(mut f)
    var activated = false
    for e in events(mut f) {
        match e {
            Activate(x) => activated = x == w
            _ => {}
        }
    }
    assert(activated)
    // A used token is gone.
    activation.activate(mut f.c, token, surf)
    discard pump(mut f)
    for e in events(mut f) {
        match e {
            Activate => panic("a token works once")
            _ => {}
        }
    }
}

test "a pointer lock with relative motion" {
    var f = setup()
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let seat = f.srv.add_seat("seat0")
    f.srv.set_capabilities(seat, 3)
    let ws = wl.Seat { id: bind(mut f, wl.seat_iface, 7) }
    let ptr = ws.get_pointer(mut f.c)
    let cons = pc.PointerConstraints { id: bind(mut f, pc.pointer_constraints_iface, 1) }
    let rel = rp.PointerManager { id: bind(mut f, rp.pointer_manager_iface, 1) }
    let (surf, target) = plain_surface(mut f, comp)
    let lp = cons.lock_pointer(mut f.c, surf, ptr, None, pc.PointerConstraintsLifetime.Persistent)
    lp.set_cursor_position_hint(mut f.c, 1.0, 2.0)
    let r = rel.get_relative_pointer(mut f.c, ptr)
    discard pump(mut f)
    let c = f.srv.constraint(seat, target).expect("constraint")
    assert(c.lock and not c.active)
    f.srv.pointer_focus(seat, Some(target), 1.0, 1.0)
    f.srv.set_constraint(seat, target, true)
    f.srv.relative_motion(seat, 1000, 3.0, 4.0, 1.5, 2.0)
    var locked = false
    var motion = false
    for e in pump(mut f) {
        match e {
            ZwpLockedPointer(x, Locked) => locked = x == lp
            ZwpRelativePointer(x, RelativeMotion(_, lo, dx, dy, ux, uy)) => motion = x == r and lo == 1000 and dx == 3.0 and dy == 4.0 and ux == 1.5 and uy == 2.0
            _ => {}
        }
    }
    assert(locked and motion)
    let now = f.srv.constraint(seat, target).expect("constraint")
    assert(now.active)
    assert_eq(now.hint, Some((1.0, 2.0)))
    f.srv.set_constraint(seat, target, false)
    var unlocked = false
    for e in pump(mut f) {
        match e {
            ZwpLockedPointer(_, Unlocked) => unlocked = true
            _ => {}
        }
    }
    assert(unlocked)
}

test "idle notifications fire, resume and wait for inhibitors" {
    var f = setup()
    let seat = f.srv.add_seat("seat0")
    discard seat
    let ws = wl.Seat { id: bind(mut f, wl.seat_iface, 7) }
    let n = idle.Notifier { id: bind(mut f, idle.notifier_iface, 2) }
    let a = n.get_idle_notification(mut f.c, 100, ws)
    let b = n.get_input_idle_notification(mut f.c, 100, ws)
    discard pump(mut f)
    f.srv.input_activity(1000000000)
    // Inhibited: only the input-idle one fires.
    assert_eq(f.srv.idle_check(1050000000, true), 1100000000)
    assert_eq(f.srv.idle_check(1200000000, true), -1)
    var idled_a = false
    var idled_b = false
    for e in pump(mut f) {
        match e {
            ExtIdleNotification(x, Idled) => {
                idled_a = idled_a or x == a
                idled_b = idled_b or x == b
            }
            _ => {}
        }
    }
    assert(idled_b and not idled_a)
    assert_eq(f.srv.idle_check(1200000000, false), 0)
    f.srv.input_activity(1300000000)
    var idled = false
    var resumed = 0
    for e in pump(mut f) {
        match e {
            ExtIdleNotification(x, Idled) => idled = x == a
            ExtIdleNotification(_, Resumed) => resumed += 1
            _ => {}
        }
    }
    assert(idled)
    assert_eq(resumed, 2)
}

test "a single-pixel buffer carries its colour" {
    var f = setup()
    let m = spb.SinglePixelBufferManager { id: bind(mut f, spb.single_pixel_buffer_manager_iface, 1) }
    discard m.create_u32_rgba_buffer(mut f.c, 0xFFFFFFFF, 0, 0, 0xFFFFFFFF)
    discard pump(mut f)
    var b: Option[server.Buffer] = None
    for e in events(mut f) {
        match e {
            BufferNew(x) => b = Some(x)
            _ => {}
        }
    }
    let info = f.srv.buffer(b.expect("BufferNew"))
    assert(info.kind == server.BufferKind.SinglePixel)
    assert_eq((info.width, info.height), (i32(1), i32(1)))
    assert_eq(info.color, [0xFFFFFFFF, 0, 0, 0xFFFFFFFF])
}

test "a drag carries an offer to the surface under the pointer and drops" {
    var f = setup()
    let st = f.srv.add_seat("seat0")
    f.srv.set_capabilities(st, 1)
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let ws = wl.Seat { id: bind(mut f, wl.seat_iface, 7) }
    let ddm = wl.DataDeviceManager { id: bind(mut f, wl.data_device_manager_iface, 3) }
    let ptr = ws.get_pointer(mut f.c)
    let dev = ddm.get_data_device(mut f.c, ws)
    let (a, sa) = plain_surface(mut f, comp)
    let (b, sb) = plain_surface(mut f, comp)
    discard ptr
    // Without a button held the drag is refused.
    let early = ddm.create_data_source(mut f.c)
    f.srv.pointer_focus(st, Some(sa), 1.0, 1.0)
    dev.start_drag(mut f.c, Some(early), a, None, 0)
    assert(pump(mut f).any(fn(e) => match e {
        WlDataSource(s, Cancelled) => s == early
        _ => false
    }))
    let src = ddm.create_data_source(mut f.c)
    src.offer(mut f.c, "text/plain")
    src.set_actions(mut f.c, wl.DataDeviceManagerDndAction.Copy | wl.DataDeviceManagerDndAction.Move)
    let serial = f.srv.pointer_button(st, 0, 272, true)
    dev.start_drag(mut f.c, Some(src), a, None, serial)
    var left = false
    var entered_a = false
    for e in pump(mut f) {
        match e {
            WlPointer(_, Leave(_, s)) => left = s == a
            WlDataDevice(_, Enter(_, s, _, _, Some)) => entered_a = s == a
            _ => {}
        }
    }
    assert(left and entered_a)
    assert(f.srv.dragging(st))
    assert(events(mut f).any(fn(e) => match e {
        Drag(x) => x == st
        _ => false
    }))
    // Over b: a fresh offer with the source's types and actions.
    f.srv.pointer_focus(st, Some(sb), 2.0, 2.0)
    var offer: Option[wl.DataOffer] = None
    var mime = ""
    var actions: u32 = 0
    var entered_b = false
    for e in pump(mut f) {
        match e {
            WlDataOffer(o, Offer(m)) => {
                offer = Some(o)
                mime = m.clone()
            }
            WlDataOffer(_, SourceActions(x)) => actions = u32(x)
            WlDataDevice(_, Enter(_, s, x, y, Some)) => entered_b = s == b and x == 2.0 and y == 2.0
            _ => {}
        }
    }
    assert(entered_b)
    assert_eq(mime, "text/plain")
    assert_eq(actions, u32(3))
    let o = offer.expect("offer")
    o.accept(mut f.c, serial, Some("text/plain"))
    o.set_actions(mut f.c, wl.DataDeviceManagerDndAction.Copy | wl.DataDeviceManagerDndAction.Move, wl.DataDeviceManagerDndAction.Move)
    var target = ""
    var chosen: u32 = 0
    for e in pump(mut f) {
        match e {
            WlDataSource(_, Target(Some(m))) => target = m.clone()
            WlDataSource(_, Action(x)) => chosen = u32(x)
            _ => {}
        }
    }
    assert_eq(target, "text/plain")
    assert_eq(chosen, u32(2))
    // Release: drop on b, the pointer is back on it.
    discard f.srv.pointer_button(st, 1, 272, false)
    var dropped = false
    var performed = false
    var back = false
    for e in pump(mut f) {
        match e {
            WlDataDevice(_, Drop) => dropped = true
            WlDataSource(_, DndDropPerformed) => performed = true
            WlPointer(_, Enter(_, s, _, _)) => back = s == b
            _ => {}
        }
    }
    assert(dropped and performed and back)
    assert(not f.srv.dragging(st))
    o.finish(mut f.c)
    assert(pump(mut f).any(fn(e) => match e {
        WlDataSource(_, DndFinished) => true
        _ => false
    }))
}

/// An shm buffer and its memory (to read what the server wrote).
fn mapped_buffer(mut f: Fx, w: i32, h: i32) -> (wl.Buffer, os.Map) {
    let shm = wl.Shm { id: bind(mut f, wl.shm_iface, 1) }
    let size = w * h * 4
    let fd = os.memfd("t", int(size)).expect("memfd")
    let m = os.map(fd, int(size), 0, true).expect("map")
    let pool = shm.create_pool(mut f.c, fd, size)
    os.close(fd)
    return (pool.create_buffer(mut f.c, 0, w, h, w * 4, wl.ShmFormat.Xrgb8888), m)
}

test "a screen capture copies the output's image into the client's buffer" {
    var f = setup()
    let o = f.srv.add_output(server.OutputInfo { name: "TEST-1", width: 4, height: 2 })
    let out = wl.Output { id: bind(mut f, wl.output_iface, 4) }
    let srcs = ics.OutputImageCaptureSourceManager { id: bind(mut f, ics.output_image_capture_source_manager_iface, 1) }
    let mgr = icc.Manager { id: bind(mut f, icc.manager_iface, 1) }
    let src = srcs.create_source(mut f.c, out)
    let sess = mgr.create_session(mut f.c, src, icc.ManagerOptions(0))
    var size = (u32(0), u32(0))
    var formats = 0
    var done = false
    for e in pump(mut f) {
        match e {
            ExtImageCopyCaptureSession(_, BufferSize(w, h)) => size = (w, h)
            ExtImageCopyCaptureSession(_, ShmFormat) => formats += 1
            ExtImageCopyCaptureSession(_, Done) => done = true
            _ => {}
        }
    }
    assert_eq(size, (u32(4), u32(2)))
    assert(formats == 2 and done)
    let (buf, m) = mapped_buffer(mut f, 4, 2)
    let fr = sess.create_frame(mut f.c)
    fr.attach_buffer(mut f.c, buf)
    fr.damage_buffer(mut f.c, 0, 0, 4, 2)
    fr.capture(mut f.c)
    discard pump(mut f)
    // The first frame is wanted now.
    assert(events(mut f).any(fn(e) => match e {
        Capture(x) => x == o
        _ => false
    }))
    assert(f.srv.capture_waiting(o))
    var px: List[u8] = []
    for i in 0..32 {
        px.push(u8(i))
    }
    f.srv.capture(o, px, 4, 2, 1500000000)
    var ready = false
    var when = (u32(9), u32(9), u32(9))
    for e in pump(mut f) {
        match e {
            ExtImageCopyCaptureFrame(_, PresentationTime(hi, lo, ns)) => when = (hi, lo, ns)
            ExtImageCopyCaptureFrame(_, Ready) => ready = true
            _ => {}
        }
    }
    assert(ready)
    assert_eq(when, (u32(0), u32(1), u32(500000000)))
    var mm = m
    let got = mm.bytes()
    assert_eq(got[0], u8(0))
    assert_eq(got[31], u8(31))
    // Later frames wait for new content; a buffer of the wrong size fails.
    fr.destroy(mut f.c)
    let fr2 = sess.create_frame(mut f.c)
    fr2.attach_buffer(mut f.c, shm_buffer(mut f, 2, 2))
    fr2.capture(mut f.c)
    discard pump(mut f)
    assert(not events(mut f).any(fn(e) => match e {
        Capture => true
        _ => false
    }))
    f.srv.capture(o, px, 4, 2, 0)
    assert(pump(mut f).any(fn(e) => match e {
        ExtImageCopyCaptureFrame(_, Failed(r)) => r == icc.FrameFailureReason.BufferConstraints
        _ => false
    }))
    // The output goes: the session stops.
    f.srv.remove_output(o)
    assert(pump(mut f).any(fn(e) => match e {
        ExtImageCopyCaptureSession(_, Stopped) => true
        _ => false
    }))
}

test "a sandboxed client is marked and does not see privileged globals" {
    var f = setup()
    let mgr = sctx.ContextManager { id: bind(mut f, sctx.context_manager_iface, 1) }
    let dir = env.get("XDG_RUNTIME_DIR").unwrap()
    let path = "{dir}/sandbox-0"
    let l = net.unix_listen(path).expect("listen")
    let closer = os.memfd("close", 1).expect("memfd")
    let ctx = mgr.create_listener(mut f.c, l.fd, closer)
    ctx.set_sandbox_engine(mut f.c, "flatpak")
    ctx.set_app_id(mut f.c, "org.example.App")
    ctx.set_instance_id(mut f.c, "7")
    ctx.commit(mut f.c)
    ctx.destroy(mut f.c)
    discard pump(mut f)
    var listen: Option[u32] = None
    for e in events(mut f) {
        match e {
            Listen(k) => listen = Some(k)
            _ => {}
        }
    }
    let k = listen.expect("Listen")
    var c2 = wire.connect(path).expect("connect")
    var client: Option[server.Client] = None
    for _ in 0..100 {
        if let Some((c, _)) = f.srv.accept_from(k) {
            client = Some(c)
            break
        }
    }
    let sc = client.expect("accept_from")
    assert_eq(f.srv.sandbox(sc), Some(("flatpak", "org.example.App", "7")))
    assert_eq(f.srv.sandbox(f.client), None)
    discard wl.Display { id: 1 }.get_registry(mut c2)
    discard c2.flush()
    for _ in 0..3 {
        assert(f.srv.dispatch(sc))
    }
    var gone: List[server.Client] = []
    f.srv.flush(mut gone)
    var seen: List[u16] = []
    for _ in 0..3 {
        discard c2.read()
        while true {
            match proto.next_event(mut c2) {
                Ok(Some(WlRegistry(_, Global(_, i, _)))) => seen.push(proto.ifaces.by_name(i))
                Ok(Some) => {}
                _ => {
                    break
                }
            }
        }
    }
    assert(seen.contains(wl.compositor_iface))
    assert(not seen.contains(dc.manager_iface))
    assert(not seen.contains(icc.manager_iface))
    assert(not seen.contains(sctx.context_manager_iface))
    f.srv.close_listener(k)
    assert(f.srv.accept_from(k).is_none())
}

test "output configuration: heads, a mode and position applied, a stale one cancelled" {
    var f = setup()
    let o = f.srv.add_output(server.OutputInfo { name: "TEST-1", width: 640, height: 480, modes: [(640, 480, 60000, true), (800, 600, 60000, false)] })
    let mgr = wom.Manager { id: bind(mut f, wom.manager_iface, 4) }
    var head: Option[wom.Head] = None
    var modes: List[wom.Mode] = []
    var current: Option[wom.Mode] = None
    var serial: u32 = 0
    var name = ""
    for e in pump(mut f) {
        match e {
            ZwlrOutputManager(_, Head(h)) => head = Some(h)
            ZwlrOutputHead(_, Name(n)) => name = n.clone()
            ZwlrOutputHead(_, Mode(m)) => modes.push(m)
            ZwlrOutputHead(_, CurrentMode(m)) => current = Some(m)
            ZwlrOutputManager(_, Done(s)) => serial = s
            _ => {}
        }
    }
    let h = head.expect("head")
    assert_eq(name, "TEST-1")
    assert_eq(modes.len(), 2)
    assert_eq(current, Some(modes[0]))
    let cfg = mgr.create_configuration(mut f.c, serial)
    let ch = cfg.enable_head(mut f.c, h)
    ch.set_mode(mut f.c, modes[1])
    ch.set_position(mut f.c, 10, 20)
    cfg.apply(mut f.c)
    discard pump(mut f)
    var asked: Option[server.OutputConfig] = None
    for e in events(mut f) {
        match e {
            OutputConfig(c, false) => asked = Some(c)
            _ => {}
        }
    }
    let c = asked.expect("OutputConfig")
    let heads = f.srv.output_config(c)
    assert_eq(heads.len(), 1)
    assert(heads[0].output == o and heads[0].enabled)
    assert_eq(heads[0].mode, Some((800, 600, 60000)))
    assert_eq(heads[0].position, Some((10, 20)))
    f.srv.output_config_done(c, true)
    assert(pump(mut f).any(fn(e) => match e {
        ZwlrOutputConfiguration(_, Succeeded) => true
        _ => false
    }))
    // The output changed: heads hear it with a new serial, and a
    // configuration against the old one is cancelled.
    f.srv.update_output(o, server.OutputInfo { name: "TEST-1", x: 10, y: 20, width: 800, height: 600, modes: [(640, 480, 60000, true), (800, 600, 60000, false)] })
    var moved = false
    var next: u32 = 0
    for e in pump(mut f) {
        match e {
            ZwlrOutputHead(_, Position(10, 20)) => moved = true
            ZwlrOutputManager(_, Done(s)) => next = s
            _ => {}
        }
    }
    assert(moved and next != serial)
    let stale = mgr.create_configuration(mut f.c, serial)
    discard stale.enable_head(mut f.c, h)
    stale.apply(mut f.c)
    assert(pump(mut f).any(fn(e) => match e {
        ZwlrOutputConfiguration(_, Cancelled) => true
        _ => false
    }))
}

test "a virtual keyboard keymap shorter than it claims is ignored" {
    var f = setup()
    discard f.srv.add_seat("seat0")
    let ws = wl.Seat { id: bind(mut f, wl.seat_iface, 7) }
    let mgr = vkb.KeyboardManager { id: bind(mut f, vkb.keyboard_manager_iface, 1) }
    let kb = mgr.create_virtual_keyboard(mut f.c, ws)
    let fd = os.memfd("keymap", 16).expect("memfd")
    // Hashing 1 MiB of a 16-byte file would read past its end (SIGBUS).
    kb.keymap(mut f.c, 1, fd, 1 << 20)
    os.close(fd)
    discard pump(mut f)
    // Not taken: a key now is a key before any keymap, and the client
    // is dropped with no_keymap.
    kb.key(mut f.c, 0, 30, 1)
    discard f.c.flush()
    discard f.srv.dispatch(f.client)
    var gone: List[server.Client] = []
    f.srv.flush(mut gone)
    assert(gone.contains(f.client))
    discard f.c.read()
    var code: i64 = -1
    while true {
        match proto.next_event(mut f.c) {
            Ok(Some(WlDisplay(_, Error(obj, c, _)))) => code = if obj == kb.id { i64(c) } else { -2 }
            Ok(Some) => {}
            _ => {
                break
            }
        }
    }
    assert_eq(code, i64(vkb.KeyboardError.NoKeymap))
}

test "multi-plane dmabuf handles out-of-order planes and validates plane_set" {
    var f = setup()
    f.srv.enable_dmabuf(server.Dmabuf { device: 1, formats: [(u32(0x34325241), u64(1))] }).unwrap()
    let dm = dmab.Dmabuf { id: bind(mut f, dmab.dmabuf_iface, 4) }
    let p = dm.create_params(mut f.c)
    let fd0 = os.memfd("p0", 4096).expect("memfd")
    let fd1 = os.memfd("p1", 4096).expect("memfd")
    // Add plane 1 before plane 0 (out-of-order add allowed by protocol).
    p.add_(mut f.c, fd1, 1, 4096, 64, 0, 1)
    p.add_(mut f.c, fd0, 0, 0, 256, 0, 1)
    os.close(fd0)
    os.close(fd1)
    discard p.create_immed(mut f.c, 16, 16, 0x34325241, dmab.BufferParamsFlags(0))
    discard pump(mut f)
    var got_buf: Option[server.Buffer] = None
    for e in events(mut f) {
        match e {
            BufferNew(b) => got_buf = Some(b)
            _ => {}
        }
    }
    let buf = got_buf.expect("BufferNew")
    let info = f.srv.buffer(buf)
    assert_eq(info.planes, 2)
    let db = f.srv.dmabuf(buf)
    assert_eq(db.planes, 2)
    assert_eq((db.plane[0].offset, db.plane[0].stride), (u32(0), u32(256)))
    assert_eq((db.plane[1].offset, db.plane[1].stride), (u32(4096), u32(64)))

    // Mismatched modifiers across planes must raise a protocol error.
    let p_bad = dm.create_params(mut f.c)
    let fa = os.memfd("pa", 4096).expect("memfd")
    let fb = os.memfd("pb", 4096).expect("memfd")
    p_bad.add_(mut f.c, fa, 0, 0, 256, 0, 1)
    p_bad.add_(mut f.c, fb, 1, 0, 64, 0, 2)
    os.close(fa)
    os.close(fb)
    discard f.c.flush()
    discard f.srv.dispatch(f.client)
    var gone: List[server.Client] = []
    f.srv.flush(mut gone)
    assert(gone.contains(f.client))
    discard f.c.read()
    var err_code: i64 = -1
    while true {
        match proto.next_event(mut f.c) {
            Ok(Some(WlDisplay(_, Error(_, c, _)))) => err_code = i64(c)
            Ok(Some) => {}
            _ => {
                break
            }
        }
    }
    assert_eq(err_code, i64(dmab.BufferParamsError.InvalidFormat))
}

test "window capture and async dmabuf capture" {
    var f = setup()
    f.srv.enable_dmabuf(server.Dmabuf { device: 42, formats: [(u32(0x34325241), u64(0))] }).unwrap()
    let cap_fmts: List[(u32, u64)] = [(u32(0x34325241), u64(0))]
    f.srv.set_capture_dmabuf(42, cap_fmts)
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let wm = xdg.WmBase { id: bind(mut f, xdg.wm_base_iface, 6) }
    let dm = dmab.Dmabuf { id: bind(mut f, dmab.dmabuf_iface, 4) }
    let surf = comp.create_surface(mut f.c)
    let xs = wm.get_xdg_surface(mut f.c, surf)
    let top = xs.get_toplevel(mut f.c)
    surf.commit(mut f.c)
    discard pump(mut f)
    var win: Option[server.Window] = None
    for e in events(mut f) {
        match e {
            WindowNew(w) => win = Some(w)
            _ => {}
        }
    }
    let w = win.expect("WindowNew")
    let serial = f.srv.configure(w, 10, 6, server.States {})
    discard pump(mut f)
    xs.ack_configure(mut f.c, serial)
    surf.attach(mut f.c, Some(shm_buffer(mut f, 10, 6)), 0, 0)
    surf.commit(mut f.c)
    discard pump(mut f)
    discard events(mut f)

    let list = ftl.ToplevelList { id: bind(mut f, ftl.toplevel_list_iface, 1) }
    discard list
    var h: Option[ftl.Handle] = None
    for e in pump(mut f) {
        match e {
            ExtForeignToplevelList(_, Toplevel(x)) => h = Some(x)
            _ => {}
        }
    }
    let handle = h.expect("toplevel handle")
    let tsrcs = ics.ForeignToplevelImageCaptureSourceManager { id: bind(mut f, ics.foreign_toplevel_image_capture_source_manager_iface, 1) }
    let mgr = icc.Manager { id: bind(mut f, icc.manager_iface, 1) }
    let src = tsrcs.create_source(mut f.c, handle)
    let sess = mgr.create_session(mut f.c, src, icc.ManagerOptions(0))
    var size = (u32(0), u32(0))
    var dmabuf_dev = false
    var dmabuf_fmt = false
    var done = false
    for e in pump(mut f) {
        match e {
            ExtImageCopyCaptureSession(_, BufferSize(bw, bh)) => size = (bw, bh)
            ExtImageCopyCaptureSession(_, DmabufDevice) => dmabuf_dev = true
            ExtImageCopyCaptureSession(_, DmabufFormat) => dmabuf_fmt = true
            ExtImageCopyCaptureSession(_, Done) => done = true
            _ => {}
        }
    }
    assert_eq(size, (u32(10), u32(6)))
    assert(dmabuf_dev and dmabuf_fmt and done)

    // Attach a dmabuf buffer to capture the window asynchronously.
    let params = dm.create_params(mut f.c)
    let fd = os.memfd("cap", 4096).expect("memfd")
    params.add_(mut f.c, fd, 0, 0, 40, 0, 0)
    os.close(fd)
    let dbuf = params.create_immed(mut f.c, 10, 6, 0x34325241, dmab.BufferParamsFlags(0))
    discard pump(mut f)
    for e in events(mut f) {
        match e {
            BufferNew(b) => f.srv.imported(b, true)
            _ => {}
        }
    }
    let fr = sess.create_frame(mut f.c)
    fr.attach_buffer(mut f.c, dbuf)
    fr.capture(mut f.c)
    discard pump(mut f)
    assert(events(mut f).any(fn(e) => match e {
        CaptureWindow(cw) => cw == w
        _ => false
    }))
    var reqs: List[server.CaptureReq] = []
    f.srv.capture_dmabuf_requests(mut reqs)
    assert_eq(reqs.len(), 1)
    assert_eq((reqs[0].width, reqs[0].height), (i32(10), i32(6)))
    f.srv.capture_done(reqs[0].session, 2000000000)
    f.srv.release(reqs[0].buffer)
    assert(pump(mut f).any(fn(e) => match e {
        ExtImageCopyCaptureFrame(_, Ready) => true
        _ => false
    }))

    // Destroying the toplevel stops active window capture sessions.
    top.destroy(mut f.c)
    assert(pump(mut f).any(fn(e) => match e {
        ExtImageCopyCaptureSession(_, Stopped) => true
        _ => false
    }))
}

test "multiple seats have independent focus, cursor serials, idle and remove_seat" {
    var f = setup()
    let seat0 = f.srv.add_seat("seat0")
    let seat1 = f.srv.add_seat("seat1")
    f.srv.set_capabilities(seat0, 3)
    f.srv.set_capabilities(seat1, 3)
    f.reg = wl.Display { id: 1 }.get_registry(mut f.c)
    discard pump(mut f)
    var seat_names: List[u32] = []
    for (name, iface) in f.globals {
        if iface == wl.seat_iface {
            seat_names.push(name)
        }
    }
    assert_eq(seat_names.len(), 2)
    let ws0 = wl.Seat { id: f.reg.bind(mut f.c, seat_names[0], wl.seat_iface, 7) }
    let ws1 = wl.Seat { id: f.reg.bind(mut f.c, seat_names[1], wl.seat_iface, 7) }
    let p0 = ws0.get_pointer(mut f.c)
    let p1 = ws1.get_pointer(mut f.c)
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let s1 = comp.create_surface(mut f.c)
    let s2 = comp.create_surface(mut f.c)
    s1.commit(mut f.c)
    s2.commit(mut f.c)
    discard pump(mut f)
    var surfs: List[server.Surface] = []
    for e in events(mut f) {
        match e {
            Applied(s) => surfs.push(s)
            _ => {}
        }
    }
    assert_eq(surfs.len(), 2)

    f.srv.pointer_focus(seat0, Some(surfs[0]), 1.0, 2.0)
    f.srv.pointer_focus(seat1, Some(surfs[1]), 3.0, 4.0)
    var ser0: u32 = 0
    var ser1: u32 = 0
    for e in pump(mut f) {
        match e {
            WlPointer(pid, Enter(ser, _, _, _)) => {
                if pid == p0 {
                    ser0 = ser
                }
                if pid == p1 {
                    ser1 = ser
                }
            }
            _ => {}
        }
    }
    assert(ser0 != 0 and ser1 != 0 and ser0 != ser1)

    // Crossed serial (ser1 sent to seat0's pointer) must be ignored.
    p0.set_cursor(mut f.c, ser1, None, 0, 0)
    discard pump(mut f)
    assert(events(mut f).is_empty())

    // Matching serial on seat1 works independently of seat0's serial.
    p1.set_cursor(mut f.c, ser1, None, 5, 6)
    discard pump(mut f)
    assert(events(mut f).any(fn(e) => match e {
        Cursor(st, _, hx, hy) => st == seat1 and hx == 5 and hy == 6
        _ => false
    }))

    // Per-seat idle notification and remove_seat global removal.
    let notifier = idle.Notifier { id: bind(mut f, idle.notifier_iface, 2) }
    let n0 = notifier.get_idle_notification(mut f.c, 100, ws0)
    let n1 = notifier.get_idle_notification(mut f.c, 100, ws1)
    discard pump(mut f)
    f.srv.input_activity_on(seat0, 1000)
    f.srv.input_activity_on(seat1, 1000)
    discard f.srv.idle_check(1000 + 150 * 1000000, false)
    var idled0 = false
    var idled1 = false
    for e in pump(mut f) {
        match e {
            ExtIdleNotification(id, Idled) => {
                if id == n0 {
                    idled0 = true
                }
                if id == n1 {
                    idled1 = true
                }
            }
            _ => {}
        }
    }
    assert(idled0 and idled1)
    f.srv.input_activity_on(seat1, 200000000)
    var res0 = false
    var res1 = false
    for e in pump(mut f) {
        match e {
            ExtIdleNotification(id, Resumed) => {
                if id == n0 {
                    res0 = true
                }
                if id == n1 {
                    res1 = true
                }
            }
            _ => {}
        }
    }
    assert(not res0 and res1)

    f.srv.remove_seat(seat1)
    assert(pump(mut f).any(fn(e) => match e {
        WlRegistry(_, GlobalRemove(n)) => n == seat_names[1]
        _ => false
    }))
}

test "reusing a completed wl_callback id for a new wl_surface stays bound" {
    var f = setup()
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let wm = xdg.WmBase { id: bind(mut f, xdg.wm_base_iface, 6) }
    let s1 = comp.create_surface(mut f.c)
    let cb = s1.frame(mut f.c)
    let cb_id = cb.id
    s1.commit(mut f.c)
    discard pump(mut f)
    var surf1 = server.Surface { id: server.ids.Id {} }
    for e in events(mut f) {
        match e {
            Applied(s) => surf1 = s
            _ => {}
        }
    }
    // Server fires wl_callback.done outside Server.dispatch, freeing cb_id.
    f.srv.frame_done(surf1, 42)
    discard pump(mut f)
    // Client immediately creates a new surface + popup reusing cb_id.
    let s2 = comp.create_surface(mut f.c)
    assert_eq(s2.id, cb_id)
    let pos = wm.create_positioner(mut f.c)
    pos.set_size(mut f.c, 200, 100)
    pos.set_anchor_rect(mut f.c, 0, 0, 20, 20)
    let xs = wm.get_xdg_surface(mut f.c, s2)
    let _pop = xs.get_popup(mut f.c, None, pos)
    pos.destroy(mut f.c)
    s2.commit(mut f.c)
    discard pump(mut f)
    assert(events(mut f).any(fn(e) => match e {
        PopupNew => true
        _ => false
    }))
}

test "destroying a text-input focused surface does not send stale leave on slot reuse" {
    var f = setup()
    let st = f.srv.add_seat("seat0")
    f.srv.set_capabilities(st, 3)
    let ws = wl.Seat { id: bind(mut f, wl.seat_iface, 7) }
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let tim = ti.InputManager { id: bind(mut f, ti.input_manager_iface, 1) }
    let tin = tim.get_text_input(mut f.c, ws)
    let s1 = comp.create_surface(mut f.c)
    s1.commit(mut f.c)
    discard pump(mut f)
    var surf1 = server.Surface { id: server.ids.Id {} }
    for e in events(mut f) {
        match e {
            Applied(s) => surf1 = s
            _ => {}
        }
    }
    f.srv.keyboard_focus(st, Some(surf1))
    assert(pump(mut f).any(fn(e) => match e {
        ZwpTextInput(_, Enter(s)) => s == s1
        _ => false
    }))
    // Client destroys the focused surface, freeing its server surface slot.
    s1.destroy(mut f.c)
    discard pump(mut f)
    // A second surface reuses that freed slot; focusing it must NOT emit a stale
    // `zwp_text_input_v3.leave` referencing the destroyed/reused surface.
    let s2 = comp.create_surface(mut f.c)
    let s3 = comp.create_surface(mut f.c)
    s2.commit(mut f.c)
    s3.commit(mut f.c)
    discard pump(mut f)
    var surfs: List[server.Surface] = []
    for e in events(mut f) {
        match e {
            Applied(s) => surfs.push(s)
            _ => {}
        }
    }
    assert_eq(surfs.len(), 2)
    f.srv.keyboard_focus(st, Some(surfs[1]))
    var got_leave = false
    var got_enter_s3 = false
    for e in pump(mut f) {
        match e {
            ZwpTextInput(t, Leave) => {
                if t == tin {
                    got_leave = true
                }
            }
            ZwpTextInput(t, Enter(s)) => {
                if t == tin and s == s3 {
                    got_enter_s3 = true
                }
            }
            _ => {}
        }
    }
    assert(not got_leave)
    assert(got_enter_s3)
}

test "a text field enabled again after focus came back activates the input method" {
    var f = setup()
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let seat = f.srv.add_seat("seat0")
    f.srv.set_capabilities(seat, 3)
    let ws = wl.Seat { id: bind(mut f, wl.seat_iface, 7) }
    let tim = ti.InputManager { id: bind(mut f, ti.input_manager_iface, 1) }
    let imm = im.MethodManager { id: bind(mut f, im.method_manager_iface, 1) }
    let (_, a) = plain_surface(mut f, comp)
    let (_, b) = plain_surface(mut f, comp)
    let text = tim.get_text_input(mut f.c, ws)
    discard imm.get_input_method(mut f.c, ws)
    discard pump(mut f)
    f.srv.keyboard_focus(seat, Some(a))
    discard pump(mut f)
    text.enable(mut f.c)
    text.commit(mut f.c)
    discard pump(mut f)
    // Focus leaves for another client's surface while the field is still
    // enabled: its commit, sent before it saw leave, arrives afterwards.
    f.srv.keyboard_focus(seat, None)
    text.set_cursor_rectangle(mut f.c, 1, 2, 3, 4)
    text.commit(mut f.c)
    discard pump(mut f)
    assert(f.srv.text_cursor(seat).is_none())
    // Back: the client enables again and the input method activates.
    f.srv.keyboard_focus(seat, Some(b))
    discard pump(mut f)
    text.enable(mut f.c)
    text.commit(mut f.c)
    assert(pump(mut f).any(fn(e) => match e {
        ZwpInputMethod(_, Activate) => true
        _ => false
    }))
    let (cs, _) = f.srv.text_cursor(seat).expect("text cursor")
    assert_eq(cs, b)
}

test "disabling one text field leaves the input method on the other" {
    var f = setup()
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let seat = f.srv.add_seat("seat0")
    f.srv.set_capabilities(seat, 3)
    let ws = wl.Seat { id: bind(mut f, wl.seat_iface, 7) }
    let tim = ti.InputManager { id: bind(mut f, ti.input_manager_iface, 1) }
    let imm = im.MethodManager { id: bind(mut f, im.method_manager_iface, 1) }
    let (_, a) = plain_surface(mut f, comp)
    let t1 = tim.get_text_input(mut f.c, ws)
    let t2 = tim.get_text_input(mut f.c, ws)
    discard imm.get_input_method(mut f.c, ws)
    discard pump(mut f)
    f.srv.keyboard_focus(seat, Some(a))
    discard pump(mut f)
    t1.enable(mut f.c)
    t1.commit(mut f.c)
    t2.enable(mut f.c)
    t2.commit(mut f.c)
    discard pump(mut f)
    t1.disable(mut f.c)
    t1.commit(mut f.c)
    assert(not pump(mut f).any(fn(e) => match e {
        ZwpInputMethod(_, Deactivate) => true
        _ => false
    }))
    assert(f.srv.text_cursor(seat).is_some())
}

test "a drag icon keeps the offset it moved by" {
    var f = setup()
    let st = f.srv.add_seat("seat0")
    f.srv.set_capabilities(st, 1)
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let ws = wl.Seat { id: bind(mut f, wl.seat_iface, 7) }
    let ddm = wl.DataDeviceManager { id: bind(mut f, wl.data_device_manager_iface, 3) }
    discard ws.get_pointer(mut f.c)
    let dev = ddm.get_data_device(mut f.c, ws)
    let (a, sa) = plain_surface(mut f, comp)
    let icon = comp.create_surface(mut f.c)
    f.srv.pointer_focus(st, Some(sa), 1.0, 1.0)
    let serial = f.srv.pointer_button(st, 0, 272, true)
    let src = ddm.create_data_source(mut f.c)
    dev.start_drag(mut f.c, Some(src), a, Some(icon), serial)
    icon.attach(mut f.c, Some(shm_buffer(mut f, 8, 8)), 0, 0)
    icon.offset(mut f.c, -5, -6)
    icon.commit(mut f.c)
    discard pump(mut f)
    let (_, x, y) = f.srv.drag_icon(st).expect("icon")
    assert_eq((x, y), (-5, -6))
    icon.offset(mut f.c, 1, 1)
    icon.commit(mut f.c)
    discard pump(mut f)
    let (_, x2, y2) = f.srv.drag_icon(st).expect("icon")
    assert_eq((x2, y2), (-4, -5))
}
