    var rd = conn.reader(m)
    var matched = true
    match m.op {
        0 => {
            let serial = rd.u32(conn)
            if rd.valid() {
                return Ok(SurfaceEvent.Configure(serial))
            }
        }
        _ => matched = false
    }
    return Err(if matched { rd.finish_err(mut conn, m) } else { conn.invalid_op(m, true, "xdg_surface") })
}

/// destroy the xdg_surface
pub fn Surface.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// assign the xdg_toplevel surface role
pub fn Surface.get_toplevel(self, mut conn: wire.Conn) -> Toplevel {
    let id = Toplevel { id: conn.alloc(toplevel_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 1, 8 + 4)
    wr.u32(mut conn, id.id)
    return id
}

/// assign the xdg_popup surface role
pub fn Surface.get_popup(self, mut conn: wire.Conn, parent: Option[Surface], positioner: Positioner) -> Popup {
    let id = Popup { id: conn.alloc(popup_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 2, 8 + 12)
    wr.u32(mut conn, id.id)
    wr.u32(mut conn, parent.map(fn(o) => o.id).unwrap_or(0))
    wr.u32(mut conn, positioner.id)
    return id
}

/// set the new window geometry
pub fn Surface.set_window_geometry(self, mut conn: wire.Conn, x: i32, y: i32, width: i32, height: i32) {
    var wr = conn.begin(self.id, 3, 8 + 16)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
    wr.i32(mut conn, width)
    wr.i32(mut conn, height)
}

/// ack a configure event
pub fn Surface.ack_configure(self, mut conn: wire.Conn, serial: u32) {
    var wr = conn.begin(self.id, 4, 8 + 4)
    wr.u32(mut conn, serial)
}

/// Events of xdg_toplevel.
pub enum ToplevelEvent {
    /// suggest a surface change (width, height, states)
    Configure(i32, i32, List[u8])
    /// surface wants to be closed
    Close
    /// recommended window geometry bounds (width, height)
    ConfigureBounds(i32, i32)
    /// compositor capabilities (capabilities)
    WmCapabilities(List[u8])
}

pub fn decode_toplevel_event(mut conn: wire.Conn, m: wire.Msg) -> Result[ToplevelEvent, wire.Error] {
    var rd = conn.reader(m)
    var matched = true
    match m.op {
        0 => {
            let width = rd.i32(conn)
            let height = rd.i32(conn)
            let states = rd.array(conn)
            if rd.valid() {
                return Ok(ToplevelEvent.Configure(width, height, states))
            }
        }
        1 => {
            if rd.valid() {
                return Ok(ToplevelEvent.Close)
            }
        }
        2 => {
            guard m.version >= 4 else {
                return Err(conn.needs_version(m, "xdg_toplevel.configure_bounds", 4))
            }
            let width = rd.i32(conn)
            let height = rd.i32(conn)
            if rd.valid() {
                return Ok(ToplevelEvent.ConfigureBounds(width, height))
            }
        }
        3 => {
            guard m.version >= 5 else {
                return Err(conn.needs_version(m, "xdg_toplevel.wm_capabilities", 5))
            }
            let capabilities = rd.array(conn)
            if rd.valid() {
                return Ok(ToplevelEvent.WmCapabilities(capabilities))
            }
        }
        _ => matched = false
    }
    return Err(if matched { rd.finish_err(mut conn, m) } else { conn.invalid_op(m, true, "xdg_toplevel") })
}

/// destroy the xdg_toplevel
pub fn Toplevel.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// set the parent of this surface
pub fn Toplevel.set_parent(self, mut conn: wire.Conn, parent: Option[Toplevel]) {
    var wr = conn.begin(self.id, 1, 8 + 4)
    wr.u32(mut conn, parent.map(fn(o) => o.id).unwrap_or(0))
}

/// set surface title
pub fn Toplevel.set_title(self, mut conn: wire.Conn, title: StrSlice) {
    var wr = conn.begin(self.id, 2, 8 + wire.str_size(title))
    wr.str(mut conn, title)
}

/// set application ID
pub fn Toplevel.set_app_id(self, mut conn: wire.Conn, app_id: StrSlice) {
    var wr = conn.begin(self.id, 3, 8 + wire.str_size(app_id))
    wr.str(mut conn, app_id)
}

/// show the window menu
pub fn Toplevel.show_window_menu(self, mut conn: wire.Conn, seat: wayland.Seat, serial: u32, x: i32, y: i32) {
    var wr = conn.begin(self.id, 4, 8 + 16)
    wr.u32(mut conn, seat.id)
    wr.u32(mut conn, serial)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
}

/// start an interactive move
pub fn Toplevel.move(self, mut conn: wire.Conn, seat: wayland.Seat, serial: u32) {
    var wr = conn.begin(self.id, 5, 8 + 8)
    wr.u32(mut conn, seat.id)
    wr.u32(mut conn, serial)
}

/// start an interactive resize
pub fn Toplevel.resize(self, mut conn: wire.Conn, seat: wayland.Seat, serial: u32, edges: ToplevelResizeEdge) {
    var wr = conn.begin(self.id, 6, 8 + 12)
    wr.u32(mut conn, seat.id)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, u32(edges))
}

/// set the maximum size
pub fn Toplevel.set_max_size(self, mut conn: wire.Conn, width: i32, height: i32) {
    var wr = conn.begin(self.id, 7, 8 + 8)
    wr.i32(mut conn, width)
    wr.i32(mut conn, height)
}

/// set the minimum size
pub fn Toplevel.set_min_size(self, mut conn: wire.Conn, width: i32, height: i32) {
    var wr = conn.begin(self.id, 8, 8 + 8)
    wr.i32(mut conn, width)
    wr.i32(mut conn, height)
}

/// maximize the window
pub fn Toplevel.set_maximized(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 9, 8)
}

/// unmaximize the window
pub fn Toplevel.unset_maximized(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 10, 8)
}

/// set the window as fullscreen on an output
pub fn Toplevel.set_fullscreen(self, mut conn: wire.Conn, output: Option[wayland.Output]) {
    var wr = conn.begin(self.id, 11, 8 + 4)
    wr.u32(mut conn, output.map(fn(o) => o.id).unwrap_or(0))
}

/// unset the window as fullscreen
pub fn Toplevel.unset_fullscreen(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 12, 8)
}

/// set the window as minimized
pub fn Toplevel.set_minimized(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 13, 8)
}

/// Events of xdg_popup.
pub enum PopupEvent {
    /// configure the popup surface (x, y, width, height)
    Configure(i32, i32, i32, i32)
    /// popup interaction is done
    PopupDone
    /// signal the completion of a repositioned request (token)
    Repositioned(u32)
}

pub fn decode_popup_event(mut conn: wire.Conn, m: wire.Msg) -> Result[PopupEvent, wire.Error] {
    var rd = conn.reader(m)
    var matched = true
    match m.op {
        0 => {
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            let width = rd.i32(conn)
            let height = rd.i32(conn)
            if rd.valid() {
                return Ok(PopupEvent.Configure(x, y, width, height))
            }
        }
        1 => {
            if rd.valid() {
                return Ok(PopupEvent.PopupDone)
            }
        }
        2 => {
            guard m.version >= 3 else {
                return Err(conn.needs_version(m, "xdg_popup.repositioned", 3))
            }
            let token = rd.u32(conn)
            if rd.valid() {
                return Ok(PopupEvent.Repositioned(token))
            }
        }
        _ => matched = false
    }
    return Err(if matched { rd.finish_err(mut conn, m) } else { conn.invalid_op(m, true, "xdg_popup") })
}

/// remove xdg_popup interface
pub fn Popup.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// make the popup take an explicit grab
pub fn Popup.grab(self, mut conn: wire.Conn, seat: wayland.Seat, serial: u32) {
    var wr = conn.begin(self.id, 1, 8 + 8)
    wr.u32(mut conn, seat.id)
    wr.u32(mut conn, serial)
}

/// recalculate the popup's location
pub fn Popup.reposition(self, mut conn: wire.Conn, positioner: Positioner, token: u32) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    var wr = conn.begin(self.id, 2, 8 + 8)
    wr.u32(mut conn, positioner.id)
    wr.u32(mut conn, token)
}
