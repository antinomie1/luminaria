/// wp_image_description_reference_v1: Reference to an image description
@derive(Hash, Show)
pub struct ImageDescriptionReference {
    pub id: u32
}

pub let image_description_reference_iface: u16 = 34
pub let image_description_reference_version: u32 = 1

/// Requests of wp_image_description_reference_v1.
pub enum ImageDescriptionReferenceRequest {
    /// destroy the reference
    Destroy
}

fn decode_image_description_reference(mut conn: wire.Conn, m: wire.Msg) -> Result[ImageDescriptionReferenceRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(ImageDescriptionReferenceRequest.Destroy)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wp_image_description_reference_v1"))
}

/// Events of wp_color_manager_v1.
pub enum ColorManagerEvent {
    /// supported rendering intent (render_intent)
    SupportedIntent(ColorManagerRenderIntent)
    /// supported features (feature)
    SupportedFeature(ColorManagerFeature)
    /// supported named transfer characteristic (tf)
    SupportedTfNamed(ColorManagerTransferFunction)
    /// supported named primaries (primaries)
    SupportedPrimariesNamed(ColorManagerPrimaries)
    /// all features have been sent
    Done
}

fn decode_color_manager_event(mut conn: wire.Conn, m: wire.Msg) -> Result[ColorManagerEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let render_intent = ColorManagerRenderIntent(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(ColorManagerEvent.SupportedIntent(render_intent))
        }
        1 => {
            let feature = ColorManagerFeature(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(ColorManagerEvent.SupportedFeature(feature))
        }
        2 => {
            let tf = ColorManagerTransferFunction(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(ColorManagerEvent.SupportedTfNamed(tf))
        }
        3 => {
            let primaries = ColorManagerPrimaries(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(ColorManagerEvent.SupportedPrimariesNamed(primaries))
        }
        4 => {
            try rd.finish(mut conn, m)
            return Ok(ColorManagerEvent.Done)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wp_color_manager_v1"))
}

/// destroy the color manager
pub fn ColorManager.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// create a color management interface for a wl_output
pub fn ColorManager.get_output(self, mut conn: wire.Conn, output: wayland.Output) -> ColorManagementOutput {
    let id = ColorManagementOutput { id: conn.alloc(color_management_output_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 1, 8 + 8)
    wr.u32(mut conn, id.id)
    wr.u32(mut conn, output.id)
    return id
}

/// create a color management interface for a wl_surface
pub fn ColorManager.get_surface(self, mut conn: wire.Conn, surface: wayland.Surface) -> ColorManagementSurface {
    let id = ColorManagementSurface { id: conn.alloc(color_management_surface_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 2, 8 + 8)
    wr.u32(mut conn, id.id)
    wr.u32(mut conn, surface.id)
    return id
}

