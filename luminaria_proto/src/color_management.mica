/// Events of wp_image_description_v1.
pub enum ImageDescriptionEvent {
    /// graceful error on creating the image description (cause, msg)
    Failed(ImageDescriptionCause, str)
    /// the object is ready to be used (32-bit) (identity)
    Ready(u32)
    /// the object is ready to be used (identity_hi, identity_lo)
    Ready2(u32, u32)
}

fn decode_image_description_event(mut conn: wire.Conn, m: wire.Msg) -> Result[ImageDescriptionEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let cause = ImageDescriptionCause(rd.u32(conn))
            let msg = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionEvent.Failed(cause, msg))
        }
        1 => {
            let identity = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionEvent.Ready(identity))
        }
        2 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "wp_image_description_v1.ready2 needs version 2"))
            }
            let identity_hi = rd.u32(conn)
            let identity_lo = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionEvent.Ready2(identity_hi, identity_lo))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wp_image_description_v1"))
}

/// destroy the image description
pub fn ImageDescription.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// get information about the image description
pub fn ImageDescription.get_information(self, mut conn: wire.Conn) -> ImageDescriptionInfo {
    let information = ImageDescriptionInfo { id: conn.alloc(image_description_info_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 1, 8 + 4)
    wr.u32(mut conn, information.id)
    return information
}

/// Events of wp_image_description_info_v1.
pub enum ImageDescriptionInfoEvent {
    /// end of information
    Done
    /// ICC profile matching the image description (icc, icc_size)
    IccFile(wire.Fd, u32)
    /// primaries as chromaticity coordinates (r_x, r_y, g_x, g_y, b_x, b_y, w_x, w_y)
    Primaries(i32, i32, i32, i32, i32, i32, i32, i32)
    /// named primaries (primaries)
    PrimariesNamed(ColorManagerPrimaries)
    /// transfer characteristic as a power curve (eexp)
    TfPower(u32)
    /// named transfer characteristic (tf)
    TfNamed(ColorManagerTransferFunction)
    /// primary color volume luminance range and reference white (min_lum, max_lum, reference_lum)
    Luminances(u32, u32, u32)
    /// target primaries as chromaticity coordinates (r_x, r_y, g_x, g_y, b_x, b_y, w_x, w_y)
    TargetPrimaries(i32, i32, i32, i32, i32, i32, i32, i32)
    /// target luminance range (min_lum, max_lum)
    TargetLuminance(u32, u32)
    /// target maximum content light level (max_cll)
    TargetMaxCll(u32)
    /// target maximum frame-average light level (max_fall)
    TargetMaxFall(u32)
}

fn decode_image_description_info_event(mut conn: wire.Conn, m: wire.Msg) -> Result[ImageDescriptionInfoEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(ImageDescriptionInfoEvent.Done)
        }
        1 => {
            let icc = rd.fd(mut conn)
            let icc_size = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionInfoEvent.IccFile(icc, icc_size))
        }
        2 => {
            let r_x = rd.i32(conn)
            let r_y = rd.i32(conn)
            let g_x = rd.i32(conn)
            let g_y = rd.i32(conn)
            let b_x = rd.i32(conn)
            let b_y = rd.i32(conn)
            let w_x = rd.i32(conn)
            let w_y = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionInfoEvent.Primaries(r_x, r_y, g_x, g_y, b_x, b_y, w_x, w_y))
        }
        3 => {
            let primaries = ColorManagerPrimaries(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionInfoEvent.PrimariesNamed(primaries))
        }
        4 => {
            let eexp = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionInfoEvent.TfPower(eexp))
        }
        5 => {
            let tf = ColorManagerTransferFunction(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionInfoEvent.TfNamed(tf))
        }
        6 => {
            let min_lum = rd.u32(conn)
            let max_lum = rd.u32(conn)
            let reference_lum = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionInfoEvent.Luminances(min_lum, max_lum, reference_lum))
        }
        7 => {
            let r_x = rd.i32(conn)
            let r_y = rd.i32(conn)
            let g_x = rd.i32(conn)
            let g_y = rd.i32(conn)
            let b_x = rd.i32(conn)
            let b_y = rd.i32(conn)
            let w_x = rd.i32(conn)
            let w_y = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionInfoEvent.TargetPrimaries(r_x, r_y, g_x, g_y, b_x, b_y, w_x, w_y))
        }
        8 => {
            let min_lum = rd.u32(conn)
            let max_lum = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionInfoEvent.TargetLuminance(min_lum, max_lum))
        }
        9 => {
            let max_cll = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionInfoEvent.TargetMaxCll(max_cll))
        }
        10 => {
            let max_fall = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ImageDescriptionInfoEvent.TargetMaxFall(max_fall))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wp_image_description_info_v1"))
}

/// destroy the reference
pub fn ImageDescriptionReference.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}
