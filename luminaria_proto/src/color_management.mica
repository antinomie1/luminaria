/// Events of wp_color_management_surface_feedback_v1.
pub enum ColorManagementSurfaceFeedbackEvent {
    /// the preferred image description changed (32-bit) (identity)
    PreferredChanged(u32)
    /// the preferred image description changed (identity_hi, identity_lo)
    PreferredChanged2(u32, u32)
}

fn decode_color_management_surface_feedback_event(mut conn: wire.Conn, m: wire.Msg) -> Result[ColorManagementSurfaceFeedbackEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let identity = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ColorManagementSurfaceFeedbackEvent.PreferredChanged(identity))
        }
        1 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "wp_color_management_surface_feedback_v1.preferred_changed2 needs version 2"))
            }
            let identity_hi = rd.u32(conn)
            let identity_lo = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ColorManagementSurfaceFeedbackEvent.PreferredChanged2(identity_hi, identity_lo))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wp_color_management_surface_feedback_v1"))
}

