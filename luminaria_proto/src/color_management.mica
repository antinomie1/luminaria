/// create Windows-scRGB image description object
pub fn ColorManager.create_windows_scrgb(self, mut conn: wire.Conn) -> ImageDescription {
    let image_description = ImageDescription { id: conn.alloc(image_description_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 6, 8 + 4)
    wr.u32(mut conn, image_description.id)
    return image_description
}

/// create an image description from a reference
pub fn ColorManager.get_image_description(self, mut conn: wire.Conn, reference: ImageDescriptionReference) -> ImageDescription {
    guard conn.version(self.id) >= 2 else {
        return ImageDescription { id: 0 }
    }
    let image_description = ImageDescription { id: conn.alloc(image_description_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 7, 8 + 8)
    wr.u32(mut conn, image_description.id)
    wr.u32(mut conn, reference.id)
    return image_description
}

/// create Windows-BT.2100 image description object
pub fn ColorManager.create_windows_bt2100(self, mut conn: wire.Conn) -> ImageDescription {
    guard conn.version(self.id) >= 3 else {
        return ImageDescription { id: 0 }
    }
    let image_description = ImageDescription { id: conn.alloc(image_description_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 8, 8 + 4)
    wr.u32(mut conn, image_description.id)
    return image_description
}

