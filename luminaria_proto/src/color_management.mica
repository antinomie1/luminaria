pub fn ColorManager.get_surface_feedback(self, mut conn: wire.Conn, surface: wayland.Surface) -> ColorManagementSurfaceFeedback {
    let id = ColorManagementSurfaceFeedback { id: conn.alloc(color_management_surface_feedback_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 3, 8 + 8)
    wr.u32(mut conn, id.id)
    wr.u32(mut conn, surface.id)
    return id
}

