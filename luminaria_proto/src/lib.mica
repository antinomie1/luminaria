            106 => Request.ZxdgOutputManager(xdg_output_unstable.OutputManager { id: m.id }, try xdg_output_unstable.decode_output_manager(mut conn, m))
            107 => Request.ZxdgOutput(xdg_output_unstable.Output { id: m.id }, try xdg_output_unstable.decode_output(mut conn, m))
            108 => Request.XdgWmBase(xdg_shell.WmBase { id: m.id }, try xdg_shell.decode_wm_base(mut conn, m))
            109 => Request.XdgPositioner(xdg_shell.Positioner { id: m.id }, try xdg_shell.decode_positioner(mut conn, m))
            110 => Request.XdgSurface(xdg_shell.Surface { id: m.id }, try xdg_shell.decode_surface(mut conn, m))
            111 => Request.XdgToplevel(xdg_shell.Toplevel { id: m.id }, try xdg_shell.decode_toplevel(mut conn, m))
            112 => Request.XdgPopup(xdg_shell.Popup { id: m.id }, try xdg_shell.decode_popup(mut conn, m))
            113 => Request.XdgSystemBell(xdg_system_bell.SystemBell { id: m.id }, try xdg_system_bell.decode_system_bell(mut conn, m))
            114 => Request.XdgToplevelIconManager(xdg_toplevel_icon.IconManager { id: m.id }, try xdg_toplevel_icon.decode_icon_manager(mut conn, m))
            115 => Request.XdgToplevelIcon(xdg_toplevel_icon.Icon { id: m.id }, try xdg_toplevel_icon.decode_icon(mut conn, m))
            116 => Request.XdgToplevelTagManager(xdg_toplevel_tag.ToplevelTagManager { id: m.id }, try xdg_toplevel_tag.decode_toplevel_tag_manager(mut conn, m))
            _ => {
                return Err(conn.error(m.id, wire.invalid_method, "no requests on interface {m.iface}"))
            }
        }
        return Ok(Some(v))
    }
}

/// A decoded event and the object it was sent to.
pub enum Event {
    WlDisplay(wayland.Display, wayland.DisplayEvent)
    WlRegistry(wayland.Registry, wayland.RegistryEvent)
    WlCallback(wayland.Callback, wayland.CallbackEvent)
    WlShm(wayland.Shm, wayland.ShmEvent)
    WlBuffer(wayland.Buffer, wayland.BufferEvent)
    WlDataOffer(wayland.DataOffer, wayland.DataOfferEvent)
    WlDataSource(wayland.DataSource, wayland.DataSourceEvent)
    WlDataDevice(wayland.DataDevice, wayland.DataDeviceEvent)
    WlShellSurface(wayland.ShellSurface, wayland.ShellSurfaceEvent)
    WlSurface(wayland.Surface, wayland.SurfaceEvent)
    WlSeat(wayland.Seat, wayland.SeatEvent)
    WlPointer(wayland.Pointer, wayland.PointerEvent)
    WlKeyboard(wayland.Keyboard, wayland.KeyboardEvent)
    WlTouch(wayland.Touch, wayland.TouchEvent)
    WlOutput(wayland.Output, wayland.OutputEvent)
    ExtDataControlDevice(ext_data_control.Device, ext_data_control.DeviceEvent)
    ExtDataControlSource(ext_data_control.Source, ext_data_control.SourceEvent)
    ExtDataControlOffer(ext_data_control.Offer, ext_data_control.OfferEvent)
    ExtForeignToplevelList(ext_foreign_toplevel_list.ToplevelList, ext_foreign_toplevel_list.ToplevelListEvent)
    ExtForeignToplevelHandle(ext_foreign_toplevel_list.Handle, ext_foreign_toplevel_list.HandleEvent)
    ExtIdleNotification(ext_idle_notify.Notification, ext_idle_notify.NotificationEvent)
    ExtSessionLock(ext_session_lock.Lock, ext_session_lock.LockEvent)
    ExtSessionLockSurface(ext_session_lock.LockSurface, ext_session_lock.LockSurfaceEvent)
    WpFractionalScale(fractional_scale.Scale, fractional_scale.ScaleEvent)
    ZwpInputMethod(input_method_unstable.Method, input_method_unstable.MethodEvent)
    ZwpInputPopupSurface(input_method_unstable.PopupSurface, input_method_unstable.PopupSurfaceEvent)
    ZwpInputMethodKeyboardGrab(input_method_unstable.MethodKeyboardGrab, input_method_unstable.MethodKeyboardGrabEvent)
    ZwpKeyboardShortcutsInhibitor(keyboard_shortcuts_inhibit_unstable.Inhibitor, keyboard_shortcuts_inhibit_unstable.InhibitorEvent)
    ZwpLinuxDmabuf(linux_dmabuf.Dmabuf, linux_dmabuf.DmabufEvent)
    ZwpLinuxBufferParams(linux_dmabuf.BufferParams, linux_dmabuf.BufferParamsEvent)
    ZwpLinuxDmabufFeedback(linux_dmabuf.DmabufFeedback, linux_dmabuf.DmabufFeedbackEvent)
    ZwpLockedPointer(pointer_constraints_unstable.LockedPointer, pointer_constraints_unstable.LockedPointerEvent)
    ZwpConfinedPointer(pointer_constraints_unstable.ConfinedPointer, pointer_constraints_unstable.ConfinedPointerEvent)
    ZwpPointerGestureSwipe(pointer_gestures_unstable.GestureSwipe, pointer_gestures_unstable.GestureSwipeEvent)
    ZwpPointerGesturePinch(pointer_gestures_unstable.GesturePinch, pointer_gestures_unstable.GesturePinchEvent)
    ZwpPointerGestureHold(pointer_gestures_unstable.GestureHold, pointer_gestures_unstable.GestureHoldEvent)
    WpPresentation(presentation_time.Presentation, presentation_time.PresentationEvent)
    WpPresentationFeedback(presentation_time.PresentationFeedback, presentation_time.PresentationFeedbackEvent)
    ZwpPrimarySelectionDevice(primary_selection_unstable.Device, primary_selection_unstable.DeviceEvent)
    ZwpPrimarySelectionOffer(primary_selection_unstable.Offer, primary_selection_unstable.OfferEvent)
    ZwpPrimarySelectionSource(primary_selection_unstable.Source, primary_selection_unstable.SourceEvent)
    ZwpRelativePointer(relative_pointer_unstable.Pointer, relative_pointer_unstable.PointerEvent)
    ZwpTabletSeat(tablet.TabletSeat, tablet.TabletSeatEvent)
    ZwpTabletTool(tablet.TabletTool, tablet.TabletToolEvent)
    ZwpTablet(tablet.Tablet, tablet.TabletEvent)
    ZwpTabletPadRing(tablet.TabletPadRing, tablet.TabletPadRingEvent)
    ZwpTabletPadStrip(tablet.TabletPadStrip, tablet.TabletPadStripEvent)
    ZwpTabletPadGroup(tablet.TabletPadGroup, tablet.TabletPadGroupEvent)
    ZwpTabletPad(tablet.TabletPad, tablet.TabletPadEvent)
    ZwpTabletPadDial(tablet.TabletPadDial, tablet.TabletPadDialEvent)
    ZwpTextInput(text_input_unstable.Input, text_input_unstable.InputEvent)
    ZwlrLayerSurface(wlr_layer_shell_unstable.Surface, wlr_layer_shell_unstable.SurfaceEvent)
    XdgActivationToken(xdg_activation.ActivationToken, xdg_activation.ActivationTokenEvent)
    ZxdgToplevelDecoration(xdg_decoration_unstable.ToplevelDecoration, xdg_decoration_unstable.ToplevelDecorationEvent)
    ZxdgExported(xdg_foreign_unstable.Exported, xdg_foreign_unstable.ExportedEvent)
    ZxdgImported(xdg_foreign_unstable.Imported, xdg_foreign_unstable.ImportedEvent)
    ZxdgOutput(xdg_output_unstable.Output, xdg_output_unstable.OutputEvent)
    XdgWmBase(xdg_shell.WmBase, xdg_shell.WmBaseEvent)
    XdgSurface(xdg_shell.Surface, xdg_shell.SurfaceEvent)
    XdgToplevel(xdg_shell.Toplevel, xdg_shell.ToplevelEvent)
    XdgPopup(xdg_shell.Popup, xdg_shell.PopupEvent)
    XdgToplevelIconManager(xdg_toplevel_icon.IconManager, xdg_toplevel_icon.IconManagerEvent)
}

/// The next event received on `conn`, `None` until more is read.
pub fn next_event(mut conn: wire.Conn) -> Result[Option[Event], wire.Error] {
    while true {
        guard let Some(m) = try conn.next() else {
            return Ok(None)
        }
        let v = match m.iface {
            1 => Event.WlDisplay(wayland.Display { id: m.id }, try wayland.decode_display_event(mut conn, m))
            2 => Event.WlRegistry(wayland.Registry { id: m.id }, try wayland.decode_registry_event(mut conn, m))
            3 => Event.WlCallback(wayland.Callback { id: m.id }, try wayland.decode_callback_event(mut conn, m))
            6 => Event.WlShm(wayland.Shm { id: m.id }, try wayland.decode_shm_event(mut conn, m))
            7 => Event.WlBuffer(wayland.Buffer { id: m.id }, try wayland.decode_buffer_event(mut conn, m))
            8 => Event.WlDataOffer(wayland.DataOffer { id: m.id }, try wayland.decode_data_offer_event(mut conn, m))
            9 => Event.WlDataSource(wayland.DataSource { id: m.id }, try wayland.decode_data_source_event(mut conn, m))
            10 => Event.WlDataDevice(wayland.DataDevice { id: m.id }, try wayland.decode_data_device_event(mut conn, m))
            13 => Event.WlShellSurface(wayland.ShellSurface { id: m.id }, try wayland.decode_shell_surface_event(mut conn, m))
            14 => Event.WlSurface(wayland.Surface { id: m.id }, try wayland.decode_surface_event(mut conn, m))
            15 => Event.WlSeat(wayland.Seat { id: m.id }, try wayland.decode_seat_event(mut conn, m))
            16 => Event.WlPointer(wayland.Pointer { id: m.id }, try wayland.decode_pointer_event(mut conn, m))
            17 => Event.WlKeyboard(wayland.Keyboard { id: m.id }, try wayland.decode_keyboard_event(mut conn, m))
            18 => Event.WlTouch(wayland.Touch { id: m.id }, try wayland.decode_touch_event(mut conn, m))
            19 => Event.WlOutput(wayland.Output { id: m.id }, try wayland.decode_output_event(mut conn, m))
            33 => Event.ExtDataControlDevice(ext_data_control.Device { id: m.id }, try ext_data_control.decode_device_event(mut conn, m))
            34 => Event.ExtDataControlSource(ext_data_control.Source { id: m.id }, try ext_data_control.decode_source_event(mut conn, m))
            35 => Event.ExtDataControlOffer(ext_data_control.Offer { id: m.id }, try ext_data_control.decode_offer_event(mut conn, m))
            36 => Event.ExtForeignToplevelList(ext_foreign_toplevel_list.ToplevelList { id: m.id }, try ext_foreign_toplevel_list.decode_toplevel_list_event(mut conn, m))
            37 => Event.ExtForeignToplevelHandle(ext_foreign_toplevel_list.Handle { id: m.id }, try ext_foreign_toplevel_list.decode_handle_event(mut conn, m))
            39 => Event.ExtIdleNotification(ext_idle_notify.Notification { id: m.id }, try ext_idle_notify.decode_notification_event(mut conn, m))
            41 => Event.ExtSessionLock(ext_session_lock.Lock { id: m.id }, try ext_session_lock.decode_lock_event(mut conn, m))
            42 => Event.ExtSessionLockSurface(ext_session_lock.LockSurface { id: m.id }, try ext_session_lock.decode_lock_surface_event(mut conn, m))
            46 => Event.WpFractionalScale(fractional_scale.Scale { id: m.id }, try fractional_scale.decode_scale_event(mut conn, m))
            49 => Event.ZwpInputMethod(input_method_unstable.Method { id: m.id }, try input_method_unstable.decode_method_event(mut conn, m))
            50 => Event.ZwpInputPopupSurface(input_method_unstable.PopupSurface { id: m.id }, try input_method_unstable.decode_popup_surface_event(mut conn, m))
            51 => Event.ZwpInputMethodKeyboardGrab(input_method_unstable.MethodKeyboardGrab { id: m.id }, try input_method_unstable.decode_method_keyboard_grab_event(mut conn, m))
            54 => Event.ZwpKeyboardShortcutsInhibitor(keyboard_shortcuts_inhibit_unstable.Inhibitor { id: m.id }, try keyboard_shortcuts_inhibit_unstable.decode_inhibitor_event(mut conn, m))
            55 => Event.ZwpLinuxDmabuf(linux_dmabuf.Dmabuf { id: m.id }, try linux_dmabuf.decode_dmabuf_event(mut conn, m))
            56 => Event.ZwpLinuxBufferParams(linux_dmabuf.BufferParams { id: m.id }, try linux_dmabuf.decode_buffer_params_event(mut conn, m))
            57 => Event.ZwpLinuxDmabufFeedback(linux_dmabuf.DmabufFeedback { id: m.id }, try linux_dmabuf.decode_dmabuf_feedback_event(mut conn, m))
            62 => Event.ZwpLockedPointer(pointer_constraints_unstable.LockedPointer { id: m.id }, try pointer_constraints_unstable.decode_locked_pointer_event(mut conn, m))
            63 => Event.ZwpConfinedPointer(pointer_constraints_unstable.ConfinedPointer { id: m.id }, try pointer_constraints_unstable.decode_confined_pointer_event(mut conn, m))
            65 => Event.ZwpPointerGestureSwipe(pointer_gestures_unstable.GestureSwipe { id: m.id }, try pointer_gestures_unstable.decode_gesture_swipe_event(mut conn, m))
            66 => Event.ZwpPointerGesturePinch(pointer_gestures_unstable.GesturePinch { id: m.id }, try pointer_gestures_unstable.decode_gesture_pinch_event(mut conn, m))
            67 => Event.ZwpPointerGestureHold(pointer_gestures_unstable.GestureHold { id: m.id }, try pointer_gestures_unstable.decode_gesture_hold_event(mut conn, m))
            68 => Event.WpPresentation(presentation_time.Presentation { id: m.id }, try presentation_time.decode_presentation_event(mut conn, m))
            69 => Event.WpPresentationFeedback(presentation_time.PresentationFeedback { id: m.id }, try presentation_time.decode_presentation_feedback_event(mut conn, m))
            71 => Event.ZwpPrimarySelectionDevice(primary_selection_unstable.Device { id: m.id }, try primary_selection_unstable.decode_device_event(mut conn, m))
            72 => Event.ZwpPrimarySelectionOffer(primary_selection_unstable.Offer { id: m.id }, try primary_selection_unstable.decode_offer_event(mut conn, m))
            73 => Event.ZwpPrimarySelectionSource(primary_selection_unstable.Source { id: m.id }, try primary_selection_unstable.decode_source_event(mut conn, m))
            75 => Event.ZwpRelativePointer(relative_pointer_unstable.Pointer { id: m.id }, try relative_pointer_unstable.decode_pointer_event(mut conn, m))
            78 => Event.ZwpTabletSeat(tablet.TabletSeat { id: m.id }, try tablet.decode_tablet_seat_event(mut conn, m))
            79 => Event.ZwpTabletTool(tablet.TabletTool { id: m.id }, try tablet.decode_tablet_tool_event(mut conn, m))
            80 => Event.ZwpTablet(tablet.Tablet { id: m.id }, try tablet.decode_tablet_event(mut conn, m))
            81 => Event.ZwpTabletPadRing(tablet.TabletPadRing { id: m.id }, try tablet.decode_tablet_pad_ring_event(mut conn, m))
            82 => Event.ZwpTabletPadStrip(tablet.TabletPadStrip { id: m.id }, try tablet.decode_tablet_pad_strip_event(mut conn, m))
            83 => Event.ZwpTabletPadGroup(tablet.TabletPadGroup { id: m.id }, try tablet.decode_tablet_pad_group_event(mut conn, m))
            84 => Event.ZwpTabletPad(tablet.TabletPad { id: m.id }, try tablet.decode_tablet_pad_event(mut conn, m))
            85 => Event.ZwpTabletPadDial(tablet.TabletPadDial { id: m.id }, try tablet.decode_tablet_pad_dial_event(mut conn, m))
            88 => Event.ZwpTextInput(text_input_unstable.Input { id: m.id }, try text_input_unstable.decode_input_event(mut conn, m))
            95 => Event.ZwlrLayerSurface(wlr_layer_shell_unstable.Surface { id: m.id }, try wlr_layer_shell_unstable.decode_surface_event(mut conn, m))
            97 => Event.XdgActivationToken(xdg_activation.ActivationToken { id: m.id }, try xdg_activation.decode_activation_token_event(mut conn, m))
            99 => Event.ZxdgToplevelDecoration(xdg_decoration_unstable.ToplevelDecoration { id: m.id }, try xdg_decoration_unstable.decode_toplevel_decoration_event(mut conn, m))
            104 => Event.ZxdgExported(xdg_foreign_unstable.Exported { id: m.id }, try xdg_foreign_unstable.decode_exported_event(mut conn, m))
            105 => Event.ZxdgImported(xdg_foreign_unstable.Imported { id: m.id }, try xdg_foreign_unstable.decode_imported_event(mut conn, m))
            107 => Event.ZxdgOutput(xdg_output_unstable.Output { id: m.id }, try xdg_output_unstable.decode_output_event(mut conn, m))
            108 => Event.XdgWmBase(xdg_shell.WmBase { id: m.id }, try xdg_shell.decode_wm_base_event(mut conn, m))
            110 => Event.XdgSurface(xdg_shell.Surface { id: m.id }, try xdg_shell.decode_surface_event(mut conn, m))
            111 => Event.XdgToplevel(xdg_shell.Toplevel { id: m.id }, try xdg_shell.decode_toplevel_event(mut conn, m))
            112 => Event.XdgPopup(xdg_shell.Popup { id: m.id }, try xdg_shell.decode_popup_event(mut conn, m))
            114 => Event.XdgToplevelIconManager(xdg_toplevel_icon.IconManager { id: m.id }, try xdg_toplevel_icon.decode_icon_manager_event(mut conn, m))
            _ => {
                return Err(conn.error(m.id, wire.invalid_method, "no events on interface {m.iface}"))
            }
        }
        // Events to objects destroyed here are read, then dropped.
        if m.alive {
            return Ok(Some(v))
        }
    }
}
