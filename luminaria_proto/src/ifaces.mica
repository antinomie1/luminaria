/// The number of interface `name`, 0 when there is none.
pub fn by_name(name: str) -> u16 {
    let nlen = name.len()
    var lo = 0
    var hi = count
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let id = int(sorted_ids[mid])
        let off = int(name_offsets[id - 1])
        let mlen = int(name_offsets[id]) - off
        let common = min(nlen, mlen)
        var cmp = 0
        for k in 0..common {
            let a = name[k]
            let b = names_blob[off + k]
            if a != b {
                cmp = if a < b { -1 } else { 1 }
                break
            }
        }
        if cmp == 0 {
            if nlen == mlen {
                return u16(id)
            }
            cmp = if nlen < mlen { -1 } else { 1 }
        }
        if cmp < 0 {
            hi = mid
        } else {
            lo = mid + 1
        }
    }
    return 0
}

pub fn name(iface: u16) -> str {
    let k = int(iface)
    guard k >= 1 and k <= count else {
        return ""
    }
    return names_blob.slice(int(name_offsets[k - 1]), int(name_offsets[k]))
}

/// The newest version this build speaks.
pub fn version(iface: u16) -> u32 {
    let k = int(iface)
    guard k >= 1 and k <= count else {
        return 0
    }
    return u32(iface_versions[k - 1])
}
