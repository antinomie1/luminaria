    conn.remove(self.id)
}

/// Events of zwp_tablet_seat_v2.
pub enum TabletSeatEvent {
    /// new device notification (id)
    TabletAdded(Tablet)
    /// a new tool has been used with a tablet (id)
    ToolAdded(TabletTool)
    /// new pad notification (id)
    PadAdded(TabletPad)
}

fn decode_tablet_seat_event(mut conn: wire.Conn, m: wire.Msg) -> Result[TabletSeatEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let id = Tablet { id: rd.new_id(mut conn, tablet_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(TabletSeatEvent.TabletAdded(id))
        }
        1 => {
            let id = TabletTool { id: rd.new_id(mut conn, tablet_tool_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(TabletSeatEvent.ToolAdded(id))
        }
        2 => {
            let id = TabletPad { id: rd.new_id(mut conn, tablet_pad_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(TabletSeatEvent.PadAdded(id))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on zwp_tablet_seat_v2"))
}

/// release the memory for the tablet seat object
pub fn TabletSeat.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// Events of zwp_tablet_tool_v2.
pub enum TabletToolEvent {
    /// tool type (tool_type)
    Type(TabletToolType)
    /// unique hardware serial number of the tool (hardware_serial_hi, hardware_serial_lo)
    HardwareSerial(u32, u32)
    /// hardware id notification in Wacom's format (hardware_id_hi, hardware_id_lo)
    HardwareIdWacom(u32, u32)
    /// tool capability notification (capability)
    Capability(TabletToolCapability)
    /// tool description events sequence complete
    Done
    /// tool removed
    Removed
    /// proximity in event (serial, tablet, surface)
    ProximityIn(u32, Tablet, wayland.Surface)
    /// proximity out event
    ProximityOut
    /// tablet tool is making contact (serial)
    Down(u32)
    /// tablet tool is no longer making contact
    Up
    /// motion event (x, y)
    Motion(f64, f64)
    /// pressure change event (pressure)
    Pressure(u32)
    /// distance change event (distance)
    Distance(u32)
    /// tilt change event (tilt_x, tilt_y)
    Tilt(f64, f64)
    /// z-rotation change event (degrees)
    Rotation(f64)
    /// Slider position change event (position)
    Slider(i32)
    /// Wheel delta event (degrees, clicks)
    Wheel(f64, i32)
    /// button event (serial, button, state)
    Button(u32, u32, TabletToolButtonState)
    /// frame event (time)
    Frame(u32)
}

fn decode_tablet_tool_event(mut conn: wire.Conn, m: wire.Msg) -> Result[TabletToolEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let tool_type = TabletToolType(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Type(tool_type))
        }
        1 => {
            let hardware_serial_hi = rd.u32(conn)
            let hardware_serial_lo = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.HardwareSerial(hardware_serial_hi, hardware_serial_lo))
        }
        2 => {
            let hardware_id_hi = rd.u32(conn)
            let hardware_id_lo = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.HardwareIdWacom(hardware_id_hi, hardware_id_lo))
        }
        3 => {
            let capability = TabletToolCapability(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Capability(capability))
        }
        4 => {
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Done)
        }
        5 => {
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Removed)
        }
        6 => {
            let serial = rd.u32(conn)
            let tablet = Tablet { id: rd.object(conn, tablet_iface, false) }
            let surface = wayland.Surface { id: rd.object(conn, wayland.surface_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.ProximityIn(serial, tablet, surface))
        }
        7 => {
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.ProximityOut)
        }
        8 => {
            let serial = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Down(serial))
        }
        9 => {
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Up)
        }
        10 => {
            let x = rd.fixed(conn)
            let y = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Motion(x, y))
        }
        11 => {
            let pressure = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Pressure(pressure))
        }
        12 => {
            let distance = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Distance(distance))
        }
        13 => {
            let tilt_x = rd.fixed(conn)
            let tilt_y = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Tilt(tilt_x, tilt_y))
        }
        14 => {
            let degrees = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Rotation(degrees))
        }
        15 => {
            let position = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Slider(position))
        }
        16 => {
            let degrees = rd.fixed(conn)
            let clicks = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Wheel(degrees, clicks))
        }
        17 => {
            let serial = rd.u32(conn)
            let button = rd.u32(conn)
            let state = TabletToolButtonState(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Button(serial, button, state))
        }
        18 => {
            let time = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletToolEvent.Frame(time))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on zwp_tablet_tool_v2"))
}

/// set the tablet tool's surface
pub fn TabletTool.set_cursor(self, mut conn: wire.Conn, serial: u32, surface: Option[wayland.Surface], hotspot_x: i32, hotspot_y: i32) {
    var wr = conn.begin(self.id, 0, 8 + 16)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, surface.map(fn(o) => o.id).unwrap_or(0))
    wr.i32(mut conn, hotspot_x)
    wr.i32(mut conn, hotspot_y)
}

/// destroy the tool object
pub fn TabletTool.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 1, 8)
    conn.remove(self.id)
}

/// Events of zwp_tablet_v2.
pub enum TabletEvent {
    /// tablet device name (name)
    Name(str)
    /// tablet device vendor/product id (vid, pid)
    Id(u32, u32)
    /// path to the device (path)
    Path(str)
    /// tablet description events sequence complete
    Done
    /// tablet removed event
    Removed
    /// tablet device bus type (bustype)
    Bustype(TabletBustype)
}

fn decode_tablet_event(mut conn: wire.Conn, m: wire.Msg) -> Result[TabletEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let name = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletEvent.Name(name))
        }
        1 => {
            let vid = rd.u32(conn)
            let pid = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletEvent.Id(vid, pid))
        }
        2 => {
            let path = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletEvent.Path(path))
        }
        3 => {
            try rd.finish(mut conn, m)
            return Ok(TabletEvent.Done)
        }
        4 => {
            try rd.finish(mut conn, m)
            return Ok(TabletEvent.Removed)
        }
        5 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "zwp_tablet_v2.bustype needs version 2"))
            }
            let bustype = TabletBustype(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(TabletEvent.Bustype(bustype))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on zwp_tablet_v2"))
}

/// destroy the tablet object
pub fn Tablet.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

