/// Events of zwp_tablet_pad_v2.
pub enum TabletPadEvent {
    /// group announced (pad_group)
    Group(TabletPadGroup)
    /// path to the device (path)
    Path(str)
    /// buttons announced (buttons)
    Buttons(u32)
    /// pad description event sequence complete
    Done
    /// physical button state (time, button, state)
    Button(u32, u32, TabletPadButtonState)
    /// enter event (serial, tablet, surface)
    Enter(u32, Tablet, wayland.Surface)
    /// leave event (serial, surface)
    Leave(u32, wayland.Surface)
    /// pad removed event
    Removed
}

fn decode_tablet_pad_event(mut conn: wire.Conn, m: wire.Msg) -> Result[TabletPadEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let pad_group = TabletPadGroup { id: rd.new_id(mut conn, tablet_pad_group_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(TabletPadEvent.Group(pad_group))
        }
        1 => {
            let path = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletPadEvent.Path(path))
        }
        2 => {
            let buttons = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletPadEvent.Buttons(buttons))
        }
        3 => {
            try rd.finish(mut conn, m)
            return Ok(TabletPadEvent.Done)
        }
        4 => {
            let time = rd.u32(conn)
            let button = rd.u32(conn)
            let state = TabletPadButtonState(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(TabletPadEvent.Button(time, button, state))
        }
        5 => {
            let serial = rd.u32(conn)
            let tablet = Tablet { id: rd.object(conn, tablet_iface, false) }
            let surface = wayland.Surface { id: rd.object(conn, wayland.surface_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(TabletPadEvent.Enter(serial, tablet, surface))
        }
        6 => {
            let serial = rd.u32(conn)
            let surface = wayland.Surface { id: rd.object(conn, wayland.surface_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(TabletPadEvent.Leave(serial, surface))
        }
        7 => {
            try rd.finish(mut conn, m)
            return Ok(TabletPadEvent.Removed)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on zwp_tablet_pad_v2"))
}

