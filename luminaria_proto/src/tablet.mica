/// Events of zwp_tablet_pad_group_v2.
pub enum TabletPadGroupEvent {
    /// buttons announced (buttons)
    Buttons(List[u8])
    /// ring announced (ring)
    Ring(TabletPadRing)
    /// strip announced (strip)
    Strip(TabletPadStrip)
    /// mode-switch ability announced (modes)
    Modes(u32)
    /// tablet group description events sequence complete
    Done
    /// mode switch event (time, serial, mode)
    ModeSwitch(u32, u32, u32)
    /// dial announced (dial)
    Dial(TabletPadDial)
}

fn decode_tablet_pad_group_event(mut conn: wire.Conn, m: wire.Msg) -> Result[TabletPadGroupEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let buttons = rd.array(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletPadGroupEvent.Buttons(buttons))
        }
        1 => {
            let ring = TabletPadRing { id: rd.new_id(mut conn, tablet_pad_ring_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(TabletPadGroupEvent.Ring(ring))
        }
        2 => {
            let strip = TabletPadStrip { id: rd.new_id(mut conn, tablet_pad_strip_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(TabletPadGroupEvent.Strip(strip))
        }
        3 => {
            let modes = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletPadGroupEvent.Modes(modes))
        }
        4 => {
            try rd.finish(mut conn, m)
            return Ok(TabletPadGroupEvent.Done)
        }
        5 => {
            let time = rd.u32(conn)
            let serial = rd.u32(conn)
            let mode = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(TabletPadGroupEvent.ModeSwitch(time, serial, mode))
        }
        6 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "zwp_tablet_pad_group_v2.dial needs version 2"))
            }
            let dial = TabletPadDial { id: rd.new_id(mut conn, tablet_pad_dial_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(TabletPadGroupEvent.Dial(dial))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on zwp_tablet_pad_group_v2"))
}

