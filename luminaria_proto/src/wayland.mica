pub fn Region.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// add rectangle to region
pub fn Region.add_(self, mut conn: wire.Conn, x: i32, y: i32, width: i32, height: i32) {
    var wr = conn.begin(self.id, 1, 8 + 16)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
    wr.i32(mut conn, width)
    wr.i32(mut conn, height)
}

/// subtract rectangle from region
pub fn Region.subtract(self, mut conn: wire.Conn, x: i32, y: i32, width: i32, height: i32) {
    var wr = conn.begin(self.id, 2, 8 + 16)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
    wr.i32(mut conn, width)
    wr.i32(mut conn, height)
}

/// unbind from the subcompositor interface
pub fn Subcompositor.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// give a surface the role sub-surface
pub fn Subcompositor.get_subsurface(self, mut conn: wire.Conn, surface: Surface, parent: Surface) -> Subsurface {
    let id = Subsurface { id: conn.alloc(subsurface_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 1, 8 + 12)
    wr.u32(mut conn, id.id)
    wr.u32(mut conn, surface.id)
    wr.u32(mut conn, parent.id)
    return id
}

/// remove sub-surface interface
pub fn Subsurface.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// reposition the sub-surface
pub fn Subsurface.set_position(self, mut conn: wire.Conn, x: i32, y: i32) {
    var wr = conn.begin(self.id, 1, 8 + 8)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
}

/// restack the sub-surface
pub fn Subsurface.place_above(self, mut conn: wire.Conn, sibling: Surface) {
    var wr = conn.begin(self.id, 2, 8 + 4)
    wr.u32(mut conn, sibling.id)
}

/// restack the sub-surface
pub fn Subsurface.place_below(self, mut conn: wire.Conn, sibling: Surface) {
    var wr = conn.begin(self.id, 3, 8 + 4)
    wr.u32(mut conn, sibling.id)
}

/// set sub-surface to synchronized mode
pub fn Subsurface.set_sync(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 4, 8)
}

/// set sub-surface to desynchronized mode
pub fn Subsurface.set_desync(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 5, 8)
}

/// destroys this object
pub fn Fixes.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// destroy a wl_registry
pub fn Fixes.destroy_registry(self, mut conn: wire.Conn, registry: Registry) {
    var wr = conn.begin(self.id, 1, 8 + 4)
    wr.u32(mut conn, registry.id)
}

/// acknowledge global removal
pub fn Fixes.ack_global_remove(self, mut conn: wire.Conn, registry: Registry, name: u32) {
    guard conn.version(self.id) >= 2 else {
        return
    }
    var wr = conn.begin(self.id, 2, 8 + 8)
    wr.u32(mut conn, registry.id)
    wr.u32(mut conn, name)
}
