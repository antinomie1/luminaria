/// Events of wl_pointer.
pub enum PointerEvent {
    /// enter event (serial, surface, surface_x, surface_y)
    Enter(u32, Surface, f64, f64)
    /// leave event (serial, surface)
    Leave(u32, Surface)
    /// pointer motion event (time, surface_x, surface_y)
    Motion(u32, f64, f64)
    /// pointer button event (serial, time, button, state)
    Button(u32, u32, u32, PointerButtonState)
    /// axis event (time, axis, value)
    Axis(u32, PointerAxis, f64)
    /// end of a pointer event sequence
    Frame
    /// axis source event (axis_source)
    AxisSource(PointerAxisSource)
    /// axis stop event (time, axis)
    AxisStop(u32, PointerAxis)
    /// axis click event (axis, discrete)
    AxisDiscrete(PointerAxis, i32)
    /// axis high-resolution scroll event (axis, value120)
    AxisValue120(PointerAxis, i32)
    /// axis relative physical direction event (axis, direction)
    AxisRelativeDirection(PointerAxis, PointerAxisRelativeDirection)
    /// pointer warp event (surface_x, surface_y)
    Warp(f64, f64)
}

fn decode_pointer_event(mut conn: wire.Conn, m: wire.Msg) -> Result[PointerEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let serial = rd.u32(conn)
            let surface = Surface { id: rd.object(conn, surface_iface, false) }
            let surface_x = rd.fixed(conn)
            let surface_y = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.Enter(serial, surface, surface_x, surface_y))
        }
        1 => {
            let serial = rd.u32(conn)
            let surface = Surface { id: rd.object(conn, surface_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.Leave(serial, surface))
        }
        2 => {
            let time = rd.u32(conn)
            let surface_x = rd.fixed(conn)
            let surface_y = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.Motion(time, surface_x, surface_y))
        }
        3 => {
            let serial = rd.u32(conn)
            let time = rd.u32(conn)
            let button = rd.u32(conn)
            let state = PointerButtonState(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.Button(serial, time, button, state))
        }
        4 => {
            let time = rd.u32(conn)
            let axis = PointerAxis(rd.u32(conn))
            let value = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.Axis(time, axis, value))
        }
        5 => {
            guard m.version >= 5 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_pointer.frame needs version 5"))
            }
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.Frame)
        }
        6 => {
            guard m.version >= 5 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_pointer.axis_source needs version 5"))
            }
            let axis_source = PointerAxisSource(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.AxisSource(axis_source))
        }
        7 => {
            guard m.version >= 5 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_pointer.axis_stop needs version 5"))
            }
            let time = rd.u32(conn)
            let axis = PointerAxis(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.AxisStop(time, axis))
        }
        8 => {
            guard m.version >= 5 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_pointer.axis_discrete needs version 5"))
            }
            let axis = PointerAxis(rd.u32(conn))
            let discrete = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.AxisDiscrete(axis, discrete))
        }
        9 => {
            guard m.version >= 8 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_pointer.axis_value120 needs version 8"))
            }
            let axis = PointerAxis(rd.u32(conn))
            let value120 = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.AxisValue120(axis, value120))
        }
        10 => {
            guard m.version >= 9 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_pointer.axis_relative_direction needs version 9"))
            }
            let axis = PointerAxis(rd.u32(conn))
            let direction = PointerAxisRelativeDirection(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.AxisRelativeDirection(axis, direction))
        }
        11 => {
            guard m.version >= 11 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_pointer.warp needs version 11"))
            }
            let surface_x = rd.fixed(conn)
            let surface_y = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(PointerEvent.Warp(surface_x, surface_y))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_pointer"))
}

/// set the pointer surface
pub fn Pointer.set_cursor(self, mut conn: wire.Conn, serial: u32, surface: Option[Surface], hotspot_x: i32, hotspot_y: i32) {
    var wr = conn.begin(self.id, 0, 8 + 16)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, surface.map(fn(o) => o.id).unwrap_or(0))
    wr.i32(mut conn, hotspot_x)
    wr.i32(mut conn, hotspot_y)
}

/// release the pointer object
pub fn Pointer.release(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    discard conn.begin(self.id, 1, 8)
    conn.remove(self.id)
}

/// Events of wl_keyboard.
pub enum KeyboardEvent {
    /// keyboard mapping (format, fd, size)
    Keymap(KeyboardKeymapFormat, wire.Fd, u32)
    /// enter event (serial, surface, keys)
    Enter(u32, Surface, List[u8])
    /// leave event (serial, surface)
    Leave(u32, Surface)
    /// key event (serial, time, key, state)
    Key(u32, u32, u32, KeyboardKeyState)
    /// modifier and group state (serial, mods_depressed, mods_latched, mods_locked, group)
    Modifiers(u32, u32, u32, u32, u32)
    /// repeat rate and delay (rate, delay)
    RepeatInfo(i32, i32)
}

fn decode_keyboard_event(mut conn: wire.Conn, m: wire.Msg) -> Result[KeyboardEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let format = KeyboardKeymapFormat(rd.u32(conn))
            let fd = rd.fd(mut conn)
            let size = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(KeyboardEvent.Keymap(format, fd, size))
        }
        1 => {
            let serial = rd.u32(conn)
            let surface = Surface { id: rd.object(conn, surface_iface, false) }
            let keys = rd.array(conn)
            try rd.finish(mut conn, m)
            return Ok(KeyboardEvent.Enter(serial, surface, keys))
        }
        2 => {
            let serial = rd.u32(conn)
            let surface = Surface { id: rd.object(conn, surface_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(KeyboardEvent.Leave(serial, surface))
        }
        3 => {
            let serial = rd.u32(conn)
            let time = rd.u32(conn)
            let key = rd.u32(conn)
            let state = KeyboardKeyState(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(KeyboardEvent.Key(serial, time, key, state))
        }
        4 => {
            let serial = rd.u32(conn)
            let mods_depressed = rd.u32(conn)
            let mods_latched = rd.u32(conn)
            let mods_locked = rd.u32(conn)
            let group = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(KeyboardEvent.Modifiers(serial, mods_depressed, mods_latched, mods_locked, group))
        }
        5 => {
            guard m.version >= 4 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_keyboard.repeat_info needs version 4"))
            }
            let rate = rd.i32(conn)
            let delay = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(KeyboardEvent.RepeatInfo(rate, delay))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_keyboard"))
}

/// release the keyboard object
pub fn Keyboard.release(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// Events of wl_touch.
pub enum TouchEvent {
    /// touch down event and beginning of a touch sequence (serial, time, surface, id, x, y)
    Down(u32, u32, Surface, i32, f64, f64)
    /// end of a touch event sequence (serial, time, id)
    Up(u32, u32, i32)
    /// update of touch point coordinates (time, id, x, y)
    Motion(u32, i32, f64, f64)
    /// end of touch frame event
    Frame
    /// touch session cancelled
    Cancel
    /// update shape of touch point (id, major, minor)
    Shape(i32, f64, f64)
    /// update orientation of touch point (id, orientation)
    Orientation(i32, f64)
}

fn decode_touch_event(mut conn: wire.Conn, m: wire.Msg) -> Result[TouchEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let serial = rd.u32(conn)
            let time = rd.u32(conn)
            let surface = Surface { id: rd.object(conn, surface_iface, false) }
            let id_arg = rd.i32(conn)
            let x = rd.fixed(conn)
            let y = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(TouchEvent.Down(serial, time, surface, id_arg, x, y))
        }
        1 => {
            let serial = rd.u32(conn)
            let time = rd.u32(conn)
            let id_arg = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(TouchEvent.Up(serial, time, id_arg))
        }
        2 => {
            let time = rd.u32(conn)
            let id_arg = rd.i32(conn)
            let x = rd.fixed(conn)
            let y = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(TouchEvent.Motion(time, id_arg, x, y))
        }
        3 => {
            try rd.finish(mut conn, m)
            return Ok(TouchEvent.Frame)
        }
        4 => {
            try rd.finish(mut conn, m)
            return Ok(TouchEvent.Cancel)
        }
        5 => {
            guard m.version >= 6 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_touch.shape needs version 6"))
            }
            let id_arg = rd.i32(conn)
            let major = rd.fixed(conn)
            let minor = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(TouchEvent.Shape(id_arg, major, minor))
        }
        6 => {
            guard m.version >= 6 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_touch.orientation needs version 6"))
            }
            let id_arg = rd.i32(conn)
            let orientation = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(TouchEvent.Orientation(id_arg, orientation))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_touch"))
}

/// release the touch object
pub fn Touch.release(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// Events of wl_output.
pub enum OutputEvent {
    /// properties of the output (x, y, physical_width, physical_height, subpixel, make, model, transform)
    Geometry(i32, i32, i32, i32, OutputSubpixel, str, str, OutputTransform)
    /// advertise available modes for the output (flags, width, height, refresh)
    Mode(OutputMode, i32, i32, i32)
    /// sent all information about output
    Done
    /// output scaling properties (factor)
    Scale(i32)
    /// name of this output (name)
    Name(str)
    /// human-readable description of this output (description)
    Description(str)
}

fn decode_output_event(mut conn: wire.Conn, m: wire.Msg) -> Result[OutputEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            let physical_width = rd.i32(conn)
            let physical_height = rd.i32(conn)
            let subpixel = OutputSubpixel(rd.u32(conn))
            let make = rd.str(conn)
            let model = rd.str(conn)
            let transform = OutputTransform(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(OutputEvent.Geometry(x, y, physical_width, physical_height, subpixel, make, model, transform))
        }
        1 => {
            let flags = OutputMode(rd.u32(conn))
            let width = rd.i32(conn)
            let height = rd.i32(conn)
            let refresh = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(OutputEvent.Mode(flags, width, height, refresh))
        }
        2 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_output.done needs version 2"))
            }
            try rd.finish(mut conn, m)
            return Ok(OutputEvent.Done)
        }
        3 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_output.scale needs version 2"))
            }
            let factor = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(OutputEvent.Scale(factor))
        }
        4 => {
            guard m.version >= 4 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_output.name needs version 4"))
            }
            let name = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(OutputEvent.Name(name))
        }
        5 => {
            guard m.version >= 4 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_output.description needs version 4"))
            }
            let description = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(OutputEvent.Description(description))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_output"))
}

/// release the output object
pub fn Output.release(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

