    /// 2x1 subsampled Cb (1) and Cr (2) planes 16 bits per channel
    S216 = 0x36313253
    /// non-subsampled Cb (1) and Cr (2) planes 16 bits per channel
    S416 = 0x36313453
    /// [31:0] x:Cr:Cb:Y 2:10:10:10 little endian
    Xvuy2101010 = 0x30335958
    /// 2x1 subsampled Cr:Cb plane 10 bits per channel packed
    P230 = 0x30333250
    T430 = 0x30333454
    /// 8-bit Y-only
    Y8 = 0x59455247
    /// [31:0] x:Y2:Y1:Y0 2:10:10:10 little endian
    Xyyy2101010 = 0x34415059
}

/// Requests of wl_shm.
pub enum ShmRequest {
    /// create a shm pool (id, fd, size)
    CreatePool(ShmPool, wire.Fd, i32)
    /// release the shm object
    Release
}

fn decode_shm(mut conn: wire.Conn, m: wire.Msg) -> Result[ShmRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let id = ShmPool { id: rd.new_id(mut conn, shm_pool_iface, m.version) }
            let fd = rd.fd(mut conn)
            let size = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(ShmRequest.CreatePool(id, fd, size))
        }
        1 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_shm.release needs version 2"))
            }
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(ShmRequest.Release)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_shm"))
}

/// pixel format description
pub fn Shm.format(self, mut conn: wire.Conn, format: ShmFormat) {
    var wr = conn.begin(self.id, 0, 8 + 4)
    wr.u32(mut conn, u32(format))
}

/// wl_buffer: content for a wl_surface
pub struct Buffer derive(Hash, Show) {
    pub id: u32
}

pub let buffer_iface: u16 = 7
pub let buffer_version: u32 = 1

/// Requests of wl_buffer.
pub enum BufferRequest {
    /// destroy a buffer
    Destroy
}

fn decode_buffer(mut conn: wire.Conn, m: wire.Msg) -> Result[BufferRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(BufferRequest.Destroy)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_buffer"))
}

/// compositor releases buffer
pub fn Buffer.release(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
}

/// wl_data_offer: offer to transfer data
pub struct DataOffer derive(Hash, Show) {
    pub id: u32
}

pub let data_offer_iface: u16 = 8
pub let data_offer_version: u32 = 4

pub enum DataOfferError: u32 {
    /// finish request was called untimely
    InvalidFinish = 0
    /// action mask contains invalid values
    InvalidActionMask = 1
    /// action argument has an invalid value
    InvalidAction = 2
    /// offer doesn't accept this request
    InvalidOffer = 3
}

/// Requests of wl_data_offer.
pub enum DataOfferRequest {
    /// accept one of the offered mime types (serial, mime_type)
    Accept(u32, Option[str])
    /// request that the data is transferred (mime_type, fd)
    Receive(str, wire.Fd)
    /// destroy data offer
    Destroy
    /// the offer will no longer be used
    Finish
    /// set the available/preferred drag-and-drop actions (dnd_actions, preferred_action)
    SetActions(DataDeviceManagerDndAction, DataDeviceManagerDndAction)
}

fn decode_data_offer(mut conn: wire.Conn, m: wire.Msg) -> Result[DataOfferRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let serial = rd.u32(conn)
            let mime_type = rd.opt_str(conn)
            try rd.finish(mut conn, m)
            return Ok(DataOfferRequest.Accept(serial, mime_type))
        }
        1 => {
            let mime_type = rd.str(conn)
            let fd = rd.fd(mut conn)
            try rd.finish(mut conn, m)
            return Ok(DataOfferRequest.Receive(mime_type, fd))
        }
        2 => {
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(DataOfferRequest.Destroy)
        }
        3 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_data_offer.finish needs version 3"))
            }
            try rd.finish(mut conn, m)
            return Ok(DataOfferRequest.Finish)
        }
        4 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_data_offer.set_actions needs version 3"))
            }
            let dnd_actions = DataDeviceManagerDndAction(rd.u32(conn))
            let preferred_action = DataDeviceManagerDndAction(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(DataOfferRequest.SetActions(dnd_actions, preferred_action))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_data_offer"))
}

/// advertise offered mime type
pub fn DataOffer.offer(self, mut conn: wire.Conn, mime_type: &str) {
    var wr = conn.begin(self.id, 0, 8 + wire.str_size(mime_type))
    wr.str(mut conn, mime_type)
}

/// notify the source-side available actions
pub fn DataOffer.source_actions(self, mut conn: wire.Conn, source_actions: DataDeviceManagerDndAction) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    var wr = conn.begin(self.id, 1, 8 + 4)
    wr.u32(mut conn, u32(source_actions))
}

/// notify the selected action
pub fn DataOffer.action(self, mut conn: wire.Conn, dnd_action: DataDeviceManagerDndAction) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    var wr = conn.begin(self.id, 2, 8 + 4)
    wr.u32(mut conn, u32(dnd_action))
}

/// wl_data_source: offer to transfer data
pub struct DataSource derive(Hash, Show) {
    pub id: u32
}

pub let data_source_iface: u16 = 9
pub let data_source_version: u32 = 4

pub enum DataSourceError: u32 {
    /// action mask contains invalid values
    InvalidActionMask = 0
    /// source doesn't accept this request
    InvalidSource = 1
}

/// Requests of wl_data_source.
pub enum DataSourceRequest {
    /// add an offered mime type (mime_type)
    Offer(str)
    /// destroy the data source
    Destroy
    /// set the available drag-and-drop actions (dnd_actions)
    SetActions(DataDeviceManagerDndAction)
}

fn decode_data_source(mut conn: wire.Conn, m: wire.Msg) -> Result[DataSourceRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let mime_type = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(DataSourceRequest.Offer(mime_type))
        }
        1 => {
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(DataSourceRequest.Destroy)
        }
        2 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_data_source.set_actions needs version 3"))
            }
            let dnd_actions = DataDeviceManagerDndAction(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(DataSourceRequest.SetActions(dnd_actions))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_data_source"))
}

/// a target accepts an offered mime type
pub fn DataSource.target(self, mut conn: wire.Conn, mime_type: Option[&str]) {
    var wr = conn.begin(self.id, 0, 8 + wire.opt_str_size(mime_type))
    wr.opt_str(mut conn, mime_type)
}

/// send the data
pub fn DataSource.send(self, mut conn: wire.Conn, mime_type: &str, fd: int) {
    var wr = conn.begin(self.id, 1, 8 + wire.str_size(mime_type))
    wr.str(mut conn, mime_type)
    conn.put_fd(fd)
}

/// selection was cancelled
pub fn DataSource.cancelled(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 2, 8)
}

/// the drag-and-drop operation physically finished
pub fn DataSource.dnd_drop_performed(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    discard conn.begin(self.id, 3, 8)
}

/// the drag-and-drop operation concluded
pub fn DataSource.dnd_finished(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    discard conn.begin(self.id, 4, 8)
}

/// notify the selected action
pub fn DataSource.action(self, mut conn: wire.Conn, dnd_action: DataDeviceManagerDndAction) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    var wr = conn.begin(self.id, 5, 8 + 4)
    wr.u32(mut conn, u32(dnd_action))
}

/// wl_data_device: data transfer device
pub struct DataDevice derive(Hash, Show) {
    pub id: u32
}

pub let data_device_iface: u16 = 10
pub let data_device_version: u32 = 4

pub enum DataDeviceError: u32 {
    /// given wl_surface has another role
    Role = 0
    /// source has already been used
    UsedSource = 1
}

/// Requests of wl_data_device.
pub enum DataDeviceRequest {
    /// start drag-and-drop operation (source, origin, icon, serial)
    StartDrag(Option[DataSource], Surface, Option[Surface], u32)
    /// copy data to the selection (source, serial)
    SetSelection(Option[DataSource], u32)
    /// destroy data device
    Release
}

fn decode_data_device(mut conn: wire.Conn, m: wire.Msg) -> Result[DataDeviceRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let source_raw = rd.object(conn, data_source_iface, true)
            let source: Option[DataSource] = if source_raw == 0 { None } else { Some(DataSource { id: source_raw }) }
            let origin = Surface { id: rd.object(conn, surface_iface, false) }
            let icon_raw = rd.object(conn, surface_iface, true)
            let icon: Option[Surface] = if icon_raw == 0 { None } else { Some(Surface { id: icon_raw }) }
            let serial = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(DataDeviceRequest.StartDrag(source, origin, icon, serial))
        }
        1 => {
            let source_raw = rd.object(conn, data_source_iface, true)
            let source: Option[DataSource] = if source_raw == 0 { None } else { Some(DataSource { id: source_raw }) }
            let serial = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(DataDeviceRequest.SetSelection(source, serial))
        }
        2 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_data_device.release needs version 2"))
            }
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(DataDeviceRequest.Release)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_data_device"))
}

/// introduce a new wl_data_offer
pub fn DataDevice.data_offer(self, mut conn: wire.Conn) -> DataOffer {
    let id = DataOffer { id: conn.alloc(data_offer_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 0, 8 + 4)
    wr.u32(mut conn, id.id)
    return id
}

/// initiate drag-and-drop session
pub fn DataDevice.enter(self, mut conn: wire.Conn, serial: u32, surface: Surface, x: f64, y: f64, id_arg: Option[DataOffer]) {
    var wr = conn.begin(self.id, 1, 8 + 20)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, surface.id)
    wr.fixed(mut conn, x)
    wr.fixed(mut conn, y)
    wr.u32(mut conn, id_arg.map(fn(o) => o.id).unwrap_or(0))
}

/// end drag-and-drop session
pub fn DataDevice.leave(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 2, 8)
}

/// drag-and-drop session motion
pub fn DataDevice.motion(self, mut conn: wire.Conn, time: u32, x: f64, y: f64) {
    var wr = conn.begin(self.id, 3, 8 + 12)
    wr.u32(mut conn, time)
    wr.fixed(mut conn, x)
    wr.fixed(mut conn, y)
}

/// end drag-and-drop session successfully
pub fn DataDevice.drop_(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 4, 8)
}

/// advertise new selection
pub fn DataDevice.selection(self, mut conn: wire.Conn, id_arg: Option[DataOffer]) {
    var wr = conn.begin(self.id, 5, 8 + 4)
    wr.u32(mut conn, id_arg.map(fn(o) => o.id).unwrap_or(0))
}

/// wl_data_device_manager: data transfer interface
pub struct DataDeviceManager derive(Hash, Show) {
    pub id: u32
}

pub let data_device_manager_iface: u16 = 11
pub let data_device_manager_version: u32 = 4

/// drag and drop actions
pub enum DataDeviceManagerDndAction: u32 derive(Flags) {
    /// no action
    None = 0
    /// copy action
    Copy = 1
    /// move action
    Move = 2
    /// ask action
    Ask = 4
}

/// Requests of wl_data_device_manager.
pub enum DataDeviceManagerRequest {
    /// create a new data source (id)
    CreateDataSource(DataSource)
    /// create a new data device (id, seat)
    GetDataDevice(DataDevice, Seat)
    /// destroy wl_data_device_manager
    Release
}

fn decode_data_device_manager(mut conn: wire.Conn, m: wire.Msg) -> Result[DataDeviceManagerRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let id = DataSource { id: rd.new_id(mut conn, data_source_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(DataDeviceManagerRequest.CreateDataSource(id))
        }
        1 => {
            let id = DataDevice { id: rd.new_id(mut conn, data_device_iface, m.version) }
            let seat = Seat { id: rd.object(conn, seat_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(DataDeviceManagerRequest.GetDataDevice(id, seat))
        }
        2 => {
            guard m.version >= 4 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_data_device_manager.release needs version 4"))
            }
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(DataDeviceManagerRequest.Release)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_data_device_manager"))
}

/// wl_shell: create desktop-style surfaces
pub struct Shell derive(Hash, Show) {
    pub id: u32
}

pub let shell_iface: u16 = 12
pub let shell_version: u32 = 1

pub enum ShellError: u32 {
    /// given wl_surface has another role
    Role = 0
}

/// Requests of wl_shell.
pub enum ShellRequest {
    /// create a shell surface from a surface (id, surface)
    GetShellSurface(ShellSurface, Surface)
}

fn decode_shell(mut conn: wire.Conn, m: wire.Msg) -> Result[ShellRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let id = ShellSurface { id: rd.new_id(mut conn, shell_surface_iface, m.version) }
            let surface = Surface { id: rd.object(conn, surface_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(ShellRequest.GetShellSurface(id, surface))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_shell"))
}

/// wl_shell_surface: desktop-style metadata interface
pub struct ShellSurface derive(Hash, Show) {
    pub id: u32
}

pub let shell_surface_iface: u16 = 13
pub let shell_surface_version: u32 = 1

/// edge values for resizing
pub enum ShellSurfaceResize: u32 derive(Flags) {
    /// no edge
    None = 0
    /// top edge
    Top = 1
    /// bottom edge
    Bottom = 2
    /// left edge
    Left = 4
    /// top and left edges
    TopLeft = 5
    /// bottom and left edges
    BottomLeft = 6
    /// right edge
    Right = 8
    /// top and right edges
    TopRight = 9
    /// bottom and right edges
    BottomRight = 10
}

/// details of transient behaviour
pub enum ShellSurfaceTransient: u32 derive(Flags) {
    /// do not set keyboard focus
    Inactive = 0x1
}

/// different method to set the surface fullscreen
pub enum ShellSurfaceFullscreenMethod: u32 {
    /// no preference, apply default policy
    Default = 0
    /// scale, preserve the surface's aspect ratio and center on output
    Scale = 1
    /// switch output mode to the smallest mode that can fit the surface, add black borders to compensate size mismatch
    Driver = 2
    /// no upscaling, center on output and add black borders to compensate size mismatch
    Fill = 3
}

/// Requests of wl_shell_surface.
pub enum ShellSurfaceRequest {
    /// respond to a ping event (serial)
    Pong(u32)
    /// start an interactive move (seat, serial)
    Move(Seat, u32)
    /// start an interactive resize (seat, serial, edges)
    Resize(Seat, u32, ShellSurfaceResize)
    /// make the surface a toplevel surface
    SetToplevel
    /// make the surface a transient surface (parent, x, y, flags)
    SetTransient(Surface, i32, i32, ShellSurfaceTransient)
    /// make the surface a fullscreen surface (method, framerate, output)
    SetFullscreen(ShellSurfaceFullscreenMethod, u32, Option[Output])
    /// make the surface a popup surface (seat, serial, parent, x, y, flags)
    SetPopup(Seat, u32, Surface, i32, i32, ShellSurfaceTransient)
    /// make the surface a maximized surface (output)
    SetMaximized(Option[Output])
    /// set surface title (title)
    SetTitle(str)
    /// set surface class (class_)
    SetClass(str)
}

fn decode_shell_surface(mut conn: wire.Conn, m: wire.Msg) -> Result[ShellSurfaceRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let serial = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceRequest.Pong(serial))
        }
        1 => {
            let seat = Seat { id: rd.object(conn, seat_iface, false) }
            let serial = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceRequest.Move(seat, serial))
        }
        2 => {
            let seat = Seat { id: rd.object(conn, seat_iface, false) }
            let serial = rd.u32(conn)
            let edges = ShellSurfaceResize(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceRequest.Resize(seat, serial, edges))
        }
        3 => {
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceRequest.SetToplevel)
        }
        4 => {
            let parent = Surface { id: rd.object(conn, surface_iface, false) }
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            let flags = ShellSurfaceTransient(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceRequest.SetTransient(parent, x, y, flags))
        }
        5 => {
            let method = ShellSurfaceFullscreenMethod(rd.u32(conn))
            let framerate = rd.u32(conn)
            let output_raw = rd.object(conn, output_iface, true)
            let output: Option[Output] = if output_raw == 0 { None } else { Some(Output { id: output_raw }) }
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceRequest.SetFullscreen(method, framerate, output))
        }
        6 => {
            let seat = Seat { id: rd.object(conn, seat_iface, false) }
            let serial = rd.u32(conn)
            let parent = Surface { id: rd.object(conn, surface_iface, false) }
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            let flags = ShellSurfaceTransient(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceRequest.SetPopup(seat, serial, parent, x, y, flags))
        }
        7 => {
            let output_raw = rd.object(conn, output_iface, true)
            let output: Option[Output] = if output_raw == 0 { None } else { Some(Output { id: output_raw }) }
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceRequest.SetMaximized(output))
        }
        8 => {
            let title = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceRequest.SetTitle(title))
        }
        9 => {
            let class_ = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceRequest.SetClass(class_))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_shell_surface"))
}

/// ping client
pub fn ShellSurface.ping(self, mut conn: wire.Conn, serial: u32) {
    var wr = conn.begin(self.id, 0, 8 + 4)
    wr.u32(mut conn, serial)
}

/// suggest resize
pub fn ShellSurface.configure(self, mut conn: wire.Conn, edges: ShellSurfaceResize, width: i32, height: i32) {
    var wr = conn.begin(self.id, 1, 8 + 12)
    wr.u32(mut conn, u32(edges))
    wr.i32(mut conn, width)
    wr.i32(mut conn, height)
}

/// popup interaction is done
pub fn ShellSurface.popup_done(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 2, 8)
}

/// wl_surface: an onscreen surface
pub struct Surface derive(Hash, Show) {
    pub id: u32
}

pub let surface_iface: u16 = 14
pub let surface_version: u32 = 7

/// wl_surface error values
pub enum SurfaceError: u32 {
    /// buffer scale value is invalid
    InvalidScale = 0
    /// buffer transform value is invalid
    InvalidTransform = 1
    /// buffer size is invalid
    InvalidSize = 2
    /// buffer offset is invalid
    InvalidOffset = 3
    /// surface was destroyed before its role object
    DefunctRoleObject = 4
    /// no buffer was attached
    NoBuffer = 5
}

/// Requests of wl_surface.
pub enum SurfaceRequest {
    /// delete surface
    Destroy
    /// set the surface contents (buffer, x, y)
    Attach(Option[Buffer], i32, i32)
    /// mark part of the surface damaged (x, y, width, height)
    Damage(i32, i32, i32, i32)
    /// request a frame throttling hint (callback)
    Frame(Callback)
    /// set opaque region (region)
    SetOpaqueRegion(Option[Region])
    /// set input region (region)
    SetInputRegion(Option[Region])
    /// commit pending surface state
    Commit
    /// sets the buffer transformation (transform)
    SetBufferTransform(OutputTransform)
    /// sets the buffer scaling factor (scale)
    SetBufferScale(i32)
    /// mark part of the surface damaged using buffer coordinates (x, y, width, height)
    DamageBuffer(i32, i32, i32, i32)
    /// set the surface contents offset (x, y)
    Offset(i32, i32)
    /// get a release callback (callback)
    GetRelease(Callback)
}

fn decode_surface(mut conn: wire.Conn, m: wire.Msg) -> Result[SurfaceRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(SurfaceRequest.Destroy)
        }
        1 => {
            let buffer_raw = rd.object(conn, buffer_iface, true)
            let buffer: Option[Buffer] = if buffer_raw == 0 { None } else { Some(Buffer { id: buffer_raw }) }
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.Attach(buffer, x, y))
        }
        2 => {
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            let width = rd.i32(conn)
            let height = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.Damage(x, y, width, height))
        }
        3 => {
            let callback = Callback { id: rd.new_id(mut conn, callback_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.Frame(callback))
        }
        4 => {
            let region_raw = rd.object(conn, region_iface, true)
            let region: Option[Region] = if region_raw == 0 { None } else { Some(Region { id: region_raw }) }
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.SetOpaqueRegion(region))
        }
        5 => {
            let region_raw = rd.object(conn, region_iface, true)
            let region: Option[Region] = if region_raw == 0 { None } else { Some(Region { id: region_raw }) }
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.SetInputRegion(region))
        }
        6 => {
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.Commit)
        }
        7 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_surface.set_buffer_transform needs version 2"))
            }
            let transform = OutputTransform(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.SetBufferTransform(transform))
        }
        8 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_surface.set_buffer_scale needs version 3"))
            }
            let scale = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.SetBufferScale(scale))
        }
        9 => {
            guard m.version >= 4 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_surface.damage_buffer needs version 4"))
            }
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            let width = rd.i32(conn)
            let height = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.DamageBuffer(x, y, width, height))
        }
        10 => {
            guard m.version >= 5 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_surface.offset needs version 5"))
            }
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.Offset(x, y))
        }
        11 => {
            guard m.version >= 7 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_surface.get_release needs version 7"))
            }
            let callback = Callback { id: rd.new_id(mut conn, callback_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(SurfaceRequest.GetRelease(callback))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_surface"))
}

/// surface enters an output
pub fn Surface.enter(self, mut conn: wire.Conn, output: Output) {
    var wr = conn.begin(self.id, 0, 8 + 4)
    wr.u32(mut conn, output.id)
}

/// surface leaves an output
pub fn Surface.leave(self, mut conn: wire.Conn, output: Output) {
    var wr = conn.begin(self.id, 1, 8 + 4)
    wr.u32(mut conn, output.id)
}

/// preferred buffer scale for the surface
pub fn Surface.preferred_buffer_scale(self, mut conn: wire.Conn, factor: i32) {
    guard conn.version(self.id) >= 6 else {
        return
    }
    var wr = conn.begin(self.id, 2, 8 + 4)
    wr.i32(mut conn, factor)
}

/// preferred buffer transform for the surface
pub fn Surface.preferred_buffer_transform(self, mut conn: wire.Conn, transform: OutputTransform) {
    guard conn.version(self.id) >= 6 else {
        return
    }
    var wr = conn.begin(self.id, 3, 8 + 4)
    wr.u32(mut conn, u32(transform))
}

/// wl_seat: group of input devices
pub struct Seat derive(Hash, Show) {
    pub id: u32
}

pub let seat_iface: u16 = 15
pub let seat_version: u32 = 11

/// seat capability bitmask
pub enum SeatCapability: u32 derive(Flags) {
    /// the seat has pointer devices
    Pointer = 1
    /// the seat has one or more keyboards
    Keyboard = 2
    /// the seat has touch devices
    Touch = 4
}

/// wl_seat error values
pub enum SeatError: u32 {
    /// get_pointer, get_keyboard or get_touch called on seat without the matching capability
    MissingCapability = 0
}

/// Requests of wl_seat.
pub enum SeatRequest {
    /// return pointer object (id)
    GetPointer(Pointer)
    /// return keyboard object (id)
    GetKeyboard(Keyboard)
    /// return touch object (id)
    GetTouch(Touch)
    /// release the seat object
    Release
}

fn decode_seat(mut conn: wire.Conn, m: wire.Msg) -> Result[SeatRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let id = Pointer { id: rd.new_id(mut conn, pointer_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(SeatRequest.GetPointer(id))
        }
        1 => {
            let id = Keyboard { id: rd.new_id(mut conn, keyboard_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(SeatRequest.GetKeyboard(id))
        }
        2 => {
            let id = Touch { id: rd.new_id(mut conn, touch_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(SeatRequest.GetTouch(id))
        }
        3 => {
            guard m.version >= 5 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_seat.release needs version 5"))
            }
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(SeatRequest.Release)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_seat"))
}

/// seat capabilities changed
pub fn Seat.capabilities(self, mut conn: wire.Conn, capabilities: SeatCapability) {
    var wr = conn.begin(self.id, 0, 8 + 4)
    wr.u32(mut conn, u32(capabilities))
}

/// unique identifier for this seat
pub fn Seat.name(self, mut conn: wire.Conn, name: &str) {
    guard conn.version(self.id) >= 2 else {
        return
    }
    var wr = conn.begin(self.id, 1, 8 + wire.str_size(name))
    wr.str(mut conn, name)
}

/// wl_pointer: pointer input device
pub struct Pointer derive(Hash, Show) {
    pub id: u32
}

pub let pointer_iface: u16 = 16
pub let pointer_version: u32 = 11

pub enum PointerError: u32 {
    /// given wl_surface has another role
    Role = 0
}

/// physical button state
pub enum PointerButtonState: u32 {
    /// the button is not pressed
    Released = 0
    /// the button is pressed
    Pressed = 1
}

/// axis types
pub enum PointerAxis: u32 {
    /// vertical axis
    VerticalScroll = 0
    /// horizontal axis
    HorizontalScroll = 1
}

/// axis source types
pub enum PointerAxisSource: u32 {
    /// a physical wheel rotation
    Wheel = 0
    /// finger on a touch surface
    Finger = 1
    /// continuous coordinate space
    Continuous = 2
    /// a physical wheel tilt
    WheelTilt = 3
}

/// axis relative direction
pub enum PointerAxisRelativeDirection: u32 {
    /// physical motion matches axis direction
    Identical = 0
    /// physical motion is the inverse of the axis direction
    Inverted = 1
}

/// Requests of wl_pointer.
pub enum PointerRequest {
    /// set the pointer surface (serial, surface, hotspot_x, hotspot_y)
    SetCursor(u32, Option[Surface], i32, i32)
    /// release the pointer object
    Release
}

fn decode_pointer(mut conn: wire.Conn, m: wire.Msg) -> Result[PointerRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let serial = rd.u32(conn)
            let surface_raw = rd.object(conn, surface_iface, true)
            let surface: Option[Surface] = if surface_raw == 0 { None } else { Some(Surface { id: surface_raw }) }
            let hotspot_x = rd.i32(conn)
            let hotspot_y = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(PointerRequest.SetCursor(serial, surface, hotspot_x, hotspot_y))
        }
        1 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_pointer.release needs version 3"))
            }
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(PointerRequest.Release)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_pointer"))
}

/// enter event
pub fn Pointer.enter(self, mut conn: wire.Conn, serial: u32, surface: Surface, surface_x: f64, surface_y: f64) {
    var wr = conn.begin(self.id, 0, 8 + 16)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, surface.id)
    wr.fixed(mut conn, surface_x)
    wr.fixed(mut conn, surface_y)
}

/// leave event
pub fn Pointer.leave(self, mut conn: wire.Conn, serial: u32, surface: Surface) {
    var wr = conn.begin(self.id, 1, 8 + 8)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, surface.id)
}

/// pointer motion event
pub fn Pointer.motion(self, mut conn: wire.Conn, time: u32, surface_x: f64, surface_y: f64) {
    var wr = conn.begin(self.id, 2, 8 + 12)
    wr.u32(mut conn, time)
    wr.fixed(mut conn, surface_x)
    wr.fixed(mut conn, surface_y)
}

/// pointer button event
pub fn Pointer.button(self, mut conn: wire.Conn, serial: u32, time: u32, button: u32, state: PointerButtonState) {
    var wr = conn.begin(self.id, 3, 8 + 16)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, time)
    wr.u32(mut conn, button)
    wr.u32(mut conn, u32(state))
}

/// axis event
pub fn Pointer.axis(self, mut conn: wire.Conn, time: u32, axis: PointerAxis, value: f64) {
    var wr = conn.begin(self.id, 4, 8 + 12)
    wr.u32(mut conn, time)
    wr.u32(mut conn, u32(axis))
    wr.fixed(mut conn, value)
}

/// end of a pointer event sequence
pub fn Pointer.frame(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 5 else {
        return
    }
    discard conn.begin(self.id, 5, 8)
}

/// axis source event
pub fn Pointer.axis_source(self, mut conn: wire.Conn, axis_source: PointerAxisSource) {
    guard conn.version(self.id) >= 5 else {
        return
    }
    var wr = conn.begin(self.id, 6, 8 + 4)
    wr.u32(mut conn, u32(axis_source))
}

/// axis stop event
pub fn Pointer.axis_stop(self, mut conn: wire.Conn, time: u32, axis: PointerAxis) {
    guard conn.version(self.id) >= 5 else {
        return
    }
    var wr = conn.begin(self.id, 7, 8 + 8)
    wr.u32(mut conn, time)
    wr.u32(mut conn, u32(axis))
}

/// axis click event
pub fn Pointer.axis_discrete(self, mut conn: wire.Conn, axis: PointerAxis, discrete: i32) {
    guard conn.version(self.id) >= 5 else {
        return
    }
    var wr = conn.begin(self.id, 8, 8 + 8)
    wr.u32(mut conn, u32(axis))
    wr.i32(mut conn, discrete)
}

/// axis high-resolution scroll event
pub fn Pointer.axis_value120(self, mut conn: wire.Conn, axis: PointerAxis, value120: i32) {
    guard conn.version(self.id) >= 8 else {
        return
    }
    var wr = conn.begin(self.id, 9, 8 + 8)
    wr.u32(mut conn, u32(axis))
    wr.i32(mut conn, value120)
}

/// axis relative physical direction event
pub fn Pointer.axis_relative_direction(self, mut conn: wire.Conn, axis: PointerAxis, direction: PointerAxisRelativeDirection) {
    guard conn.version(self.id) >= 9 else {
        return
    }
    var wr = conn.begin(self.id, 10, 8 + 8)
    wr.u32(mut conn, u32(axis))
    wr.u32(mut conn, u32(direction))
}

/// pointer warp event
pub fn Pointer.warp(self, mut conn: wire.Conn, surface_x: f64, surface_y: f64) {
    guard conn.version(self.id) >= 11 else {
        return
    }
    var wr = conn.begin(self.id, 11, 8 + 8)
    wr.fixed(mut conn, surface_x)
    wr.fixed(mut conn, surface_y)
}

/// wl_keyboard: keyboard input device
pub struct Keyboard derive(Hash, Show) {
    pub id: u32
}

pub let keyboard_iface: u16 = 17
pub let keyboard_version: u32 = 11

/// keyboard mapping format
pub enum KeyboardKeymapFormat: u32 {
    /// no keymap; client must understand how to interpret the raw keycode
    NoKeymap = 0
    /// libxkbcommon compatible, null-terminated string; to determine the xkb keycode, clients must add 8 to the key event keycode
    XkbV1 = 1
}

/// physical key state
pub enum KeyboardKeyState: u32 {
    /// key is not pressed
    Released = 0
    /// key is pressed
    Pressed = 1
    /// key was repeated
    Repeated = 2
}

/// Requests of wl_keyboard.
pub enum KeyboardRequest {
    /// release the keyboard object
    Release
}

fn decode_keyboard(mut conn: wire.Conn, m: wire.Msg) -> Result[KeyboardRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_keyboard.release needs version 3"))
            }
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(KeyboardRequest.Release)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_keyboard"))
}

/// keyboard mapping
pub fn Keyboard.keymap(self, mut conn: wire.Conn, format: KeyboardKeymapFormat, fd: int, size: u32) {
    var wr = conn.begin(self.id, 0, 8 + 8)
    wr.u32(mut conn, u32(format))
    conn.put_fd(fd)
    wr.u32(mut conn, size)
}

/// enter event
pub fn Keyboard.enter(self, mut conn: wire.Conn, serial: u32, surface: Surface, keys: &[u8]) {
    var wr = conn.begin(self.id, 1, 8 + wire.array_size(keys) + 8)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, surface.id)
    wr.array(mut conn, keys)
}

/// leave event
pub fn Keyboard.leave(self, mut conn: wire.Conn, serial: u32, surface: Surface) {
    var wr = conn.begin(self.id, 2, 8 + 8)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, surface.id)
}

/// key event
pub fn Keyboard.key(self, mut conn: wire.Conn, serial: u32, time: u32, key: u32, state: KeyboardKeyState) {
    var wr = conn.begin(self.id, 3, 8 + 16)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, time)
    wr.u32(mut conn, key)
    wr.u32(mut conn, u32(state))
}

/// modifier and group state
pub fn Keyboard.modifiers(self, mut conn: wire.Conn, serial: u32, mods_depressed: u32, mods_latched: u32, mods_locked: u32, group: u32) {
    var wr = conn.begin(self.id, 4, 8 + 20)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, mods_depressed)
    wr.u32(mut conn, mods_latched)
    wr.u32(mut conn, mods_locked)
    wr.u32(mut conn, group)
}

/// repeat rate and delay
pub fn Keyboard.repeat_info(self, mut conn: wire.Conn, rate: i32, delay: i32) {
    guard conn.version(self.id) >= 4 else {
        return
    }
    var wr = conn.begin(self.id, 5, 8 + 8)
    wr.i32(mut conn, rate)
    wr.i32(mut conn, delay)
}

/// wl_touch: touchscreen input device
pub struct Touch derive(Hash, Show) {
    pub id: u32
}

pub let touch_iface: u16 = 18
pub let touch_version: u32 = 11

/// Requests of wl_touch.
pub enum TouchRequest {
    /// release the touch object
    Release
}

fn decode_touch(mut conn: wire.Conn, m: wire.Msg) -> Result[TouchRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_touch.release needs version 3"))
            }
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(TouchRequest.Release)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_touch"))
}

/// touch down event and beginning of a touch sequence
pub fn Touch.down(self, mut conn: wire.Conn, serial: u32, time: u32, surface: Surface, id_arg: i32, x: f64, y: f64) {
    var wr = conn.begin(self.id, 0, 8 + 24)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, time)
    wr.u32(mut conn, surface.id)
    wr.i32(mut conn, id_arg)
    wr.fixed(mut conn, x)
    wr.fixed(mut conn, y)
}

/// end of a touch event sequence
pub fn Touch.up(self, mut conn: wire.Conn, serial: u32, time: u32, id_arg: i32) {
    var wr = conn.begin(self.id, 1, 8 + 12)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, time)
    wr.i32(mut conn, id_arg)
}

/// update of touch point coordinates
pub fn Touch.motion(self, mut conn: wire.Conn, time: u32, id_arg: i32, x: f64, y: f64) {
    var wr = conn.begin(self.id, 2, 8 + 16)
    wr.u32(mut conn, time)
    wr.i32(mut conn, id_arg)
    wr.fixed(mut conn, x)
    wr.fixed(mut conn, y)
}

/// end of touch frame event
pub fn Touch.frame(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 3, 8)
}

/// touch session cancelled
pub fn Touch.cancel(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 4, 8)
}

/// update shape of touch point
pub fn Touch.shape(self, mut conn: wire.Conn, id_arg: i32, major: f64, minor: f64) {
    guard conn.version(self.id) >= 6 else {
        return
    }
    var wr = conn.begin(self.id, 5, 8 + 12)
    wr.i32(mut conn, id_arg)
    wr.fixed(mut conn, major)
    wr.fixed(mut conn, minor)
}

/// update orientation of touch point
pub fn Touch.orientation(self, mut conn: wire.Conn, id_arg: i32, orientation: f64) {
    guard conn.version(self.id) >= 6 else {
        return
    }
    var wr = conn.begin(self.id, 6, 8 + 8)
    wr.i32(mut conn, id_arg)
    wr.fixed(mut conn, orientation)
}

/// wl_output: compositor output region
pub struct Output derive(Hash, Show) {
    pub id: u32
}

pub let output_iface: u16 = 19
pub let output_version: u32 = 4

/// subpixel geometry information
pub enum OutputSubpixel: u32 {
    /// unknown geometry
    Unknown = 0
    /// no geometry
    None = 1
    /// horizontal RGB
    HorizontalRgb = 2
    /// horizontal BGR
    HorizontalBgr = 3
    /// vertical RGB
    VerticalRgb = 4
    /// vertical BGR
    VerticalBgr = 5
}

/// transformation applied to buffer contents
pub enum OutputTransform: u32 {
    /// no transform
    Normal = 0
    /// 90 degrees counter-clockwise
    Transform90 = 1
    /// 180 degrees counter-clockwise
    Transform180 = 2
    /// 270 degrees counter-clockwise
    Transform270 = 3
    /// 180 degree flip around a vertical axis
    Flipped = 4
    /// flip and rotate 90 degrees counter-clockwise
    Flipped90 = 5
    /// flip and rotate 180 degrees counter-clockwise
    Flipped180 = 6
    /// flip and rotate 270 degrees counter-clockwise
    Flipped270 = 7
}

/// mode information
pub enum OutputMode: u32 derive(Flags) {
    /// indicates this is the current mode
    Current = 0x1
    /// indicates this is the preferred mode
    Preferred = 0x2
}

/// Requests of wl_output.
pub enum OutputRequest {
    /// release the output object
    Release
}

fn decode_output(mut conn: wire.Conn, m: wire.Msg) -> Result[OutputRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_output.release needs version 3"))
            }
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(OutputRequest.Release)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_output"))
}

/// properties of the output
pub fn Output.geometry(self, mut conn: wire.Conn, x: i32, y: i32, physical_width: i32, physical_height: i32, subpixel: OutputSubpixel, make: &str, model: &str, transform: OutputTransform) {
    var wr = conn.begin(self.id, 0, 8 + wire.str_size(make) + wire.str_size(model) + 24)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
    wr.i32(mut conn, physical_width)
    wr.i32(mut conn, physical_height)
    wr.u32(mut conn, u32(subpixel))
    wr.str(mut conn, make)
    wr.str(mut conn, model)
    wr.u32(mut conn, u32(transform))
}

/// advertise available modes for the output
pub fn Output.mode(self, mut conn: wire.Conn, flags: OutputMode, width: i32, height: i32, refresh: i32) {
    var wr = conn.begin(self.id, 1, 8 + 16)
    wr.u32(mut conn, u32(flags))
    wr.i32(mut conn, width)
    wr.i32(mut conn, height)
    wr.i32(mut conn, refresh)
}

/// sent all information about output
pub fn Output.done(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 2 else {
        return
    }
    discard conn.begin(self.id, 2, 8)
}

/// output scaling properties
pub fn Output.scale(self, mut conn: wire.Conn, factor: i32) {
    guard conn.version(self.id) >= 2 else {
        return
    }
    var wr = conn.begin(self.id, 3, 8 + 4)
    wr.i32(mut conn, factor)
}

/// name of this output
pub fn Output.name(self, mut conn: wire.Conn, name: &str) {
    guard conn.version(self.id) >= 4 else {
        return
    }
    var wr = conn.begin(self.id, 4, 8 + wire.str_size(name))
    wr.str(mut conn, name)
}

/// human-readable description of this output
pub fn Output.description(self, mut conn: wire.Conn, description: &str) {
    guard conn.version(self.id) >= 4 else {
        return
    }
    var wr = conn.begin(self.id, 5, 8 + wire.str_size(description))
    wr.str(mut conn, description)
}

/// wl_region: region interface
pub struct Region derive(Hash, Show) {
    pub id: u32
}

pub let region_iface: u16 = 20
pub let region_version: u32 = 7

/// Requests of wl_region.
pub enum RegionRequest {
    /// destroy region
    Destroy
    /// add rectangle to region (x, y, width, height)
    Add(i32, i32, i32, i32)
    /// subtract rectangle from region (x, y, width, height)
    Subtract(i32, i32, i32, i32)
}

fn decode_region(mut conn: wire.Conn, m: wire.Msg) -> Result[RegionRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(RegionRequest.Destroy)
        }
        1 => {
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            let width = rd.i32(conn)
            let height = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(RegionRequest.Add(x, y, width, height))
        }
        2 => {
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            let width = rd.i32(conn)
            let height = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(RegionRequest.Subtract(x, y, width, height))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_region"))
}

/// wl_subcompositor: sub-surface compositing
pub struct Subcompositor derive(Hash, Show) {
    pub id: u32
}

pub let subcompositor_iface: u16 = 21
pub let subcompositor_version: u32 = 1

pub enum SubcompositorError: u32 {
    /// the to-be sub-surface is invalid
    BadSurface = 0
    /// the to-be sub-surface parent is invalid
    BadParent = 1
}

/// Requests of wl_subcompositor.
pub enum SubcompositorRequest {
    /// unbind from the subcompositor interface
    Destroy
    /// give a surface the role sub-surface (id, surface, parent)
    GetSubsurface(Subsurface, Surface, Surface)
}

fn decode_subcompositor(mut conn: wire.Conn, m: wire.Msg) -> Result[SubcompositorRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(SubcompositorRequest.Destroy)
        }
        1 => {
            let id = Subsurface { id: rd.new_id(mut conn, subsurface_iface, m.version) }
            let surface = Surface { id: rd.object(conn, surface_iface, false) }
            let parent = Surface { id: rd.object(conn, surface_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(SubcompositorRequest.GetSubsurface(id, surface, parent))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_subcompositor"))
}

/// wl_subsurface: sub-surface interface to a wl_surface
pub struct Subsurface derive(Hash, Show) {
    pub id: u32
}

pub let subsurface_iface: u16 = 22
pub let subsurface_version: u32 = 1

pub enum SubsurfaceError: u32 {
    /// wl_surface is not a sibling or the parent
    BadSurface = 0
}

/// Requests of wl_subsurface.
pub enum SubsurfaceRequest {
    /// remove sub-surface interface
    Destroy
    /// reposition the sub-surface (x, y)
    SetPosition(i32, i32)
    /// restack the sub-surface (sibling)
    PlaceAbove(Surface)
    /// restack the sub-surface (sibling)
    PlaceBelow(Surface)
    /// set sub-surface to synchronized mode
    SetSync
    /// set sub-surface to desynchronized mode
    SetDesync
}

fn decode_subsurface(mut conn: wire.Conn, m: wire.Msg) -> Result[SubsurfaceRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(SubsurfaceRequest.Destroy)
        }
        1 => {
            let x = rd.i32(conn)
            let y = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(SubsurfaceRequest.SetPosition(x, y))
        }
        2 => {
            let sibling = Surface { id: rd.object(conn, surface_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(SubsurfaceRequest.PlaceAbove(sibling))
        }
        3 => {
            let sibling = Surface { id: rd.object(conn, surface_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(SubsurfaceRequest.PlaceBelow(sibling))
        }
        4 => {
            try rd.finish(mut conn, m)
            return Ok(SubsurfaceRequest.SetSync)
        }
        5 => {
            try rd.finish(mut conn, m)
            return Ok(SubsurfaceRequest.SetDesync)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_subsurface"))
}

/// wl_fixes: wayland protocol fixes
pub struct Fixes derive(Hash, Show) {
    pub id: u32
}

pub let fixes_iface: u16 = 23
pub let fixes_version: u32 = 2

/// wl_fixes error values
pub enum FixesError: u32 {
    /// unknown global or the global is not removed
    InvalidAckRemove = 0
}

/// Requests of wl_fixes.
pub enum FixesRequest {
    /// destroys this object
    Destroy
    /// destroy a wl_registry (registry)
    DestroyRegistry(Registry)
    /// acknowledge global removal (registry, name)
    AckGlobalRemove(Registry, u32)
}

fn decode_fixes(mut conn: wire.Conn, m: wire.Msg) -> Result[FixesRequest, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(FixesRequest.Destroy)
        }
        1 => {
            let registry = Registry { id: rd.object(conn, registry_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(FixesRequest.DestroyRegistry(registry))
        }
        2 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_fixes.ack_global_remove needs version 2"))
            }
            let registry = Registry { id: rd.object(conn, registry_iface, false) }
            let name = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(FixesRequest.AckGlobalRemove(registry, name))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid request {m.op} on wl_fixes"))
}

/// Events of wl_display.
pub enum DisplayEvent {
    /// fatal error event (object_id, code, message)
    Error(u32, u32, str)
    /// acknowledge object ID deletion (id)
    DeleteId(u32)
}

fn decode_display_event(mut conn: wire.Conn, m: wire.Msg) -> Result[DisplayEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let object_id = rd.object(conn, 0, false)
            let code = rd.u32(conn)
            let message = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(DisplayEvent.Error(object_id, code, message))
        }
        1 => {
            let id_arg = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(DisplayEvent.DeleteId(id_arg))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_display"))
}

/// asynchronous roundtrip
pub fn Display.sync(self, mut conn: wire.Conn) -> Callback {
    let callback = Callback { id: conn.alloc(callback_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 0, 8 + 4)
    wr.u32(mut conn, callback.id)
    return callback
}

/// get global registry object
pub fn Display.get_registry(self, mut conn: wire.Conn) -> Registry {
    let registry = Registry { id: conn.alloc(registry_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 1, 8 + 4)
    wr.u32(mut conn, registry.id)
    return registry
}

/// Events of wl_registry.
pub enum RegistryEvent {
    /// announce global object (name, interface, version)
    Global(u32, str, u32)
    /// announce removal of global object (name)
    GlobalRemove(u32)
}

fn decode_registry_event(mut conn: wire.Conn, m: wire.Msg) -> Result[RegistryEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let name = rd.u32(conn)
            let interface = rd.str(conn)
            let version = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(RegistryEvent.Global(name, interface, version))
        }
        1 => {
            let name = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(RegistryEvent.GlobalRemove(name))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_registry"))
}

/// bind an object to the display
pub fn Registry.bind(self, mut conn: wire.Conn, name: u32, iface: u16, version: u32) -> u32 {
    let id = conn.alloc(iface, version)
    var wr = conn.begin(self.id, 0, 8 + wire.str_size(ifaces.name(iface)) + 8 + 4)
    wr.u32(mut conn, name)
    wr.str(mut conn, ifaces.name(iface))
    wr.u32(mut conn, version)
    wr.u32(mut conn, id)
    return id
}

/// Events of wl_callback.
pub enum CallbackEvent {
    /// done event (callback_data)
    Done(u32)
}

fn decode_callback_event(mut conn: wire.Conn, m: wire.Msg) -> Result[CallbackEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let callback_data = rd.u32(conn)
            try rd.finish(mut conn, m)
            conn.remove(m.id)
            return Ok(CallbackEvent.Done(callback_data))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_callback"))
}

/// create new surface
pub fn Compositor.create_surface(self, mut conn: wire.Conn) -> Surface {
    let id = Surface { id: conn.alloc(surface_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 0, 8 + 4)
    wr.u32(mut conn, id.id)
    return id
}

/// create new region
pub fn Compositor.create_region(self, mut conn: wire.Conn) -> Region {
    let id = Region { id: conn.alloc(region_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 1, 8 + 4)
    wr.u32(mut conn, id.id)
    return id
}

/// destroy wl_compositor
pub fn Compositor.release(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 7 else {
        return
    }
    discard conn.begin(self.id, 2, 8)
    conn.remove(self.id)
}

/// create a buffer from the pool
pub fn ShmPool.create_buffer(self, mut conn: wire.Conn, offset: i32, width: i32, height: i32, stride: i32, format: ShmFormat) -> Buffer {
    let id = Buffer { id: conn.alloc(buffer_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 0, 8 + 24)
    wr.u32(mut conn, id.id)
    wr.i32(mut conn, offset)
    wr.i32(mut conn, width)
    wr.i32(mut conn, height)
    wr.i32(mut conn, stride)
    wr.u32(mut conn, u32(format))
    return id
}

/// destroy the pool
pub fn ShmPool.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 1, 8)
    conn.remove(self.id)
}

/// change the size of the pool mapping
pub fn ShmPool.resize(self, mut conn: wire.Conn, size: i32) {
    var wr = conn.begin(self.id, 2, 8 + 4)
    wr.i32(mut conn, size)
}

/// Events of wl_shm.
pub enum ShmEvent {
    /// pixel format description (format)
    Format(ShmFormat)
}

fn decode_shm_event(mut conn: wire.Conn, m: wire.Msg) -> Result[ShmEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let format = ShmFormat(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(ShmEvent.Format(format))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_shm"))
}

/// create a shm pool
pub fn Shm.create_pool(self, mut conn: wire.Conn, fd: int, size: i32) -> ShmPool {
    let id = ShmPool { id: conn.alloc(shm_pool_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 0, 8 + 8)
    wr.u32(mut conn, id.id)
    conn.put_fd(fd)
    wr.i32(mut conn, size)
    return id
}

/// release the shm object
pub fn Shm.release(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 2 else {
        return
    }
    discard conn.begin(self.id, 1, 8)
    conn.remove(self.id)
}

/// Events of wl_buffer.
pub enum BufferEvent {
    /// compositor releases buffer
    Release
}

fn decode_buffer_event(mut conn: wire.Conn, m: wire.Msg) -> Result[BufferEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            try rd.finish(mut conn, m)
            return Ok(BufferEvent.Release)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_buffer"))
}

/// destroy a buffer
pub fn Buffer.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// Events of wl_data_offer.
pub enum DataOfferEvent {
    /// advertise offered mime type (mime_type)
    Offer(str)
    /// notify the source-side available actions (source_actions)
    SourceActions(DataDeviceManagerDndAction)
    /// notify the selected action (dnd_action)
    Action(DataDeviceManagerDndAction)
}

fn decode_data_offer_event(mut conn: wire.Conn, m: wire.Msg) -> Result[DataOfferEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let mime_type = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(DataOfferEvent.Offer(mime_type))
        }
        1 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_data_offer.source_actions needs version 3"))
            }
            let source_actions = DataDeviceManagerDndAction(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(DataOfferEvent.SourceActions(source_actions))
        }
        2 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_data_offer.action needs version 3"))
            }
            let dnd_action = DataDeviceManagerDndAction(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(DataOfferEvent.Action(dnd_action))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_data_offer"))
}

/// accept one of the offered mime types
pub fn DataOffer.accept(self, mut conn: wire.Conn, serial: u32, mime_type: Option[&str]) {
    var wr = conn.begin(self.id, 0, 8 + wire.opt_str_size(mime_type) + 4)
    wr.u32(mut conn, serial)
    wr.opt_str(mut conn, mime_type)
}

/// request that the data is transferred
pub fn DataOffer.receive(self, mut conn: wire.Conn, mime_type: &str, fd: int) {
    var wr = conn.begin(self.id, 1, 8 + wire.str_size(mime_type))
    wr.str(mut conn, mime_type)
    conn.put_fd(fd)
}

/// destroy data offer
pub fn DataOffer.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 2, 8)
    conn.remove(self.id)
}

/// the offer will no longer be used
pub fn DataOffer.finish(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    discard conn.begin(self.id, 3, 8)
}

/// set the available/preferred drag-and-drop actions
pub fn DataOffer.set_actions(self, mut conn: wire.Conn, dnd_actions: DataDeviceManagerDndAction, preferred_action: DataDeviceManagerDndAction) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    var wr = conn.begin(self.id, 4, 8 + 8)
    wr.u32(mut conn, u32(dnd_actions))
    wr.u32(mut conn, u32(preferred_action))
}

/// Events of wl_data_source.
pub enum DataSourceEvent {
    /// a target accepts an offered mime type (mime_type)
    Target(Option[str])
    /// send the data (mime_type, fd)
    Send(str, wire.Fd)
    /// selection was cancelled
    Cancelled
    /// the drag-and-drop operation physically finished
    DndDropPerformed
    /// the drag-and-drop operation concluded
    DndFinished
    /// notify the selected action (dnd_action)
    Action(DataDeviceManagerDndAction)
}

fn decode_data_source_event(mut conn: wire.Conn, m: wire.Msg) -> Result[DataSourceEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let mime_type = rd.opt_str(conn)
            try rd.finish(mut conn, m)
            return Ok(DataSourceEvent.Target(mime_type))
        }
        1 => {
            let mime_type = rd.str(conn)
            let fd = rd.fd(mut conn)
            try rd.finish(mut conn, m)
            return Ok(DataSourceEvent.Send(mime_type, fd))
        }
        2 => {
            try rd.finish(mut conn, m)
            return Ok(DataSourceEvent.Cancelled)
        }
        3 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_data_source.dnd_drop_performed needs version 3"))
            }
            try rd.finish(mut conn, m)
            return Ok(DataSourceEvent.DndDropPerformed)
        }
        4 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_data_source.dnd_finished needs version 3"))
            }
            try rd.finish(mut conn, m)
            return Ok(DataSourceEvent.DndFinished)
        }
        5 => {
            guard m.version >= 3 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_data_source.action needs version 3"))
            }
            let dnd_action = DataDeviceManagerDndAction(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(DataSourceEvent.Action(dnd_action))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_data_source"))
}

/// add an offered mime type
pub fn DataSource.offer(self, mut conn: wire.Conn, mime_type: &str) {
    var wr = conn.begin(self.id, 0, 8 + wire.str_size(mime_type))
    wr.str(mut conn, mime_type)
}

/// destroy the data source
pub fn DataSource.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 1, 8)
    conn.remove(self.id)
}

/// set the available drag-and-drop actions
pub fn DataSource.set_actions(self, mut conn: wire.Conn, dnd_actions: DataDeviceManagerDndAction) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    var wr = conn.begin(self.id, 2, 8 + 4)
    wr.u32(mut conn, u32(dnd_actions))
}

/// Events of wl_data_device.
pub enum DataDeviceEvent {
    /// introduce a new wl_data_offer (id)
    DataOffer(DataOffer)
    /// initiate drag-and-drop session (serial, surface, x, y, id)
    Enter(u32, Surface, f64, f64, Option[DataOffer])
    /// end drag-and-drop session
    Leave
    /// drag-and-drop session motion (time, x, y)
    Motion(u32, f64, f64)
    /// end drag-and-drop session successfully
    Drop
    /// advertise new selection (id)
    Selection(Option[DataOffer])
}

fn decode_data_device_event(mut conn: wire.Conn, m: wire.Msg) -> Result[DataDeviceEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let id = DataOffer { id: rd.new_id(mut conn, data_offer_iface, m.version) }
            try rd.finish(mut conn, m)
            return Ok(DataDeviceEvent.DataOffer(id))
        }
        1 => {
            let serial = rd.u32(conn)
            let surface = Surface { id: rd.object(conn, surface_iface, false) }
            let x = rd.fixed(conn)
            let y = rd.fixed(conn)
            let id_arg_raw = rd.object(conn, data_offer_iface, true)
            let id_arg: Option[DataOffer] = if id_arg_raw == 0 { None } else { Some(DataOffer { id: id_arg_raw }) }
            try rd.finish(mut conn, m)
            return Ok(DataDeviceEvent.Enter(serial, surface, x, y, id_arg))
        }
        2 => {
            try rd.finish(mut conn, m)
            return Ok(DataDeviceEvent.Leave)
        }
        3 => {
            let time = rd.u32(conn)
            let x = rd.fixed(conn)
            let y = rd.fixed(conn)
            try rd.finish(mut conn, m)
            return Ok(DataDeviceEvent.Motion(time, x, y))
        }
        4 => {
            try rd.finish(mut conn, m)
            return Ok(DataDeviceEvent.Drop)
        }
        5 => {
            let id_arg_raw = rd.object(conn, data_offer_iface, true)
            let id_arg: Option[DataOffer] = if id_arg_raw == 0 { None } else { Some(DataOffer { id: id_arg_raw }) }
            try rd.finish(mut conn, m)
            return Ok(DataDeviceEvent.Selection(id_arg))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_data_device"))
}

/// start drag-and-drop operation
pub fn DataDevice.start_drag(self, mut conn: wire.Conn, source: Option[DataSource], origin: Surface, icon: Option[Surface], serial: u32) {
    var wr = conn.begin(self.id, 0, 8 + 16)
    wr.u32(mut conn, source.map(fn(o) => o.id).unwrap_or(0))
    wr.u32(mut conn, origin.id)
    wr.u32(mut conn, icon.map(fn(o) => o.id).unwrap_or(0))
    wr.u32(mut conn, serial)
}

/// copy data to the selection
pub fn DataDevice.set_selection(self, mut conn: wire.Conn, source: Option[DataSource], serial: u32) {
    var wr = conn.begin(self.id, 1, 8 + 8)
    wr.u32(mut conn, source.map(fn(o) => o.id).unwrap_or(0))
    wr.u32(mut conn, serial)
}

/// destroy data device
pub fn DataDevice.release(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 2 else {
        return
    }
    discard conn.begin(self.id, 2, 8)
    conn.remove(self.id)
}

/// create a new data source
pub fn DataDeviceManager.create_data_source(self, mut conn: wire.Conn) -> DataSource {
    let id = DataSource { id: conn.alloc(data_source_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 0, 8 + 4)
    wr.u32(mut conn, id.id)
    return id
}

/// create a new data device
pub fn DataDeviceManager.get_data_device(self, mut conn: wire.Conn, seat: Seat) -> DataDevice {
    let id = DataDevice { id: conn.alloc(data_device_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 1, 8 + 8)
    wr.u32(mut conn, id.id)
    wr.u32(mut conn, seat.id)
    return id
}

/// destroy wl_data_device_manager
pub fn DataDeviceManager.release(self, mut conn: wire.Conn) {
    guard conn.version(self.id) >= 4 else {
        return
    }
    discard conn.begin(self.id, 2, 8)
    conn.remove(self.id)
}

/// create a shell surface from a surface
pub fn Shell.get_shell_surface(self, mut conn: wire.Conn, surface: Surface) -> ShellSurface {
    let id = ShellSurface { id: conn.alloc(shell_surface_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 0, 8 + 8)
    wr.u32(mut conn, id.id)
    wr.u32(mut conn, surface.id)
    return id
}

/// Events of wl_shell_surface.
pub enum ShellSurfaceEvent {
    /// ping client (serial)
    Ping(u32)
    /// suggest resize (edges, width, height)
    Configure(ShellSurfaceResize, i32, i32)
    /// popup interaction is done
    PopupDone
}

fn decode_shell_surface_event(mut conn: wire.Conn, m: wire.Msg) -> Result[ShellSurfaceEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let serial = rd.u32(conn)
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceEvent.Ping(serial))
        }
        1 => {
            let edges = ShellSurfaceResize(rd.u32(conn))
            let width = rd.i32(conn)
            let height = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceEvent.Configure(edges, width, height))
        }
        2 => {
            try rd.finish(mut conn, m)
            return Ok(ShellSurfaceEvent.PopupDone)
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_shell_surface"))
}

/// respond to a ping event
pub fn ShellSurface.pong(self, mut conn: wire.Conn, serial: u32) {
    var wr = conn.begin(self.id, 0, 8 + 4)
    wr.u32(mut conn, serial)
}

/// start an interactive move
pub fn ShellSurface.move(self, mut conn: wire.Conn, seat: Seat, serial: u32) {
    var wr = conn.begin(self.id, 1, 8 + 8)
    wr.u32(mut conn, seat.id)
    wr.u32(mut conn, serial)
}

/// start an interactive resize
pub fn ShellSurface.resize(self, mut conn: wire.Conn, seat: Seat, serial: u32, edges: ShellSurfaceResize) {
    var wr = conn.begin(self.id, 2, 8 + 12)
    wr.u32(mut conn, seat.id)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, u32(edges))
}

/// make the surface a toplevel surface
pub fn ShellSurface.set_toplevel(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 3, 8)
}

/// make the surface a transient surface
pub fn ShellSurface.set_transient(self, mut conn: wire.Conn, parent: Surface, x: i32, y: i32, flags: ShellSurfaceTransient) {
    var wr = conn.begin(self.id, 4, 8 + 16)
    wr.u32(mut conn, parent.id)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
    wr.u32(mut conn, u32(flags))
}

/// make the surface a fullscreen surface
pub fn ShellSurface.set_fullscreen(self, mut conn: wire.Conn, method: ShellSurfaceFullscreenMethod, framerate: u32, output: Option[Output]) {
    var wr = conn.begin(self.id, 5, 8 + 12)
    wr.u32(mut conn, u32(method))
    wr.u32(mut conn, framerate)
    wr.u32(mut conn, output.map(fn(o) => o.id).unwrap_or(0))
}

/// make the surface a popup surface
pub fn ShellSurface.set_popup(self, mut conn: wire.Conn, seat: Seat, serial: u32, parent: Surface, x: i32, y: i32, flags: ShellSurfaceTransient) {
    var wr = conn.begin(self.id, 6, 8 + 24)
    wr.u32(mut conn, seat.id)
    wr.u32(mut conn, serial)
    wr.u32(mut conn, parent.id)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
    wr.u32(mut conn, u32(flags))
}

/// make the surface a maximized surface
pub fn ShellSurface.set_maximized(self, mut conn: wire.Conn, output: Option[Output]) {
    var wr = conn.begin(self.id, 7, 8 + 4)
    wr.u32(mut conn, output.map(fn(o) => o.id).unwrap_or(0))
}

/// set surface title
pub fn ShellSurface.set_title(self, mut conn: wire.Conn, title: &str) {
    var wr = conn.begin(self.id, 8, 8 + wire.str_size(title))
    wr.str(mut conn, title)
}

/// set surface class
pub fn ShellSurface.set_class(self, mut conn: wire.Conn, class_: &str) {
    var wr = conn.begin(self.id, 9, 8 + wire.str_size(class_))
    wr.str(mut conn, class_)
}

/// Events of wl_surface.
pub enum SurfaceEvent {
    /// surface enters an output (output)
    Enter(Output)
    /// surface leaves an output (output)
    Leave(Output)
    /// preferred buffer scale for the surface (factor)
    PreferredBufferScale(i32)
    /// preferred buffer transform for the surface (transform)
    PreferredBufferTransform(OutputTransform)
}

fn decode_surface_event(mut conn: wire.Conn, m: wire.Msg) -> Result[SurfaceEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let output = Output { id: rd.object(conn, output_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(SurfaceEvent.Enter(output))
        }
        1 => {
            let output = Output { id: rd.object(conn, output_iface, false) }
            try rd.finish(mut conn, m)
            return Ok(SurfaceEvent.Leave(output))
        }
        2 => {
            guard m.version >= 6 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_surface.preferred_buffer_scale needs version 6"))
            }
            let factor = rd.i32(conn)
            try rd.finish(mut conn, m)
            return Ok(SurfaceEvent.PreferredBufferScale(factor))
        }
        3 => {
            guard m.version >= 6 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_surface.preferred_buffer_transform needs version 6"))
            }
            let transform = OutputTransform(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(SurfaceEvent.PreferredBufferTransform(transform))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_surface"))
}

/// delete surface
pub fn Surface.destroy(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 0, 8)
    conn.remove(self.id)
}

/// set the surface contents
pub fn Surface.attach(self, mut conn: wire.Conn, buffer: Option[Buffer], x: i32, y: i32) {
    var wr = conn.begin(self.id, 1, 8 + 12)
    wr.u32(mut conn, buffer.map(fn(o) => o.id).unwrap_or(0))
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
}

/// mark part of the surface damaged
pub fn Surface.damage(self, mut conn: wire.Conn, x: i32, y: i32, width: i32, height: i32) {
    var wr = conn.begin(self.id, 2, 8 + 16)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
    wr.i32(mut conn, width)
    wr.i32(mut conn, height)
}

/// request a frame throttling hint
pub fn Surface.frame(self, mut conn: wire.Conn) -> Callback {
    let callback = Callback { id: conn.alloc(callback_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 3, 8 + 4)
    wr.u32(mut conn, callback.id)
    return callback
}

/// set opaque region
pub fn Surface.set_opaque_region(self, mut conn: wire.Conn, region: Option[Region]) {
    var wr = conn.begin(self.id, 4, 8 + 4)
    wr.u32(mut conn, region.map(fn(o) => o.id).unwrap_or(0))
}

/// set input region
pub fn Surface.set_input_region(self, mut conn: wire.Conn, region: Option[Region]) {
    var wr = conn.begin(self.id, 5, 8 + 4)
    wr.u32(mut conn, region.map(fn(o) => o.id).unwrap_or(0))
}

/// commit pending surface state
pub fn Surface.commit(self, mut conn: wire.Conn) {
    discard conn.begin(self.id, 6, 8)
}

/// sets the buffer transformation
pub fn Surface.set_buffer_transform(self, mut conn: wire.Conn, transform: OutputTransform) {
    guard conn.version(self.id) >= 2 else {
        return
    }
    var wr = conn.begin(self.id, 7, 8 + 4)
    wr.u32(mut conn, u32(transform))
}

/// sets the buffer scaling factor
pub fn Surface.set_buffer_scale(self, mut conn: wire.Conn, scale: i32) {
    guard conn.version(self.id) >= 3 else {
        return
    }
    var wr = conn.begin(self.id, 8, 8 + 4)
    wr.i32(mut conn, scale)
}

/// mark part of the surface damaged using buffer coordinates
pub fn Surface.damage_buffer(self, mut conn: wire.Conn, x: i32, y: i32, width: i32, height: i32) {
    guard conn.version(self.id) >= 4 else {
        return
    }
    var wr = conn.begin(self.id, 9, 8 + 16)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
    wr.i32(mut conn, width)
    wr.i32(mut conn, height)
}

/// set the surface contents offset
pub fn Surface.offset(self, mut conn: wire.Conn, x: i32, y: i32) {
    guard conn.version(self.id) >= 5 else {
        return
    }
    var wr = conn.begin(self.id, 10, 8 + 8)
    wr.i32(mut conn, x)
    wr.i32(mut conn, y)
}

/// get a release callback
pub fn Surface.get_release(self, mut conn: wire.Conn) -> Callback {
    guard conn.version(self.id) >= 7 else {
        return Callback { id: 0 }
    }
    let callback = Callback { id: conn.alloc(callback_iface, conn.version(self.id)) }
    var wr = conn.begin(self.id, 11, 8 + 4)
    wr.u32(mut conn, callback.id)
    return callback
}

/// Events of wl_seat.
pub enum SeatEvent {
    /// seat capabilities changed (capabilities)
    Capabilities(SeatCapability)
    /// unique identifier for this seat (name)
    Name(str)
}

fn decode_seat_event(mut conn: wire.Conn, m: wire.Msg) -> Result[SeatEvent, wire.Error] {
    var rd = conn.reader(m)
    match m.op {
        0 => {
            let capabilities = SeatCapability(rd.u32(conn))
            try rd.finish(mut conn, m)
            return Ok(SeatEvent.Capabilities(capabilities))
        }
        1 => {
            guard m.version >= 2 else {
                return Err(conn.error(m.id, wire.invalid_method, "wl_seat.name needs version 2"))
            }
            let name = rd.str(conn)
            try rd.finish(mut conn, m)
            return Ok(SeatEvent.Name(name))
        }
        _ => {}
    }
    return Err(conn.error(m.id, wire.invalid_method, "invalid event {m.op} on wl_seat"))
}

