luminaria_lib = static_library('luminaria',
  files(
    'core/display.cpp',
    'core/event_loop.cpp',
    'backend/headless.cpp',
    'backend/wayland.cpp',
    'backend/drm.cpp',
    'backend/libinput.cpp',
    'backend/session.cpp',
    'xwayland/xwayland.cpp',
    'render/vulkan.cpp',
    'render/cursor_theme.cpp',
    'types/compositor.cpp',
    'types/xdg_shell.cpp',
    'scene/scene.cpp',
    'types/seat.cpp',
    'types/output_global.cpp',
    'types/screencopy.cpp',
    'types/linux_dmabuf.cpp',
    'types/subcompositor.cpp',
    'types/data_device.cpp',
    'types/drm_syncobj.cpp',
    'types/single_pixel_buffer.cpp',
    'types/presentation_time.cpp',
    'types/tearing_control.cpp',
    'types/cursor_shape.cpp',
    'types/workspace.cpp',
    'scene/output_layout.cpp',
    'types/xdg_decoration.cpp',
    'types/viewporter.cpp',
    'types/fractional_scale.cpp',
  ),
  xdg_shell_c,         # generated protocol code
  xdg_shell_h,         # generated server header (also on the include path)
  xdg_shell_client_h,  # nested backend acts as a client of the parent
  xdg_decoration_c, xdg_decoration_h, xdg_decoration_client_h, # decoration, both ways
  viewporter_c, viewporter_h,
  fractional_scale_c, fractional_scale_h,
  dmabuf_c, dmabuf_h,  # linux-dmabuf-v1 server glue
  primary_sel_c, primary_sel_h,
  xdg_output_c, xdg_output_h,
  syncobj_c, syncobj_h,
  single_pixel_c, single_pixel_h,
  presentation_c, presentation_h,
  tearing_c, tearing_h,
  cursor_shape_c, cursor_shape_h, tablet_c, tablet_h,
  workspace_c, workspace_h,
  quad_vert_spv, quad_frag_spv,  # SPIR-V for the textured-quad pipeline
  wlr_screencopy_c, wlr_screencopy_h,
  ext_copy_capture_c, ext_copy_capture_h,
  ext_capture_source_c, ext_capture_source_h,
  include_directories : luminaria_inc,
  dependencies : luminaria_deps,
)

luminaria_dep = declare_dependency(
  link_with : luminaria_lib,
  include_directories : luminaria_inc,
  dependencies : luminaria_deps,
)
