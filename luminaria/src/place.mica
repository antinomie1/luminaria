// The layout made concrete: each output's placements, animations and
// occlusion.

import std.collections.map
import std.mem
import std.os
import std.time
import luminaria_types as types
import luminaria_server as server
import layout
import shell
import plug
import display
import manipulation

/// A placement's last shown position, and its animation.
struct Anim {
    x: f64 = 0.0
    y: f64 = 0.0
    opacity: f32 = 1.0
    fx: f64 = 0.0
    fy: f64 = 0.0
    fo: f32 = 1.0
    t0: int = 0
    dur: int = 0
}

/// The output containing global point `x, y`, or -1.
fn output_at[O: plug.Output, R: plug.Renderer](d: display.Display[O, R], x: f64, y: f64) -> int {
    for o in 0..d.outs.len() {
        let out = d.outs[o]
        if out.alive and x >= out.x and y >= out.y and x < out.x + out.lw() and y < out.y + out.lh() {
            return o
        }
    }
    return -1
}

/// Where placement `key` shows now: animated toward `x, y, opacity`.
fn animate[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], key: u64, x: f64, y: f64, opacity: f32, ms: int, now: int) -> (f64, f64, f32) {
    guard let Some(cur) = d.anims.get(key) else {
        discard d.anims.insert(key, Anim { x, y, opacity })
        return (x, y, opacity)
    }
    var a = cur
    if a.x != x or a.y != y or a.opacity != opacity {
        // A new target: start from where it shows now.
        let (cx, cy, co) = a.at(now)
        a = Anim { x, y, opacity, fx: cx, fy: cy, fo: co, t0: now, dur: if ms > 0 { ms * 1000000 } else { 0 } }
        discard d.anims.insert(key, a)
    }
    let (rx, ry, ro) = a.at(now)
    if a.dur > 0 and now < a.t0 + a.dur {
        d.animating = true
    }
    return (rx, ry, ro)
}

fn Anim.at(self, now: int) -> (f64, f64, f32) {
    guard self.dur > 0 and now < self.t0 + self.dur else {
        return (self.x, self.y, self.opacity)
    }
    let t = f64(now - self.t0) / f64(self.dur)
    let u = 1.0 - t
    let e = 1.0 - u * u * u
    return (self.fx + (self.x - self.fx) * e, self.fy + (self.y - self.fy) * e, self.fo + (self.opacity - self.fo) * f32(e))
}

/// Turn the layout (and the library's offsets) into each output's
/// placements, hit rectangles and surface outputs, reusing scratch buffers
/// and indexing popups by root surface to avoid per-frame allocations.
fn rebuild[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R]) {
    let now = time.now_ns()
    d.animating = false
    d.hits.clear()
    d.origins.clear()
    d.surf_keys.clear()
    d.surf_window.clear()
    d.blocked_keys.clear()
    d.blocked_wins.clear()
    for o in 0..d.outs.len() {
        d.outs[o].has_blocked = false
    }
    var per = mem.replace(mut d.per_scratch, [])
    while per.len() < d.outs.len() {
        per.push([])
    }
    for o in 0..per.len() {
        per[o].clear()
    }
    var masks = mem.replace(mut d.masks_scratch, map.Map.new())
    masks.clear()
    var pmap = mem.replace(mut d.popups_by_root, map.Map.new())
    pmap.clear()
    if not d.locked and not d.popups.is_empty() {
        for pp in d.popups {
            var top = d.srv.popup_parent(pp)
            for _ in 0..16 {
                guard let Some(t) = top else {
                    break
                }
                guard let Some(up) = d.srv.popup_of(t) else {
                    break
                }
                top = d.srv.popup_parent(up)
            }
            if let Some(root) = top {
                var list = pmap.remove(root).unwrap_or([])
                list.push(pp)
                discard pmap.insert(root, list)
            }
        }
    }
    shell.arrange(mut d)
    if d.locked {
        shell.place_lock(mut d, mut per, mut masks)
    } else {
        shell.place_layers(mut d, 0, pmap, mut per, mut masks)
        shell.place_layers(mut d, 1, pmap, mut per, mut masks)
        let places = mem.replace(mut d.lay.places, [])
        var last_win = -1
        for i in 0..places.len() {
            match places[i].what {
                Window => last_win = i
                _ => {}
            }
        }
        var win_popups: List[(server.Surface, f32, server.Window)] = []
        for i in 0..places.len() {
            let p = places[i]
            match p.what {
                Window(w) => {
                    guard d.srv.mapped(w) else {
                        if i == last_win {
                            for (ps, pop_op, pw) in win_popups {
                                shell.place_popups(mut d, ps, pmap, pop_op, Some(pw), mut per, mut masks)
                            }
                            win_popups.clear()
                        }
                        continue
                    }
                    if p.style.block_capture {
                        discard d.blocked_wins.insert(w, true)
                    }
                    let s = d.srv.window_surface(w)
                    let info = d.srv.info(s)
                    let geo = info.geometry
                    let eff_w = if geo.w > 0 { geo.w } else { info.width }
                    let eff_h = if geo.h > 0 { geo.h } else { info.height }
                    var win = d.wins.get(w).unwrap_or(display.Win {})
                    if let Some((hx, hy)) = manipulation.drag_hold(d, w) {
                        // A drag carries it: the offset puts it under the pointer.
                        win.off_x = hx - p.x - d.manip.pan_x
                        win.off_y = hy - p.y - d.manip.pan_y
                        discard d.wins.insert(w, win)
                    }
                    let (off_x, off_y) = manipulation.resize_offset(d, w, eff_w, eff_h, win)
                    let tx = p.x + off_x + d.manip.pan_x
                    let ty = p.y + off_y + d.manip.pan_y
                    let (x, y, opacity) = animate(mut d, display.skey(s), tx, ty, p.style.opacity, p.style.transition_ms, now)
                    let sc = f64(p.style.scale)
                    place_tree_on(mut d, s, x - f64(geo.x) * sc, y - f64(geo.y) * sc, sc, p.style, opacity, Some(w), p.only_output, mut per, mut masks)
                    if pmap.contains(s) {
                        win_popups.push((s, opacity, w))
                    }
                    if i == last_win {
                        for (ps, pop_op, pw) in win_popups {
                            shell.place_popups(mut d, ps, pmap, pop_op, Some(pw), mut per, mut masks)
                        }
                        win_popups.clear()
                    }
                }
                Image(img) => {
                    guard int(img.index) < d.images.len() and d.images[int(img.index)].alive and d.images[int(img.index)].gen == img.gen else {
                        continue
                    }
                    let opaque = d.images[int(img.index)].opaque
                    let (x, y, opacity) = animate(mut d, display.ikey(img), p.x + d.manip.pan_x, p.y + d.manip.pan_y, p.style.opacity, p.style.transition_ms, now)
                    for o in 0..d.outs.len() {
                        let out = d.outs[o]
                        guard out.alive and x < out.x + out.lw() and y < out.y + out.lh() and x + p.w > out.x and y + p.h > out.y else {
                            continue
                        }
                        let k = out.scale
                        let opq = if opaque { types.Rect { w: f32(p.w * k), h: f32(p.h * k) } } else { types.Rect {} }
                        per[o].push(types.Placement { key: display.ikey(img), tex: display.ikey(img), x: f32(((x - out.x) * k).round()), y: f32(((y - out.y) * k).round()), w: f32((p.w * k).round()), h: f32((p.h * k).round()), opacity, radius: p.style.radius * f32(k), shadow: p.style.shadow * f32(k), opaque: opq })
                    }
                }
            }
        }
        for (ps, pop_op, pw) in win_popups {
            shell.place_popups(mut d, ps, pmap, pop_op, Some(pw), mut per, mut masks)
        }
        d.lay.places = places
        shell.place_layers(mut d, 2, pmap, mut per, mut masks)
        shell.place_layers(mut d, 3, pmap, mut per, mut masks)
        shell.place_ime(mut d, mut per, mut masks)
        // Each seat's drag image follows that seat's pointer.
        for si in 0..d.seats.len() {
            if let Some((icon, ix, iy)) = d.srv.drag_icon(d.seats[si].seat) {
                if d.srv.info(icon).mapped {
                    place_tree(mut d, icon, d.seats[si].px + f64(ix), d.seats[si].py + f64(iy), 1.0, layout.Style {}, 1.0, None, mut per, mut masks)
                }
            }
        }
    }
    // Software cursors across all seats (seat 0 uses SW cursor when HW unavailable;
    // secondary seats always draw via renderer textures).
    for si in 0..d.seats.len() {
        if not d.seats[si].cursor_hw and d.seats[si].cursor.width > 0 {
            let ckey = d.seats[si].cursor_key
            if d.comp.has(ckey) {
                for o in 0..d.outs.len() {
                    let out = d.outs[o]
                    guard out.alive else {
                        continue
                    }
                    let k = out.scale
                    let cx = (d.seats[si].px - out.x) * k - f64(d.seats[si].cursor.hot_x)
                    let cy = (d.seats[si].py - out.y) * k - f64(d.seats[si].cursor.hot_y)
                    if cx < f64(out.width) and cy < f64(out.height) and cx + f64(d.seats[si].cursor.width) > 0.0 and cy + f64(d.seats[si].cursor.height) > 0.0 {
                        per[o].push(types.Placement { key: ckey, tex: ckey, x: f32(cx.round()), y: f32(cy.round()), w: f32(d.seats[si].cursor.width), h: f32(d.seats[si].cursor.height) })
                    }
                }
            }
        }
    }
    for o in 0..d.outs.len() {
        if d.outs[o].alive {
            d.comp.layout(o, per[o])
            if not d.comp.idle(o) {
                d.outs[o].dirty = true
            }
        }
    }
    for e in masks.entries() {
        let s = e.key
        let m = e.val
        d.srv.set_outputs(s, m)
        var best = 1.0
        for o in 0..d.outs.len() {
            if d.outs[o].alive and m & (u64(1) << u64(d.outs[o].sout.id.index)) != 0 {
                best = max(best, d.outs[o].scale)
            }
        }
        let want = i32(best * 120.0 + 0.5)
        var sf = d.surfs.get(s).unwrap_or(display.Surf {})
        if sf.scale120 != want {
            sf.scale120 = want
            discard d.surfs.insert(s, sf)
            d.srv.preferred(s, want, 0)
        }
    }
    d.per_scratch = per
    d.masks_scratch = masks
    d.popups_by_root = pmap
}

/// Place surface `s`'s tree with its origin at `ox, oy`.
fn place_tree[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], s: server.Surface, ox: f64, oy: f64, sc: f64, style: layout.Style, opacity: f32, owner: Option[server.Window], mut per: List[List[types.Placement]], mut masks: map.Map[server.Surface, u64]) {
    place_tree_on(mut d, s, ox, oy, sc, style, opacity, owner, None, mut per, mut masks)
}

/// Place surface `s`'s tree with its origin at `ox, oy`, optionally restricted to `only_output`.
fn place_tree_on[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], s: server.Surface, ox: f64, oy: f64, sc: f64, style: layout.Style, opacity: f32, owner: Option[server.Window], only_output: Option[server.Output], mut per: List[List[types.Placement]], mut masks: map.Map[server.Surface, u64]) {
    var clip_out = -1
    if let Some(target_so) = only_output {
        for oi in 0..d.outs.len() {
            if d.outs[oi].alive and d.outs[oi].sout == target_so {
                clip_out = oi
                break
            }
        }
        guard clip_out >= 0 else {
            return
        }
    }
    var tree = mem.replace(mut d.tree_scratch, [])
    tree.clear()
    d.srv.tree(s, mut tree)
    for (ts, dx, dy) in tree {
        let info = d.srv.info(ts)
        let gx = ox + f64(dx) * sc
        let gy = oy + f64(dy) * sc
        let gw = f64(info.width) * sc
        let gh = f64(info.height) * sc
        discard d.origins.insert(ts, (gx, gy, sc))
        discard d.surf_keys.insert(display.skey(ts), ts)
        if let Some(w) = owner {
            discard d.surf_window.insert(ts, w)
        }
        if clip_out >= 0 {
            let co = d.outs[clip_out]
            let hx0 = max(gx, co.x)
            let hy0 = max(gy, co.y)
            let hx1 = min(gx + gw, co.x + co.lw())
            let hy1 = min(gy + gh, co.y + co.lh())
            d.hits.add_clipped(ts, gx, gy, hx0, hy0, hx1, hy1, sc)
        } else {
            d.hits.add(ts, gx, gy, gw, gh, sc)
        }
        guard let Some(sf) = d.surfs.get(ts) else {
            continue
        }
        guard sf.tex != 0 else {
            continue
        }
        let tex = sf.tex
        let root = ts == s
        if style.block_capture {
            discard d.blocked_keys.insert(display.skey(ts), true)
        }
        let opq = if info.alpha < 1.0 { server.Rect {} } else { d.srv.opaque(ts) }
        let alpha = opacity * info.alpha
        let has_geo = root and owner.is_some() and info.geometry.w > 0 and info.geometry.h > 0
        let win_x = gx + f64(info.geometry.x) * sc
        let win_y = gy + f64(info.geometry.y) * sc
        let win_w = f64(info.geometry.w) * sc
        let win_h = f64(info.geometry.h) * sc
        let bx0 = if has_geo { min(gx, win_x) } else { gx }
        let by0 = if has_geo { min(gy, win_y) } else { gy }
        let bx1 = if has_geo { max(gx + gw, win_x + win_w) } else { gx + gw }
        let by1 = if has_geo { max(gy + gh, win_y + win_h) } else { gy + gh }
        var mask: u64 = 0
        for o in 0..d.outs.len() {
            if clip_out >= 0 and o != clip_out {
                continue
            }
            let out = d.outs[o]
            guard out.alive and bx0 < out.x + out.lw() and by0 < out.y + out.lh() and bx1 > out.x and by1 > out.y else {
                continue
            }
            if style.block_capture {
                d.outs[o].has_blocked = true
            }
            let k = out.scale
            let f = sc * k
            var src = types.Rect {}
            if info.src[2] > 0.0 {
                let bs = f64(info.scale)
                src = types.Rect { x: f32(info.src[0] * bs), y: f32(info.src[1] * bs), w: f32(info.src[2] * bs), h: f32(info.src[3] * bs) }
            }
            let geom = if has_geo {
                types.Rect {
                    x: f32(((win_x - out.x) * k).round()),
                    y: f32(((win_y - out.y) * k).round()),
                    w: f32((win_w * k).round()),
                    h: f32((win_h * k).round()),
                }
            } else {
                types.Rect {}
            }
            per[o].push(types.Placement {
                key: display.skey(ts),
                tex,
                x: f32(((gx - out.x) * k).round()),
                y: f32(((gy - out.y) * k).round()),
                w: f32((gw * k).round()),
                h: f32((gh * k).round()),
                geometry: geom,
                src,
                transform: info.transform,
                opacity: alpha,
                radius: if root { style.radius * f32(f) } else { 0.0 },
                shadow: if root { style.shadow * f32(k) } else { 0.0 },
                opaque: types.Rect { x: f32(f64(opq.x) * f), y: f32(f64(opq.y) * f), w: f32(f64(opq.w) * f), h: f32(f64(opq.h) * f) },
                color_space: info.color_space,
            })
            mask |= u64(1) << u64(out.sout.id.index)
        }
        discard masks.insert(ts, mask)
    }
    d.tree_scratch = tree
}

/// Windows hidden for a while are told (Occluded); visible ones again.
fn occlusion[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R]) {
    let now = time.now_ns()
    var soon = 0
    var updates: List[(server.Window, display.Win)] = []
    for e in d.wins.entries() {
        let w = e.key
        let cur = e.val
        guard d.srv.mapped(w) else {
            continue
        }
        let s = d.srv.window_surface(w)
        var seen = false
        for o in 0..d.outs.len() {
            seen = seen or (d.outs[o].alive and d.comp.visible(o, display.skey(s)))
        }
        var win = cur
        var changed = false
        if seen {
            if win.hidden {
                win.hidden = false
                changed = true
            }
            if win.occluded {
                win.occluded = false
                changed = true
                d.emit(display.Event.Occluded(w, false))
            }
        } else if not win.hidden {
            win.hidden = true
            win.hidden_since = now
            changed = true
            soon = sooner(soon, 500000000)
        } else if not win.occluded and now - win.hidden_since >= 500000000 {
            win.occluded = true
            changed = true
            d.emit(display.Event.Occluded(w, true))
        } else if not win.occluded {
            soon = sooner(soon, 500000000 - (now - win.hidden_since))
        }
        if changed {
            updates.push((w, win))
        }
    }
    for (w, win) in updates {
        discard d.wins.insert(w, win)
    }
    d.occl_due = if soon > 0 { now + soon } else { 0 }
    arm_house(mut d)
}

/// The smaller of two delays, 0 being none.
fn sooner(a: int, b: int) -> int {
    return if a == 0 or b < a { b } else { a }
}

/// Arm the housekeeping timer for what is due first: the next occlusion
/// check or the layout transaction deadline (one must not cancel the other).
fn arm_house[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R]) {
    var due = d.occl_due
    if d.waits.txn_layout.is_some() and (due == 0 or d.waits.txn_deadline < due) {
        due = d.waits.txn_deadline
    }
    if due > 0 {
        discard os.timer_arm(d.house_fd, max(due - time.now_ns(), 1), 0)
    }
}
