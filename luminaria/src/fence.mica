// Fences of client buffers, as descriptors a poller waits on: a dmabuf's
// implicit write fence exported as a sync_file, or a drm_syncobj timeline
// point turned into an eventfd. Nothing here blocks; release points are
// signaled once the GPU is done with the buffer.

import std.os
import libdrm_sys as drm

/// The dmabuf's pending writes as a sync_file (readable once done), or -1
/// when the kernel cannot export it (then the buffer counts as ready).
pub fn export(dmabuf_fd: int) -> int {
    // struct dma_buf_export_sync_file { __u32 flags; __s32 fd; }, DMA_BUF_SYNC_READ.
    var arg: [2]u32 = [1, 0xFFFFFFFF]
    unsafe {
        let r = os.ioctl(dmabuf_fd, os.iowr(98, 2, 8), Ptr.of_mut(mut arg).cast[u8]())
        guard r.is_ok() else {
            return -1
        }
    }
    return if arg[1] & 0x80000000 != 0 { -1 } else { int(arg[1]) }
}

/// A render node for drm_syncobj (any node of the GPU works).
pub struct Syncobj {
    pub fd: int = -1
}

pub fn Syncobj.open(major: i64, minor: i64) -> Syncobj {
    let path = if minor >= 128 { "/dev/dri/renderD{minor}" } else { "/dev/dri/card{minor}" }
    match os.open(path, true) {
        Ok(fd) => {
            return Syncobj { fd }
        }
        Err => {
            return Syncobj {}
        }
    }
}

pub fn Syncobj.drop(mut self) {
    if self.fd >= 0 {
        os.close(self.fd)
    }
}

/// Whether the node supports timeline syncobjs (linux-drm-syncobj).
pub fn Syncobj.timelines(self) -> bool {
    guard self.fd >= 0 else {
        return false
    }
    var v: u64 = 0
    unsafe {
        return drm.get_cap(i32(self.fd), 20, Ptr.of_mut(mut v)) == 0 and v == 1
    }
}

/// An eventfd that becomes readable when timeline `timeline_fd` reaches
/// `point` (submitted or signaled), or -1.
pub fn Syncobj.wait(self, timeline_fd: int, point: u64) -> int {
    guard self.fd >= 0 else {
        return -1
    }
    var handle: u32 = 0
    unsafe {
        guard drm.syncobj_fd_to_handle(i32(self.fd), i32(timeline_fd), Ptr.of_mut(mut handle)) == 0 else {
            return -1
        }
    }
    let ev = match os.eventfd(0) {
        Ok(fd) => fd
        Err => -1
    }
    if ev >= 0 and drm.syncobj_eventfd(i32(self.fd), handle, point, i32(ev), 0) != 0 {
        os.close(ev)
        discard drm.syncobj_destroy(i32(self.fd), handle)
        return -1
    }
    discard drm.syncobj_destroy(i32(self.fd), handle)
    return ev
}

/// Signal timeline point `point` (a release point: we are done).
pub fn Syncobj.signal(self, timeline_fd: int, point: u64) {
    guard self.fd >= 0 else {
        return
    }
    var handle: u32 = 0
    unsafe {
        guard drm.syncobj_fd_to_handle(i32(self.fd), i32(timeline_fd), Ptr.of_mut(mut handle)) == 0 else {
            return
        }
        var p = point
        discard drm.syncobj_timeline_signal(i32(self.fd), Ptr.of_mut(mut handle), Ptr.of_mut(mut p), 1)
    }
    discard drm.syncobj_destroy(i32(self.fd), handle)
}
