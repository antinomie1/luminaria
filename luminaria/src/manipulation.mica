// Moves, resizes and pans the library runs at input rate.

import std.time
import luminaria_server as server
import plug
import display
import place
import seats

/// The manipulation running, and the pan's inertia.
struct State {
    active: Manip = Manip.Idle
    coasting: bool = false
    inertia_t: int = 0
    pan_x: f64 = 0.0
    pan_y: f64 = 0.0
    /// Offsets wait for the compositor's next layout after a Moved.
    offsets_done: bool = false
}

enum Manip {
    Idle
    /// Window, pointer start, offset at start.
    Move(server.Window, f64, f64, f64, f64)
    /// Window, edges, pointer start, size at start, offset at start.
    Resize(server.Window, u32, f64, f64, i32, i32, f64, f64)
    /// Pan by gesture: velocity (logical px per ms), last update time.
    Pan(f64, f64, u32)
}

/// Target `(width, height)` for an active resize from the current seat-0 pointer.
fn resize_target[O: plug.Output, R: plug.Renderer](d: display.Display[O, R], w: server.Window, edges: u32, sx: f64, sy: f64, w0: i32, h0: i32) -> (i32, i32) {
    let dx = i32((d.seats[0].px - sx).round())
    let dy = i32((d.seats[0].py - sy).round())
    var nw = w0
    var nh = h0
    if edges & 8 != 0 {
        nw = w0 + dx
    } else if edges & 4 != 0 {
        nw = w0 - dx
    }
    if edges & 2 != 0 {
        nh = h0 + dy
    } else if edges & 1 != 0 {
        nh = h0 - dy
    }
    let (minw, minh, maxw, maxh) = d.srv.size_hints(w)
    nw = max(nw, max(minw, 32))
    nh = max(nh, max(minh, 32))
    if maxw > 0 {
        nw = min(nw, maxw)
    }
    if maxh > 0 {
        nh = min(nh, maxh)
    }
    return (nw, nh)
}

/// Send the latest resize configure for an active `Manip.Resize`.
/// When `force` is false (pointer motion / ack), waits for the current
/// configure to be acked so slow clients are not flooded at pointer rate;
/// when `force` is true (once per output frame, right before `frame_done`),
/// always delivers the latest cursor target so frame-paced clients never
/// render a stale size.
fn resize_step[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], force: bool) {
    guard not d.seats.is_empty() else {
        return
    }
    match d.manip.active {
        Resize(w, edges, sx, sy, w0, h0, _, _) => {
            let wi = d.win_idx(w)
            guard wi >= 0 else {
                return
            }
            let cur = d.wins[wi]
            guard force or not cur.inflight else {
                return
            }
            let (nw, nh) = resize_target(d, w, edges, sx, sy, w0, h0)
            guard nw != cur.width or nh != cur.height else {
                return
            }
            var st = cur.states
            st.resizing = true
            discard d.configure(w, nw, nh, st)
        }
        _ => {}
    }
}

/// True when an active resize has a newer target size waiting to be sent
/// on the next output frame.
fn needs_resize_sync[O: plug.Output, R: plug.Renderer](d: display.Display[O, R]) -> bool {
    guard not d.seats.is_empty() else {
        return false
    }
    return match d.manip.active {
        Resize(w, edges, sx, sy, w0, h0, _, _) => {
            let wi = d.win_idx(w)
            guard wi >= 0 else {
                return false
            }
            let cur = d.wins[wi]
            let (nw, nh) = resize_target(d, w, edges, sx, sy, w0, h0)
            return nw != cur.width or nh != cur.height
        }
        _ => false
    }
}

/// Effective `(off_x, off_y)` for window `w`: during a left/top interactive
/// resize, derives the offset purely from the window's committed geometry so
/// the opposite edge stays pixel-locked regardless of commit timing or cell snap.
fn resize_offset[O: plug.Output, R: plug.Renderer](d: display.Display[O, R], w: server.Window, geo_w: i32, geo_h: i32, win: display.Win) -> (f64, f64) {
    match d.manip.active {
        Resize(mw, edges, _, _, w0, h0, ox, oy) => {
            if mw == w {
                let x = if edges & 4 != 0 and geo_w > 0 { ox + f64(w0 - geo_w) } else { ox }
                let y = if edges & 1 != 0 and geo_h > 0 { oy + f64(h0 - geo_h) } else { oy }
                return (x, y)
            }
        }
        _ => {}
    }
    return (win.off_x, win.off_y)
}

@noinline
fn end_manipulation[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R]) {
    match d.manip.active {
        Move(w, _, _, _, _) => {
            let wi = d.win_idx(w)
            let (ox, oy) = if wi >= 0 { (d.wins[wi].off_x, d.wins[wi].off_y) } else { (0.0, 0.0) }
            d.emit(display.Event.Moved(w, ox, oy))
        }
        Resize(w, edges, _, _, w0, h0, ox, oy) => {
            let wi = d.win_ensure(w)
            let cur = d.wins[wi]
            let rw = if cur.width > 0 { cur.width } else { w0 }
            let rh = if cur.height > 0 { cur.height } else { h0 }
            let fx = if edges & 4 != 0 and rw > 0 { ox + f64(w0 - rw) } else { ox }
            let fy = if edges & 1 != 0 and rh > 0 { oy + f64(h0 - rh) } else { oy }
            d.wins[wi].off_x = fx
            d.wins[wi].off_y = fy
            var st = cur.states
            st.resizing = false
            discard d.configure(w, rw, rh, st)
            d.emit(display.Event.Resized(w, fx, fy, rw, rh))
        }
        Pan => d.emit(display.Event.Panned(d.manip.pan_x, d.manip.pan_y))
        Idle => {}
    }
    d.manip.active = Manip.Idle
    d.manip.coasting = false
    d.manip.offsets_done = true
    if not d.seats.is_empty() and d.seats[0].cursor_surface.is_none() {
        d.set_cursor_named("default")
    }
}

/// Inertia after a pan: velocity decays by e every 300 ms.
fn coast[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R]) {
    guard d.manip.coasting else {
        return
    }
    match d.manip.active {
        Pan(vx, vy, last) => {
            let now = time.now_ns()
            let dt = f64(now - d.manip.inertia_t) / 1000000.0
            d.manip.inertia_t = now
            d.manip.pan_x += vx * dt
            d.manip.pan_y += vy * dt
            let k = (-dt / 300.0).exp()
            let nvx = vx * k
            let nvy = vy * k
            if nvx.abs() + nvy.abs() < 0.02 {
                end_manipulation(mut d)
            } else {
                d.manip.active = Manip.Pan(nvx, nvy, last)
                d.animating = true
            }
            place.rebuild(mut d)
        }
        _ => {}
    }
}

/// The window seat `st`'s drag carries changed (xdg-toplevel-drag): the
/// one let go of ends like a move (`Moved`), a new one starts following.
fn drag_changed[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], st: server.Seat) {
    let si = seats.seat_index(d, st)
    if si >= 0 {
        let now = d.srv.drag_window(st)
        let was = d.seats[si].drag_win.map(fn(x) => x.0)
        let next = now.map(fn(x) => x.0)
        if was != next {
            if let Some(w) = was {
                let wi = d.win_idx(w)
                let (ox, oy) = if wi >= 0 { (d.wins[wi].off_x, d.wins[wi].off_y) } else { (0.0, 0.0) }
                d.manip.offsets_done = true
                d.emit(display.Event.Moved(w, ox, oy))
            }
            if let Some(w) = next {
                d.emit(display.Event.WindowDragged(w))
            }
        }
        d.seats[si].drag_win = now
    }
    place.rebuild(mut d)
}

/// Where a drag holds window `w` (its window geometry's top left), if one
/// carries it.
fn drag_hold[O: plug.Output, R: plug.Renderer](d: display.Display[O, R], w: server.Window) -> Option[(f64, f64)] {
    for s in d.seats {
        if let Some((dw, hx, hy)) = s.drag_win {
            if dw == w {
                return Some((s.px - f64(hx), s.py - f64(hy)))
            }
        }
    }
    return None
}
