// Hit testing: which surface is under a point. Every pointer motion asks
// (1000 Hz mice, hundreds of surfaces), so the rectangles live in
// structure-of-arrays form as whole logical pixels and are tested eight at
// a time: a lane is outside when any of x - x0, x1 - x - 1, y - y0,
// y1 - y - 1 is negative, so one OR of four lane-wise subtractions and one
// bitmask answer a block (2.6x the scalar loop). Candidates are then
// checked top-down against the surface's input region.

import luminaria_server as server

/// Padding lanes: never inside.
let far: i32 = 0x3fffffff

pub struct Hits {
    x0: List[i32] = []
    y0: List[i32] = []
    x1: List[i32] = []
    y1: List[i32] = []
    /// Surface and where its origin is (global logical coordinates).
    surfs: List[server.Surface] = []
    ox: List[f64] = []
    oy: List[f64] = []
    /// Global units per surface unit (a scaled-down window: 0.5).
    sc: List[f64] = []
}

pub fn Hits.new() -> Hits {
    return Hits {}
}

pub fn Hits.clear(mut self) {
    self.x0.clear()
    self.y0.clear()
    self.x1.clear()
    self.y1.clear()
    self.surfs.clear()
    self.ox.clear()
    self.oy.clear()
    self.sc.clear()
}

/// A surface on top of the previous ones, at `x, y`, `w` x `h` global
/// units, `scale` global units per surface unit.
pub fn Hits.add(mut self, s: server.Surface, x: f64, y: f64, w: f64, h: f64, scale: f64) {
    self.add_clipped(s, x, y, x, y, x + w, y + h, scale)
}

/// Like `add`, but clips the hittable bounding box to `[cx0, cy0) .. [cx1, cy1)` while
/// preserving `(ox, oy)` as the true surface origin for local pointer coordinates.
pub fn Hits.add_clipped(mut self, s: server.Surface, ox: f64, oy: f64, cx0: f64, cy0: f64, cx1: f64, cy1: f64, scale: f64) {
    guard cx1 > cx0 and cy1 > cy0 else {
        return
    }
    let n = self.surfs.len()
    // Overwrite the padding of the last block, or start a new block.
    if n == self.x0.len() {
        for _ in 0..8 {
            self.x0.push(far)
            self.x1.push(-far)
            self.y0.push(far)
            self.y1.push(-far)
        }
    }
    self.x0[n] = i32(cx0.floor())
    self.y0[n] = i32(cy0.floor())
    self.x1[n] = i32(cx1.ceil())
    self.y1[n] = i32(cy1.ceil())
    self.surfs.push(s)
    self.ox.push(ox)
    self.oy.push(oy)
    self.sc.push(scale)
}

pub fn Hits.len(self) -> int {
    return self.surfs.len()
}

/// The topmost surface accepting input at `x, y` and the point in its
/// coordinates.
pub fn Hits.find(self, srv: server.Server, x: f64, y: f64) -> Option[(server.Surface, f64, f64)] {
    let n = self.surfs.len()
    guard n > 0 else {
        return None
    }
    let px = u32x8(u32(int(i32(x.floor())).bits() & 0xffffffff))
    let py = u32x8(u32(int(i32(y.floor())).bits() & 0xffffffff))
    let one = u32x8(1)
    var base = ((n - 1) / 8) * 8
    while base >= 0 {
        var out: u32 = 0
        unsafe {
            let a = u32x8.load(self.x0.as_ptr().offset(base).cast[u32]())
            let b = u32x8.load(self.x1.as_ptr().offset(base).cast[u32]())
            let c = u32x8.load(self.y0.as_ptr().offset(base).cast[u32]())
            let d = u32x8.load(self.y1.as_ptr().offset(base).cast[u32]())
            out = ((px - a) | (b - px - one) | (py - c) | (d - py - one)).bitmask()
        }
        var inside = ~out & 0xff
        while inside != 0 {
            let k = 31 - int(inside.clz())
            inside &= ~(u32(1) << u32(k))
            let i = base + k
            let s = self.surfs[i]
            let lx = (x - self.ox[i]) / self.sc[i]
            let ly = (y - self.oy[i]) / self.sc[i]
            if srv.accepts(s, lx, ly) {
                return Some((s, lx, ly))
            }
        }
        base -= 8
    }
    return None
}
