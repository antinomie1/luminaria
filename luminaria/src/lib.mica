// luminaria: a library for writing Wayland compositors. It provides the
// mechanism (protocol state, composition, devices); the compositor keeps
// the policy and its own loop: where windows go, who gets focus, what keys
// do, what each frame shows.
//
//     var d = try lum.open(lum.Options {})
//     while true {
//         guard let Some(e) = try d.next() else {
//             break
//         }
//         match e {
//             WindowMapped(w) => d.layout(fn(mut l) { l.window(w, 100.0, 100.0, lum.Style {}) })
//             _ => d.accept(e)
//         }
//     }

//
// A Display joins an Output and a Renderer (plug.mica): the built-in
// ones by default, any others through `display.Display.with`.

pub import display
pub import plug
pub import layout
pub import cursor
pub import hit
pub import clock
pub import fence
pub import luminaria_types as types
pub import luminaria_server as server
pub import luminaria_proto as proto
pub import luminaria_wire as wire

when feature == "backend" {
    pub import luminaria_backend as backend
}

when feature == "vulkan" {
    pub import luminaria_compose as compose
}

when feature == "backend" and feature == "vulkan" {
    /// A display on the built-in output (DRM, nested or headless, by
    /// `backend`) and the Vulkan renderer.
    pub type Display = display.Display[backend.Backend, compose.Compositor]

    pub fn open(o: Options) -> Result[Display, str] {
        let comp = try compose.Compositor.open(o.validation)
        let be = try backend.Backend.open(backend.Options { kind: o.backend, headless: o.headless.clone(), keymap: o.keymap.clone(), buffers: o.buffers, title: o.title.clone() })
        return Display.with(o, be, comp)
    }
}

pub type Options = display.Options
pub type Event = display.Event
pub type Key = display.Key
pub type Pointer = display.Pointer
pub type Scroll = display.Scroll
pub type Touch = display.Touch
pub type TouchKind = display.TouchKind
pub type Gesture = display.Gesture
pub type GestureKind = display.GestureKind
pub type Layout = layout.Layout
pub type Style = layout.Style
pub type Image = layout.Image
pub type Window = server.Window
pub type Output = server.Output
pub type Client = server.Client
pub type Surface = server.Surface
pub type States = server.States
pub type Mode = types.Mode
pub type Mods = types.Mods
pub type Names = types.Names
pub type AxisSource = types.AxisSource
pub type InputConfig = types.InputConfig
pub type Kind = types.OutputKind
