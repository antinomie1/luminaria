// The desktop shell around the compositor's layout: layer surfaces
// (arranged by their anchors, margins and exclusive zones, drawn below
// and above the layout), the session lock (only lock surfaces show and
// get input), input method popups (under the text cursor) and who has
// the keyboard.

import luminaria_server as server
import luminaria_types as types
import layout
import display
import place
import clients
import outputs
import plug

/// Where a layer surface goes: output index, global logical position.
struct Spot {
    gen: u32 = 0
    o: int = -1
    x: f64 = 0.0
    y: f64 = 0.0
}

fn spot_of[O: plug.Output, R: plug.Renderer](d: display.Display[O, R], l: server.Layer) -> Option[Spot] {
    let idx = int(l.id.index)
    guard l.id.gen != 0 and idx < d.spots.len() and d.spots[idx].gen == l.id.gen else {
        return None
    }
    return Some(d.spots[idx])
}

fn set_spot[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], l: server.Layer, o: int, x: f64, y: f64) {
    let idx = int(l.id.index)
    while d.spots.len() <= idx {
        d.spots.push(Spot {})
    }
    d.spots[idx] = Spot { gen: l.id.gen, o, x, y }
}

fn clear_spot[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], l: server.Layer) {
    let idx = int(l.id.index)
    if l.id.gen != 0 and idx < d.spots.len() and d.spots[idx].gen == l.id.gen {
        d.spots[idx] = Spot {}
    }
}

/// The edge an exclusive zone is taken from (0: none).
fn zone_edge(st: server.LayerState) -> u32 {
    if st.exclusive_edge != 0 {
        return st.exclusive_edge
    }
    let a = st.anchor
    // One edge, or one edge and both perpendicular ones.
    if a == 1 or a == 13 {
        return 1
    }
    if a == 2 or a == 14 {
        return 2
    }
    if a == 4 or a == 7 {
        return 4
    }
    if a == 8 or a == 11 {
        return 8
    }
    return 0
}

/// The output a layer surface is on: the one it asked for, else the one
/// it was given when it appeared.
fn layer_output[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], l: server.Layer, info: server.LayerInfo) -> int {
    if let Some(so) = info.output {
        let o = outputs.out_index(d, so)
        if o >= 0 {
            return o
        }
    }
    if let Some(s) = spot_of(d, l) {
        if s.o >= 0 and s.o < d.outs.len() and d.outs[s.o].alive {
            return s.o
        }
    }
    var o = if d.seats.is_empty() { -1 } else { place.output_at(d, d.seats[0].px, d.seats[0].py) }
    if o < 0 {
        for k in 0..d.outs.len() {
            if d.outs[k].alive {
                o = k
                break
            }
        }
    }
    return o
}

/// Lay out every layer surface: zones first (overlay to background), then
/// sizes and positions; configure what changed. Outputs whose usable area
/// changed report OutputArea.
@noinline
fn arrange[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R]) {
    guard d.srv.has_layers() else {
        guard d.had_layers else {
            return
        }
        for o in 0..d.outs.len() {
            guard d.outs[o].alive else {
                continue
            }
            let ax = d.outs[o].x
            let ay = d.outs[o].y
            let aw = d.outs[o].lw()
            let ah = d.outs[o].lh()
            if ax != d.outs[o].ux or ay != d.outs[o].uy or aw != d.outs[o].uw or ah != d.outs[o].uh {
                d.outs[o].ux = ax
                d.outs[o].uy = ay
                d.outs[o].uw = aw
                d.outs[o].uh = ah
                d.emit(display.Event.OutputArea(d.outs[o].sout))
            }
        }
        d.had_layers = false
        return
    }
    d.had_layers = true
    let ls = d.srv.layers()
    var areas: List[(f64, f64, f64, f64)] = []
    for o in 0..d.outs.len() {
        areas.push((d.outs[o].x, d.outs[o].y, d.outs[o].lw(), d.outs[o].lh()))
    }
    var bounds: List[(f64, f64, f64, f64)] = []
    var outs: List[int] = []
    for _ in 0..ls.len() {
        bounds.push((0.0, 0.0, 0.0, 0.0))
        outs.push(-1)
    }
    var layer = 3
    while layer >= 0 {
        for i in 0..ls.len() {
            let l = ls[i]
            let info = d.srv.layer(l)
            guard int(info.state.layer) == layer else {
                continue
            }
            let o = layer_output(mut d, l, info)
            guard o >= 0 else {
                continue
            }
            outs[i] = o
            let st = info.state
            let full = (d.outs[o].x, d.outs[o].y, d.outs[o].lw(), d.outs[o].lh())
            bounds[i] = if st.exclusive < 0 { full } else { areas[o] }
            guard st.exclusive > 0 else {
                continue
            }
            let (ax, ay, aw, ah) = areas[o]
            let m = st.margin
            let edge = zone_edge(st)
            let z = f64(st.exclusive)
            if edge == 1 {
                areas[o] = (ax, ay + z + f64(m[0]), aw, ah - z - f64(m[0]))
            } else if edge == 2 {
                areas[o] = (ax, ay, aw, ah - z - f64(m[2]))
            } else if edge == 4 {
                areas[o] = (ax + z + f64(m[3]), ay, aw - z - f64(m[3]), ah)
            } else if edge == 8 {
                areas[o] = (ax, ay, aw - z - f64(m[1]), ah)
            }
        }
        layer -= 1
    }
    for i in 0..ls.len() {
        let l = ls[i]
        let o = outs[i]
        guard o >= 0 else {
            continue
        }
        let info = d.srv.layer(l)
        let st = info.state
        // Zero-zone surfaces stay clear of the others' zones.
        let (bx, by, bw, bh) = if st.exclusive == 0 { areas[o] } else { bounds[i] }
        let m = st.margin
        let a = st.anchor
        let w = if st.width > 0 { f64(st.width) } else { max(bw - f64(m[3] + m[1]), 1.0) }
        let h = if st.height > 0 { f64(st.height) } else { max(bh - f64(m[0] + m[2]), 1.0) }
        let x = if a & 4 != 0 and a & 8 == 0 { bx + f64(m[3]) } else if a & 8 != 0 and a & 4 == 0 { bx + bw - f64(m[1]) - w } else { bx + (bw - w) / 2.0 }
        let y = if a & 1 != 0 and a & 2 == 0 { by + f64(m[0]) } else if a & 2 != 0 and a & 1 == 0 { by + bh - f64(m[2]) - h } else { by + (bh - h) / 2.0 }
        set_spot(mut d, l, o, x.round(), y.round())
        let iw = i32(w.round())
        let ih = i32(h.round())
        if iw != info.width or ih != info.height {
            discard d.srv.configure_layer(l, iw, ih)
        }
    }
    for o in 0..d.outs.len() {
        guard d.outs[o].alive else {
            continue
        }
        let (ax, ay, aw, ah) = areas[o]
        if ax != d.outs[o].ux or ay != d.outs[o].uy or aw != d.outs[o].uw or ah != d.outs[o].uh {
            d.outs[o].ux = ax
            d.outs[o].uy = ay
            d.outs[o].uw = aw
            d.outs[o].uh = ah
            d.emit(display.Event.OutputArea(d.outs[o].sout))
        }
    }
}

/// Place the mapped layer surfaces of `layer`, then their popups above all surfaces of `layer`.
fn place_layers[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], layer: u32, mut per: List[List[types.Placement]]) {
    place_layers_filtered(mut d, layer, u64(0), false, false, mut per)
}

/// Place the mapped layer surfaces of `layer` restricted either to outputs in `fs_mask`
/// (`only_fs = true`) or to outputs not in `fs_mask` (`only_fs = false`).
fn place_layers_masked[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], layer: u32, fs_mask: u64, only_fs: bool, mut per: List[List[types.Placement]]) {
    place_layers_filtered(mut d, layer, fs_mask, true, only_fs, mut per)
}

@noinline
fn place_layers_filtered[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], layer: u32, fs_mask: u64, filter_fs: bool, only_fs: bool, mut per: List[List[types.Placement]]) {
    guard d.srv.has_layers() else {
        return
    }
    var pop_roots: List[server.Surface] = []
    for l in d.srv.layers() {
        let info = d.srv.layer(l)
        guard info.mapped and info.state.layer == layer else {
            continue
        }
        guard let Some(sp) = spot_of(d, l) else {
            continue
        }
        if filter_fs {
            let on_fs = sp.o >= 0 and sp.o < 64 and (fs_mask & (u64(1) << u64(sp.o))) != 0
            guard on_fs == only_fs else {
                continue
            }
        }
        let only_out = if sp.o >= 0 and sp.o < d.outs.len() and d.outs[sp.o].alive { Some(d.outs[sp.o].sout) } else { None }
        place.place_tree_on(mut d, info.surface, sp.x, sp.y, 1.0, layout.Style {}, 1.0, None, only_out, mut per)
        if d.has_popups(info.surface) {
            pop_roots.push(info.surface)
        }
    }
    for root in pop_roots {
        place_popups(mut d, root, 1.0, None, mut per)
    }
}

/// Popups whose chain of parents starts at `root` (placed already), using
/// the pre-indexed popup list `d.popups_by_root`.
@noinline
fn place_popups[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], root: server.Surface, opacity: f32, owner: Option[server.Window], mut per: List[List[types.Placement]]) {
    for pi in 0..d.popups_by_root.len() {
        guard d.popups_by_root[pi].0 == root else {
            continue
        }
        let pp = d.popups_by_root[pi].1
        let ps = d.srv.popup_surface(pp)
        guard d.srv.info(ps).mapped else {
            continue
        }
        guard let Some(parent) = d.srv.popup_parent(pp) else {
            continue
        }
        guard let Some((pgx, pgy, psc)) = d.origin_of(parent) else {
            continue
        }
        let pgeo = d.srv.info(parent).geometry
        let g = d.srv.popup_geometry(pp)
        let own = d.srv.info(ps).geometry
        let ox = pgx + f64(pgeo.x + g.x - own.x) * psc
        let oy = pgy + f64(pgeo.y + g.y - own.y) * psc
        let block = match owner {
            Some(w) => d.blocked_wins.contains(w)
            None => false
        }
        place.place_tree(mut d, ps, ox, oy, psc, layout.Style { block_capture: block }, opacity, owner, mut per)
    }
}

/// While locked: each output shows its lock surface, nothing else.
@noinline
@cold
fn place_lock[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], mut per: List[List[types.Placement]]) {
    for k in d.srv.lock_surfaces() {
        let (s, so, mapped) = d.srv.lock_surface(k)
        guard mapped else {
            continue
        }
        guard let Some(out) = so else {
            continue
        }
        let o = outputs.out_index(d, out)
        guard o >= 0 else {
            continue
        }
        place.place_tree(mut d, s, d.outs[o].x, d.outs[o].y, 1.0, layout.Style {}, 1.0, None, mut per)
    }
}

/// Input method popups, their top left under the text cursor.
@noinline
fn place_ime[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], mut per: List[List[types.Placement]]) {
    for si in 0..d.seats.len() {
        let st = d.seats[si].seat
        guard let Some((ts, r)) = d.srv.text_cursor(st) else {
            continue
        }
        guard let Some((gx, gy, sc)) = d.origin_of(ts) else {
            continue
        }
        for s in d.srv.ime_popups(st) {
            place.place_tree(mut d, s, gx + f64(r.x) * sc, gy + f64(r.y + r.h) * sc, sc, layout.Style {}, 1.0, None, mut per)
        }
    }
}

/// Configure a lock surface to its output's size.
fn configure_lock[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], k: server.LockSurface) {
    let (_, so, _) = d.srv.lock_surface(k)
    guard let Some(out) = so else {
        return
    }
    let o = outputs.out_index(d, out)
    guard o >= 0 else {
        return
    }
    discard d.srv.configure_lock(k, i32(d.outs[o].lw()), i32(d.outs[o].lh()))
}

/// A client asked to lock: hide the session at once; the locker hears
/// `locked` once every output showed a frame without it.
@noinline
@cold
fn lock[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R]) {
    let was = d.locked
    d.locked = true
    d.lock_wait.clear()
    for o in 0..d.outs.len() {
        if d.outs[o].alive {
            d.outs[o].dirty = true
            d.lock_wait.push(o)
        }
    }
    clients.dismiss_popups_all(mut d)
    place.rebuild(mut d)
    update_keyboard(mut d)
    if was or d.lock_wait.is_empty() {
        d.lock_wait.clear()
        d.srv.lock_done()
    }
    if not was {
        d.emit(display.Event.Locked(true))
    }
}

@noinline
@cold
fn unlock[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R]) {
    d.locked = false
    d.lock_wait.clear()
    for o in 0..d.outs.len() {
        d.outs[o].dirty = true
    }
    place.rebuild(mut d)
    update_keyboard(mut d)
    d.emit(display.Event.Locked(false))
}

/// Output `o` presented a frame: part of a pending lock.
fn presented[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], o: int) {
    guard not d.lock_wait.is_empty() else {
        return
    }
    d.lock_wait.retain(fn(k) => k != o)
    if d.lock_wait.is_empty() {
        d.srv.lock_done()
    }
}

/// Who gets the keyboard on seat `si`: the lock screen, an exclusive layer
/// surface, a grabbing popup, a layer surface clicked on, else the focused window.
@noinline
fn keyboard_target[O: plug.Output, R: plug.Renderer](d: display.Display[O, R], si: int) -> Option[server.Surface] {
    guard si >= 0 and si < d.seats.len() else {
        return None
    }
    if d.locked {
        var any: Option[server.Surface] = None
        let here = place.output_at(d, d.seats[si].px, d.seats[si].py)
        for k in d.srv.lock_surfaces() {
            let (s, so, mapped) = d.srv.lock_surface(k)
            guard mapped else {
                continue
            }
            if let Some(out) = so {
                if outputs.out_index(d, out) == here {
                    return Some(s)
                }
            }
            if any.is_none() {
                any = Some(s)
            }
        }
        return any
    }
    // The topmost exclusive layer surface (top and overlay layers), skipping
    // `Layer.Top` surfaces currently occluded beneath an active fullscreen window.
    let fs_mask = if d.srv.has_layers() { place.fullscreen_outputs(d) } else { u64(0) }
    var best: Option[server.Surface] = None
    var best_layer: u32 = 0
    for l in d.srv.layers() {
        let info = d.srv.layer(l)
        guard info.mapped and info.state.keyboard == 1 and info.state.layer >= 2 else {
            continue
        }
        if info.state.layer == 2 and fs_mask != 0 {
            if let Some(sp) = spot_of(d, l) {
                if sp.o >= 0 and sp.o < 64 and (fs_mask & (u64(1) << u64(sp.o))) != 0 {
                    continue
                }
            }
        }
        if best.is_none() or info.state.layer >= best_layer {
            best = Some(info.surface)
            best_layer = info.state.layer
        }
    }
    if best.is_some() {
        return best
    }
    if let Some(p) = d.seats[si].grabs.last() {
        return Some(d.srv.popup_surface(p))
    }
    if let Some(s) = d.seats[si].layer_focus {
        var occluded_top = false
        if fs_mask != 0 {
            if let Some(l) = d.srv.layer_of(s) {
                let info = d.srv.layer(l)
                if info.state.layer == 2 {
                    if let Some(sp) = spot_of(d, l) {
                        occluded_top = sp.o >= 0 and sp.o < 64 and (fs_mask & (u64(1) << u64(sp.o))) != 0
                    }
                }
            }
        }
        if not occluded_top {
            return Some(s)
        }
    }
    return d.seats[si].focus
}

fn update_keyboard_on[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], si: int) {
    guard si >= 0 and si < d.seats.len() else {
        return
    }
    let t = keyboard_target(d, si)
    d.srv.keyboard_focus(d.seats[si].seat, t)
}

fn update_keyboard[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R]) {
    for si in 0..d.seats.len() {
        update_keyboard_on(mut d, si)
    }
}

/// A click on a layer surface that takes the keyboard on demand.
fn clicked_on[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], si: int, s: server.Surface) {
    guard si >= 0 and si < d.seats.len() else {
        return
    }
    // A popup keeps the focus of what it pops up from.
    guard d.srv.popup_of(s).is_none() else {
        return
    }
    guard let Some(l) = d.srv.layer_of(s) else {
        if d.seats[si].layer_focus.is_some() {
            d.seats[si].layer_focus = None
            update_keyboard_on(mut d, si)
        }
        return
    }
    let info = d.srv.layer(l)
    if info.state.keyboard != 0 {
        d.seats[si].layer_focus = Some(s)
        update_keyboard_on(mut d, si)
    }
}

/// A layer surface went away.
fn layer_gone[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], l: server.Layer) {
    clear_spot(mut d, l)
    for si in 0..d.seats.len() {
        if let Some(s) = d.seats[si].layer_focus {
            if not d.srv.surface_alive(s) or d.srv.layer_of(s).is_none() {
                d.seats[si].layer_focus = None
            }
        }
    }
}

/// Output `o` goes: its layer surfaces are closed.
fn output_gone[O: plug.Output, R: plug.Renderer](mut d: display.Display[O, R], o: int) {
    for l in d.srv.layers() {
        if let Some(sp) = spot_of(d, l) {
            if sp.o == o {
                d.srv.close_layer(l)
                clear_spot(mut d, l)
            }
        }
    }
}
