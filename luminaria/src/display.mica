// The Display: socket, protocol state, composition and devices joined.
// `next` hands the compositor one event at a time and, whenever nothing is
// queued, finishes the frames that are due and flushes every client in one
// go before sleeping; nothing it does blocks on a client or the GPU. The
// compositor answers with a few calls (configure, focus, layout) and
// passes everything it does not handle to `accept`, which does what the
// protocol suggests.

import std.collections.map
import std.mem
import std.net
import std.os
import std.time
import luminaria_types as types
import luminaria_types.pixels as pixels
import luminaria_server as server
import layout
import hit
import cursor
import shell
import plug
import clock
import fence

// ------------------------------------------------------------- events

pub struct Key {
    pub time: u32 = 0
    /// evdev code (KEY_A is 30).
    pub code: u32 = 0
    /// xkb keysym (lum.backend.keysym.key_a ...).
    pub sym: u32 = 0
    /// Text the key types, "" for none.
    pub text: str = ""
    pub pressed: bool = false
    pub mods: types.Mods = types.Mods {}
}

pub struct Pointer {
    pub time: u32 = 0
    /// Global logical position.
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    /// Motion since the last event (unaccelerated deltas in `raw_*`).
    pub dx: f64 = 0.0
    pub dy: f64 = 0.0
    pub raw_dx: f64 = 0.0
    pub raw_dy: f64 = 0.0
    /// evdev button (BTN_LEFT 272) for Button events.
    pub button: u32 = 0
    pub pressed: bool = false
}

pub struct Scroll {
    pub time: u32 = 0
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    /// Pixels to scroll.
    pub dx: f64 = 0.0
    pub dy: f64 = 0.0
    /// Wheel clicks in 120ths.
    pub v120x: i32 = 0
    pub v120y: i32 = 0
    pub source: types.AxisSource = types.AxisSource.Wheel
}

pub enum TouchKind {
    Down
    Motion
    Up
    Frame
    Cancel
}

pub struct Touch {
    pub time: u32 = 0
    pub kind: TouchKind = TouchKind.Frame
    pub id: i32 = 0
    pub x: f64 = 0.0
    pub y: f64 = 0.0
}

pub enum GestureKind {
    SwipeBegin
    SwipeUpdate
    SwipeEnd
    PinchBegin
    PinchUpdate
    PinchEnd
    HoldBegin
    HoldEnd
}

pub struct Gesture {
    pub time: u32 = 0
    pub kind: GestureKind = GestureKind.HoldEnd
    pub fingers: i32 = 0
    pub dx: f64 = 0.0
    pub dy: f64 = 0.0
    pub scale: f64 = 1.0
    pub rotation: f64 = 0.0
    pub cancelled: bool = false
}

pub enum Event {
    OutputAdded(server.Output)
    OutputRemoved(server.Output)
    OutputChanged(server.Output)
    /// A frame of this output is about to be drawn, for the vblank at this
    /// CLOCK_MONOTONIC time: move animations there, then return.
    Frame(server.Output, int)
    ClientNew(server.Client)
    ClientGone(server.Client)
    /// A new window (title and app id are set): configure it.
    WindowNew(server.Window)
    WindowMapped(server.Window)
    WindowUnmapped(server.Window)
    WindowClosed(server.Window)
    WindowTitle(server.Window)
    WindowAppId(server.Window)
    WindowParent(server.Window)
    /// The client drew the window at a new size it was configured to.
    WindowResized(server.Window, i32, i32)
    RequestMove(server.Window)
    /// Edges as xdg_toplevel.resize_edge (top 1, bottom 2, left 4, right 8).
    RequestResize(server.Window, u32)
    RequestMaximize(server.Window, bool)
    RequestFullscreen(server.Window, Option[server.Output], bool)
    RequestMinimize(server.Window)
    RequestMenu(server.Window, f64, f64)
    /// The window is entirely hidden (or visible again) for a while.
    Occluded(server.Window, bool)
    Key(Key)
    Modifiers(types.Mods)
    Motion(Pointer)
    Button(Pointer)
    Scroll(Scroll)
    Touch(Touch)
    Gesture(Gesture)
    DeviceAdded(u32, types.DeviceDesc)
    DeviceRemoved(u32)
    /// A move the library ran ended: by this much, to fold into the layout.
    Moved(server.Window, f64, f64)
    /// A resize ended: offset of the window's top left, new size.
    Resized(server.Window, f64, f64, i32, i32)
    /// A pan ended (inertia included): by this much.
    Panned(f64, f64)
    /// The session became active or was switched away.
    Session(bool)
    /// A descriptor given to `watch` is readable.
    Ready(int)
    /// A `timer` expired.
    Timer(int)
    /// The client prefers server-side decorations (true) or drawing its
    /// own; answer with `decorate` (`accept`: the client draws them).
    WindowDecoration(server.Window, bool)
    /// The window's icon changed: `icon`.
    WindowIcon(server.Window)
    /// A window asks for focus with a valid activation token (`accept`
    /// focuses it).
    RequestActivate(server.Window)
    /// A client rang the bell (from this window, if any).
    Bell(Option[server.Window])
    /// The session was locked (only the lock screen shows and gets input)
    /// or unlocked.
    Locked(bool)
    /// Panels changed the output's free area: `usable`.
    OutputArea(server.Output)
    /// A tool (wlr-randr, kanshi) asks for this configuration of the
    /// outputs (`output_config`): only test it (true) or apply it, then
    /// answer with `output_config_done` (`accept`: `apply_output_config`).
    OutputConfig(server.OutputConfig, bool)
    /// A client bound an extension's global (`extend`): the object, its
    /// version.
    ExtensionBound(server.ext.Object, u32)
    /// A request to an extension object: opcode and arguments. `accept`
    /// closes its descriptors.
    ExtensionRequest(server.ext.Object, u16, List[server.ext.Arg])
}

// --------------------------------------------------------------- state

pub struct Options {
    /// Socket name; "" picks the first free wayland-N.
    pub socket: str = ""
    pub backend: types.OutputKind = types.OutputKind.Auto
    /// Headless outputs (tests): one 1920x1080 at 60 Hz when empty.
    pub headless: List[types.Mode] = []
    pub keymap: types.Names = types.Names {}
    pub repeat_rate: i32 = 25
    pub repeat_delay: i32 = 600
    /// Scanout buffers per output: 2 is lighter, 3 absorbs a late frame.
    pub buffers: int = 2
    /// Behind everything (premultiplied RGBA).
    pub background: [4]f32 = [0.1, 0.1, 0.12, 1.0]
    pub cursor_theme_size: int = 24
    /// The nested window's title.
    pub title: str = "luminaria"
    /// Load the Vulkan validation layer.
    pub validation: bool = false
    /// On DRM, run the event loop (the calling thread) and the commit
    /// thread in the real-time class.
    pub realtime: bool = true
}

/// Tokens: what a readable descriptor belongs to.
let tok_listener = 1
let tok_backend = 1000
let tok_output = 2000
let tok_house = 3000
let tok_time = 3001
let tok_idle = 3002
let tok_fence = 1000000
let tok_client = 2000000
let tok_user = 3000000
let tok_timer = 4000000
/// Sandbox listeners: 2k accepts, 2k + 1 is the close descriptor.
let tok_sandbox = 5000000

struct Out {
    alive: bool = false
    clock: clock.Clock = clock.Clock {}
    sout: server.Output = server.Output { id: server.ids.Id {} }
    x: f64 = 0.0
    y: f64 = 0.0
    scale: f64 = 1.0
    width: i32 = 0
    height: i32 = 0
    refresh_mhz: i32 = 60000
    timer: int = -1
    armed: bool = false
    due: bool = false
    dirty: bool = false
    /// Key of the client buffer scanned out (0: composing).
    scanned: u64 = 0
    /// When the last frame reached the screen (stats).
    shown_ns: int = 0
    vrr: bool = false
    enabled: bool = true
    /// The area panels leave free (global logical).
    ux: f64 = 0.0
    uy: f64 = 0.0
    uw: f64 = 0.0
    uh: f64 = 0.0
}

fn Out.lw(self) -> f64 {
    return f64(self.width) / self.scale
}

fn Out.lh(self) -> f64 {
    return f64(self.height) / self.scale
}

/// Composition state of a client surface.
struct Surf {
    /// The renderer's key of the texture shown (the buffer's, or the
    /// surface's shm texture); 0: none.
    tex: u64 = 0
    buffer: Option[server.Buffer] = None
    /// An shm buffer waiting for the next frame to upload (coalesced:
    /// a newer commit replaces it without a copy).
    pending: Option[server.Buffer] = None
    /// Release point of the current buffer: timeline fd, point.
    rel_fd: int = -1
    rel_point: u64 = 0
    /// Buffer damage of the last commit (direct scanout passes it on).
    dmg: (i32, i32, i32, i32) = (0, 0, 0, 0)
    /// Preferred scale last sent, in 120ths.
    scale120: i32 = 0
}

struct Win {
    width: i32 = 0
    height: i32 = 0
    states: server.States = server.States {}
    configured: bool = false
    /// A configure is waiting for its ack (resizes send one at a time).
    inflight: bool = false
    /// The library's offset on top of the layout (moves, resizes).
    off_x: f64 = 0.0
    off_y: f64 = 0.0
    hidden: bool = false
    hidden_since: int = 0
    occluded: bool = false
}

enum Manip {
    Idle
    /// Window, pointer start, offset at start.
    Move(server.Window, f64, f64, f64, f64)
    /// Window, edges, pointer start, size at start, offset at start.
    Resize(server.Window, u32, f64, f64, i32, i32, f64, f64)
    /// Pan by gesture: velocity (logical px per ms), last update time.
    Pan(f64, f64, u32)
}

/// A placement's last shown position, and its animation.
struct Anim {
    x: f64 = 0.0
    y: f64 = 0.0
    opacity: f32 = 1.0
    fx: f64 = 0.0
    fy: f64 = 0.0
    fo: f32 = 1.0
    t0: int = 0
    dur: int = 0
}

struct ImageData {
    gen: u32
    opaque: bool = false
    alive: bool = true
}

struct Fence {
    txn: server.Txn
    fd: int
    used: bool = true
}

pub struct Display[O: plug.Output, R: plug.Renderer] {
    srv: server.Server
    be: O
    comp: R
    poll: net.Poller
    evs: List[net.Event] = []
    sync: fence.Syncobj = fence.Syncobj {}
    seat: server.Seat = server.Seat { id: server.ids.Id {} }
    background: vec4
    outs: List[Out] = []
    /// Per output: surfaces the frame in flight shows, buffers and release
    /// points to hand back once it is on screen.
    drawn: List[List[server.Surface]] = []
    releases: List[List[server.Buffer]] = []
    points: List[List[(int, u64)]] = []
    /// Per output: what it measured (`stats`).
    probes: List[types.Stats] = []
    lay: layout.Layout = layout.Layout {}
    hits: hit.Hits = hit.Hits {}
    surfs: map.Map[server.Surface, Surf]
    wins: map.Map[server.Window, Win]
    origins: map.Map[server.Surface, (f64, f64, f64)]
    anims: map.Map[u64, Anim]
    animating: bool = false
    popups: List[server.Popup] = []
    grabs: List[server.Popup] = []
    focus: Option[server.Surface] = None
    images: List[ImageData] = []
    queue: List[Event] = []
    qhead: int = 0
    fences: List[Fence] = []
    left: map.Map[server.Txn, int]
    fifo: List[(server.Surface, server.Txn)] = []
    timed: List[(int, server.Txn)] = []
    time_fd: int = -1
    house_fd: int = -1
    px: f64 = 0.0
    py: f64 = 0.0
    buttons: int = 0
    grab: Option[server.Surface] = None
    pointer_on: Option[server.Surface] = None
    cursor: cursor.Image = cursor.Image {}
    /// The cursor is a texture (under cursor_key): the output does not show
    /// it itself.
    cursor_hw: bool = false
    cursor_surface: Option[server.Surface] = None
    cursor_hx: i32 = 0
    cursor_hy: i32 = 0
    cursor_size: int = 24
    manip: Manip = Manip.Idle
    coasting: bool = false
    inertia_t: int = 0
    pan_x: f64 = 0.0
    pan_y: f64 = 0.0
    /// Offsets wait for the compositor's next layout after a Moved.
    offsets_done: bool = false
    timers: List[(int, int)] = []
    /// A layout transaction: windows still to ack, deadline, the layout.
    txn_wins: List[server.Window] = []
    txn_open: bool = false
    txn_layout: Option[layout.Layout] = None
    txn_deadline: int = 0
    held: List[server.Surface] = []
    quit: bool = false
    t0: int = 0
    /// Layer surface positions.
    spots: map.Map[server.Layer, shell.Spot]
    layer_focus: Option[server.Surface] = None
    locked: bool = false
    /// Outputs still to show a frame before the locker hears `locked`.
    lock_wait: List[int] = []
    /// The surface whose pointer constraint is on.
    constrained: Option[server.Surface] = None
    idle_fd: int = -1
}

fn skey(s: server.Surface) -> u64 {
    return (u64(s.id.index) << 32) | u64(s.id.gen)
}

fn bkey(b: server.Buffer) -> u64 {
    return (u64(1) << 62) | (u64(b.id.index) << 32) | u64(b.id.gen)
}

fn ikey(img: layout.Image) -> u64 {
    return (u64(1) << 63) | (u64(img.index) << 32) | u64(img.gen)
}

let cursor_key: u64 = 0x7fffffffffffffff

/// A display on output `be` and renderer `comp` (any types with the
/// methods of plug.Output and plug.Renderer; `lum.open` picks the
/// built-in ones). Of `o`, the device fields are for `lum.open`.
pub fn Display[O, R].with(o: Options, take be: O, take comp: R) -> Result[Display[O, R], str] {
    var srv = try server.Server.open(o.socket.clone())
    let poll = try net.poller().map_err(fn(e) => "{e}")
    // linux-dmabuf: what the renderer samples, from its render node.
    var main: u64 = 0
    var sync = fence.Syncobj {}
    if let Some((major, minor)) = comp.render_node() {
        main = types.buffer.dev_t(major, minor)
        sync = fence.Syncobj.open(major, minor)
    }
    var d = Display { srv, be, comp, poll, sync, background: vec4(0.0), surfs: map.Map.new(), wins: map.Map.new(), origins: map.Map.new(), anims: map.Map.new(), left: map.Map.new(), spots: map.Map.new() }
    let formats = d.comp.formats()
    if not formats.is_empty() {
        var scanout: List[(u32, u64)] = []
        for m in d.be.scanout_modifiers(0) {
            for f in [types.buffer.xrgb8888, types.buffer.argb8888] {
                if formats.contains((f, m)) {
                    scanout.push((f, m))
                }
            }
        }
        try d.srv.enable_dmabuf(server.Dmabuf { device: main, formats, scanout, scanout_device: d.be.scanout_device() })
    }
    if d.sync.timelines() {
        d.srv.enable_syncobj()
    }
    let bg = o.background
    d.background = vec4(bg[0], bg[1], bg[2], bg[3])
    d.seat = d.srv.add_seat("seat0")
    d.srv.set_capabilities(d.seat, 3)
    d.srv.set_repeat(d.seat, o.repeat_rate, o.repeat_delay)
    d.send_keymap()
    d.cursor_size = o.cursor_theme_size
    d.time_fd = try os.timerfd().map_err(fn(e) => "{e}")
    d.house_fd = try os.timerfd().map_err(fn(e) => "{e}")
    discard d.poll.add(d.time_fd, tok_time, true, false)
    discard d.poll.add(d.house_fd, tok_house, true, false)
    d.idle_fd = try os.timerfd().map_err(fn(e) => "{e}")
    discard d.poll.add(d.idle_fd, tok_idle, true, false)
    discard d.poll.add(d.srv.listener.fd, tok_listener, true, false)
    var fds: List[(int, int)] = []
    d.be.fds(mut fds)
    for (fd, t) in fds {
        discard d.poll.add(fd, tok_backend + t, true, false)
    }
    d.t0 = time.now_ns()
    d.set_cursor_named("default")
    // Outputs the backend found at start.
    d.backend_events()
    return Ok(d)
}

/// The socket clients connect to: put it in WAYLAND_DISPLAY for them.
pub fn Display[O, R].socket(self) -> str {
    return self.srv.name()
}

fn Display[O, R].send_keymap(mut self) {
    let (fd, size) = self.be.keymap()
    if fd >= 0 {
        if let Ok(dup) = os.dup(fd) {
            self.srv.set_keymap(self.seat, dup, size)
        }
    }
}

fn Display[O, R].emit(mut self, take e: Event) {
    self.queue.push(e)
}

/// The next event. When none is queued, due frames are finished and
/// clients flushed, then it sleeps until something happens. None once the
/// compositor quits or the backend ends (the parent closed our window).
pub fn Display[O, R].next(mut self) -> Result[Option[Event], str] {
    while true {
        if self.qhead < self.queue.len() {
            let e = self.queue[self.qhead].clone()
            self.qhead += 1
            return Ok(Some(e))
        }
        self.queue.clear()
        self.qhead = 0
        guard not self.quit else {
            return Ok(None)
        }
        try self.finish()
        try self.wait(-1)
    }
}

/// Like `next` without sleeping: None when nothing is ready (embed in
/// another loop that polls `fd`).
pub fn Display[O, R].poll(mut self) -> Result[Option[Event], str] {
    if self.qhead >= self.queue.len() {
        self.queue.clear()
        self.qhead = 0
        try self.finish()
        try self.wait(0)
    }
    guard self.qhead < self.queue.len() else {
        return Ok(None)
    }
    let e = self.queue[self.qhead].clone()
    self.qhead += 1
    return Ok(Some(e))
}

/// One descriptor that is readable when `poll` has work.
pub fn Display[O, R].fd(self) -> int {
    return self.poll.fd
}

/// End the loop: `next` returns None.
pub fn Display[O, R].quit(mut self) {
    self.quit = true
}

fn Display[O, R].wait(mut self, ms: int) -> Result[(), str] {
    var evs = mem.replace(mut self.evs, [])
    let r = self.poll.wait(mut evs, ms)
    if let Err(e) = r {
        self.evs = evs
        return Err("{e}")
    }
    for e in evs {
        try self.ready(e.token)
    }
    evs.clear()
    self.evs = evs
    return Ok(())
}

fn Display[O, R].ready(mut self, t: int) -> Result[(), str] {
    if t == tok_listener {
        while true {
            guard let Some((c, fd)) = try self.srv.accept() else {
                break
            }
            discard self.poll.add(fd, tok_client + int(c.id.index), true, false)
        }
    } else if t >= tok_sandbox {
        let k = u32((t - tok_sandbox) / 2)
        if (t - tok_sandbox) % 2 == 0 {
            while true {
                guard let Some((c, fd)) = self.srv.accept_from(k) else {
                    break
                }
                discard self.poll.add(fd, tok_client + int(c.id.index), true, false)
            }
        } else {
            // The sandbox is done: no new clients from it.
            let (lf, cf) = self.srv.listener_fds(k)
            discard self.poll.remove(lf)
            discard self.poll.remove(cf)
            self.srv.close_listener(k)
        }
    } else if t >= tok_timer {
        let k = t - tok_timer
        for i in 0..self.timers.len() {
            if self.timers[i].1 == k {
                let fd = self.timers[i].0
                discard os.count(fd)
                discard self.poll.remove(fd)
                os.close(fd)
                discard self.timers.remove(i)
                self.emit(Event.Timer(k))
                break
            }
        }
    } else if t >= tok_user {
        self.emit(Event.Ready(t - tok_user))
    } else if t >= tok_client {
        let idx = u32(t - tok_client)
        let c = server.Client { id: server.ids.Id { index: idx, gen: self.srv.client_gen(idx) } }
        if not self.srv.dispatch(c) {
            self.drop_client(c)
        }
    } else if t >= tok_fence {
        let k = t - tok_fence
        if k < self.fences.len() and self.fences[k].used {
            let txn = self.fences[k].txn
            let fd = self.fences[k].fd
            discard self.poll.remove(fd)
            os.close(fd)
            self.fences[k].used = false
            self.resolve(txn)
        }
    } else if t == tok_time {
        discard os.count(self.time_fd)
        self.timed_waits()
    } else if t == tok_house {
        discard os.count(self.house_fd)
        self.housekeeping()
    } else if t == tok_idle {
        discard os.count(self.idle_fd)
        self.idle_tick()
    } else if t >= tok_output {
        let o = t - tok_output
        if o < self.outs.len() {
            discard os.count(self.outs[o].timer)
            self.outs[o].armed = false
            self.frame_due(o)
        }
    } else if t >= tok_backend {
        try self.be.dispatch(t - tok_backend)
        self.backend_events()
    }
    self.server_events()
    return Ok(())
}

fn Display[O, R].drop_client(mut self, c: server.Client) {
    let fd = self.srv.client_fd(c)
    if fd >= 0 {
        discard self.poll.remove(fd)
    }
    self.srv.disconnect(c)
}

/// Finish due frames, flush every client.
fn Display[O, R].finish(mut self) -> Result[(), str] {
    for o in 0..self.outs.len() {
        if self.outs[o].due {
            try self.render(o)
        }
    }
    for o in 0..self.outs.len() {
        self.schedule(o)
    }
    var gone: List[server.Client] = []
    self.srv.flush(mut gone)
    for c in gone {
        self.drop_client(c)
    }
    self.server_events()
    return Ok(())
}

// ------------------------------------------------------------ outputs

fn Display[O, R].backend_events(mut self) {
    while true {
        guard let Some(got) = self.be.next() else {
            break
        }
        var e = got
        match take e {
            OutputAdded(o) => self.output_added(int(o))
            OutputRemoved(o) => self.output_removed(int(o))
            OutputChanged(o) => self.output_changed(int(o))
            Presented(o, seq, ns, flags) => self.presented(int(o), seq, ns, flags)
            Released(o) => self.schedule(int(o))
            Dropped(o) => {
                if int(o) < self.outs.len() {
                    self.outs[int(o)].dirty = true
                    self.comp.damage_all()
                    self.schedule(int(o))
                }
            }
            Input(i) => self.input(i)
            Session(on) => {
                if on {
                    for o in 0..self.outs.len() {
                        self.outs[o].dirty = true
                    }
                    self.comp.damage_all()
                }
                self.emit(Event.Session(on))
            }
            Keymap => self.send_keymap()
            Closed => self.quit = true
        }
    }
}

fn Display[O, R].output_info(self, o: int) -> server.OutputInfo {
    let d = self.be.output(u32(o))
    let out = self.outs[o]
    return server.OutputInfo {
        name: d.name.clone(),
        description: "{d.make} {d.model}".trim(),
        make: d.make.clone(),
        model: d.model.clone(),
        x: i32(out.x),
        y: i32(out.y),
        width: d.mode.width,
        height: d.mode.height,
        refresh_mhz: d.mode.refresh_mhz,
        width_mm: d.width_mm,
        height_mm: d.height_mm,
        scale120: i32(out.scale * 120.0 + 0.5),
        modes: d.modes.map(fn(m) => (m.width, m.height, m.refresh_mhz, m.preferred)),
        enabled: out.enabled,
        vrr_capable: d.vrr,
        vrr: out.vrr,
    }
}

fn Display[O, R].output_added(mut self, o: int) {
    let d = self.be.output(u32(o))
    while self.outs.len() <= o {
        self.outs.push(Out {})
        self.drawn.push([])
        self.releases.push([])
        self.points.push([])
        self.probes.push(types.Stats.new())
    }
    // To the right of the others.
    var x: f64 = 0.0
    for k in 0..self.outs.len() {
        if self.outs[k].alive {
            x = max(x, self.outs[k].x + self.outs[k].lw())
        }
    }
    let timer = os.timerfd().unwrap_or(-1)
    self.outs[o] = Out { alive: true, clock: clock.Clock.new(int(d.mode.refresh_mhz)), x, width: d.mode.width, height: d.mode.height, refresh_mhz: d.mode.refresh_mhz, timer, dirty: true }
    if timer >= 0 {
        discard self.poll.add(timer, tok_output + o, true, false)
    }
    let info = self.output_info(o)
    let so0 = self.srv.add_output(info)
    self.outs[o].sout = so0
    let bg = self.background
    self.comp.add_output(o, u32(d.mode.width), u32(d.mode.height), bg)
    let so = self.outs[o].sout
    self.emit(Event.OutputAdded(so))
    if self.px == 0.0 and self.py == 0.0 {
        self.px = x + self.outs[o].lw() / 2.0
        self.py = self.outs[o].lh() / 2.0
    }
    self.rebuild()
}

fn Display[O, R].output_removed(mut self, o: int) {
    guard o < self.outs.len() and self.outs[o].alive else {
        return
    }
    shell.output_gone(mut self, o)
    self.outs[o].alive = false
    let so = self.outs[o].sout
    self.srv.remove_output(so)
    self.comp.remove_output(o)
    if self.outs[o].timer >= 0 {
        discard self.poll.remove(self.outs[o].timer)
        os.close(self.outs[o].timer)
        self.outs[o].timer = -1
    }
    for b in mem.replace(mut self.releases[o], []) {
        self.srv.release(b)
    }
    self.emit(Event.OutputRemoved(so))
    self.rebuild()
}

fn Display[O, R].output_changed(mut self, o: int) {
    guard o < self.outs.len() and self.outs[o].alive else {
        return
    }
    let d = self.be.output(u32(o))
    self.outs[o].width = d.mode.width
    self.outs[o].height = d.mode.height
    self.outs[o].refresh_mhz = d.mode.refresh_mhz
    self.outs[o].dirty = true
    self.comp.resize(o, u32(d.mode.width), u32(d.mode.height))
    self.outs[o].clock.refresh_ns = 1000000000000 / max(int(d.mode.refresh_mhz), 1000)
    let info = self.output_info(o)
    let so = self.outs[o].sout
    self.srv.update_output(so, info)
    self.emit(Event.OutputChanged(so))
    self.rebuild()
}

/// The backend index of a server output.
fn Display[O, R].out_index(self, so: server.Output) -> int {
    for o in 0..self.outs.len() {
        if self.outs[o].alive and self.outs[o].sout == so {
            return o
        }
    }
    return -1
}

// ------------------------------------------------------------ clients

fn Display[O, R].server_events(mut self) {
    while true {
        guard let Some(got) = self.srv.next() else {
            break
        }
        var e = got
        match take e {
            ClientNew(c) => self.emit(Event.ClientNew(c))
            ClientGone(c) => self.emit(Event.ClientGone(c))
            ExtBound(o, v) => self.emit(Event.ExtensionBound(o, v))
            ExtRequest(o, op, args) => self.emit(Event.ExtensionRequest(o, op, args))
            BufferNew(b) => self.buffer_new(b)
            BufferGone(b) => self.buffer_gone(b)
            Committed(t) => self.waits(t)
            Applied(s) => self.applied(s)
            SurfaceGone(s) => self.surface_gone(s)
            WindowNew(w) => {
                discard self.wins.insert(w, Win {})
                self.emit(Event.WindowNew(w))
            }
            WindowMapped(w) => {
                self.emit(Event.WindowMapped(w))
                self.rebuild()
            }
            WindowUnmapped(w) => {
                if let Some(cur) = self.wins.get(w) {
                    discard self.wins.insert(w, Win { width: cur.width, height: cur.height, states: cur.states })
                }
                self.emit(Event.WindowUnmapped(w))
                self.rebuild()
            }
            WindowClosed(w) => {
                discard self.wins.remove(w)
                self.txn_wins.retain(fn(x) => x != w)
                self.emit(Event.WindowClosed(w))
                self.rebuild()
            }
            WindowTitle(w) => self.emit(Event.WindowTitle(w))
            WindowAppId(w) => self.emit(Event.WindowAppId(w))
            WindowParent(w) => self.emit(Event.WindowParent(w))
            WindowRequest(w, r) => self.request(w, r)
            WindowAcked(w, aw, ah) => self.acked(w, aw, ah)
            PopupNew(p) => {
                self.popups.push(p)
                self.configure_popup(p)
            }
            PopupMapped => self.rebuild()
            PopupGone(p) => {
                self.popups.retain(fn(x) => x != p)
                if self.grabs.contains(p) {
                    self.grabs.retain(fn(x) => x != p)
                    self.refocus()
                }
                self.rebuild()
            }
            PopupGrab(p, st) => {
                self.grabs.push(p)
                shell.update_keyboard(mut self)
            }
            PopupReposition(p) => self.configure_popup(p)
            Cursor(st, s, hx, hy) => {
                self.cursor_surface = s
                self.cursor_hx = hx
                self.cursor_hy = hy
                match s {
                    Some(cs) => self.client_cursor(cs)
                    None => self.hide_cursor()
                }
            }
            CursorShape(st, shape) => {
                self.cursor_surface = None
                self.set_cursor_named(server.server.cursor_name(shape))
            }
            LayerNew => self.rebuild()
            LayerChanged => {
                self.rebuild()
                shell.update_keyboard(mut self)
            }
            LayerGone(l) => {
                shell.layer_gone(mut self, l)
                self.rebuild()
                shell.update_keyboard(mut self)
            }
            LockRequest => shell.lock(mut self)
            Unlock => shell.unlock(mut self)
            LockSurfaceNew(k) => shell.configure_lock(mut self, k)
            LockSurfaceChanged => {
                self.rebuild()
                shell.update_keyboard(mut self)
            }
            WindowDecoration(w) => self.emit(Event.WindowDecoration(w, self.srv.decoration(w) == 2))
            WindowIcon(w) => self.emit(Event.WindowIcon(w))
            Activate(w) => self.emit(Event.RequestActivate(w))
            Bell(s) => {
                let w = match s {
                    Some(x) => self.srv.window_of(x)
                    None => None
                }
                self.emit(Event.Bell(w))
            }
            ImeChanged => self.rebuild()
            IdleChanged => self.idle_tick()
            Drag => self.rebuild()
            Capture(so) => {
                // The first frame of a capture is taken at once.
                let o = self.out_index(so)
                if o >= 0 {
                    self.outs[o].dirty = true
                }
            }
            Listen(k) => {
                let (lf, cf) = self.srv.listener_fds(k)
                discard self.poll.add(lf, tok_sandbox + int(k) * 2, true, false)
                discard self.poll.add(cf, tok_sandbox + int(k) * 2 + 1, true, false)
            }
            OutputConfig(c, only_test) => self.emit(Event.OutputConfig(c, only_test))
        }
    }
}

fn Display[O, R].request(mut self, w: server.Window, r: server.Request) {
    match r {
        Move => self.emit(Event.RequestMove(w))
        Resize(_, _, edges) => self.emit(Event.RequestResize(w, edges))
        Maximize(on) => self.emit(Event.RequestMaximize(w, on))
        Fullscreen(on, o) => self.emit(Event.RequestFullscreen(w, o, on))
        Minimize => self.emit(Event.RequestMinimize(w))
        Menu(_, x, y) => self.emit(Event.RequestMenu(w, f64(x), f64(y)))
    }
}

fn Display[O, R].acked(mut self, w: server.Window, aw: i32, ah: i32) {
    guard let Some(cur) = self.wins.get(w) else {
        return
    }
    var win = cur
    win.inflight = false
    let resized = aw != win.width or ah != win.height
    // A resize from the left or top keeps the opposite edge in place.
    match self.manip {
        Resize(mw, edges, _, _, w0, h0, ox, oy) => {
            if mw == w {
                if edges & 4 != 0 and aw > 0 {
                    win.off_x = ox + f64(w0 - aw)
                }
                if edges & 1 != 0 and ah > 0 {
                    win.off_y = oy + f64(h0 - ah)
                }
            }
        }
        _ => {}
    }
    discard self.wins.insert(w, win)
    if self.txn_open or self.txn_layout.is_some() {
        self.txn_wins.retain(fn(x) => x != w)
        self.try_finish()
    }
    if resized and aw > 0 {
        self.emit(Event.WindowResized(w, aw, ah))
    }
    self.rebuild()
}

fn Display[O, R].buffer_new(mut self, b: server.Buffer) {
    let info = self.srv.buffer(b)
    if info.kind == server.BufferKind.SinglePixel {
        discard self.comp.solid(bkey(b), info.color)
        return
    }
    guard info.kind == server.BufferKind.Dmabuf else {
        return
    }
    let ok = self.comp.import_dmabuf(bkey(b), self.srv.dmabuf(b))
    self.srv.imported(b, ok)
}

fn Display[O, R].buffer_gone(mut self, b: server.Buffer) {
    self.be.forget(bkey(b))
    guard self.comp.has(bkey(b)) else {
        return
    }
    // Still shown: the texture lives until the surface moves on.
    var used = false
    self.surfs.each(fn(s, sf) {
        used = used or sf.buffer == Some(b)
    })
    if not used {
        self.comp.forget(bkey(b))
    }
}

/// Release `b` once every output that may still read it has shown a newer
/// frame (now when none does).
fn Display[O, R].release_later(mut self, b: server.Buffer, s: server.Surface, rel_fd: int, rel_point: u64) {
    var held = false
    for o in 0..self.outs.len() {
        if self.outs[o].alive and (self.drawn[o].contains(s) or self.be.holds(bkey(b))) {
            self.releases[o].push(b)
            if rel_fd >= 0 {
                self.points[o].push((rel_fd, rel_point))
            }
            held = true
            break
        }
    }
    if not held {
        self.srv.release(b)
        if rel_fd >= 0 {
            self.sync.signal(rel_fd, rel_point)
        }
        self.drop_orphan(b)
    }
}

/// A dmabuf the client destroyed while shown: free it now.
fn Display[O, R].drop_orphan(mut self, b: server.Buffer) {
    guard not self.srv.buffer_alive(b) else {
        return
    }
    self.comp.forget(bkey(b))
}

fn Display[O, R].applied(mut self, s: server.Surface) {
    if self.txn_layout.is_some() and self.held_window(s) {
        if not self.held.contains(s) {
            self.held.push(s)
        }
        return
    }
    let info = self.srv.info(s)
    var dmg: List[server.Rect] = []
    var bdmg: List[server.Rect] = []
    let changed = self.srv.take_changes(s, mut dmg, mut bdmg)
    var sf = self.surfs.get(s).unwrap_or(Surf {})
    // Damage in buffer pixels.
    var rects: List[(i32, i32, i32, i32)] = []
    for r in bdmg {
        rects.push((r.x, r.y, r.w, r.h))
    }
    for r in dmg {
        if info.transform == 0 and info.src[2] < 0.0 {
            let k = info.scale
            rects.push((r.x * k, r.y * k, r.w * k, r.h * k))
        } else {
            rects.clear()
            break
        }
    }
    if changed & server.changed_buffer != 0 {
        let old = sf.buffer
        let new = info.buffer
        if old != new {
            if let Some(ob) = old {
                if self.srv.buffer(ob).kind != server.BufferKind.Shm or not self.srv.buffer_alive(ob) {
                    self.release_later(ob, s, sf.rel_fd, sf.rel_point)
                }
            }
        }
        sf.buffer = new
        match new {
            None => sf.tex = 0
            Some(b) => {
                let bi = self.srv.buffer(b)
                if bi.kind != server.BufferKind.Shm {
                    sf.tex = if self.comp.has(bkey(b)) { bkey(b) } else { 0 }
                    if sf.tex == 0 {
                        sf.buffer = None
                    }
                } else {
                    sf.tex = if self.comp.shm_commit(skey(s), bi.width, bi.height, bi.format, rects) { skey(s) } else { 0 }
                    // Coalesce: a buffer not uploaded yet is replaced uncopied.
                    if let Some(p) = sf.pending {
                        if p != b {
                            self.srv.release(p)
                        }
                    }
                    sf.pending = Some(b)
                }
            }
        }
        match self.srv.release_point(s) {
            Some((fd, point)) => {
                sf.rel_fd = fd
                sf.rel_point = point
            }
            None => sf.rel_fd = -1
        }
    }
    if not rects.is_empty() {
        var bb = (rects[0].0, rects[0].1, rects[0].0 + rects[0].2, rects[0].1 + rects[0].3)
        for r in rects {
            bb = (min(bb.0, r.0), min(bb.1, r.1), max(bb.2, r.0 + r.2), max(bb.3, r.1 + r.3))
        }
        sf.dmg = (bb.0, bb.1, bb.2 - bb.0, bb.3 - bb.1)
    } else {
        sf.dmg = (0, 0, info.buffer_width, info.buffer_height)
    }
    discard self.surfs.insert(s, sf)
    if changed & (server.changed_damage | server.changed_buffer) != 0 {
        self.comp.commit(skey(s), rects)
        self.mark_dirty_for(s)
    }
    if self.cursor_surface == Some(s) {
        self.client_cursor(s)
    }
    if changed & (server.changed_buffer | server.changed_geometry | server.changed_tree | server.changed_opaque) != 0 {
        self.rebuild()
    }
}

/// Outputs showing `s` have something to draw.
fn Display[O, R].mark_dirty_for(mut self, s: server.Surface) {
    guard let Some((gx, gy, sc)) = self.origins.get(s) else {
        return
    }
    let info = self.srv.info(s)
    for o in 0..self.outs.len() {
        guard self.outs[o].alive else {
            continue
        }
        let out = self.outs[o]
        if gx < out.x + out.lw() and gy < out.y + out.lh() and gx + f64(info.width) * sc > out.x and gy + f64(info.height) * sc > out.y {
            self.outs[o].dirty = true
        }
    }
}

fn Display[O, R].surface_gone(mut self, s: server.Surface) {
    self.comp.forget(skey(s))
    if let Some(sf) = self.surfs.remove(s) {
        if let Some(p) = sf.pending {
            self.srv.release(p)
        }
    }
    discard self.origins.remove(s)
    if self.focus == Some(s) {
        self.focus = None
    }
    if self.grab == Some(s) {
        self.grab = None
    }
    if self.pointer_on == Some(s) {
        self.pointer_on = None
    }
    if self.cursor_surface == Some(s) {
        self.cursor_surface = None
        self.set_cursor_named("default")
    }
    for o in 0..self.outs.len() {
        self.drawn[o].retain(fn(x) => x != s)
    }
    self.fifo.retain(fn(f) => f.0 != s)
    self.rebuild()
}

// -------------------------------------------------------------- popups

/// The window a popup belongs to (through parent popups).
fn Display[O, R].popup_root(self, p: server.Popup) -> Option[server.Window] {
    var cur = p
    for _ in 0..16 {
        guard let Some(parent) = self.srv.popup_parent(cur) else {
            return None
        }
        if let Some(w) = self.srv.window_of(parent) {
            return Some(w)
        }
        guard let Some(pp) = self.srv.popup_of(parent) else {
            return None
        }
        cur = pp
    }
    return None
}

/// Configure a popup inside the output under its parent.
fn Display[O, R].configure_popup(mut self, p: server.Popup) {
    var bounds = server.Rect {}
    if let Some(parent) = self.srv.popup_parent(p) {
        if let Some((gx, gy, sc)) = self.origins.get(parent) {
            let geo = self.srv.info(parent).geometry
            let ax = gx + f64(geo.x) * sc
            let ay = gy + f64(geo.y) * sc
            let o = self.output_at(ax, ay)
            if o >= 0 {
                let out = self.outs[o]
                bounds = server.Rect { x: i32((out.x - ax) / sc), y: i32((out.y - ay) / sc), w: i32(out.lw() / sc), h: i32(out.lh() / sc) }
            }
        }
    }
    discard self.srv.configure_popup(p, bounds)
}

/// Dismiss every grabbing popup (a click outside them).
fn Display[O, R].dismiss_popups(mut self) {
    var k = self.grabs.len() - 1
    while k >= 0 {
        self.srv.dismiss(self.grabs[k])
        k -= 1
    }
    self.grabs.clear()
    self.refocus()
}

/// Keyboard focus back to the window after popups go.
fn Display[O, R].refocus(mut self) {
    shell.update_keyboard(mut self)
}

// --------------------------------------------------------------- waits

fn Display[O, R].waits(mut self, t: server.Txn) {
    let ws = self.srv.waits(t).to_list()
    var n = 0
    let now = time.now_ns()
    for w in ws {
        match w {
            Implicit(b, fd) => {
                let f = fence.export(fd)
                if f >= 0 {
                    self.add_fence(t, f)
                    n += 1
                }
            }
            Timeline(fd, point) => {
                let ev = self.sync.wait(fd, point)
                if ev >= 0 {
                    self.add_fence(t, ev)
                    n += 1
                }
            }
            Fifo(s) => {
                var shown = false
                for o in 0..self.outs.len() {
                    shown = shown or (self.outs[o].alive and self.drawn[o].contains(s))
                }
                if shown {
                    self.fifo.push((s, t))
                    n += 1
                }
            }
            Time(ns) => {
                if ns > now + 1000000 {
                    self.timed.push((ns, t))
                    n += 1
                }
            }
        }
    }
    if not self.timed.is_empty() {
        self.arm_timed()
    }
    if n == 0 {
        self.srv.ready(t)
    } else {
        discard self.left.insert(t, n)
    }
}

fn Display[O, R].add_fence(mut self, t: server.Txn, fd: int) {
    var k = -1
    for i in 0..self.fences.len() {
        if not self.fences[i].used {
            k = i
            break
        }
    }
    if k < 0 {
        self.fences.push(Fence { txn: t, fd })
        k = self.fences.len() - 1
    } else {
        self.fences[k] = Fence { txn: t, fd }
    }
    discard self.poll.add(fd, tok_fence + k, true, false)
}

fn Display[O, R].resolve(mut self, t: server.Txn) {
    guard let Some(n) = self.left.get(t) else {
        return
    }
    if n <= 1 {
        discard self.left.remove(t)
        self.srv.ready(t)
    } else {
        discard self.left.insert(t, n - 1)
    }
}

fn Display[O, R].arm_timed(mut self) {
    var first = 0
    for (ns, _) in self.timed {
        if first == 0 or ns < first {
            first = ns
        }
    }
    if first > 0 {
        discard os.timer_arm(self.time_fd, max(first - 1000000 - time.now_ns(), 1), 0)
    }
}

fn Display[O, R].timed_waits(mut self) {
    let now = time.now_ns()
    var due: List[server.Txn] = []
    for (ns, t) in self.timed {
        if ns <= now + 1000000 {
            due.push(t)
        }
    }
    self.timed.retain(fn(x) => x.0 > now + 1000000)
    for t in due {
        self.resolve(t)
    }
    self.arm_timed()
}

// -------------------------------------------------------------- layout

/// The output containing global point `x, y`, or -1.
fn Display[O, R].output_at(self, x: f64, y: f64) -> int {
    for o in 0..self.outs.len() {
        let out = self.outs[o]
        if out.alive and x >= out.x and y >= out.y and x < out.x + out.lw() and y < out.y + out.lh() {
            return o
        }
    }
    return -1
}

/// Where placement `key` shows now: animated toward `x, y, opacity`.
fn Display[O, R].animate(mut self, key: u64, x: f64, y: f64, opacity: f32, ms: int, now: int) -> (f64, f64, f32) {
    guard let Some(cur) = self.anims.get(key) else {
        discard self.anims.insert(key, Anim { x, y, opacity })
        return (x, y, opacity)
    }
    var a = cur
    if a.x != x or a.y != y or a.opacity != opacity {
        // A new target: start from where it shows now.
        let (cx, cy, co) = a.at(now)
        a = Anim { x, y, opacity, fx: cx, fy: cy, fo: co, t0: now, dur: if ms > 0 { ms * 1000000 } else { 0 } }
        discard self.anims.insert(key, a)
    }
    let (rx, ry, ro) = a.at(now)
    if a.dur > 0 and now < a.t0 + a.dur {
        self.animating = true
    }
    return (rx, ry, ro)
}

fn Anim.at(self, now: int) -> (f64, f64, f32) {
    guard self.dur > 0 and now < self.t0 + self.dur else {
        return (self.x, self.y, self.opacity)
    }
    let t = f64(now - self.t0) / f64(self.dur)
    let u = 1.0 - t
    let e = 1.0 - u * u * u
    return (self.fx + (self.x - self.fx) * e, self.fy + (self.y - self.fy) * e, self.fo + (self.opacity - self.fo) * f32(e))
}

/// Turn the layout (and the library's offsets) into each output's
/// placements, hit rectangles and surface outputs.
fn Display[O, R].rebuild(mut self) {
    let now = time.now_ns()
    self.animating = false
    self.hits.clear()
    self.origins.clear()
    var per: List[List[types.Placement]] = []
    for _ in 0..self.outs.len() {
        per.push([])
    }
    var masks: map.Map[server.Surface, u64] = map.Map.new()
    shell.arrange(mut self)
    // Locked: the lock screen alone.
    var places = self.lay.places.clone()
    if self.locked {
        places.clear()
    }
    if self.locked {
        shell.place_lock(mut self, mut per, mut masks)
    } else {
        shell.place_layers(mut self, 0, mut per, mut masks)
        shell.place_layers(mut self, 1, mut per, mut masks)
    }
    for p in places {
        match p.what {
            Window(w) => {
                guard self.srv.mapped(w) else {
                    continue
                }
                let s = self.srv.window_surface(w)
                let win = self.wins.get(w).unwrap_or(Win {})
                let tx = p.x + win.off_x + self.pan_x
                let ty = p.y + win.off_y + self.pan_y
                let (x, y, opacity) = self.animate(skey(s), tx, ty, p.style.opacity, p.style.transition_ms, now)
                let sc = f64(p.style.scale)
                let geo = self.srv.info(s).geometry
                self.place_tree(s, x - f64(geo.x) * sc, y - f64(geo.y) * sc, sc, p.style, opacity, mut per, mut masks)
                // Its popups, parents first.
                let pops = self.popups.clone()
                for pp in pops {
                    guard self.popup_root(pp) == Some(w) else {
                        continue
                    }
                    let ps = self.srv.popup_surface(pp)
                    guard self.srv.info(ps).mapped else {
                        continue
                    }
                    guard let Some(parent) = self.srv.popup_parent(pp) else {
                        continue
                    }
                    guard let Some((pgx, pgy, psc)) = self.origins.get(parent) else {
                        continue
                    }
                    let pgeo = self.srv.info(parent).geometry
                    let g = self.srv.popup_geometry(pp)
                    let own = self.srv.info(ps).geometry
                    let ox = pgx + f64(pgeo.x + g.x - own.x) * psc
                    let oy = pgy + f64(pgeo.y + g.y - own.y) * psc
                    self.place_tree(ps, ox, oy, psc, layout.Style {}, opacity, mut per, mut masks)
                }
            }
            Image(img) => {
                guard int(img.index) < self.images.len() and self.images[int(img.index)].alive and self.images[int(img.index)].gen == img.gen else {
                    continue
                }
                let opaque = self.images[int(img.index)].opaque
                let (x, y, opacity) = self.animate(ikey(img), p.x + self.pan_x, p.y + self.pan_y, p.style.opacity, p.style.transition_ms, now)
                for o in 0..self.outs.len() {
                    let out = self.outs[o]
                    guard out.alive and x < out.x + out.lw() and y < out.y + out.lh() and x + p.w > out.x and y + p.h > out.y else {
                        continue
                    }
                    let k = out.scale
                    let opq = if opaque { types.Rect { w: f32(p.w * k), h: f32(p.h * k) } } else { types.Rect {} }
                    per[o].push(types.Placement { key: ikey(img), tex: ikey(img), x: f32(((x - out.x) * k).round()), y: f32(((y - out.y) * k).round()), w: f32((p.w * k).round()), h: f32((p.h * k).round()), opacity, radius: p.style.radius * f32(k), shadow: p.style.shadow * f32(k), opaque: opq })
                }
            }
        }
    }
    if not self.locked {
        shell.place_layers(mut self, 2, mut per, mut masks)
        shell.place_layers(mut self, 3, mut per, mut masks)
        shell.place_ime(mut self, mut per, mut masks)
        // A drag's image follows the pointer.
        if let Some(icon) = self.srv.drag_icon(self.seat) {
            if self.srv.info(icon).mapped {
                self.place_tree(icon, self.px, self.py, 1.0, layout.Style {}, 1.0, mut per, mut masks)
            }
        }
    }
    // A cursor the display does not show itself is drawn on top.
    if not self.cursor_hw and self.cursor.width > 0 {
        if self.comp.has(cursor_key) {
            for o in 0..self.outs.len() {
                let out = self.outs[o]
                guard out.alive else {
                    continue
                }
                let k = out.scale
                let cx = (self.px - out.x) * k - f64(self.cursor.hot_x)
                let cy = (self.py - out.y) * k - f64(self.cursor.hot_y)
                if cx < f64(out.width) and cy < f64(out.height) and cx + f64(self.cursor.width) > 0.0 and cy + f64(self.cursor.height) > 0.0 {
                    per[o].push(types.Placement { key: cursor_key, tex: cursor_key, x: f32(cx.round()), y: f32(cy.round()), w: f32(self.cursor.width), h: f32(self.cursor.height) })
                }
            }
        }
    }
    for o in 0..self.outs.len() {
        if self.outs[o].alive {
            self.comp.layout(o, per[o])
            if not self.comp.idle(o) {
                self.outs[o].dirty = true
            }
        }
    }
    masks.each(fn(s, m) {
        self.srv.set_outputs(s, m)
    })
    self.update_scales(masks)
}

fn Display[O, R].update_scales(mut self, masks: map.Map[server.Surface, u64]) {
    let keys = masks.keys()
    for s in keys {
        let m = masks.get(s).unwrap_or(0)
        var best = 1.0
        for o in 0..self.outs.len() {
            if self.outs[o].alive and m & (u64(1) << u64(self.outs[o].sout.id.index)) != 0 {
                best = max(best, self.outs[o].scale)
            }
        }
        let want = i32(best * 120.0 + 0.5)
        var sf = self.surfs.get(s).unwrap_or(Surf {})
        if sf.scale120 != want {
            sf.scale120 = want
            discard self.surfs.insert(s, sf)
            self.srv.preferred(s, want, 0)
        }
    }
}

/// Place surface `s`'s tree with its origin at `ox, oy`.
fn Display[O, R].place_tree(mut self, s: server.Surface, ox: f64, oy: f64, sc: f64, style: layout.Style, opacity: f32, mut per: List[List[types.Placement]], mut masks: map.Map[server.Surface, u64]) {
    var tree: List[(server.Surface, i32, i32)] = []
    self.srv.tree(s, mut tree)
    for (ts, dx, dy) in tree {
        let info = self.srv.info(ts)
        let gx = ox + f64(dx) * sc
        let gy = oy + f64(dy) * sc
        let gw = f64(info.width) * sc
        let gh = f64(info.height) * sc
        discard self.origins.insert(ts, (gx, gy, sc))
        self.hits.add(ts, gx, gy, gw, gh, sc)
        guard let Some(sf) = self.surfs.get(ts) else {
            continue
        }
        guard sf.tex != 0 else {
            continue
        }
        let tex = sf.tex
        let root = ts == s
        let opq = if info.alpha < 1.0 { server.Rect {} } else { self.srv.opaque(ts) }
        let alpha = opacity * info.alpha
        var mask: u64 = 0
        for o in 0..self.outs.len() {
            let out = self.outs[o]
            guard out.alive and gx < out.x + out.lw() and gy < out.y + out.lh() and gx + gw > out.x and gy + gh > out.y else {
                continue
            }
            let k = out.scale
            let f = sc * k
            var src = types.Rect {}
            if info.src[2] > 0.0 {
                let bs = f64(info.scale)
                src = types.Rect { x: f32(info.src[0] * bs), y: f32(info.src[1] * bs), w: f32(info.src[2] * bs), h: f32(info.src[3] * bs) }
            }
            per[o].push(types.Placement {
                key: skey(ts),
                tex,
                x: f32(((gx - out.x) * k).round()),
                y: f32(((gy - out.y) * k).round()),
                w: f32((gw * k).round()),
                h: f32((gh * k).round()),
                src,
                transform: info.transform,
                opacity: alpha,
                radius: if root { style.radius * f32(f) } else { 0.0 },
                shadow: if root { style.shadow * f32(k) } else { 0.0 },
                opaque: types.Rect { x: f32(f64(opq.x) * f), y: f32(f64(opq.y) * f), w: f32(f64(opq.w) * f), h: f32(f64(opq.h) * f) },
            })
            mask |= u64(1) << u64(out.sout.id.index)
        }
        discard masks.insert(ts, mask)
    }
}

// --------------------------------------------------------------- input

fn source_code(s: types.AxisSource) -> u32 {
    return match s {
        Wheel => 0
        Finger => 1
        Continuous => 2
        WheelTilt => 3
    }
}

/// Keep the pointer on some output.
fn Display[O, R].clamp_pointer(mut self) {
    guard self.output_at(self.px, self.py) < 0 else {
        return
    }
    var best = -1
    var bd: f64 = 1.0e18
    for o in 0..self.outs.len() {
        let out = self.outs[o]
        guard out.alive else {
            continue
        }
        let cx = self.px.clamp(out.x, out.x + out.lw() - 1.0)
        let cy = self.py.clamp(out.y, out.y + out.lh() - 1.0)
        let d = (cx - self.px) * (cx - self.px) + (cy - self.py) * (cy - self.py)
        if d < bd {
            bd = d
            best = o
            discard cx
        }
    }
    if best >= 0 {
        let out = self.outs[best]
        self.px = self.px.clamp(out.x, out.x + out.lw() - 1.0)
        self.py = self.py.clamp(out.y, out.y + out.lh() - 1.0)
    }
}

fn Display[O, R].input(mut self, take i: types.Input) {
    self.srv.input_activity(time.now_ns())
    match take i {
        Key(t, code, pressed, sym, text) => {
            let mods = self.be.mods()
            self.emit(Event.Key(Key { time: t, code, sym, text, pressed, mods }))
        }
        Modifiers(d, l, k, g) => {
            // Clients always see the modifier state, bindings or not.
            self.srv.modifiers(self.seat, d, l, k, g)
            self.emit(Event.Modifiers(self.be.mods()))
        }
        Motion(t, dx, dy, rdx, rdy) => {
            let (x, y) = self.constrain(self.px + dx, self.py + dy)
            self.px = x
            self.py = y
            self.moved(t, dx, dy, rdx, rdy)
        }
        MotionAbsolute(t, o, nx, ny) => {
            let oi = int(o)
            guard oi < self.outs.len() and self.outs[oi].alive else {
                return
            }
            let x = self.outs[oi].x + nx * self.outs[oi].lw()
            let y = self.outs[oi].y + ny * self.outs[oi].lh()
            let dx = x - self.px
            let dy = y - self.py
            let (cx, cy) = self.constrain(x, y)
            self.px = cx
            self.py = cy
            self.moved(t, dx, dy, dx, dy)
        }
        Button(t, button, pressed) => {
            if pressed {
                self.buttons += 1
            } else {
                self.buttons = max(self.buttons - 1, 0)
            }
            let p = Pointer { time: t, x: self.px, y: self.py, button, pressed }
            match self.manip {
                Move or Resize => {
                    if not pressed and self.buttons == 0 {
                        self.end_manipulation()
                    }
                    return
                }
                _ => {}
            }
            self.emit(Event.Button(p))
        }
        Axis(t, src, dx, dy, cx, cy, inv) => {
            self.emit(Event.Scroll(Scroll { time: t, x: self.px, y: self.py, dx, dy, v120x: cx, v120y: cy, source: src }))
        }
        TouchDown(t, id, o, nx, ny) => {
            let (x, y) = self.touch_point(int(o), nx, ny)
            self.emit(Event.Touch(Touch { time: t, kind: TouchKind.Down, id, x, y }))
        }
        TouchMotion(t, id, o, nx, ny) => {
            let (x, y) = self.touch_point(int(o), nx, ny)
            self.emit(Event.Touch(Touch { time: t, kind: TouchKind.Motion, id, x, y }))
        }
        TouchUp(t, id) => self.emit(Event.Touch(Touch { time: t, kind: TouchKind.Up, id }))
        TouchFrame => self.emit(Event.Touch(Touch { kind: TouchKind.Frame }))
        TouchCancel => self.emit(Event.Touch(Touch { kind: TouchKind.Cancel }))
        SwipeBegin(t, f) => self.gesture(Gesture { time: t, kind: GestureKind.SwipeBegin, fingers: f })
        SwipeUpdate(t, dx, dy) => self.gesture(Gesture { time: t, kind: GestureKind.SwipeUpdate, dx, dy })
        SwipeEnd(t, c) => self.gesture(Gesture { time: t, kind: GestureKind.SwipeEnd, cancelled: c })
        PinchBegin(t, f) => self.gesture(Gesture { time: t, kind: GestureKind.PinchBegin, fingers: f })
        PinchUpdate(t, dx, dy, sc, rot) => self.gesture(Gesture { time: t, kind: GestureKind.PinchUpdate, dx, dy, scale: sc, rotation: rot })
        PinchEnd(t, c) => self.gesture(Gesture { time: t, kind: GestureKind.PinchEnd, cancelled: c })
        HoldBegin(t, f) => self.gesture(Gesture { time: t, kind: GestureKind.HoldBegin, fingers: f })
        HoldEnd(t, c) => self.gesture(Gesture { time: t, kind: GestureKind.HoldEnd, cancelled: c })
        DeviceAdded(id, desc) => self.emit(Event.DeviceAdded(id, desc))
        DeviceRemoved(id) => self.emit(Event.DeviceRemoved(id))
    }
}

fn Display[O, R].touch_point(self, o: int, nx: f64, ny: f64) -> (f64, f64) {
    guard o < self.outs.len() and self.outs[o].alive else {
        return (nx, ny)
    }
    return (self.outs[o].x + nx * self.outs[o].lw(), self.outs[o].y + ny * self.outs[o].lh())
}

/// The pointer moved: the cursor follows at once (input rate, not frame
/// rate), a running manipulation moves its window, else the compositor
/// hears of it.
fn Display[O, R].moved(mut self, t: u32, dx: f64, dy: f64, rdx: f64, rdy: f64) {
    self.clamp_pointer()
    self.move_cursor()
    match self.manip {
        Move(w, sx, sy, bx, by) => {
            if let Some(cur) = self.wins.get(w) {
                discard self.wins.insert(w, Win { off_x: bx + self.px - sx, off_y: by + self.py - sy, ..cur })
            }
            self.rebuild()
            return
        }
        Resize(w, edges, sx, sy, w0, h0, ox, oy) => {
            self.resize_step(w, edges, sx, sy, w0, h0)
            return
        }
        _ => {}
    }
    self.emit(Event.Motion(Pointer { time: t, x: self.px, y: self.py, dx, dy, raw_dx: rdx, raw_dy: rdy }))
}

fn Display[O, R].gesture(mut self, g: Gesture) {
    match self.manip {
        Pan(vx, vy, last) => {
            match g.kind {
                SwipeUpdate => {
                    self.pan_x += g.dx
                    self.pan_y += g.dy
                    let dt = f64(max(g.time - last, 1))
                    // Velocity, smoothed over the last updates.
                    self.manip = Manip.Pan(vx * 0.5 + g.dx / dt * 0.5, vy * 0.5 + g.dy / dt * 0.5, g.time)
                    self.rebuild()
                }
                SwipeEnd => {
                    // Inertia runs in `render` until it slows down.
                    self.animating = true
                    self.inertia_t = time.now_ns()
                    for o in 0..self.outs.len() {
                        self.outs[o].dirty = true
                    }
                    self.coasting = not g.cancelled
                    if g.cancelled {
                        self.end_manipulation()
                    }
                }
                _ => {}
            }
            return
        }
        _ => {}
    }
    self.emit(Event.Gesture(g))
}

/// The surface under global `x, y` and the point in its coordinates.
fn Display[O, R].under(self, x: f64, y: f64) -> Option[(server.Surface, f64, f64)] {
    return self.hits.find(self.srv, x, y)
}

fn Display[O, R].deliver_motion(mut self, t: u32) {
    var target: Option[(server.Surface, f64, f64)] = None
    // A drag goes to what is under the pointer, not to the grab.
    let dragging = self.srv.dragging(self.seat)
    if self.buttons > 0 and not dragging {
        if let Some(g) = self.grab {
            if let Some((gx, gy, sc)) = self.origins.get(g) {
                target = Some((g, (self.px - gx) / sc, (self.py - gy) / sc))
            }
        }
    }
    if target.is_none() {
        target = self.under(self.px, self.py)
    }
    match target {
        Some((s, lx, ly)) => {
            if self.pointer_on != Some(s) {
                self.pointer_on = Some(s)
                self.srv.pointer_focus(self.seat, Some(s), lx, ly)
            } else if not self.pointer_locked() {
                self.srv.pointer_motion(self.seat, t, lx, ly)
            }
        }
        None => {
            if self.pointer_on.is_some() {
                self.pointer_on = None
                self.srv.pointer_focus(self.seat, None, 0.0, 0.0)
                if self.cursor_surface.is_some() {
                    self.cursor_surface = None
                    self.set_cursor_named("default")
                }
            }
        }
    }
    self.update_constraint()
    if dragging and self.srv.drag_icon(self.seat).is_some() {
        self.rebuild()
    }
}

/// Whether a pointer lock holds the pointer still.
fn Display[O, R].pointer_locked(self) -> bool {
    guard let Some(s) = self.constrained else {
        return false
    }
    return match self.srv.constraint(self.seat, s) {
        Some(c) => c.active and c.lock
        None => false
    }
}

/// Where the pointer may go on its way to `x, y`: nowhere while locked,
/// inside the region while confined.
fn Display[O, R].constrain(self, x: f64, y: f64) -> (f64, f64) {
    guard let Some(s) = self.constrained else {
        return (x, y)
    }
    guard let Some(c) = self.srv.constraint(self.seat, s) else {
        return (x, y)
    }
    guard c.active else {
        return (x, y)
    }
    if c.lock {
        return (self.px, self.py)
    }
    guard let Some((gx, gy, sc)) = self.origins.get(s) else {
        return (x, y)
    }
    let info = self.srv.info(s)
    let rects = c.region.clone().unwrap_or([server.Rect { w: info.width, h: info.height }])
    let lx = (x - gx) / sc
    let ly = (y - gy) / sc
    for r in rects {
        if lx >= f64(r.x) and ly >= f64(r.y) and lx < f64(r.x + r.w) and ly < f64(r.y + r.h) {
            return (x, y)
        }
    }
    // Outside: clamp into the rectangle the pointer is in now.
    let cx = (self.px - gx) / sc
    let cy = (self.py - gy) / sc
    var r = rects.first().unwrap_or(server.Rect {})
    for q in rects {
        if cx >= f64(q.x) and cy >= f64(q.y) and cx < f64(q.x + q.w) and cy < f64(q.y + q.h) {
            r = q
        }
    }
    let nx = min(max(lx, f64(r.x)), f64(r.x + r.w) - 0.01)
    let ny = min(max(ly, f64(r.y)), f64(r.y + r.h) - 0.01)
    return (gx + nx * sc, gy + ny * sc)
}

/// Turn pointer constraints on and off: one applies while the pointer is
/// inside its region on a surface of the client with the keyboard.
fn Display[O, R].update_constraint(mut self) {
    let kb = self.srv.keyboard_focused(self.seat)
    let kb_client = match kb {
        Some(k) => Some(self.srv.client_of(k))
        None => None
    }
    if let Some(s) = self.constrained {
        let keep = self.pointer_on == Some(s) and kb_client == Some(self.srv.client_of(s)) and self.srv.surface_alive(s)
        if not keep {
            if let Some(c) = self.srv.constraint(self.seat, s) {
                // A lock ends where the client says the cursor is.
                if c.lock {
                    if let Some((hx, hy)) = c.hint {
                        if let Some((gx, gy, sc)) = self.origins.get(s) {
                            self.px = gx + hx * sc
                            self.py = gy + hy * sc
                            self.move_cursor()
                        }
                    }
                }
            }
            self.srv.set_constraint(self.seat, s, false)
            self.constrained = None
        }
    }
    guard self.constrained.is_none() else {
        return
    }
    guard let Some(s) = self.pointer_on else {
        return
    }
    guard kb_client == Some(self.srv.client_of(s)) else {
        return
    }
    guard let Some(c) = self.srv.constraint(self.seat, s) else {
        return
    }
    guard let Some((gx, gy, sc)) = self.origins.get(s) else {
        return
    }
    let lx = (self.px - gx) / sc
    let ly = (self.py - gy) / sc
    let inside = match c.region.clone() {
        Some(rs) => rs.any(fn(r) => lx >= f64(r.x) and ly >= f64(r.y) and lx < f64(r.x + r.w) and ly < f64(r.y + r.h))
        None => self.srv.accepts(s, lx, ly)
    }
    if inside {
        self.srv.set_constraint(self.seat, s, true)
        self.constrained = Some(s)
    }
}

/// Whether `s` is a grabbing popup's surface (or under one).
fn Display[O, R].in_grab(self, s: server.Surface) -> bool {
    for p in self.grabs {
        if self.srv.popup_surface(p) == s {
            return true
        }
        var tree: List[(server.Surface, i32, i32)] = []
        self.srv.tree(self.srv.popup_surface(p), mut tree)
        for (ts, _, _) in tree {
            if ts == s {
                return true
            }
        }
    }
    return false
}

/// Do what event `e` asks, the way the protocol suggests: input goes to
/// the client under the pointer or with keyboard focus, new windows get
/// a configure, maximize and fullscreen requests are granted on the
/// window's output, moves and resizes run as library manipulations,
/// hidden windows are told they are suspended. Everything else: nothing.
pub fn Display[O, R].accept(mut self, e: Event) {
    match e {
        ExtensionRequest(_, _, args) => {
            for a in args {
                match a {
                    Fd(f) => {
                        if f >= 0 {
                            os.close(f)
                        }
                    }
                    _ => {}
                }
            }
        }
        WindowNew(w) => {
            discard self.configure(w, 0, 0, server.States {})
        }
        RequestMove(w) => self.manipulate_move(w)
        RequestResize(w, edges) => self.manipulate_resize(w, edges)
        RequestMaximize(w, on) => {
            let cur = self.wins.get(w).unwrap_or(Win {})
            var st = cur.states
            st.maximized = on
            // Maximized windows stay clear of panels.
            let (ww, hh) = self.window_output_size(w, true)
            if on {
                discard self.configure(w, ww, hh, st)
            } else {
                discard self.configure(w, 0, 0, st)
            }
        }
        RequestFullscreen(w, o, on) => {
            let cur = self.wins.get(w).unwrap_or(Win {})
            var st = cur.states
            st.fullscreen = on
            var (ww, hh) = self.window_output_size(w, false)
            if let Some(so) = o {
                let oi = self.out_index(so)
                if oi >= 0 {
                    ww = i32(self.outs[oi].lw())
                    hh = i32(self.outs[oi].lh())
                }
            }
            if on {
                discard self.configure(w, ww, hh, st)
            } else {
                discard self.configure(w, 0, 0, st)
            }
        }
        Occluded(w, hidden) => {
            let cur = self.wins.get(w).unwrap_or(Win {})
            if cur.configured {
                var st = cur.states
                st.suspended = hidden
                discard self.configure(w, cur.width, cur.height, st)
            }
        }
        Key(k) => {
            // Ctrl+Alt+Fn arrives as XF86Switch_VT_n.
            if k.pressed and k.sym >= 0x1008FE01 and k.sym <= 0x1008FE0C {
                self.be.switch_vt(int(k.sym - 0x1008FE00))
                return
            }
            discard self.srv.key(self.seat, k.time, k.code, k.pressed)
        }
        Modifiers => {}
        Motion(p) => {
            self.srv.relative_motion(self.seat, u64(time.now_ns() / 1000), p.dx, p.dy, p.raw_dx, p.raw_dy)
            self.deliver_motion(p.time)
        }
        Button(p) => {
            if p.pressed {
                if let Some((s, _, _)) = self.under(self.px, self.py) {
                    shell.clicked(mut self, s)
                }
            }
            if p.pressed and not self.grabs.is_empty() {
                let under = self.under(self.px, self.py)
                let inside = match under {
                    Some((s, _, _)) => self.in_grab(s)
                    None => false
                }
                if not inside {
                    self.dismiss_popups()
                }
            }
            self.deliver_motion(p.time)
            if p.pressed and self.buttons == 1 {
                self.grab = self.pointer_on
            }
            discard self.srv.pointer_button(self.seat, p.time, p.button, p.pressed)
            if self.buttons == 0 {
                self.grab = None
            }
        }
        Scroll(s) => {
            self.deliver_motion(s.time)
            self.srv.pointer_axis(self.seat, s.time, source_code(s.source), s.dx, s.dy, s.v120x, s.v120y, false)
        }
        Touch(t) => {
            match t.kind {
                Down => {
                    if let Some((s, lx, ly)) = self.under(t.x, t.y) {
                        discard self.srv.touch_down(self.seat, s, t.time, t.id, lx, ly)
                    }
                }
                Motion => {
                    if let Some(s) = self.srv.touch_target(self.seat, t.id) {
                        if let Some((gx, gy, sc)) = self.origins.get(s) {
                            self.srv.touch_motion(self.seat, t.time, t.id, (t.x - gx) / sc, (t.y - gy) / sc)
                        }
                    }
                }
                Up => {
                    discard self.srv.touch_up(self.seat, t.time, t.id)
                }
                Frame => self.srv.touch_frame(self.seat)
                Cancel => self.srv.touch_cancel(self.seat)
            }
        }
        Gesture(g) => {
            let (kind, phase) = match g.kind {
                SwipeBegin => (0, 0)
                SwipeUpdate => (0, 1)
                SwipeEnd => (0, 2)
                PinchBegin => (1, 0)
                PinchUpdate => (1, 1)
                PinchEnd => (1, 2)
                HoldBegin => (2, 0)
                HoldEnd => (2, 2)
            }
            self.srv.gesture(self.seat, kind, phase, g.time, u32(max(g.fingers, 0)), g.dx, g.dy, g.scale, g.rotation, g.cancelled)
        }
        // The library draws no title bars: clients do.
        WindowDecoration(w, _) => self.decorate(w, false)
        OutputConfig(c, only_test) => {
            let ok = self.apply_output_config(c, only_test)
            self.srv.output_config_done(c, ok)
        }
        RequestActivate(w) => self.focus(Some(w))
        _ => {}
    }
}

/// Logical size of the output the window is (mostly) on.
/// Logical size of the output the window is (mostly) on; `usable`: the
/// part panels leave free.
fn Display[O, R].window_output_size(self, w: server.Window, usable: bool) -> (i32, i32) {
    let s = self.srv.window_surface(w)
    var o = 0
    if let Some((gx, gy, _)) = self.origins.get(s) {
        let k = self.output_at(gx + 1.0, gy + 1.0)
        if k >= 0 {
            o = k
        }
    } else {
        let k = self.output_at(self.px, self.py)
        if k >= 0 {
            o = k
        }
    }
    guard o < self.outs.len() and self.outs[o].alive else {
        return (0, 0)
    }
    if usable and self.outs[o].uw > 0.0 and self.outs[o].uh > 0.0 {
        return (i32(self.outs[o].uw), i32(self.outs[o].uh))
    }
    return (i32(self.outs[o].lw()), i32(self.outs[o].lh()))
}

// -------------------------------------------------------- manipulation

/// Move window `w` with the pointer until the buttons go up, inside the
/// library: every motion moves it with no round trip through the
/// compositor, and Moved tells the compositor where it ended. Nothing
/// happens with no button down (a client asking after a quick click).
pub fn Display[O, R].manipulate_move(mut self, w: server.Window) {
    guard self.buttons > 0 else {
        return
    }
    let cur = self.wins.get(w).unwrap_or(Win {})
    self.manip = Manip.Move(w, self.px, self.py, cur.off_x, cur.off_y)
    self.dismiss_popups()
    self.set_cursor_named("grabbing")
}

/// Resize window `w` from `edges` (top 1, bottom 2, left 4, right 8) with
/// the pointer: one configure at a time (the next goes when the client
/// answered), the opposite edge staying put. Nothing happens with no
/// button down.
pub fn Display[O, R].manipulate_resize(mut self, w: server.Window, edges: u32) {
    guard self.buttons > 0 else {
        return
    }
    let cur = self.wins.get(w).unwrap_or(Win {})
    let geo = self.srv.info(self.srv.window_surface(w)).geometry
    let w0 = if cur.width > 0 { cur.width } else { geo.w }
    let h0 = if cur.height > 0 { cur.height } else { geo.h }
    self.manip = Manip.Resize(w, edges, self.px, self.py, w0, h0, cur.off_x, cur.off_y)
    self.dismiss_popups()
    let name = match edges {
        1 => "n-resize"
        2 => "s-resize"
        4 => "w-resize"
        8 => "e-resize"
        5 => "nw-resize"
        9 => "ne-resize"
        6 => "sw-resize"
        10 => "se-resize"
        _ => "move"
    }
    self.set_cursor_named(name)
}

fn Display[O, R].resize_step(mut self, w: server.Window, edges: u32, sx: f64, sy: f64, w0: i32, h0: i32) {
    guard let Some(cur) = self.wins.get(w) else {
        return
    }
    guard not cur.inflight else {
        return
    }
    let dx = i32(self.px - sx)
    let dy = i32(self.py - sy)
    var nw = w0
    var nh = h0
    if edges & 8 != 0 {
        nw = w0 + dx
    } else if edges & 4 != 0 {
        nw = w0 - dx
    }
    if edges & 2 != 0 {
        nh = h0 + dy
    } else if edges & 1 != 0 {
        nh = h0 - dy
    }
    let (minw, minh, maxw, maxh) = self.srv.size_hints(w)
    nw = max(nw, max(minw, 32))
    nh = max(nh, max(minh, 32))
    if maxw > 0 {
        nw = min(nw, maxw)
    }
    if maxh > 0 {
        nh = min(nh, maxh)
    }
    guard nw != cur.width or nh != cur.height else {
        return
    }
    var st = cur.states
    st.resizing = true
    discard self.configure(w, nw, nh, st)
}

/// Pan everything with the next swipe (workspace scrolling): updates move
/// the whole layout at input rate, the end coasts with inertia, Panned
/// tells the compositor the distance.
pub fn Display[O, R].manipulate_pan(mut self) {
    self.manip = Manip.Pan(0.0, 0.0, 0)
}

fn Display[O, R].end_manipulation(mut self) {
    match self.manip {
        Move(w, _, _, _, _) => {
            let cur = self.wins.get(w).unwrap_or(Win {})
            self.emit(Event.Moved(w, cur.off_x, cur.off_y))
        }
        Resize(w, _, _, _, _, _, _, _) => {
            let cur = self.wins.get(w).unwrap_or(Win {})
            var st = cur.states
            st.resizing = false
            discard self.configure(w, cur.width, cur.height, st)
            self.emit(Event.Resized(w, cur.off_x, cur.off_y, cur.width, cur.height))
        }
        Pan => self.emit(Event.Panned(self.pan_x, self.pan_y))
        Idle => {}
    }
    self.manip = Manip.Idle
    self.coasting = false
    self.offsets_done = true
    if self.cursor_surface.is_none() {
        self.set_cursor_named("default")
    }
}

/// Inertia after a pan: velocity decays by e every 300 ms.
fn Display[O, R].coast(mut self) {
    guard self.coasting else {
        return
    }
    match self.manip {
        Pan(vx, vy, last) => {
            let now = time.now_ns()
            let dt = f64(now - self.inertia_t) / 1000000.0
            self.inertia_t = now
            self.pan_x += vx * dt
            self.pan_y += vy * dt
            let k = (-dt / 300.0).exp()
            let nvx = vx * k
            let nvy = vy * k
            if nvx.abs() + nvy.abs() < 0.02 {
                self.end_manipulation()
            } else {
                self.manip = Manip.Pan(nvx, nvy, last)
                self.animating = true
            }
            self.rebuild()
        }
        _ => {}
    }
}

// --------------------------------------------------------------- frames

/// Arm output `o`'s frame for its clock's deadline when it has something
/// to show; nothing is armed when idle (no wakeups).
fn Display[O, R].schedule(mut self, o: int) {
    guard self.outs[o].alive and not self.outs[o].armed and not self.outs[o].due else {
        return
    }
    var wants = self.outs[o].dirty or self.animating
    if not wants {
        for s in self.drawn[o] {
            if self.srv.wants_frame(s) {
                wants = true
                break
            }
        }
    }
    guard wants and self.be.can_present(u32(o)) else {
        return
    }
    let now = time.now_ns()
    // Nested, the parent's frame callback already says when to draw: a
    // second, predicted deadline would only miss the parent's.
    let start = if self.be.paced() { now } else { self.outs[o].clock.start(now) }
    if start <= now + 200000 {
        self.frame_due(o)
        return
    }
    discard os.timer_arm(self.outs[o].timer, start - now, 0)
    self.outs[o].armed = true
}

fn Display[O, R].frame_due(mut self, o: int) {
    guard self.outs[o].alive and not self.outs[o].due else {
        return
    }
    self.outs[o].due = true
    let target = self.outs[o].clock.begin(time.now_ns())
    let so = self.outs[o].sout
    self.emit(Event.Frame(so, target))
}

/// Upload what shm commits left for this frame (once per buffer, whatever
/// the number of commits), then hand the buffers back.
fn Display[O, R].upload_pending(mut self) {
    // The server lends each buffer's bytes while the device records them.
    var srv = mem.replace(mut self.srv, server.Server.none())
    for s in self.surfs.keys() {
        guard let Some(sf) = self.surfs.get(s) else {
            continue
        }
        guard let Some(b) = sf.pending else {
            continue
        }
        discard srv.with_shm(b, fn(bytes: &[u8], stride: int) {
            discard self.comp.shm_upload(skey(s), bytes, stride)
        })
        srv.release(b)
        discard self.surfs.insert(s, Surf { pending: None, ..sf })
    }
    self.srv = srv
}

fn Display[O, R].render(mut self, o: int) -> Result[(), str] {
    self.outs[o].due = false
    guard self.outs[o].alive and self.be.can_present(u32(o)) else {
        return Ok(())
    }
    let t0 = time.now_ns()
    self.coast()
    if self.animating {
        self.rebuild()
    }
    self.upload_pending()
    if self.outs[o].dirty {
        var scanned = false
        // Direct scanout: one client buffer fills the output as is (not
        // while a capture waits for a composed image).
        let capturing = self.srv.capture_waiting(self.outs[o].sout)
        if not capturing {
            if let Some(key) = self.comp.scanout(o) {
                scanned = self.try_scanout(o, key)
            }
        }
        if not scanned {
            guard let Some((key, age)) = try self.acquire(o) else {
                // Every target is on screen: try again at the next flip.
                return Ok(())
            }
            if let Some(fence) = try self.comp.render(o, key, age) {
                var rects: List[(i32, i32, i32, i32)] = []
                self.comp.changed(o, mut rects)
                self.count_damage(o, rects)
                try self.be.present(u32(o), fence, rects, false)
                self.probes[o].frame(time.now_ns() - t0)
            }
            self.outs[o].scanned = 0
            if capturing {
                // The image is whole (drawn by buffer age): read it back.
                if let Ok(px) = self.comp.read(key) {
                    self.srv.capture(self.outs[o].sout, px, self.outs[o].width, self.outs[o].height, time.now_ns())
                }
            }
        }
        self.outs[o].dirty = false
    }
    // What this frame shows: its clients hear of it.
    var drawn: List[server.Surface] = []
    self.origins.each(fn(s, _) {
        if self.comp.visible(o, skey(s)) {
            drawn.push(s)
        }
    })
    let ms = u32((time.now_ns() / 1000000) & 0xffffffff)
    for s in drawn {
        self.srv.frame_done(s, ms)
    }
    self.drawn[o] = drawn
    if self.animating {
        self.outs[o].dirty = true
    }
    self.occlusion()
    return Ok(())
}

/// The target to draw output `o` into and its age: the output asks for
/// targets first when it has none (of its size), the renderer makes them.
fn Display[O, R].acquire(mut self, o: int) -> Result[Option[(u64, u32)], str] {
    for _ in 0..2 {
        match self.be.acquire(u32(o)) {
            Draw(key, age) => {
                self.free_targets()
                return Ok(Some((key, age)))
            }
            Need(w) => {
                self.free_targets()
                let ts = try self.comp.targets(w)
                try self.be.give(u32(o), ts)
            }
            Busy => {
                return Ok(None)
            }
        }
    }
    return Ok(None)
}

/// Free the render targets the output let go of.
fn Display[O, R].free_targets(mut self) {
    var gone: List[u64] = []
    self.be.retired(mut gone)
    for k in gone {
        self.comp.drop_target(k)
    }
}

fn Display[O, R].try_scanout(mut self, o: int, key: u64) -> bool {
    var target: Option[server.Surface] = None
    self.origins.each(fn(s, _) {
        if skey(s) == key {
            target = Some(s)
        }
    })
    guard let Some(s) = target else {
        return false
    }
    guard let Some(sf) = self.surfs.get(s) else {
        return false
    }
    guard let Some(b) = sf.buffer else {
        return false
    }
    let bi = self.srv.buffer(b)
    guard bi.kind == server.BufferKind.Dmabuf and bi.planes == 1 else {
        return false
    }
    let rects: List[(i32, i32, i32, i32)] = [sf.dmg]
    let tear = self.srv.info(s).tearing
    let t0 = time.now_ns()
    guard self.be.scanout(u32(o), bkey(b), self.srv.dmabuf(b), rects, tear) else {
        return false
    }
    self.count_damage(o, rects)
    self.probes[o].frame(time.now_ns() - t0)
    self.outs[o].scanned = key
    return true
}

fn Display[O, R].count_damage(mut self, o: int, rects: &[(i32, i32, i32, i32)]) {
    if rects.is_empty() {
        self.probes[o].damage_rects += 1
        self.probes[o].damage_pixels += int(self.outs[o].width) * int(self.outs[o].height)
    }
    for r in rects {
        self.probes[o].damage_rects += 1
        self.probes[o].damage_pixels += int(r.2) * int(r.3)
    }
}

fn Display[O, R].presented(mut self, o: int, seq: u64, ns: int, flags: u32) {
    guard o < self.outs.len() and self.outs[o].alive else {
        return
    }
    if self.outs[o].clock.presented(seq, ns) {
        self.probes[o].missed += 1
    }
    self.probes[o].frames += 1
    if flags & types.presented_zero_copy != 0 {
        self.probes[o].scanned_out += 1
    }
    let gap = ns - self.outs[o].shown_ns
    if self.outs[o].shown_ns > 0 and gap > 0 and gap < 500000000 {
        self.probes[o].interval(gap)
    }
    self.outs[o].shown_ns = ns
    let refresh = self.outs[o].clock.refresh_ns
    let so = self.outs[o].sout
    let drawn = self.drawn[o].clone()
    for s in drawn {
        self.srv.presented(s, so, ns, refresh, seq, flags)
        self.srv.latch(s)
        var done: List[server.Txn] = []
        for (fs, t) in self.fifo {
            if fs == s {
                done.push(t)
            }
        }
        self.fifo.retain(fn(f) => f.0 != s)
        for t in done {
            self.resolve(t)
        }
    }
    // Buffers the GPU and display are done with.
    let rel = mem.replace(mut self.releases[o], [])
    for b in rel {
        if self.be.holds(bkey(b)) {
            self.releases[o].push(b)
        } else {
            self.srv.release(b)
            self.drop_orphan(b)
        }
    }
    for (fd, point) in mem.replace(mut self.points[o], []) {
        self.sync.signal(fd, point)
    }
    shell.presented(mut self, o)
    self.schedule(o)
}

/// Windows hidden for a while are told (Occluded); visible ones again.
fn Display[O, R].occlusion(mut self) {
    let now = time.now_ns()
    var soon = 0
    for w in self.wins.keys() {
        guard let Some(cur) = self.wins.get(w) else {
            continue
        }
        guard self.srv.mapped(w) else {
            continue
        }
        let s = self.srv.window_surface(w)
        var seen = false
        for o in 0..self.outs.len() {
            seen = seen or (self.outs[o].alive and self.comp.visible(o, skey(s)))
        }
        var win = cur
        if seen {
            win.hidden = false
            if win.occluded {
                win.occluded = false
                self.emit(Event.Occluded(w, false))
            }
        } else if not win.hidden {
            win.hidden = true
            win.hidden_since = now
            soon = 500000000
        } else if not win.occluded and now - win.hidden_since >= 500000000 {
            win.occluded = true
            self.emit(Event.Occluded(w, true))
        } else if not win.occluded {
            soon = 500000000 - (now - win.hidden_since)
        }
        discard self.wins.insert(w, win)
    }
    if soon > 0 {
        discard os.timer_arm(self.house_fd, soon, 0)
    }
}

fn Display[O, R].housekeeping(mut self) {
    self.occlusion()
    if self.txn_layout.is_some() and time.now_ns() >= self.txn_deadline {
        self.txn_wins.clear()
        self.try_finish()
    }
}

// --------------------------------------------------------------- cursor

fn Display[O, R].set_cursor_image(mut self, take img: cursor.Image) {
    self.cursor_hw = self.be.set_cursor(img.pixels, img.width, img.height, img.hot_x, img.hot_y)
    if self.cursor_hw or img.width == 0 {
        self.comp.forget(cursor_key)
    } else {
        discard self.comp.image(cursor_key, img.width, img.height, types.buffer.argb8888, img.pixels, int(img.width) * 4)
        let all: List[(i32, i32, i32, i32)] = []
        self.comp.commit(cursor_key, all)
    }
    self.cursor = img
    self.move_cursor()
    if not self.cursor_hw {
        self.rebuild()
    }
}

/// Show cursor `name` of the theme ("default", "text", "pointer", ...).
pub fn Display[O, R].set_cursor_named(mut self, name: str) {
    let img = cursor.load(name, self.cursor_size)
    self.set_cursor_image(img)
}

pub fn Display[O, R].hide_cursor(mut self) {
    self.set_cursor_image(cursor.Image {})
    for o in 0..self.outs.len() {
        self.be.move_cursor(u32(o), None)
    }
}

/// A client's cursor surface (shm): its pixels become the cursor.
fn Display[O, R].client_cursor(mut self, s: server.Surface) {
    let info = self.srv.info(s)
    guard let Some(b) = info.buffer else {
        self.hide_cursor()
        return
    }
    let bi = self.srv.buffer(b)
    guard bi.kind == server.BufferKind.Shm else {
        return
    }
    var img = cursor.Image { width: bi.width, height: bi.height, hot_x: self.cursor_hx * info.scale, hot_y: self.cursor_hy * info.scale }
    discard self.srv.with_shm(b, fn(bytes: &[u8], stride: int) {
        img.pixels = pixels.pack(bytes, stride, int(bi.width) * 4, int(bi.height))
    })
    if bi.format == types.buffer.xrgb8888 {
        pixels.opaque(mut img.pixels)
    }
    self.srv.release(b)
    let ms = u32((time.now_ns() / 1000000) & 0xffffffff)
    self.srv.frame_done(s, ms)
    self.set_cursor_image(img)
}

/// Put the hardware cursor where the pointer is, on every output.
fn Display[O, R].move_cursor(mut self) {
    if not self.cursor_hw {
        if self.comp.has(cursor_key) {
            self.rebuild()
        }
        return
    }
    for o in 0..self.outs.len() {
        let out = self.outs[o]
        guard out.alive else {
            continue
        }
        let x = i32((self.px - out.x) * out.scale) - self.cursor.hot_x
        let y = i32((self.py - out.y) * out.scale) - self.cursor.hot_y
        let inside = x < out.width and y < out.height and x + self.cursor.width > 0 and y + self.cursor.height > 0
        self.be.move_cursor(u32(o), if inside and self.cursor.width > 0 { Some((x, y)) } else { None })
    }
}

// ------------------------------------------------------------------ api

/// What the screen shows, back to front: replaces the last layout from the
/// next frame; only what changed is redrawn. A window's subsurfaces and
/// popups come along.
pub fn Display[O, R].layout(mut self, f: fn(mut layout.Layout)) {
    if self.offsets_done {
        let keys = self.wins.keys()
        for w in keys {
            if let Some(cur) = self.wins.get(w) {
                discard self.wins.insert(w, Win { off_x: 0.0, off_y: 0.0, ..cur })
            }
        }
        self.pan_x = 0.0
        self.pan_y = 0.0
        self.offsets_done = false
    }
    var l = layout.Layout {}
    f(mut l)
    if self.txn_open {
        self.txn_layout = Some(l)
        return
    }
    self.lay = l
    self.rebuild()
}

/// Configure window `w`: size in logical pixels (0 lets the client
/// choose) and states. The serial it will ack.
pub fn Display[O, R].configure(mut self, w: server.Window, width: i32, height: i32, st: server.States) -> u32 {
    let serial = self.srv.configure(w, width, height, st)
    let cur = self.wins.get(w).unwrap_or(Win {})
    discard self.wins.insert(w, Win { width, height, states: st, configured: true, inflight: true, ..cur })
    if self.txn_open and not self.txn_wins.contains(w) {
        self.txn_wins.push(w)
    }
    return serial
}

/// Start a layout transaction: the configures and the layout until `end`
/// show together, once every configured window drew its new size.
pub fn Display[O, R].begin(mut self) {
    self.txn_open = true
    self.txn_wins.clear()
}

/// End the transaction: it shows when the windows are ready, or after
/// `timeout_ms` with what arrived (a slow client never holds it up).
pub fn Display[O, R].end(mut self, timeout_ms: int) {
    self.txn_open = false
    if self.txn_layout.is_none() {
        self.txn_wins.clear()
        return
    }
    self.txn_deadline = time.now_ns() + timeout_ms * 1000000
    discard os.timer_arm(self.house_fd, timeout_ms * 1000000, 0)
    self.try_finish()
}

fn Display[O, R].held_window(self, s: server.Surface) -> bool {
    for w in self.txn_wins {
        if self.srv.window_surface(w) == s {
            return true
        }
    }
    // Subsurfaces of held windows wait too.
    if let Some(origin) = self.origins.get(s) {
        discard origin
    }
    return false
}

fn Display[O, R].try_finish(mut self) {
    guard self.txn_layout.is_some() and self.txn_wins.is_empty() and not self.txn_open else {
        return
    }
    self.lay = self.txn_layout.take().unwrap()
    for s in mem.replace(mut self.held, []) {
        if self.srv.surface_alive(s) {
            self.applied(s)
        }
    }
    self.rebuild()
}

/// Who draws window `w`'s title bar: the compositor (`server_side`, with
/// images in the layout) or the client.
pub fn Display[O, R].decorate(mut self, w: server.Window, server_side: bool) {
    self.srv.set_decoration(w, server_side)
    let cur = self.wins.get(w).unwrap_or(Win {})
    if cur.configured {
        discard self.configure(w, cur.width, cur.height, cur.states)
    }
}

/// The window's icon: a theme name and/or images.
pub fn Display[O, R].icon(self, w: server.Window) -> server.Icon {
    return self.srv.icon(w)
}

/// A name for the window that stays the same across restarts (to
/// remember its place), and a description of it.
pub fn Display[O, R].tag(self, w: server.Window) -> (str, str) {
    return self.srv.tag(w)
}

/// The window is a modal dialog of its parent.
pub fn Display[O, R].modal(self, w: server.Window) -> bool {
    return self.srv.modal(w)
}

/// What the window shows: none 0, photo 1, video 2, game 3.
pub fn Display[O, R].content_type(self, w: server.Window) -> u32 {
    return self.srv.info(self.srv.window_surface(w)).content
}

/// A token for a program the compositor starts (put it in
/// XDG_ACTIVATION_TOKEN): its window may then take focus.
pub fn Display[O, R].activation_token(mut self) -> str {
    return self.srv.activation_token()
}

/// The part of output `o` panels leave free: x, y, width, height.
pub fn Display[O, R].usable(self, so: server.Output) -> (f64, f64, f64, f64) {
    let o = self.out_index(so)
    guard o >= 0 else {
        return (0.0, 0.0, 0.0, 0.0)
    }
    let out = self.outs[o]
    if out.uw <= 0.0 or out.uh <= 0.0 {
        return (out.x, out.y, out.lw(), out.lh())
    }
    return (out.ux, out.uy, out.uw, out.uh)
}

/// The session is locked: only the lock screen shows.
pub fn Display[O, R].locked(self) -> bool {
    return self.locked
}

/// The focused client asked for the compositor's shortcuts (a remote
/// desktop, a VM): let keys through to it.
pub fn Display[O, R].shortcuts_inhibited(self) -> bool {
    return self.srv.shortcuts_inhibited(self.seat)
}

/// A visible client wants the screen kept on (a video playing).
pub fn Display[O, R].idle_inhibited(self) -> bool {
    for s in self.srv.idle_inhibitors() {
        for o in 0..self.outs.len() {
            if self.outs[o].alive and self.comp.visible(o, skey(s)) {
                return true
            }
        }
    }
    return false
}

/// Idle notifications that are due go out; arm for the next one.
fn Display[O, R].idle_tick(mut self) {
    let now = time.now_ns()
    let next = self.srv.idle_check(now, self.idle_inhibited())
    if next > 0 {
        discard os.timer_arm(self.idle_fd, max(next - now, 1000000), 0)
    } else if next < 0 {
        // Held back by an inhibitor: look again in a while.
        discard os.timer_arm(self.idle_fd, 5000000000, 0)
    }
}

/// Ask window `w` to close.
pub fn Display[O, R].close(mut self, w: server.Window) {
    self.srv.close(w)
}

/// Give window `w` the keyboard (None: nobody). Popups grabbing the
/// keyboard keep it until they close.
pub fn Display[O, R].focus(mut self, w: Option[server.Window]) {
    self.focus = match w {
        Some(x) => Some(self.srv.window_surface(x))
        None => None
    }
    // A window taking focus ends a layer surface's on-demand focus.
    self.layer_focus = None
    shell.update_keyboard(mut self)
}

pub fn Display[O, R].focused(self) -> Option[server.Window] {
    guard let Some(s) = self.focus else {
        return None
    }
    return self.srv.window_of(s)
}

/// The window under global `x, y` (popups and subsurfaces count as their
/// window).
pub fn Display[O, R].window_at(self, x: f64, y: f64) -> Option[server.Window] {
    guard let Some((s, _, _)) = self.under(x, y) else {
        return None
    }
    if let Some(w) = self.srv.window_of(s) {
        return Some(w)
    }
    // A subsurface or popup: find its window by position in the layout.
    for p in self.lay.places {
        match p.what {
            Window(w) => {
                let ws = self.srv.window_surface(w)
                var tree: List[(server.Surface, i32, i32)] = []
                self.srv.tree(ws, mut tree)
                for (ts, _, _) in tree {
                    if ts == s {
                        return Some(w)
                    }
                }
            }
            _ => {}
        }
    }
    for pp in self.popups {
        if self.srv.popup_surface(pp) == s {
            return self.popup_root(pp)
        }
    }
    return None
}

pub fn Display[O, R].title(self, w: server.Window) -> str {
    return self.srv.title(w).to_str()
}

pub fn Display[O, R].app_id(self, w: server.Window) -> str {
    return self.srv.app_id(w).to_str()
}

pub fn Display[O, R].parent(self, w: server.Window) -> Option[server.Window] {
    return self.srv.parent(w)
}

/// The window's geometry size (what the client drew), logical pixels.
pub fn Display[O, R].size(self, w: server.Window) -> (i32, i32) {
    let g = self.srv.info(self.srv.window_surface(w)).geometry
    return (g.w, g.h)
}

/// Minimum and maximum size the client wants (0: none).
pub fn Display[O, R].size_hints(self, w: server.Window) -> (i32, i32, i32, i32) {
    return self.srv.size_hints(w)
}

pub fn Display[O, R].client(self, w: server.Window) -> server.Client {
    return self.srv.window_client(w)
}

/// Process id, user and group of a client.
pub fn Display[O, R].credentials(self, c: server.Client) -> (int, int, int) {
    return self.srv.credentials(c)
}

/// The sandbox a client runs in (wp-security-context): engine
/// ("flatpak"), app id, instance id; None outside one.
pub fn Display[O, R].sandbox(self, c: server.Client) -> Option[(str, str, str)] {
    return self.srv.sandbox(c)
}

/// Whether any of the window shows on some output.
pub fn Display[O, R].visible(self, w: server.Window) -> bool {
    let s = self.srv.window_surface(w)
    for o in 0..self.outs.len() {
        if self.outs[o].alive and self.comp.visible(o, skey(s)) {
            return true
        }
    }
    return false
}

// --------------------------------------------------------------- outputs

pub fn Display[O, R].outputs(self) -> List[server.Output] {
    var out: List[server.Output] = []
    for o in self.outs {
        if o.alive {
            out.push(o.sout)
        }
    }
    return out
}

/// Position and size in global logical pixels.
pub fn Display[O, R].output_rect(self, so: server.Output) -> (f64, f64, f64, f64) {
    let o = self.out_index(so)
    guard o >= 0 else {
        return (0.0, 0.0, 0.0, 0.0)
    }
    return (self.outs[o].x, self.outs[o].y, self.outs[o].lw(), self.outs[o].lh())
}

pub fn Display[O, R].output_desc(self, so: server.Output) -> types.OutputDesc {
    let o = self.out_index(so)
    guard o >= 0 else {
        return types.OutputDesc {}
    }
    return self.be.output(u32(o))
}

fn Display[O, R].output_moved(mut self, o: int) {
    let info = self.output_info(o)
    let so = self.outs[o].sout
    self.srv.update_output(so, info)
    self.comp.damage_all()
    self.rebuild()
}

/// Scale of an output (1.5: 150%); clients render for it.
pub fn Display[O, R].set_scale(mut self, so: server.Output, scale: f64) {
    let o = self.out_index(so)
    guard o >= 0 and scale >= 0.5 and scale <= 4.0 else {
        return
    }
    self.outs[o].scale = scale
    self.output_moved(o)
}

pub fn Display[O, R].set_position(mut self, so: server.Output, x: f64, y: f64) {
    let o = self.out_index(so)
    guard o >= 0 else {
        return
    }
    self.outs[o].x = x
    self.outs[o].y = y
    self.output_moved(o)
}

pub fn Display[O, R].set_mode(mut self, so: server.Output, m: types.Mode) {
    let o = self.out_index(so)
    if o >= 0 {
        self.be.set_mode(u32(o), m)
        self.backend_events()
    }
}

/// Turn an output off (power saving) or on.
pub fn Display[O, R].enable(mut self, so: server.Output, on: bool) {
    let o = self.out_index(so)
    if o >= 0 {
        self.be.enable(u32(o), on)
        self.outs[o].dirty = on
        self.outs[o].enabled = on
        let info = self.output_info(o)
        self.srv.update_output(so, info)
    }
}

pub fn Display[O, R].set_vrr(mut self, so: server.Output, on: bool) {
    let o = self.out_index(so)
    if o >= 0 {
        let v = on and self.be.output(u32(o)).vrr
        self.be.set_vrr(u32(o), v)
        self.outs[o].clock.vrr = v
        self.outs[o].vrr = v
        let info = self.output_info(o)
        self.srv.update_output(so, info)
    }
}

/// What an output configuration asks of each output.
pub fn Display[O, R].output_config(self, c: server.OutputConfig) -> List[server.HeadConfig] {
    return self.srv.output_config(c)
}

/// Answer an output configuration: applied (or, for a test, it would
/// apply), else failed and nothing changed.
pub fn Display[O, R].output_config_done(mut self, c: server.OutputConfig, ok: bool) {
    self.srv.output_config_done(c, ok)
}

/// Apply what configuration `c` asks (only check it when `only_test`):
/// whether every output can do it. Modes are the output's own (any mode
/// only nested or headless, where it must stay the current one); outputs
/// are not rotated.
pub fn Display[O, R].apply_output_config(mut self, c: server.OutputConfig, only_test: bool) -> bool {
    let heads = self.srv.output_config(c)
    for h in heads {
        let o = self.out_index(h.output)
        guard o >= 0 else {
            return false
        }
        let d = self.be.output(u32(o))
        if let Some((w, hh, mhz)) = h.mode {
            let current = w == d.mode.width and hh == d.mode.height and (mhz == 0 or int(mhz - d.mode.refresh_mhz).abs() < 500)
            let listed = self.be.sets_modes() and d.modes.any(fn(m) => m.width == w and m.height == hh and (mhz == 0 or int(mhz - m.refresh_mhz).abs() < 500))
            guard current or listed else {
                return false
            }
        }
        guard h.transform.unwrap_or(0) == 0 else {
            return false
        }
        if let Some(sc) = h.scale {
            guard sc >= 0.5 and sc <= 4.0 else {
                return false
            }
        }
        guard not h.vrr.unwrap_or(false) or d.vrr else {
            return false
        }
    }
    guard not only_test else {
        return true
    }
    for h in heads {
        let so = h.output
        let o = self.out_index(so)
        if not h.enabled {
            if self.outs[o].enabled {
                self.enable(so, false)
            }
            continue
        }
        if not self.outs[o].enabled {
            self.enable(so, true)
        }
        if let Some((w, hh, mhz)) = h.mode {
            let d = self.be.output(u32(o))
            if w != d.mode.width or hh != d.mode.height or (mhz != 0 and int(mhz - d.mode.refresh_mhz).abs() >= 500) {
                self.set_mode(so, types.Mode { width: w, height: hh, refresh_mhz: mhz })
            }
        }
        if let Some((x, y)) = h.position {
            self.set_position(so, f64(x), f64(y))
        }
        if let Some(sc) = h.scale {
            self.set_scale(so, sc)
        }
        if let Some(v) = h.vrr {
            self.set_vrr(so, v)
        }
    }
    return true
}

/// The output under global `x, y`.
pub fn Display[O, R].output_under(self, x: f64, y: f64) -> Option[server.Output] {
    let o = self.output_at(x, y)
    return if o < 0 { None } else { Some(self.outs[o].sout) }
}

// --------------------------------------------------------------- pointer

pub fn Display[O, R].pointer(self) -> (f64, f64) {
    return (self.px, self.py)
}

/// Move the pointer to global `x, y`.
pub fn Display[O, R].warp(mut self, x: f64, y: f64) {
    self.px = x
    self.py = y
    self.clamp_pointer()
    self.move_cursor()
    self.deliver_motion(u32((time.now_ns() / 1000000) & 0xffffffff))
}

// ---------------------------------------------------------------- images

/// A texture of `pixels` (RGBA8 premultiplied, rows packed) for layouts:
/// wallpapers, decorations, panels.
pub fn Display[O, R].image(mut self, width: i32, height: i32, pixels: &[u8], opaque: bool) -> Result[layout.Image, str] {
    var at = self.images.len()
    var gen: u32 = 1
    for i in 0..self.images.len() {
        if not self.images[i].alive {
            at = i
            gen = self.images[i].gen + 1
            break
        }
    }
    let img = layout.Image { index: u32(at), gen }
    let fourcc = if opaque { types.buffer.xbgr8888 } else { types.buffer.abgr8888 }
    guard self.comp.image(ikey(img), width, height, fourcc, pixels, int(width) * 4) else {
        return Err("the renderer cannot make a {width}x{height} image")
    }
    let data = ImageData { gen, opaque }
    if at == self.images.len() {
        self.images.push(data)
    } else {
        self.images[at] = data
    }
    return Ok(img)
}

/// Redraw part of an image: `pixels` is the whole image (rows `stride`
/// bytes apart), of which `x, y, w, h` changed.
pub fn Display[O, R].update_image(mut self, img: layout.Image, x: i32, y: i32, w: i32, h: i32, pixels: &[u8], stride: i32) -> Result[(), str] {
    guard int(img.index) < self.images.len() and self.images[int(img.index)].alive and self.images[int(img.index)].gen == img.gen else {
        return Err("no such image")
    }
    let rects: List[(i32, i32, i32, i32)] = [(x, y, w, h)]
    guard self.comp.update(ikey(img), pixels, int(stride), rects) else {
        return Err("image update {x},{y} {w}x{h} does not fit")
    }
    self.comp.commit(ikey(img), rects)
    for o in 0..self.outs.len() {
        self.outs[o].dirty = true
    }
    return Ok(())
}

pub fn Display[O, R].drop_image(mut self, img: layout.Image) {
    if int(img.index) < self.images.len() and self.images[int(img.index)].alive and self.images[int(img.index)].gen == img.gen {
        self.comp.forget(ikey(img))
        self.images[int(img.index)].alive = false
    }
}

// ----------------------------------------------------------- extensions

/// Add a protocol the library does not speak, described by its messages'
/// signatures; a global when `global`. Its requests come as
/// ExtensionRequest; the index names it there.
pub fn Display[O, R].extend(mut self, take i: server.ext.Interface, global: bool) -> int {
    return self.srv.extend(i, global)
}

/// Send event `op` of `o`'s interface; false when either is unknown.
pub fn Display[O, R].ext_send(mut self, o: server.ext.Object, op: u16, args: &[server.ext.Arg]) -> bool {
    return self.srv.ext_send(o, op, args)
}

/// A new object of extension `k` for `client`, to pass in an event.
pub fn Display[O, R].ext_new(mut self, client: server.Client, k: int, version: u32) -> Option[server.ext.Object] {
    return self.srv.ext_new(client, k, version)
}

pub fn Display[O, R].ext_destroy(mut self, o: server.ext.Object) {
    self.srv.ext_destroy(o)
}

// ------------------------------------------------------- the compositor's

/// Wake with Ready(token) whenever `fd` is readable (IPC sockets, ...).
pub fn Display[O, R].watch(mut self, fd: int, token: int) {
    discard self.poll.add(fd, tok_user + token, true, false)
}

pub fn Display[O, R].unwatch(mut self, fd: int) {
    discard self.poll.remove(fd)
}

/// Timer(token) after `ms` milliseconds.
pub fn Display[O, R].timer(mut self, ms: int, token: int) {
    guard let Ok(fd) = os.timerfd() else {
        return
    }
    discard os.timer_arm(fd, max(ms, 1) * 1000000, 0)
    discard self.poll.add(fd, tok_timer + token, true, false)
    self.timers.push((fd, token))
}

pub fn Display[O, R].configure_input(mut self, device: u32, c: types.InputConfig) {
    self.be.configure_input(device, c)
}

pub fn Display[O, R].set_keymap(mut self, names: types.Names) -> Result[(), str] {
    try self.be.set_keymap(names)
    self.backend_events()
    return Ok(())
}

pub fn Display[O, R].mods(self) -> types.Mods {
    return self.be.mods()
}

/// The pixels a headless output shows (BGRA8): tests and screenshots.
/// What output `so` measured since the last `reset_stats` (frames,
/// intervals, frame times, damage), with the device's counters (commits,
/// stalls, scheduling) and whether the renderer is a CPU one.
pub fn Display[O, R].stats(self, so: server.Output) -> types.Stats {
    let o = self.out_index(so)
    var s = if o >= 0 { self.probes[o].clone() } else { types.Stats.new() }
    self.be.stats(mut s)
    s.software = self.comp.render_node().is_none()
    return s
}

/// Start measuring again.
pub fn Display[O, R].reset_stats(mut self) {
    for o in 0..self.probes.len() {
        self.probes[o] = types.Stats.new()
    }
}

pub fn Display[O, R].read_output(mut self, so: server.Output) -> Result[List[u8], str] {
    let o = self.out_index(so)
    guard o >= 0 else {
        return Err("no such output")
    }
    guard let Some(t) = self.be.shown(u32(o)) else {
        return Err("nothing shown yet (or not headless)")
    }
    return self.comp.read(t)
}

fn Display[O, R].drop(mut self) {
    // The output lets go of its targets first; the renderer frees them all.
    var gone: List[u64] = []
    self.be.shutdown(mut gone)
    self.comp.close()
}

/// Feed an input event as if a device sent it (remote input, tests).
pub fn Display[O, R].inject(mut self, take i: types.Input) {
    self.input(i)
}
