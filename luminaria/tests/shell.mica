// The Display's shell on a headless output, with an in-process client
// on the generated API: a panel is arranged along its edge and the rest
// of the output stays usable; the session lock shows only the lock
// surface and tells the locker once a frame without the session is out;
// a screen capture gets the composed image; an output configuration is
// applied. Skipped without a Vulkan device.

import std.env
import std.fs
import std.io
import std.os
import std.time
import luminaria as lum
import luminaria_wire as wire
import luminaria_proto as proto
import luminaria_proto.wayland as wl
import luminaria_proto.wlr_layer_shell_unstable as ls
import luminaria_proto.ext_session_lock as sl
import luminaria_proto.ext_image_capture_source as ics
import luminaria_proto.ext_image_copy_capture as icc
import luminaria_proto.ext_foreign_toplevel_list as ftl
import luminaria_proto.linux_dmabuf as dmab
import luminaria_proto.wlr_output_management_unstable as wom
import luminaria_proto.wlr_virtual_pointer_unstable as vp
import luminaria_proto.wlr_gamma_control_unstable as gc
import luminaria_proto.color_management as cm
import luminaria_proto.xdg_shell as xdg

struct Fx {
    d: lum.Display
    c: wire.Conn
    reg: wl.Registry = wl.Registry { id: 0 }
    globals: List[(u32, u16)] = []
    /// Display events seen.
    seen: List[lum.Event] = []
}

fn setup() -> Option[Fx] {
    let dir = fs.create_temp_dir("luminaria-shell").expect("temp dir")
    discard env.set("XDG_RUNTIME_DIR", dir)
    match lum.open(lum.Options { backend: lum.Kind.Headless, headless: [lum.Mode { width: 128, height: 96, refresh_mhz: 60000 }] }) {
        Ok(d) => {
            let c = wire.connect(d.socket()).expect("connect")
            return Some(Fx { d, c })
        }
        Err(e) => {
            io.eprint("skipped: {e}")
            return None
        }
    }
}

/// Run both ends for a while; the client's events.
fn pump(mut f: Fx, ms: int) -> List[proto.Event] {
    var out: List[proto.Event] = []
    let end = time.now_ns() + ms * 1000000
    while time.now_ns() < end {
        discard f.c.flush()
        while true {
            guard let Some(e) = f.d.poll().expect("poll") else {
                break
            }
            f.seen.push(e.clone())
            f.d.accept(e)
        }
        discard f.c.read()
        while true {
            match proto.next_event(mut f.c) {
                Ok(Some(e)) => {
                    match e {
                        WlRegistry(_, Global(n, i, v)) => f.globals.push((n, proto.ifaces.by_name(i)))
                        _ => {}
                    }
                    out.push(e)
                }
                Ok(None) => {
                    break
                }
                Err(e) => panic("client: {e}")
            }
        }
        time.sleep_ms(2)
    }
    return out
}

fn bind(mut f: Fx, iface: u16, version: u32) -> u32 {
    if f.reg.id == 0 {
        f.reg = wl.Display { id: 1 }.get_registry(mut f.c)
        discard pump(mut f, 30)
    }
    for (n, i) in f.globals.clone() {
        if i == iface {
            return f.reg.bind(mut f.c, n, iface, version)
        }
    }
    panic("no global {proto.ifaces.name(iface)}")
}

fn shm_buffer(mut f: Fx, w: i32, h: i32) -> wl.Buffer {
    let shm = wl.Shm { id: bind(mut f, wl.shm_iface, 1) }
    let size = w * h * 4
    let fd = os.memfd("t", int(size)).expect("memfd")
    let pool = shm.create_pool(mut f.c, fd, size)
    os.close(fd)
    return pool.create_buffer(mut f.c, 0, w, h, w * 4, wl.ShmFormat.Argb8888)
}

test "a panel takes its zone and leaves the rest usable" {
    guard let Some(fx) = setup() else {
        return
    }
    var f = fx
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let shell = ls.Shell { id: bind(mut f, ls.shell_iface, 5) }
    let surf = comp.create_surface(mut f.c)
    let l = shell.get_layer_surface(mut f.c, surf, None, ls.ShellLayer.Top, "panel")
    l.set_anchor(mut f.c, ls.SurfaceAnchor.Top | ls.SurfaceAnchor.Left | ls.SurfaceAnchor.Right)
    l.set_size(mut f.c, 0, 30)
    l.set_exclusive_zone(mut f.c, 30)
    surf.commit(mut f.c)
    var serial: u32 = 0
    var size = (u32(0), u32(0))
    for e in pump(mut f, 100) {
        match e {
            ZwlrLayerSurface(_, Configure(s, w, h)) => {
                serial = s
                size = (w, h)
            }
            _ => {}
        }
    }
    // Stretched across the output.
    assert_eq(size, (u32(128), u32(30)))
    l.ack_configure(mut f.c, serial)
    surf.attach(mut f.c, Some(shm_buffer(mut f, 128, 30)), 0, 0)
    surf.commit(mut f.c)
    discard pump(mut f, 100)
    let o = f.d.outputs()[0]
    assert_eq(f.d.usable(o), (0.0, 30.0, 128.0, 66.0))
    assert(f.seen.any(fn(e) => match e {
        OutputArea(x) => x == o
        _ => false
    }))
    // Gone: the whole output is free again.
    l.destroy(mut f.c)
    surf.destroy(mut f.c)
    discard pump(mut f, 100)
    assert_eq(f.d.usable(o), (0.0, 0.0, 128.0, 96.0))
}

test "the lock screen alone shows until unlock" {
    guard let Some(fx) = setup() else {
        return
    }
    var f = fx
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let out = wl.Output { id: bind(mut f, wl.output_iface, 4) }
    let mgr = sl.LockManager { id: bind(mut f, sl.lock_manager_iface, 1) }
    let lock = mgr.lock(mut f.c)
    let surf = comp.create_surface(mut f.c)
    let lsurf = lock.get_lock_surface(mut f.c, surf, out)
    var serial: u32 = 0
    var size = (u32(0), u32(0))
    var locked = false
    for e in pump(mut f, 200) {
        match e {
            ExtSessionLockSurface(_, Configure(s, w, h)) => {
                serial = s
                size = (w, h)
            }
            ExtSessionLock(_, Locked) => locked = true
            _ => {}
        }
    }
    assert_eq(size, (u32(128), u32(96)))
    assert(locked)
    assert(f.d.locked())
    assert(f.seen.any(fn(e) => match e {
        Locked(true) => true
        _ => false
    }))
    lsurf.ack_configure(mut f.c, serial)
    surf.attach(mut f.c, Some(shm_buffer(mut f, 128, 96)), 0, 0)
    surf.commit(mut f.c)
    discard pump(mut f, 100)
    lock.unlock_and_destroy(mut f.c)
    discard pump(mut f, 100)
    assert(not f.d.locked())
    assert(f.seen.any(fn(e) => match e {
        Locked(false) => true
        _ => false
    }))
}

test "a screen capture gets the composed image" {
    guard let Some(fx) = setup() else {
        return
    }
    var f = fx
    let out = wl.Output { id: bind(mut f, wl.output_iface, 4) }
    let srcs = ics.OutputImageCaptureSourceManager { id: bind(mut f, ics.output_image_capture_source_manager_iface, 1) }
    let mgr = icc.Manager { id: bind(mut f, icc.manager_iface, 1) }
    let sess = mgr.create_session(mut f.c, srcs.create_source(mut f.c, out), icc.ManagerOptions(0))
    discard pump(mut f, 50)
    let shm = wl.Shm { id: bind(mut f, wl.shm_iface, 1) }
    let size = 128 * 96 * 4
    let fd = os.memfd("shot", size).expect("memfd")
    var m = os.map(fd, size, 0, true).expect("map")
    let buf = shm.create_pool(mut f.c, fd, i32(size)).create_buffer(mut f.c, 0, 128, 96, 512, wl.ShmFormat.Xrgb8888)
    os.close(fd)
    let fr = sess.create_frame(mut f.c)
    fr.attach_buffer(mut f.c, buf)
    fr.damage_buffer(mut f.c, 0, 0, 128, 96)
    fr.capture(mut f.c)
    assert(pump(mut f, 200).any(fn(e) => match e {
        ExtImageCopyCaptureFrame(_, Ready) => true
        _ => false
    }))
    // The background, everywhere.
    let px = m.bytes()
    assert_eq(px[3], u8(255))
    assert(px[0] > 0)
    assert_eq((px[0], px[1], px[2]), (px[size - 4], px[size - 3], px[size - 2]))
}

test "an output configuration moves and scales the output" {
    guard let Some(fx) = setup() else {
        return
    }
    var f = fx
    let mgr = wom.Manager { id: bind(mut f, wom.manager_iface, 4) }
    var head: Option[wom.Head] = None
    var serial: u32 = 0
    for e in pump(mut f, 50) {
        match e {
            ZwlrOutputManager(_, Head(h)) => head = Some(h)
            ZwlrOutputManager(_, Done(s)) => serial = s
            _ => {}
        }
    }
    let cfg = mgr.create_configuration(mut f.c, serial)
    let ch = cfg.enable_head(mut f.c, head.expect("head"))
    ch.set_position(mut f.c, 200, 0)
    ch.set_scale(mut f.c, 2.0)
    cfg.apply(mut f.c)
    var ok = false
    for e in pump(mut f, 100) {
        match e {
            ZwlrOutputConfiguration(_, Succeeded) => ok = true
            ZwlrOutputManager(_, Done(s)) => serial = s
            _ => {}
        }
    }
    assert(ok)
    let o = f.d.outputs()[0]
    assert_eq(f.d.output_rect(o), (200.0, 0.0, 64.0, 48.0))
    // Outputs are not rotated: that fails and changes nothing.
    let bad = mgr.create_configuration(mut f.c, serial)
    bad.enable_head(mut f.c, head.expect("head")).set_transform(mut f.c, wl.OutputTransform.Transform90)
    bad.apply(mut f.c)
    assert(pump(mut f, 100).any(fn(e) => match e {
        ZwlrOutputConfiguration(_, Failed) => true
        _ => false
    }))
    assert_eq(f.d.output_rect(o), (200.0, 0.0, 64.0, 48.0))
}

fn read_u64_le(b: &[u8], at: int) -> u64 {
    var v: u64 = 0
    for i in 0..8 {
        v |= u64(b[at + i]) << u64(i * 8)
    }
    return v
}

test "a window capture gets only the toplevel window image" {
    guard let Some(fx) = setup() else {
        return
    }
    var f = fx
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let wm = xdg.WmBase { id: bind(mut f, xdg.wm_base_iface, 2) }
    let shm = wl.Shm { id: bind(mut f, wl.shm_iface, 1) }
    let list = ftl.ToplevelList { id: bind(mut f, ftl.toplevel_list_iface, 1) }
    let ft_srcs = ics.ForeignToplevelImageCaptureSourceManager { id: bind(mut f, ics.foreign_toplevel_image_capture_source_manager_iface, 1) }
    let mgr = icc.Manager { id: bind(mut f, icc.manager_iface, 1) }

    let surf = comp.create_surface(mut f.c)
    let xs = wm.get_xdg_surface(mut f.c, surf)
    let top = xs.get_toplevel(mut f.c)
    top.set_title(mut f.c, "cap-win")
    surf.commit(mut f.c)
    for e in pump(mut f, 50) {
        match e {
            XdgSurface(s, Configure(serial)) => s.ack_configure(mut f.c, serial)
            _ => {}
        }
    }
    let size = 48 * 32 * 4
    let wfd = os.memfd("win-green", size).expect("memfd")
    var wm_map = os.map(wfd, size, 0, true).expect("map")
    let wpx = wm_map.bytes()
    for i in 0..(48 * 32) {
        wpx[i * 4] = 0
        wpx[i * 4 + 1] = 255
        wpx[i * 4 + 2] = 0
        wpx[i * 4 + 3] = 255
    }
    let wbuf = shm.create_pool(mut f.c, wfd, i32(size)).create_buffer(mut f.c, 0, 48, 32, 48 * 4, wl.ShmFormat.Argb8888)
    os.close(wfd)
    surf.attach(mut f.c, Some(wbuf), 0, 0)
    surf.commit(mut f.c)

    var handle: Option[ftl.Handle] = None
    for e in pump(mut f, 80) {
        match e {
            ExtForeignToplevelList(_, Toplevel(h)) => handle = Some(h)
            _ => {}
        }
    }
    for e in f.seen.clone() {
        match e {
            WindowMapped(w) => f.d.layout(fn(mut l) {
                l.window(w, 16.0, 16.0, lum.Style {})
            })
            _ => {}
        }
    }
    discard pump(mut f, 30)
    let h = handle.expect("foreign toplevel handle")
    let src = ft_srcs.create_source(mut f.c, h)
    let sess = mgr.create_session(mut f.c, src, icc.ManagerOptions(0))
    var bw: u32 = 0
    var bh: u32 = 0
    var done = false
    for e in pump(mut f, 80) {
        match e {
            ExtImageCopyCaptureSession(_, BufferSize(w, hh)) => {
                bw = w
                bh = hh
            }
            ExtImageCopyCaptureSession(_, Done) => done = true
            _ => {}
        }
    }
    assert(done)
    assert_eq((bw, bh), (u32(48), u32(32)))

    let cfd = os.memfd("cap-win", size).expect("memfd")
    var cm = os.map(cfd, size, 0, true).expect("map")
    let cbuf = shm.create_pool(mut f.c, cfd, i32(size)).create_buffer(mut f.c, 0, 48, 32, 48 * 4, wl.ShmFormat.Xrgb8888)
    os.close(cfd)
    let fr = sess.create_frame(mut f.c)
    fr.attach_buffer(mut f.c, cbuf)
    fr.damage_buffer(mut f.c, 0, 0, 48, 32)
    fr.capture(mut f.c)
    assert(pump(mut f, 200).any(fn(e) => match e {
        ExtImageCopyCaptureFrame(_, Ready) => true
        _ => false
    }))
    let px = cm.bytes()
    // BGRA solid green everywhere in the captured window buffer (no background at corners).
    assert_eq((px[0], px[1], px[2]), (u8(0), u8(255), u8(0)))
    let last = size - 4
    assert_eq((px[last], px[last + 1], px[last + 2]), (u8(0), u8(255), u8(0)))
    discard list
}

test "an output dmabuf capture copies the rendered frame asynchronously" {
    guard let Some(fx) = setup() else {
        return
    }
    var f = fx
    guard let Ok(cc) = lum.compose.Compositor.open(false) else {
        return
    }
    var cap_comp = cc
    let out = wl.Output { id: bind(mut f, wl.output_iface, 4) }
    let srcs = ics.OutputImageCaptureSourceManager { id: bind(mut f, ics.output_image_capture_source_manager_iface, 1) }
    let mgr = icc.Manager { id: bind(mut f, icc.manager_iface, 1) }
    let dma = dmab.Dmabuf { id: bind(mut f, dmab.dmabuf_iface, 4) }
    let sess = mgr.create_session(mut f.c, srcs.create_source(mut f.c, out), icc.ManagerOptions(0))

    var dev_bytes: List[u8] = []
    var offered: List[(u32, u64)] = []
    for e in pump(mut f, 80) {
        match e {
            ExtImageCopyCaptureSession(_, DmabufDevice(b)) => dev_bytes = b.clone()
            ExtImageCopyCaptureSession(_, DmabufFormat(fmt, mods)) => {
                var i = 0
                while i + 8 <= mods.len() {
                    offered.push((fmt, read_u64_le(mods, i)))
                    i += 8
                }
            }
            _ => {}
        }
    }
    if offered.is_empty() {
        io.eprint("skipped: GPU reports no dmabuf capture formats")
        cap_comp.close()
        return
    }
    assert_eq(dev_bytes.len(), 8)
    let cap_fmts = cap_comp.formats()
    var chosen_opt: Option[(u32, u64)] = None
    for (fmt, m) in offered {
        if (fmt == lum.types.buffer.xrgb8888 or fmt == lum.types.buffer.argb8888) and cap_fmts.contains((fmt, m)) {
            chosen_opt = Some((fmt, m))
            break
        }
    }
    if chosen_opt.is_none() {
        for (fmt, m) in offered {
            if cap_fmts.contains((fmt, m)) {
                chosen_opt = Some((fmt, m))
                break
            }
        }
    }
    guard let Some(chosen) = chosen_opt else {
        io.eprint("skipped: no common sampleable/writable capture format")
        cap_comp.close()
        return
    }
    let ts = match cap_comp.targets(lum.types.Want { width: 128, height: 96, format: chosen.0, modifiers: [chosen.1], count: 1, export: true }) {
        Ok(t) => t
        Err(err) => {
            io.eprint("skipped: export capture target: {err}")
            cap_comp.close()
            return
        }
    }
    let tgt = ts[0]
    let params = dma.create_params(mut f.c)
    for pi in 0..tgt.buf.planes {
        let p = tgt.buf.plane[pi]
        params.add_(mut f.c, p.fd, u32(pi), p.offset, p.stride, u32(tgt.buf.modifier >> 32), u32(tgt.buf.modifier & 0xffffffff))
    }
    let buf = params.create_immed(mut f.c, 128, 96, chosen.0, dmab.BufferParamsFlags(0))
    params.destroy(mut f.c)
    let fr = sess.create_frame(mut f.c)
    fr.attach_buffer(mut f.c, buf)
    fr.damage_buffer(mut f.c, 0, 0, 128, 96)
    fr.capture(mut f.c)

    var ready = false
    var released = false
    for _ in 0..10 {
        for e in pump(mut f, 40) {
            match e {
                ExtImageCopyCaptureFrame(_, Ready) => ready = true
                WlBuffer(b, Release) => {
                    if b.id == buf.id {
                        released = true
                    }
                }
                _ => {}
            }
        }
        if ready and released {
            break
        }
    }
    assert(ready)
    assert(released)
    // Import the written dmabuf with a proper foreign->family acquire barrier
    // and sample it offscreen so multi-plane/compressed modifiers resolve cleanly.
    assert(cap_comp.import_dmabuf(999, tgt.buf))
    for pi in 0..tgt.buf.planes {
        os.close(tgt.buf.plane[pi].fd)
    }
    cap_comp.drop_target(tgt.key)
    let px = cap_comp.render_offscreen(128, 96, [lum.types.Placement { key: 1, tex: 999, w: 128.0, h: 96.0 }]).expect("sample captured dmabuf")
    let size = 128 * 96 * 4
    assert_eq(px.len(), size)
    assert(px[0] > 0)
    assert_eq((px[0], px[1], px[2]), (px[size - 4], px[size - 3], px[size - 2]))
    cap_comp.forget(999)
    cap_comp.close()
}

test "virtual pointer drives pointer position, buttons and scroll" {
    guard let Some(fx) = setup() else {
        return
    }
    var f = fx
    let out = wl.Output { id: bind(mut f, wl.output_iface, 4) }
    let mgr = vp.PointerManager { id: bind(mut f, vp.pointer_manager_iface, 2) }
    let p = mgr.create_virtual_pointer_with_output(mut f.c, None, Some(out))
    p.motion_absolute(mut f.c, 10, 64, 48, 128, 96)
    p.frame(mut f.c)
    p.button(mut f.c, 11, 272, wl.PointerButtonState.Pressed)
    p.frame(mut f.c)
    p.button(mut f.c, 12, 272, wl.PointerButtonState.Released)
    p.frame(mut f.c)
    p.axis_source(mut f.c, wl.PointerAxisSource.Wheel)
    p.axis_discrete(mut f.c, 13, wl.PointerAxis.VerticalScroll, 15.0, 1)
    p.frame(mut f.c)
    discard pump(mut f, 80)
    let (px, py) = f.d.pointer()
    assert(px >= 63.0 and px <= 65.0)
    assert(py >= 47.0 and py <= 49.0)
    assert(f.seen.any(fn(e) => match e {
        Button(b) => b.button == 272 and b.pressed
        _ => false
    }))
    assert(f.seen.any(fn(e) => match e {
        Scroll(s) => s.v120y == 120
        _ => false
    }))
    p.destroy(mut f.c)
    mgr.destroy(mut f.c)
    discard pump(mut f, 30)
}

test "gamma control enforces exclusive ownership and accepts valid ramps" {
    guard let Some(fx) = setup() else {
        return
    }
    var f = fx
    let out = wl.Output { id: bind(mut f, wl.output_iface, 4) }
    let mgr = gc.ControlManager { id: bind(mut f, gc.control_manager_iface, 1) }
    let ctrl1 = mgr.get_gamma_control(mut f.c, out)
    var gsize: u32 = 0
    for e in pump(mut f, 50) {
        match e {
            ZwlrGammaControl(c, GammaSize(n)) => {
                if c.id == ctrl1.id {
                    gsize = n
                }
            }
            _ => {}
        }
    }
    assert_eq(gsize, u32(256))
    // Second concurrent owner on the same output must fail immediately.
    let ctrl2 = mgr.get_gamma_control(mut f.c, out)
    var failed2 = false
    for e in pump(mut f, 50) {
        match e {
            ZwlrGammaControl(c, Failed) => {
                if c.id == ctrl2.id {
                    failed2 = true
                }
            }
            _ => {}
        }
    }
    assert(failed2)
    ctrl2.destroy(mut f.c)
    // Supply a valid 256 * 3 * 2 byte gamma table via memfd.
    let gbytes = int(gsize) * 3 * 2
    let gfd = os.memfd("gamma", gbytes).expect("memfd")
    var gmap = os.map(gfd, gbytes, 0, true).expect("map")
    let gb = gmap.bytes()
    for i in 0..int(gsize) {
        let v = u16(i * 65535 / (int(gsize) - 1))
        let lo = u8(v & 0xff)
        let hi = u8(v >> 8)
        for ch in 0..3 {
            let at = (ch * int(gsize) + i) * 2
            gb[at] = lo
            gb[at + 1] = hi
        }
    }
    ctrl1.set_gamma(mut f.c, gfd)
    os.close(gfd)
    let evs1 = pump(mut f, 50)
    assert(not evs1.any(fn(e) => match e {
        ZwlrGammaControl(c, Failed) => c.id == ctrl1.id
        _ => false
    }))
    // Destroying ctrl1 releases ownership so a new control succeeds.
    ctrl1.destroy(mut f.c)
    discard pump(mut f, 30)
    let ctrl3 = mgr.get_gamma_control(mut f.c, out)
    var gsize3: u32 = 0
    for e in pump(mut f, 50) {
        match e {
            ZwlrGammaControl(c, GammaSize(n)) => {
                if c.id == ctrl3.id {
                    gsize3 = n
                }
            }
            _ => {}
        }
    }
    assert_eq(gsize3, u32(256))
    ctrl3.destroy(mut f.c)
    mgr.destroy(mut f.c)
    discard pump(mut f, 30)
}

test "color management and HDR output toggle notify clients and render 10-bit targets" {
    guard let Some(fx) = setup() else {
        return
    }
    var f = fx
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let out = wl.Output { id: bind(mut f, wl.output_iface, 4) }
    let mgr = cm.ColorManager { id: bind(mut f, cm.color_manager_iface, 1) }
    var got_done = false
    for e in pump(mut f, 50) {
        match e {
            WpColorManager(_, Done) => got_done = true
            _ => {}
        }
    }
    assert(got_done)
    let cm_out = mgr.get_output(mut f.c, out)
    let desc0 = cm_out.get_image_description(mut f.c)
    var id0: u32 = 0
    for e in pump(mut f, 50) {
        match e {
            WpImageDescription(d, Ready(id)) => {
                if d.id == desc0.id {
                    id0 = id
                }
            }
            _ => {}
        }
    }
    assert(id0 > 0)
    // Toggle HDR on the headless output and verify image_description_changed fires.
    let so = f.d.outputs()[0]
    assert(f.d.set_hdr(so, true, 203.0, 1000.0))
    assert(f.d.hdr(so))
    var out_changed = false
    for e in pump(mut f, 80) {
        match e {
            WpColorManagementOutput(o, ImageDescriptionChanged) => {
                if o.id == cm_out.id {
                    out_changed = true
                }
            }
            _ => {}
        }
    }
    assert(out_changed)
    // Create a parametric BT.2020 + ST.2084 PQ image description and attach to a surface.
    let creator = mgr.create_parametric_creator(mut f.c)
    creator.set_primaries_named(mut f.c, cm.ColorManagerPrimaries.Bt2020)
    creator.set_tf_named(mut f.c, cm.ColorManagerTransferFunction.St2084Pq)
    let pq_desc = creator.create(mut f.c)
    var pq_ready = false
    for e in pump(mut f, 50) {
        match e {
            WpImageDescription(d, Ready) => {
                if d.id == pq_desc.id {
                    pq_ready = true
                }
            }
            _ => {}
        }
    }
    assert(pq_ready)
    let surf = comp.create_surface(mut f.c)
    let cm_surf = mgr.get_surface(mut f.c, surf)
    cm_surf.set_image_description(mut f.c, pq_desc, cm.ColorManagerRenderIntent.Perceptual)
    surf.commit(mut f.c)
    discard pump(mut f, 60)
    // Turn HDR back off cleanly.
    assert(f.d.set_hdr(so, false, 203.0, 1000.0))
    assert(not f.d.hdr(so))
    discard pump(mut f, 50)
    cm_surf.destroy(mut f.c)
    pq_desc.destroy(mut f.c)
    desc0.destroy(mut f.c)
    cm_out.destroy(mut f.c)
    mgr.destroy(mut f.c)
    surf.destroy(mut f.c)
    discard pump(mut f, 30)
}

test "block_capture redacts window in output and window captures without affecting display" {
    guard let Some(fx) = setup() else {
        return
    }
    var f = fx
    let comp = wl.Compositor { id: bind(mut f, wl.compositor_iface, 6) }
    let wm = xdg.WmBase { id: bind(mut f, xdg.wm_base_iface, 2) }
    let shm = wl.Shm { id: bind(mut f, wl.shm_iface, 1) }
    let out = wl.Output { id: bind(mut f, wl.output_iface, 4) }
    let list = ftl.ToplevelList { id: bind(mut f, ftl.toplevel_list_iface, 1) }
    let out_srcs = ics.OutputImageCaptureSourceManager { id: bind(mut f, ics.output_image_capture_source_manager_iface, 1) }
    let ft_srcs = ics.ForeignToplevelImageCaptureSourceManager { id: bind(mut f, ics.foreign_toplevel_image_capture_source_manager_iface, 1) }
    let mgr = icc.Manager { id: bind(mut f, icc.manager_iface, 1) }

    let surf = comp.create_surface(mut f.c)
    let xs = wm.get_xdg_surface(mut f.c, surf)
    let top = xs.get_toplevel(mut f.c)
    top.set_title(mut f.c, "secret")
    surf.commit(mut f.c)
    for e in pump(mut f, 50) {
        match e {
            XdgSurface(s, Configure(serial)) => s.ack_configure(mut f.c, serial)
            _ => {}
        }
    }
    // Bright red window (BGRA: 0, 0, 255, 255).
    let wsize = 48 * 32 * 4
    let wfd = os.memfd("secret-red", wsize).expect("memfd")
    var wmap = os.map(wfd, wsize, 0, true).expect("map")
    let wpx = wmap.bytes()
    for i in 0..(48 * 32) {
        wpx[i * 4] = 0
        wpx[i * 4 + 1] = 0
        wpx[i * 4 + 2] = 255
        wpx[i * 4 + 3] = 255
    }
    let wbuf = shm.create_pool(mut f.c, wfd, i32(wsize)).create_buffer(mut f.c, 0, 48, 32, 48 * 4, wl.ShmFormat.Argb8888)
    os.close(wfd)
    surf.attach(mut f.c, Some(wbuf), 0, 0)
    surf.commit(mut f.c)

    var handle: Option[ftl.Handle] = None
    for e in pump(mut f, 80) {
        match e {
            ExtForeignToplevelList(_, Toplevel(h)) => handle = Some(h)
            _ => {}
        }
    }
    for e in f.seen.clone() {
        match e {
            WindowMapped(w) => f.d.layout(fn(mut l) {
                l.window(w, 16.0, 16.0, lum.Style { block_capture: true })
            })
            _ => {}
        }
    }
    // Wait for frame to present on-screen.
    discard pump(mut f, 100)
    let so = f.d.outputs()[0]
    let disp_px = f.d.read_output(so).expect("read_output")
    // Inside the window at (32, 32): on-screen must still show bright RED!
    let d_at = (32 * 128 + 32) * 4
    assert_eq((disp_px[d_at], disp_px[d_at + 1], disp_px[d_at + 2]), (u8(0), u8(0), u8(255)))

    // Capture the entire output: window region must be solid black, background outside intact.
    let osess = mgr.create_session(mut f.c, out_srcs.create_source(mut f.c, out), icc.ManagerOptions(0))
    discard pump(mut f, 50)
    let osize = 128 * 96 * 4
    let ofd = os.memfd("cap-out", osize).expect("memfd")
    var omap = os.map(ofd, osize, 0, true).expect("map")
    let obuf = shm.create_pool(mut f.c, ofd, i32(osize)).create_buffer(mut f.c, 0, 128, 96, 128 * 4, wl.ShmFormat.Xrgb8888)
    os.close(ofd)
    let ofr = osess.create_frame(mut f.c)
    ofr.attach_buffer(mut f.c, obuf)
    ofr.damage_buffer(mut f.c, 0, 0, 128, 96)
    ofr.capture(mut f.c)
    assert(pump(mut f, 200).any(fn(e) => match e {
        ExtImageCopyCaptureFrame(_, Ready) => true
        _ => false
    }))
    let opx = omap.bytes()
    assert_eq((opx[d_at], opx[d_at + 1], opx[d_at + 2]), (u8(0), u8(0), u8(0)))
    // Background pixel at (110, 80) outside window is non-black.
    let bg_at = (80 * 128 + 110) * 4
    assert(opx[bg_at] > 0 or opx[bg_at + 1] > 0 or opx[bg_at + 2] > 0)

    // Capture the toplevel window directly: must also be solid black.
    let h = handle.expect("handle")
    let wsess = mgr.create_session(mut f.c, ft_srcs.create_source(mut f.c, h), icc.ManagerOptions(0))
    discard pump(mut f, 60)
    let cfd = os.memfd("cap-win-blk", wsize).expect("memfd")
    var cmap = os.map(cfd, wsize, 0, true).expect("map")
    let cbuf = shm.create_pool(mut f.c, cfd, i32(wsize)).create_buffer(mut f.c, 0, 48, 32, 48 * 4, wl.ShmFormat.Xrgb8888)
    os.close(cfd)
    let wfr = wsess.create_frame(mut f.c)
    wfr.attach_buffer(mut f.c, cbuf)
    wfr.damage_buffer(mut f.c, 0, 0, 48, 32)
    wfr.capture(mut f.c)
    assert(pump(mut f, 200).any(fn(e) => match e {
        ExtImageCopyCaptureFrame(_, Ready) => true
        _ => false
    }))
    let cpx = cmap.bytes()
    assert_eq((cpx[0], cpx[1], cpx[2]), (u8(0), u8(0), u8(0)))
    let w_mid = (16 * 48 + 24) * 4
    assert_eq((cpx[w_mid], cpx[w_mid + 1], cpx[w_mid + 2]), (u8(0), u8(0), u8(0)))
    discard list
}
