// Backends on the real machine: xkb keys and modifiers, a headless frame
// paced by its timer and read back, the connected displays of the DRM card
// (probed, not taken over), and a frame in a window of the parent
// compositor when there is one. The Vulkan renderer makes and draws the
// render targets.

import std.env
import std.io
import std.net
import std.time
import luminaria_types as types
import luminaria_compose as compose
import luminaria_backend as backend

/// The image to draw output `o` into, after giving it the targets it
/// asks for: key and age.
fn frame(mut b: backend.Backend, mut r: compose.Compositor, o: u32) -> (u64, u32) {
    for _ in 0..2 {
        match b.acquire(o) {
            Draw(key, age) => {
                return (key, age)
            }
            Need(w) => b.give(o, r.targets(w).unwrap()).unwrap()
            Busy => {}
        }
    }
    assert(false)
    return (0, 0)
}

/// Draw and present the acquired image.
fn show(mut b: backend.Backend, mut r: compose.Compositor, o: u32, key: u64, age: u32, rects: &[backend.Rect]) {
    let fence = r.render(int(o), key, age).unwrap().unwrap_or(-1)
    b.present(o, fence, rects, false).unwrap()
}

test "keys go through xkb" {
    guard let Ok(kb) = backend.keyboard.Keyboard.new(backend.Names { layout: "us" }) else {
        io.eprint("skipped: no xkb data")
        return
    }
    var k = kb
    let (sym, text, _) = k.key(30, true)
    assert_eq(sym, u32(0x61))
    assert_eq(text, "a")
    discard k.key(30, false)
    let (_, _, changed) = k.key(42, true)
    assert(changed)
    assert(k.mods().shift)
    let (big, shifted, _) = k.key(30, true)
    assert_eq(big, u32(0x41))
    assert_eq(shifted, "A")
    assert(k.fd >= 0 and k.size > 100)
}

/// Wait for and return the next Presented of output `o`.
fn presented(mut b: backend.Backend, o: u32) -> bool {
    var p = net.poller().expect("poller")
    var fds: List[(int, int)] = []
    b.fds(mut fds)
    for (fd, token) in fds {
        discard p.add(fd, token, true, false)
    }
    var evs: List[net.Event] = []
    let start = time.now_ns()
    while time.now_ns() - start < 2000000000 {
        discard p.wait(mut evs, 100)
        for e in evs {
            discard b.dispatch(e.token)
        }
        while true {
            guard let Some(e) = b.next() else {
                break
            }
            match e {
                Presented(out, seq, ns, _) => {
                    if out == o {
                        return seq > 0 and ns > 0
                    }
                }
                _ => {}
            }
        }
    }
    return false
}

test "a headless frame is presented at the next refresh" {
    guard let Ok(rr) = compose.Compositor.open(true) else {
        return
    }
    var r = rr
    var b = backend.Backend.open(backend.Options { kind: backend.Kind.Headless, headless: [backend.Mode { width: 64, height: 48, refresh_mhz: 120000 }] }).expect("headless")
    var added = false
    while true {
        guard let Some(e) = b.next() else {
            break
        }
        match e {
            OutputAdded(0) => added = true
            _ => {}
        }
    }
    assert(added)
    assert_eq(b.output(0).mode.width, i32(64))
    assert(b.can_present(0))
    r.add_output(0, 64, 48, vec4(0.0, 0.0, 1.0, 1.0))
    let (k1, a1) = frame(mut b, mut r, 0)
    assert_eq(a1, u32(0))
    let none: List[backend.Rect] = []
    show(mut b, mut r, 0, k1, a1, none)
    assert(not b.can_present(0))
    assert(presented(mut b, 0))
    assert(b.can_present(0))
    assert_eq(b.shown(0), Some(k1))
    let px = r.read(k1).unwrap()
    // B8G8R8A8: blue is the first byte.
    assert_eq((px[0], px[1], px[2], px[3]), (u8(255), u8(0), u8(0), u8(255)))
    // The next frame's buffer has not been shown: age 0, then 2.
    let (k2, a2) = frame(mut b, mut r, 0)
    assert(k2 != k1)
    assert_eq(a2, u32(0))
    show(mut b, mut r, 0, k2, a2, none)
    assert(presented(mut b, 0))
    let (_, a3) = frame(mut b, mut r, 0)
    assert_eq(a3, u32(2))
    var gone: List[u64] = []
    b.shutdown(mut gone)
    assert_eq(gone.len(), 2)
    for k in gone {
        r.drop_target(k)
    }
    r.close()
}

test "the DRM card's connected displays" {
    match backend.probe("") {
        Ok(outs) => {
            // This machine runs a desktop: something is connected.
            assert(not outs.is_empty())
            io.eprint("connected: {outs[0].name} {outs[0].make} {outs[0].model} {outs[0].mode.width}x{outs[0].mode.height}@{outs[0].mode.refresh_mhz}")
            for o in outs {
                assert(not o.name.is_empty())
                assert(o.mode.width > 0 and o.mode.height > 0 and o.mode.refresh_mhz > 1000)
                assert(not o.modes.is_empty())
            }
        }
        Err(e) => io.eprint("skipped: {e}")
    }
}

test "a frame in a window of the parent compositor" {
    guard env.get("WAYLAND_DISPLAY").is_some() else {
        return
    }
    guard let Ok(rr) = compose.Compositor.open(false) else {
        return
    }
    var r = rr
    guard let Ok(bb) = backend.Backend.open(backend.Options { kind: backend.Kind.Nested, title: "luminaria test" }) else {
        io.eprint("skipped: no parent with linux-dmabuf")
        return
    }
    var b = bb
    let m = b.output(0).mode
    assert(m.width > 0)
    assert(b.paced())
    r.add_output(0, u32(m.width), u32(m.height), vec4(0.2, 0.4, 0.6, 1.0))
    let (k, age) = frame(mut b, mut r, 0)
    let rects: List[backend.Rect] = [(0, 0, 16, 16)]
    show(mut b, mut r, 0, k, age, rects)
    // Shown when the parent draws the window (it may hold back hidden ones).
    if not presented(mut b, 0) {
        io.eprint("note: the parent sent no frame callback")
    }
    var gone: List[u64] = []
    b.shutdown(mut gone)
    for g in gone {
        r.drop_target(g)
    }
    r.close()
}

test "reset_targets retires headless targets and re-acquires cleanly" {
    guard let Ok(rr) = compose.Compositor.open(false) else {
        return
    }
    var r = rr
    var b = backend.Backend.open(backend.Options { kind: backend.Kind.Headless, headless: [backend.Mode { width: 32, height: 24, refresh_mhz: 60000 }] }).expect("headless")
    while b.next().is_some() {}
    r.add_output(0, 32, 24, vec4(0.1, 0.2, 0.3, 1.0))
    let (k1, _) = frame(mut b, mut r, 0)
    let none: List[backend.Rect] = []
    show(mut b, mut r, 0, k1, 0, none)
    assert(presented(mut b, 0))
    var retired: List[u64] = []
    b.reset_targets(mut retired)
    assert_eq(retired.len(), 2)
    for k in retired {
        r.drop_target(k)
    }
    // Can re-acquire and render again cleanly after reset_targets.
    assert(b.can_present(0))
    let (k2, age2) = frame(mut b, mut r, 0)
    assert_eq(age2, u32(0))
    assert(not retired.contains(k2))
    show(mut b, mut r, 0, k2, age2, none)
    assert(presented(mut b, 0))
    var gone: List[u64] = []
    b.shutdown(mut gone)
    for k in gone {
        r.drop_target(k)
    }
    r.close()
}

test "set_keymap_on stores independent keymap for a second seat" {
    var b = backend.Backend.open(backend.Options { kind: backend.Kind.Headless }).expect("headless")
    while b.next().is_some() {}
    let (fd0, sz0) = b.keymap_on("seat1")
    assert_eq(fd0, -1)
    assert_eq(sz0, u32(0))
    match b.set_keymap_on("seat1", backend.Names { layout: "us" }) {
        Ok => {
            let (fd1, sz1) = b.keymap_on("seat1")
            assert(fd1 >= 0 and sz1 > 100)
            var got_ev = false
            while true {
                guard let Some(e) = b.next() else {
                    break
                }
                match e {
                    KeymapOn(s) => {
                        if s == "seat1" {
                            got_ev = true
                        }
                    }
                    _ => {}
                }
            }
            assert(got_ev)
        }
        Err(e) => io.eprint("skipped: {e}")
    }
    var gone: List[u64] = []
    b.shutdown(mut gone)
}

test "keyboard layout switching cycles XKB groups and resolves keysyms" {
    guard let Ok(kb) = backend.keyboard.Keyboard.new(backend.Names { layout: "us,de" }) else {
        io.eprint("skipped: no us,de xkb data")
        return
    }
    var k = kb
    // evdev 21 is KEY_Y on US, KEY_Z on DE.
    let (sym0, _, _) = k.key(21, true)
    discard k.key(21, false)
    assert_eq(sym0, u32(0x79))
    assert(not k.layout_name().is_empty())
    assert(k.switch_layout(1))
    let (sym1, _, _) = k.key(21, true)
    discard k.key(21, false)
    assert_eq(sym1, u32(0x7a))
    assert(k.switch_layout(-1))
    let (sym2, _, _) = k.key(21, true)
    discard k.key(21, false)
    assert_eq(sym2, u32(0x79))
    assert_eq(backend.keysym_from_name("Return"), u32(0xff0d))
    assert_eq(backend.keysym_from_name("return"), u32(0xff0d))
    assert_eq(backend.keysym_from_name("XF86AudioRaiseVolume"), u32(0x1008ff13))
    assert_eq(backend.keysym_from_name("not_a_real_keysym_xyz"), u32(0))
}
