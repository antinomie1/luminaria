// Scanout buffers of an output: a few render targets (dmabufs) the
// renderer made and draws into, and the display (KMS or a parent
// compositor) shows. Buffer age follows each buffer, so redraws are
// partial.

import std.os
import luminaria_types as types

struct Slot {
    /// The renderer's key for it.
    key: u64
    buf: types.Dmabuf
    /// KMS framebuffer id or parent wl_buffer id.
    id: u32 = 0
    /// Optional KMS dumb-buffer backing when the renderer cannot export dmabufs.
    dumb_handle: u32 = 0
    dumb_pitch: u32 = 0
    dumb_map: Option[os.Map] = None
    /// On screen or queued to be.
    busy: bool = false
    /// Present number it was last drawn for (0: never).
    drawn: u64 = 0
}

struct Swap {
    slots: List[Slot] = []
    /// Presents so far.
    frame: u64 = 0
    width: i32 = 0
    height: i32 = 0
    format: u32 = types.buffer.xrgb8888
}

fn create(width: i32, height: i32, ts: &[types.Target]) -> Swap {
    var s = Swap { width, height }
    for t in ts {
        s.slots.push(Slot { key: t.key, buf: t.buf })
    }
    return s
}

/// A free buffer and its age (frames since its content was shown; 0
/// undefined).
fn Swap.acquire(self) -> Option[(int, u32)] {
    var best = -1
    for i in 0..self.slots.len() {
        guard not self.slots[i].busy else {
            continue
        }
        // The most recently drawn free buffer needs the least redraw.
        if best < 0 or self.slots[i].drawn > self.slots[best].drawn {
            best = i
        }
    }
    guard best >= 0 else {
        return None
    }
    let d = self.slots[best].drawn
    let age: u32 = if d == 0 { 0 } else { u32(self.frame - d + 1) }
    return Some((best, age))
}

/// Buffer `i` was drawn and handed to the display.
fn Swap.queued(mut self, i: int) {
    self.frame += 1
    self.slots[i].drawn = self.frame
    self.slots[i].busy = true
}

/// The display let go of buffer `i`.
fn Swap.free(mut self, i: int) {
    if i >= 0 and i < self.slots.len() {
        self.slots[i].busy = false
    }
}

/// No buffer's content is known any more (a frame was lost).
fn Swap.forget(mut self) {
    for i in 0..self.slots.len() {
        self.slots[i].drawn = 0
    }
}

fn Swap.find(self, id: u32) -> int {
    for i in 0..self.slots.len() {
        if self.slots[i].id == id {
            return i
        }
    }
    return -1
}

/// The renderer's keys of every slot (to free them).
fn Swap.keys(self, mut out: List[u64]) {
    for sl in self.slots {
        out.push(sl.key)
    }
}

/// Close every exported dmabuf file descriptor owned by these swap slots
/// (deduplicated per slot across planes).
fn Swap.close_fds(mut self) {
    for i in 0..self.slots.len() {
        let n = min(self.slots[i].buf.planes, 4)
        for p in 0..n {
            let fd = self.slots[i].buf.plane[p].fd
            if fd >= 0 {
                var duped = false
                for q in 0..p {
                    if self.slots[i].buf.plane[q].fd == fd {
                        duped = true
                        break
                    }
                }
                if not duped {
                    os.close(fd)
                }
                self.slots[i].buf.plane[p].fd = -1
            }
        }
    }
}
