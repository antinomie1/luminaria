// luminaria_backend: where pixels go and input comes from. DRM/KMS (atomic
// commits, planes and their formats, page flips, hotplug), a nested Wayland
// backend and a headless one; seat sessions through libseat, input devices
// through libinput, keymaps through xkbcommon (devices.mica, usable on its
// own under an output of your own). Frames are requested, never
// polled: an idle output costs no wakeups. No GPU here: the renderer makes
// the images outputs show. `acquire` names the image to draw into (or the
// render targets the output needs first, which `give` hands back), and
// `present` shows it with the renderer's fence and the changed rectangles
// (KMS IN_FENCE_FD and FB_DAMAGE_CLIPS, a parent's implicit fence and
// damage); `scanout` shows a client's dmabuf directly. On DRM, commits go
// out on a commit thread just before each vblank, and the event loop and
// that thread run in the real-time class (sched.mica).

import std.env
import std.mem
import std.os
import std.time
import libudev_sys as udev
import libdrm_sys.uapi as uapi
import luminaria_types as types
pub import keyboard
pub import xkbcommon_sys.keysym as keysym
pub import devices
import drm
import commit
import sched

when feature == "nested" {
    import nested
} else {
    import nested_off as nested
}

import headless
import swap

pub type Mode = types.Mode
pub type OutputDesc = types.OutputDesc
pub type Input = types.Input
pub type Event = types.Event
pub type AxisSource = types.AxisSource
pub type DeviceDesc = types.DeviceDesc
pub type Names = types.Names
pub type Mods = types.Mods
pub type InputConfig = types.InputConfig

pub type Kind = types.OutputKind
/// Session, libinput and keymaps (devices.mica).
pub type Devices = devices.Devices

pub struct Options {
    pub kind: Kind = Kind.Auto
    /// Headless outputs (one 1920x1080 at 60 Hz when empty).
    pub headless: List[Mode] = []
    pub keymap: Names = Names {}
    /// Scanout buffers per output: 2 is lighter, 3 absorbs a late frame.
    pub buffers: int = 2
    pub title: str = "luminaria"
    /// On DRM, run the calling thread (the event loop) and the commit
    /// thread in the real-time class.
    pub realtime: bool = true
}

/// A damaged rectangle in output pixels: x, y, w, h.
pub type Rect = (i32, i32, i32, i32)

/// Poller tokens of the backend's descriptors.
pub let token_drm = 1
pub let token_session = devices.token_session
pub let token_input = devices.token_input
pub let token_udev = 4
pub let token_nested = 5
pub let token_commit = 6
/// Headless output `i` uses token_headless + i.
pub let token_headless = 64

pub struct Backend {
    kind: Kind
    /// The session, libinput and keymaps (keymaps only when not DRM).
    devices: devices.Devices = devices.Devices {}
    drm: Option[drm.Drm] = None
    nested: Option[nested.Nested] = None
    headless: Option[headless.Headless] = None
    monitor: Option[udev.Monitor] = None
    udev: Option[udev.Udev] = None
    descs: List[OutputDesc] = []
    alive: List[bool] = []
    events: List[Event] = []
    head: int = 0
    buffers: int = 2
    active: bool = true
    /// Slot index each output's acquired frame uses.
    acquired: List[int] = []
    /// Render targets let go of, for the renderer to free.
    retired: List[u64] = []
    realtime: bool = true
    /// The event loop's scheduling (policy, priority or nice).
    sched: (int, int) = (0, 0)
}

pub fn Backend.open(o: Options) -> Result[Backend, str] {
    var kind = o.kind
    if kind == Kind.Auto {
        kind = if nested.available and env.get("WAYLAND_DISPLAY").is_some() { Kind.Nested } else { Kind.Drm }
    }
    var b = Backend { kind, buffers: max(o.buffers, 2), realtime: o.realtime, sched: sched.current() }
    match kind {
        Drm => try b.open_drm(o.keymap)
        Nested => {
            let n = try nested.open(o.title.clone())
            let desc = n.desc()
            b.nested = Some(n)
            b.add_output(desc)
        }
        Headless => {
            var modes = o.headless.clone()
            if modes.is_empty() {
                modes.push(Mode { width: 1920, height: 1080, refresh_mhz: 60000, preferred: true })
            }
            let h = try headless.create(modes)
            for out in h.outs {
                b.add_output(out.desc.clone())
            }
            b.headless = Some(h)
        }
        Auto => {}
    }
    return Ok(b)
}

fn Backend.add_output(mut self, take d: OutputDesc) {
    self.descs.push(d)
    self.alive.push(true)
    self.acquired.push(-1)
    self.push(Event.OutputAdded(u32(self.descs.len() - 1)))
}

fn Backend.open_drm(mut self, names: Names) -> Result[(), str] {
    self.devices = try devices.Devices.open(names)
    let path = try drm.find_card()
    var d = try drm.open(path)
    if self.realtime {
        self.sched = sched.realtime(sched.loop_priority)
    }
    try d.start(self.realtime)
    var added: List[int] = []
    d.connect(mut added)
    for o in added {
        let desc = d.desc(o)
        while self.descs.len() < o {
            self.descs.push(OutputDesc {})
            self.alive.push(false)
            self.acquired.push(-1)
        }
        self.add_output(desc)
    }
    self.drm = Some(d)
    if let Some(u) = udev.new() {
        if let Some(m) = udev.monitor_new_from_netlink(u, "udev") {
            discard udev.monitor_filter_add_match_subsystem_devtype(m, "drm", "")
            discard udev.monitor_enable_receiving(m)
            self.monitor = Some(m)
        }
        self.udev = Some(u)
    }
    return Ok(())
}

fn Backend.push(mut self, take e: Event) {
    self.events.push(e)
}

/// The next event, oldest first.
pub fn Backend.next(mut self) -> Option[Event] {
    guard self.head < self.events.len() else {
        self.events.clear()
        self.head = 0
        return self.devices.next()
    }
    let e = self.events[self.head].clone()
    self.head += 1
    return Some(e)
}

pub fn Backend.kind(self) -> Kind {
    return self.kind
}

/// Descriptors to poll for reading and their tokens.
pub fn Backend.fds(self, mut out: List[(int, int)]) {
    if let Some(d) = self.drm {
        out.push((d.fd, token_drm))
        if let Some(t) = d.thread {
            out.push((t.wake, token_commit))
        }
    }
    self.devices.fds(mut out)
    if let Some(m) = self.monitor {
        out.push((int(udev.monitor_get_fd(m)), token_udev))
    }
    if let Some(n) = self.nested {
        out.push((n.fd(), token_nested))
    }
    if let Some(h) = self.headless {
        for k in 0..h.outs.len() {
            out.push((h.outs[k].timer, token_headless + k))
        }
    }
}

/// Handle what descriptor `token` has.
pub fn Backend.dispatch(mut self, token: int) -> Result[(), str] {
    if token == token_drm {
        self.flips()
    } else if token == token_commit {
        self.notes()
    } else if token == token_session or token == token_input {
        if let Some(on) = self.devices.dispatch(token) {
            self.set_active(on)
        }
    } else if token == token_udev {
        self.hotplug()
    } else if token == token_nested {
        if let Some(nn) = self.nested.take() {
            var n = nn
            var got: List[Event] = []
            let r = n.dispatch(mut got)
            if n.resized {
                self.descs[0] = n.desc()
            }
            self.nested = Some(n)
            for g in take got {
                self.push(g)
            }
            try r
        }
    } else if token >= token_headless {
        let k = token - token_headless
        if let Some(hh) = self.headless.take() {
            var h = hh
            let t = h.tick(k)
            self.headless = Some(h)
            if let Some((seq, ns)) = t {
                self.push(Event.Presented(u32(k), seq, ns, 0))
            }
        }
    }
    return Ok(())
}

/// Finished page flips: frames are presented (cursor-only flips only
/// free the commit thread).
fn Backend.flips(mut self) {
    guard let Some(dd) = self.drm.take() else {
        return
    }
    var d = dd
    var flips: List[(int, u64, int, bool)] = []
    d.read_events(mut flips)
    for (o, seq, ns, frame) in flips {
        guard frame else {
            continue
        }
        let direct = d.outputs[o].direct_queued != 0
        d.flipped(o)
        var flags = types.presented_vsync | types.presented_hw_clock | types.presented_hw_completion
        if direct {
            flags |= types.presented_zero_copy
        }
        self.push(Event.Presented(u32(o), seq, ns, flags))
    }
    self.drm = Some(d)
}

/// What the commit thread reports: failed commits, and its watchdog's
/// ping (answered once the flips that arrived are read).
fn Backend.notes(mut self) {
    var got: List[commit.Note] = []
    if let Some(d) = self.drm {
        if let Some(t) = d.thread {
            discard os.count(t.wake)
            while true {
                guard let Some(n) = t.notes.try_recv() else {
                    break
                }
                got.push(n)
            }
        }
    }
    for n in take got {
        match n {
            Ping => {
                self.flips()
                if let Some(d) = self.drm {
                    if let Some(t) = d.thread {
                        t.send(commit.Job.Pong)
                    }
                }
            }
            Failed(o, frame, modeset) => {
                if let Some(dd) = self.drm.take() {
                    var d = dd
                    d.failed(o, frame, modeset)
                    self.drm = Some(d)
                }
                if frame {
                    self.push(Event.Dropped(u32(o)))
                }
            }
        }
    }
}

fn Backend.set_active(mut self, on: bool) {
    self.active = on
    if let Some(dd) = self.drm.take() {
        var d = dd
        // Queued commits would fail without the device, and flips
        // outstanding at the switch never report.
        if let Some(t) = d.thread {
            t.send(commit.Job.Reset)
        }
        if on {
            for o in 0..d.outputs.len() {
                d.outputs[o].modeset = true
                d.failed(o, true, true)
            }
        }
        self.drm = Some(d)
    }
}

fn Backend.hotplug(mut self) {
    guard let Some(m) = self.monitor else {
        return
    }
    if let Some(dev) = udev.monitor_receive_device(m) {
        discard udev.device_unref(dev)
    }
    guard let Some(dd) = self.drm.take() else {
        return
    }
    var d = dd
    d.scan()
    for o in d.disconnected() {
        if o < self.alive.len() and self.alive[o] {
            self.alive[o] = false
            d.crtcs[d.outputs[o].crtc].used = false
            d.outputs[o].conn = d.conns.len() + 1000
            self.push(Event.OutputRemoved(u32(o)))
        }
    }
    var added: List[int] = []
    d.connect(mut added)
    for o in added {
        let desc = d.desc(o)
        while self.descs.len() < o {
            self.descs.push(OutputDesc {})
            self.alive.push(false)
            self.acquired.push(-1)
        }
        self.add_output(desc)
    }
    self.drm = Some(d)
}

// --------------------------------------------------------------- outputs

pub fn Backend.output(self, o: u32) -> OutputDesc {
    guard int(o) < self.descs.len() else {
        return OutputDesc {}
    }
    return self.descs[int(o)].clone()
}

pub fn Backend.output_alive(self, o: u32) -> bool {
    return int(o) < self.alive.len() and self.alive[int(o)]
}

/// Pick a mode (one of the output's) for output `o`.
pub fn Backend.set_mode(mut self, o: u32, m: Mode) {
    guard let Some(dd) = self.drm.take() else {
        return
    }
    var d = dd
    let ci = d.outputs[int(o)].conn
    if ci < d.conns.len() {
        for raw in d.conns[ci].modes.clone() {
            let tm = drm.to_mode(raw)
            if tm.width == m.width and tm.height == m.height and (m.refresh_mhz == 0 or int(tm.refresh_mhz - m.refresh_mhz).abs() < 500) {
                d.outputs[int(o)].mode = raw
                d.outputs[int(o)].mode_blob = 0
                d.outputs[int(o)].modeset = true
                self.descs[int(o)].mode = tm
                self.push(Event.OutputChanged(o))
                break
            }
        }
    }
    self.drm = Some(d)
}

/// Turn output `o` on or off (DPMS): an off output draws nothing.
pub fn Backend.enable(mut self, o: u32, on: bool) {
    guard let Some(dd) = self.drm.take() else {
        return
    }
    var d = dd
    d.outputs[int(o)].enabled = on
    d.outputs[int(o)].modeset = true
    if not on {
        d.update(int(o))
    }
    self.drm = Some(d)
}

/// Variable refresh rate on outputs that support it.
pub fn Backend.set_vrr(mut self, o: u32, on: bool) {
    guard let Some(dd) = self.drm.take() else {
        return
    }
    var d = dd
    d.outputs[int(o)].vrr = on and self.descs[int(o)].vrr
    d.outputs[int(o)].modeset = true
    self.drm = Some(d)
}

/// Whether a frame may be presented on `o` now (none is pending).
pub fn Backend.can_present(self, o: u32) -> bool {
    guard self.active and self.output_alive(o) else {
        return false
    }
    if let Some(d) = self.drm {
        return not d.outputs[int(o)].pending and d.outputs[int(o)].enabled
    }
    if let Some(n) = self.nested {
        return n.frame_cb == 0
    }
    if let Some(h) = self.headless {
        return h.outs[int(o)].pending < 0
    }
    return false
}

/// The image to draw output `o` into, Busy when every one is in use, or
/// the render targets the output needs first.
pub fn Backend.acquire(mut self, o: u32) -> types.Acquire {
    let oi = int(o)
    var pick: Option[(int, u32, u64)] = None
    if let Some(dd) = self.drm.take() {
        var d = dd
        let want = d.prepare(oi, self.buffers, mut self.retired)
        if want.is_none() {
            if let Some(s) = d.outputs[oi].swap {
                if let Some((i, age)) = s.acquire() {
                    pick = Some((i, age, s.slots[i].key))
                }
            }
        }
        self.drm = Some(d)
        if let Some(w) = take want {
            return types.Acquire.Need(w)
        }
    } else if let Some(nn) = self.nested.take() {
        var n = nn
        // The parent holds the shown buffer and may hold the queued one.
        let want = n.prepare(max(self.buffers, 3), mut self.retired)
        if want.is_none() {
            if let Some(s) = n.swap {
                if let Some((i, age)) = s.acquire() {
                    pick = Some((i, age, s.slots[i].key))
                }
            }
        }
        self.nested = Some(n)
        if let Some(w) = take want {
            return types.Acquire.Need(w)
        }
    } else if let Some(h) = self.headless {
        if let Some(w) = h.prepare(oi, self.buffers) {
            return types.Acquire.Need(w)
        }
        if let Some((i, age)) = h.acquire(oi) {
            pick = Some((i, age, h.outs[oi].slots[i]))
        }
    }
    guard let Some((i, age, key)) = pick else {
        return types.Acquire.Busy
    }
    self.acquired[oi] = i
    return types.Acquire.Draw(key, age)
}

/// The render targets output `o` asked for.
pub fn Backend.give(mut self, o: u32, ts: &[types.Target]) -> Result[(), str] {
    let oi = int(o)
    if let Some(dd) = self.drm.take() {
        var d = dd
        let r = d.give(oi, ts)
        self.drm = Some(d)
        return r
    }
    if let Some(nn) = self.nested.take() {
        var n = nn
        n.give(ts)
        self.nested = Some(n)
        return Ok(())
    }
    if let Some(hh) = self.headless.take() {
        var h = hh
        h.give(oi, ts)
        self.headless = Some(h)
    }
    return Ok(())
}

/// Render targets no output uses any more (the renderer frees them).
pub fn Backend.retired(mut self, mut out: List[u64]) {
    for k in self.retired {
        out.push(k)
    }
    self.retired.clear()
}

fn to_clips(rects: &[Rect]) -> List[uapi.ModeRect] {
    var out: List[uapi.ModeRect] = []
    for r in rects {
        out.push(uapi.ModeRect { x1: r.0, y1: r.1, x2: r.0 + r.2, y2: r.1 + r.3 })
    }
    return out
}

/// Show the acquired image once `fence` (a sync_file the output closes;
/// -1: none) signals; `rects` is what changed (empty: everything), `tear`
/// lets a full-screen game flip immediately.
pub fn Backend.present(mut self, o: u32, fence: int, rects: &[Rect], tear: bool) -> Result[(), str] {
    let oi = int(o)
    let i = self.acquired[oi]
    guard i >= 0 else {
        if fence >= 0 {
            os.close(fence)
        }
        return Err("present without acquire")
    }
    self.acquired[oi] = -1
    if let Some(dd) = self.drm.take() {
        var d = dd
        var fb: u32 = 0
        if let Some(s) = d.outputs[oi].swap {
            fb = s.slots[i].id
        }
        let r = d.request(oi, fb, fence, to_clips(rects), tear)
        d.send(r)
        if let Some(sw) = d.outputs[oi].swap.take() {
            var s = sw
            s.queued(i)
            d.outputs[oi].swap = Some(s)
        }
        d.outputs[oi].queued = i
        d.outputs[oi].direct_queued = 0
        self.drm = Some(d)
        return Ok(())
    }
    if let Some(nn) = self.nested.take() {
        var n = nn
        n.present(i, fence, rects)
        n.flush()
        self.nested = Some(n)
        return Ok(())
    }
    if fence >= 0 {
        os.close(fence)
    }
    if let Some(hh) = self.headless.take() {
        var h = hh
        h.present(oi, i)
        self.headless = Some(h)
    }
    return Ok(())
}

/// A client's dmabuf to show on `o` as is (it fills the output, opaque,
/// unscaled): framebuffer import, an atomic test, then the flip. False
/// when the display cannot take it (compose instead).
pub fn Backend.scanout(mut self, o: u32, key: u64, b: types.Dmabuf, rects: &[Rect], tear: bool) -> bool {
    guard b.planes >= 1 and b.planes <= 4 else {
        return false
    }
    let oi = int(o)
    if let Some(dd) = self.drm.take() {
        var d = dd
        d.outputs[oi].queued_overlays.clear()
        var fb: u32 = 0
        if let Ok(id) = d.get_or_add_fb(oi, key, b) {
            fb = id
        }
        var ok = false
        if fb != 0 and not d.outputs[oi].modeset {
            let r = d.request(oi, fb, -1, to_clips(rects), tear)
            ok = d.probe_commit(r)
            if ok {
                d.send(r)
            } else {
                r.release(d.fd)
            }
        }
        if ok {
            d.outputs[oi].direct_queued = fb
            d.outputs[oi].queued = -1
        }
        self.drm = Some(d)
        return ok
    }
    if let Some(nn) = self.nested.take() {
        var n = nn
        let ok = n.scanout(key, b, rects)
        n.flush()
        self.nested = Some(n)
        return ok
    }
    return false
}

/// Probe hardware overlay candidates top-to-bottom on output `o` against
/// primary render target `target_key`; returns promoted placement keys.
pub fn Backend.test_overlays(mut self, o: u32, target_key: u64, cands: &[types.Overlay]) -> List[u64] {
    guard let Some(dd) = self.drm.take() else {
        let none: List[u64] = []
        return none
    }
    var d = dd
    let oi = int(o)
    var primary_fb: u32 = 0
    if oi < d.outputs.len() {
        if let Some(s) = d.outputs[oi].swap {
            for sl in s.slots {
                if sl.key == target_key {
                    primary_fb = sl.id
                    break
                }
            }
        }
    }
    let promoted = d.test_overlays(oi, primary_fb, cands)
    self.drm = Some(d)
    return promoted
}

/// Drop any queued overlay promotion on output `o`.
pub fn Backend.clear_overlays(mut self, o: u32) {
    if let Some(dd) = self.drm.take() {
        var d = dd
        d.clear_overlays(int(o))
        self.drm = Some(d)
    }
}

/// Whether the display still reads client buffer `key` (scanned out or overlay).
pub fn Backend.holds(self, key: u64) -> bool {
    if let Some(d) = self.drm {
        for o in d.outputs {
            for (k, id) in o.fbs {
                if k == key and (id == o.direct_queued or id == o.direct_shown) {
                    return true
                }
            }
            for sl in o.cur_overlays {
                if sl.buf_key == key {
                    return true
                }
            }
            for sl in o.pend_overlays {
                if sl.buf_key == key {
                    return true
                }
            }
            for sl in o.queued_overlays {
                if sl.buf_key == key {
                    return true
                }
            }
        }
    }
    if let Some(n) = self.nested {
        return n.holds(key)
    }
    return false
}

/// A client buffer goes away: drop what was made for it.
pub fn Backend.forget(mut self, key: u64) {
    if let Some(dd) = self.drm.take() {
        var d = dd
        for o in 0..d.outputs.len() {
            for (k, id) in d.outputs[o].fbs {
                if k == key {
                    d.rm_fb(id)
                }
            }
            d.outputs[o].fbs.retain(fn(p) => p.0 != key)
        }
        self.drm = Some(d)
    }
    if let Some(nn) = self.nested.take() {
        var n = nn
        n.forget(key)
        self.nested = Some(n)
    }
}

/// The render target a headless output shows (tests, screenshots).
pub fn Backend.shown(self, o: u32) -> Option[u64] {
    if let Some(h) = self.headless {
        return h.shown(int(o))
    }
    return None
}

// ---------------------------------------------------------------- cursor

/// A hardware cursor image (ARGB8888 premultiplied): true when the
/// display shows it itself (a cursor plane, the parent's cursor); false
/// means the compositor draws it.
pub fn Backend.set_cursor(mut self, pixels: &[u8], width: i32, height: i32, hot_x: i32, hot_y: i32) -> bool {
    if let Some(dd) = self.drm.take() {
        var d = dd
        var ok = true
        for o in 0..d.outputs.len() {
            if d.outputs[o].cursor_fb == 0 {
                discard d.make_cursor(o)
            }
            ok = ok and d.set_cursor_image(o, pixels, u32(width), u32(height))
        }
        self.drm = Some(d)
        return ok
    }
    if let Some(nn) = self.nested.take() {
        var n = nn
        n.set_cursor(pixels, width, height, hot_x, hot_y)
        n.flush()
        self.nested = Some(n)
        return true
    }
    return false
}

/// Put the hardware cursor's top left at output pixel `x, y` (None hides
/// it). The commit thread submits it just before the next vblank, folded
/// into the frame when one comes first: the cursor shows where it is last,
/// not where it was when the frame began.
pub fn Backend.move_cursor(mut self, o: u32, at: Option[(i32, i32)]) {
    guard let Some(dd) = self.drm.take() else {
        return
    }
    var d = dd
    let oi = int(o)
    if oi < d.outputs.len() and d.outputs[oi].cursor >= 0 {
        match at {
            Some((x, y)) => {
                d.outputs[oi].cursor_x = x
                d.outputs[oi].cursor_y = y
                d.outputs[oi].cursor_shown = true
            }
            None => d.outputs[oi].cursor_shown = false
        }
        if not d.outputs[oi].modeset and self.active {
            d.update(oi)
        }
    }
    self.drm = Some(d)
}

// ----------------------------------------------------------------- input

/// The keymap for clients: memfd and size (with its NUL).
pub fn Backend.keymap(self) -> (int, u32) {
    if let Some(n) = self.nested {
        if let Some(k) = n.keyboard {
            return (k.fd, k.size)
        }
    }
    return self.devices.keymap()
}

/// Modifiers in effect now.
pub fn Backend.mods(self) -> Mods {
    if let Some(n) = self.nested {
        if let Some(k) = n.keyboard {
            return k.mods()
        }
    }
    return self.devices.mods()
}

pub fn Backend.set_keymap(mut self, names: Names) -> Result[(), str] {
    guard self.kind == Kind.Drm else {
        return Err("the keymap comes from the parent compositor")
    }
    return self.devices.set_keymap(names)
}

/// Keymap for `seat` (memfd and size); falls back to the default keymap.
pub fn Backend.keymap_on(self, seat: str) -> (int, u32) {
    let k = self.devices.keymap_on(seat)
    return if k.0 >= 0 { k } else { self.keymap() }
}

/// Active modifiers on `seat`; falls back to the default seat's modifiers.
pub fn Backend.base_sym(self, code: u32) -> u32 {
    if let Some(n) = self.nested {
        if let Some(k) = n.keyboard {
            return k.base_sym(code)
        }
    }
    return self.devices.base_sym(code)
}

pub fn Backend.base_sym_on(self, seat: str, code: u32) -> u32 {
    guard self.kind != Kind.Nested else {
        return self.base_sym(code)
    }
    return self.devices.base_sym_on(seat, code)
}

pub fn Backend.mods_on(self, seat: str) -> Mods {
    guard self.kind != Kind.Nested else {
        return self.mods()
    }
    return self.devices.mods_on(seat)
}

/// Set a per-seat keymap on `seat`.
pub fn Backend.set_keymap_on(mut self, seat: str, names: Names) -> Result[(), str] {
    guard self.kind != Kind.Nested else {
        return Err("the keymap comes from the parent compositor")
    }
    return self.devices.set_keymap_on(seat, names)
}

/// Reassign input device `device` to logical seat `seat`.
pub fn Backend.assign_device_seat(mut self, device: u32, seat: str) -> bool {
    return self.devices.assign_device_seat(device, seat)
}

pub fn Backend.configure_input(mut self, device: u32, c: InputConfig) {
    self.devices.configure_input(device, c)
}

/// Switch to virtual terminal `n` (DRM sessions).
pub fn Backend.switch_vt(self, n: int) {
    self.devices.switch_vt(n)
}

/// dev_t of the scanout device (for the dmabuf scanout tranche), 0 when
/// there is none.
pub fn Backend.scanout_device(self) -> u64 {
    if let Some(d) = self.drm {
        return d.devnum
    }
    return 0
}

/// XRGB8888 modifiers output `o`'s primary plane scans out.
pub fn Backend.scanout_modifiers(self, o: u32) -> List[u64] {
    if let Some(d) = self.drm {
        if int(o) < d.outputs.len() {
            return d.planes[d.outputs[int(o)].primary].xrgb.clone()
        }
    }
    let none: List[u64] = []
    return none
}

/// Release every render target so they can be recreated after a GPU reset.
pub fn Backend.reset_targets(mut self, mut retired: List[u64]) {
    self.retired(mut retired)
    for i in 0..self.acquired.len() {
        self.acquired[i] = -1
    }
    if let Some(dd) = self.drm.take() {
        var d = dd
        d.reset_targets(mut retired)
        self.drm = Some(d)
    }
    if let Some(nn) = self.nested.take() {
        var n = nn
        n.release(mut retired)
        self.nested = Some(n)
    }
    if let Some(hh) = self.headless.take() {
        var h = hh
        h.release(mut retired)
        self.headless = Some(h)
    }
}

/// Let go of every render target (their keys go to `retired`, for the
/// renderer to free) before the renderer goes away.
pub fn Backend.shutdown(mut self, mut retired: List[u64]) {
    self.retired(mut retired)
    if let Some(dd) = self.drm.take() {
        var d = dd
        d.release(mut retired)
        self.drm = Some(d)
    }
    if let Some(nn) = self.nested.take() {
        var n = nn
        n.release(mut retired)
        self.nested = Some(n)
    }
    if let Some(hh) = self.headless.take() {
        var h = hh
        h.release(mut retired)
        self.headless = Some(h)
    }
}

/// Add what the devices counted to `s`: commits, scheduling.
pub fn Backend.stats(self, mut s: types.Stats) {
    s.policy = self.sched.0
    s.priority = self.sched.1
    guard let Some(d) = self.drm else {
        return
    }
    s.tests = d.tests
    s.overlays = d.overlay_frames
    if let Some(t) = d.thread {
        t.counts.read(fn(c: commit.Counts) {
            s.commits = c.commits
            s.merged = c.merged
            s.failed = c.failed
            s.late = c.late
            s.stalls = c.stalls
            s.flip_timeouts = c.timeouts
        })
    }
}

/// Whether the output paces frames itself (a parent compositor's frame
/// callbacks): then a frame starts as soon as one may, not by a clock.
pub fn Backend.paced(self) -> bool {
    return self.kind == Kind.Nested
}

/// Whether outputs take any mode they list (KMS); otherwise only the
/// current one.
pub fn Backend.sets_modes(self) -> bool {
    return self.kind == Kind.Drm
}

/// The displays connected to DRM card `path` ("" for the default card),
/// without taking them over.
pub fn probe(path: str) -> Result[List[OutputDesc], str] {
    let p = if path.is_empty() { try drm.find_card() } else { path.clone() }
    var d = try drm.open(p)
    var added: List[int] = []
    d.connect(mut added)
    var out: List[OutputDesc] = []
    for o in added {
        out.push(d.desc(o))
    }
    return Ok(out)
}
