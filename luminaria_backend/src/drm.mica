// KMS through atomic commits. Each connected connector gets a CRTC, its
// primary plane and (when there is one) a cursor plane. A frame is one
// non-blocking atomic commit: the framebuffer, the GPU's sync_file as
// IN_FENCE_FD (the kernel waits, not us), the changed rectangles as
// FB_DAMAGE_CLIPS (panels with self refresh sleep through the rest), and
// the cursor. Requests are built here and submitted by the commit thread
// (commit.mica); TEST_ONLY probes stay synchronous. Page-flip events carry
// the vblank time. A client's dmabuf can be the framebuffer directly
// (scanout), tested first.

import std.env
import std.fs
import std.mem
import std.os
import std.str
import libdrm_sys as drm
import libdrm_sys.uapi as uapi
import libudev_sys as udev
import luminaria_types.pixels as pixels
import commit
import session
import swap
import luminaria_types as types

struct Props {
    names: List[str] = []
    ids: List[u32] = []
    values: List[u64] = []
}

fn Props.id(self, name: str) -> u32 {
    for i in 0..self.names.len() {
        if self.names[i] == name {
            return self.ids[i]
        }
    }
    return 0
}

fn Props.value(self, name: str) -> u64 {
    for i in 0..self.names.len() {
        if self.names[i] == name {
            return self.values[i]
        }
    }
    return 0
}

fn cname(a: [32]i8) -> str {
    var out: List[u8] = []
    for c in a {
        guard c != 0 else {
            break
        }
        out.push(u8(c))
    }
    return str.from_bytes(out)
}

fn props_of(fd: int, obj: u32, kind: u32) -> Props {
    var p = Props {}
    unsafe {
        let op = drm.mode_object_get_properties(i32(fd), obj, kind)
        guard not op.is_null() else {
            return p
        }
        let o = op.read()
        for i in 0..int(o.count_props) {
            let id = o.props.offset(i).read()
            let pr = drm.mode_get_property(i32(fd), id)
            guard not pr.is_null() else {
                continue
            }
            p.names.push(cname(pr.read().name))
            p.ids.push(id)
            p.values.push(o.prop_values.offset(i).read())
            drm.mode_free_property(pr)
        }
        drm.mode_free_object_properties(op)
    }
    return p
}

/// The bytes of property blob `id`.
fn blob(fd: int, id: u32) -> List[u8] {
    var out: List[u8] = []
    guard id != 0 else {
        return out
    }
    unsafe {
        let b = drm.mode_get_property_blob(i32(fd), id)
        guard not b.is_null() else {
            return out
        }
        let r = b.read()
        for i in 0..int(r.length) {
            out.push(r.data.offset(i).read())
        }
        drm.mode_free_property_blob(b)
    }
    return out
}

/// Manufacturer and model from an EDID.
fn edid_names(e: List[u8]) -> (str, str) {
    guard e.len() >= 128 else {
        return ("", "")
    }
    let id = (u32(e[8]) << 8) | u32(e[9])
    var make: List[u8] = []
    for shift in [10, 5, 0] {
        make.push(u8(((id >> u32(shift)) & 31) + 64))
    }
    var model = ""
    for d in 0..4 {
        let at = 54 + d * 18
        if e[at] == 0 and e[at + 1] == 0 and e[at + 3] == 0xfc {
            var name: List[u8] = []
            for k in at + 5..at + 18 {
                if e[k] == 0x0a {
                    break
                }
                name.push(e[k])
            }
            model = str.from_bytes(name).trim()
        }
    }
    return (str.from_bytes(make), model)
}

struct Crtc {
    id: u32
    props: Props
    /// Legacy gamma LUT length from drmModeGetCrtc (fallback when GAMMA_LUT_SIZE is absent).
    legacy_gamma_size: u32 = 0
    /// Taken by an output.
    used: bool = false
}

struct Plane {
    id: u32
    /// 0 overlay, 1 primary, 2 cursor.
    kind: u64
    crtcs: u32
    props: Props
    /// Supported DRM fourccs on this plane.
    formats: List[u32] = []
    /// Supported (fourcc, modifier) pairs from IN_FORMATS.
    fmt_mods: List[(u32, u64)] = []
    /// Modifiers it scans XRGB8888 out with.
    xrgb: List[u64] = []
    /// Modifiers it scans XRGB2101010 (10-bit HDR) out with.
    xrgb10: List[u64] = []
}

struct OverlaySlot {
    plane: int = 0
    fb: u32 = 0
    buf_key: u64 = 0
    key: u64 = 0
    x: i32 = 0
    y: i32 = 0
    w: i32 = 0
    h: i32 = 0
    src_x: u64 = 0
    src_y: u64 = 0
    src_w: u64 = 0
    src_h: u64 = 0
}

struct Connector {
    id: u32
    name: str
    connected: bool
    modes: List[drm.ModeModeInfo] = []
    width_mm: i32 = 0
    height_mm: i32 = 0
    crtcs: u32 = 0
    props: Props = Props {}
    make: str = ""
    model: str = ""
    internal: bool = false
    hdr_capable: bool = false
    has_colorspace: bool = false
    bt2020_rgb_val: u64 = 0
    default_cs_val: u64 = 0
}

struct Output {
    conn: int
    crtc: int
    primary: int
    cursor: int = -1
    overlay_planes: List[int] = []
    mode: drm.ModeModeInfo
    mode_blob: u32 = 0
    swap: Option[swap.Swap] = None
    /// A commit waits for its page flip.
    pending: bool = false
    /// Slot queued and on screen (-1: none, or a client buffer).
    queued: int = -1
    shown: int = -1
    /// Client framebuffers queued and shown when scanning out directly.
    direct_queued: u32 = 0
    direct_shown: u32 = 0
    /// Hardware overlay plane assignments (queued -> pending -> current).
    queued_overlays: List[OverlaySlot] = []
    pend_overlays: List[OverlaySlot] = []
    cur_overlays: List[OverlaySlot] = []
    modeset: bool = true
    enabled: bool = true
    vrr: bool = false
    gamma_blob: u32 = 0
    gamma_dirty: bool = false
    hdr: bool = false
    hdr_blob: u32 = 0
    hdr_dirty: bool = false
    /// Replaced property blobs freed once the replacing atomic commit is submitted.
    retired_blobs: List[u32] = []
    cursor_fbs: [2]u32 = [0, 0]
    cursor_handles: [2]u32 = [0, 0]
    cursor_pitches: [2]u32 = [0, 0]
    cursor_map0: Option[os.Map] = None
    cursor_map1: Option[os.Map] = None
    cursor_idx: int = 0
    cursor_x: i32 = 0
    cursor_y: i32 = 0
    cursor_shown: bool = false
    /// Framebuffers kept for client buffers: buffer key, fb id.
    fbs: List[(u64, u32)] = []
}

struct Drm {
    fd: int
    path: str
    crtcs: List[Crtc] = []
    planes: List[Plane] = []
    conns: List[Connector] = []
    outputs: List[Output] = []
    cursor_w: u32 = 64
    cursor_h: u32 = 64
    modifiers: bool = false
    async_flip: bool = false
    /// dev_t of the card.
    devnum: u64 = 0
    rbuf: List[u8] = []
    /// The commit thread (none when only probing).
    thread: Option[commit.Thread] = None
    /// TEST_ONLY commits asked, and presented frames using overlay planes.
    tests: int = 0
    overlay_frames: int = 0
}

/// The card to drive: $LUMINARIA_DRM_DEVICE, else the first with a
/// connected output.
fn find_card() -> Result[str, str] {
    if let Some(p) = env.get("LUMINARIA_DRM_DEVICE") {
        return Ok(p)
    }
    var names = (try fs.list_dir("/dev/dri").map_err(fn(e) => "{e}")).filter(fn(n) => n.starts_with("card"))
    names.sort()
    guard not names.is_empty() else {
        return Err("no DRM card")
    }
    return Ok("/dev/dri/" + names[0])
}

fn open(take path: str) -> Result[Drm, str] {
    let fd = try session.open_device(path.clone())
    var d = Drm { fd, path }
    try d.probe()
    return Ok(d)
}

fn Drm.drop(mut self) {
    // The thread commits on the fd: it goes first.
    discard self.thread.take()
    session.close_device(self.fd)
}

/// Start the commit thread (and put it in the real-time class).
fn Drm.start(mut self, realtime: bool) -> Result[(), str] {
    discard os.set_nonblocking(self.fd, true)
    self.thread = Some(try commit.start(self.fd, realtime))
    return Ok(())
}

fn Drm.probe(mut self) -> Result[(), str] {
    let f = i32(self.fd)
    guard drm.set_client_cap(f, u64(uapi.drm_client_cap_universal_planes), 1) == 0 and drm.set_client_cap(f, u64(uapi.drm_client_cap_atomic), 1) == 0 else {
        return Err("{self.path}: no atomic modesetting")
    }
    var v: u64 = 0
    unsafe {
        if drm.get_cap(f, u64(uapi.drm_cap_cursor_width), Ptr.of_mut(mut v)) == 0 and v > 0 {
            self.cursor_w = u32(v)
        }
        if drm.get_cap(f, u64(uapi.drm_cap_cursor_height), Ptr.of_mut(mut v)) == 0 and v > 0 {
            self.cursor_h = u32(v)
        }
        v = 0
        self.modifiers = drm.get_cap(f, u64(uapi.drm_cap_addfb2_modifiers), Ptr.of_mut(mut v)) == 0 and v == 1
        v = 0
        self.async_flip = drm.get_cap(f, u64(uapi.drm_cap_atomic_async_page_flip), Ptr.of_mut(mut v)) == 0 and v == 1
        let res = drm.mode_get_resources(f)
        guard not res.is_null() else {
            return Err("{self.path}: no KMS resources")
        }
        let r = res.read()
        for i in 0..int(r.count_crtcs) {
            let id = r.crtcs.offset(i).read()
            var legacy_gamma: u32 = 0
            let cp = drm.mode_get_crtc(f, id)
            if not cp.is_null() {
                let gs = cp.read().gamma_size
                if gs > 0 {
                    legacy_gamma = u32(gs)
                }
                drm.mode_free_crtc(cp)
            }
            self.crtcs.push(Crtc { id, props: props_of(self.fd, id, u32(uapi.drm_mode_object_crtc)), legacy_gamma_size: legacy_gamma })
        }
        drm.mode_free_resources(res)
        let pres = drm.mode_get_plane_resources(f)
        if not pres.is_null() {
            let pr = pres.read()
            for i in 0..int(pr.count_planes) {
                let id = pr.planes.offset(i).read()
                let pp = drm.mode_get_plane(f, id)
                guard not pp.is_null() else {
                    continue
                }
                let pinfo = pp.read()
                let crtcs = pinfo.possible_crtcs
                var formats: List[u32] = []
                for k in 0..int(pinfo.count_formats) {
                    formats.push(pinfo.formats.offset(k).read())
                }
                drm.mode_free_plane(pp)
                let props = props_of(self.fd, id, u32(uapi.drm_mode_object_plane))
                var pl = Plane { id, kind: props.value("type"), crtcs, props, formats }
                self.read_plane_formats(pl.props.value("IN_FORMATS"), mut pl)
                self.planes.push(pl)
            }
            drm.mode_free_plane_resources(pres)
        }
    }
    self.scan()
    self.devnum = devnum(self.path)
    return Ok(())
}

/// Populate supported (fourcc, modifier) pairs from a plane's IN_FORMATS blob.
fn Drm.read_plane_formats(self, id: u64, mut pl: Plane) {
    guard id != 0 else {
        pl.xrgb.push(0)
        if pl.formats.contains(u32(uapi.drm_format_xrgb2101010)) {
            pl.xrgb10.push(0)
        }
        return
    }
    unsafe {
        let b = drm.mode_get_property_blob(i32(self.fd), u32(id))
        guard not b.is_null() else {
            pl.xrgb.push(0)
            if pl.formats.contains(u32(uapi.drm_format_xrgb2101010)) {
                pl.xrgb10.push(0)
            }
            return
        }
        var it = drm.ModeFormatModifierIterator {}
        while drm.mode_format_modifier_blob_iter_next(b, Ptr.of_mut(mut it)) {
            pl.fmt_mods.push((it.fmt, it.mod))
            if it.fmt == u32(uapi.drm_format_xrgb8888) {
                pl.xrgb.push(it.mod)
            } else if it.fmt == u32(uapi.drm_format_xrgb2101010) {
                pl.xrgb10.push(it.mod)
            }
        }
        drm.mode_free_property_blob(b)
    }
    if pl.xrgb.is_empty() and pl.formats.contains(u32(uapi.drm_format_xrgb8888)) {
        pl.xrgb.push(0)
    }
    if pl.xrgb10.is_empty() and pl.formats.contains(u32(uapi.drm_format_xrgb2101010)) {
        pl.xrgb10.push(0)
    }
}

/// Inspect connector `Colorspace` enum property for `BT2020_RGB` and `Default`.
fn read_colorspace_enums(fd: int, prop_id: u32) -> (bool, u64, u64) {
    guard prop_id != 0 else {
        return (false, 0, 0)
    }
    var found_bt2020 = false
    var bt2020_val: u64 = 0
    var default_val: u64 = 0
    unsafe {
        let pr = drm.mode_get_property(i32(fd), prop_id)
        guard not pr.is_null() else {
            return (false, 0, 0)
        }
        let p = pr.read()
        for i in 0..int(p.count_enums) {
            let e = p.enums.offset(i).read()
            let name = cname(e.name)
            if name == "BT2020_RGB" {
                found_bt2020 = true
                bt2020_val = e.value
            } else if name == "Default" {
                default_val = e.value
            }
        }
        drm.mode_free_property(pr)
    }
    return (found_bt2020, bt2020_val, default_val)
}

fn Drm.plane_supports(self, p: int, fmt: u32, modifier: u64) -> bool {
    guard self.planes[p].formats.is_empty() or self.planes[p].formats.contains(fmt) else {
        return false
    }
    if self.planes[p].fmt_mods.is_empty() {
        return modifier == 0 or not self.modifiers
    }
    for (f, m) in self.planes[p].fmt_mods {
        if f == fmt and m == modifier {
            return true
        }
    }
    return false
}

/// Read every connector again (hotplug).
fn Drm.scan(mut self) {
    let f = i32(self.fd)
    var conns: List[Connector] = []
    unsafe {
        let res = drm.mode_get_resources(f)
        guard not res.is_null() else {
            return
        }
        let r = res.read()
        for i in 0..int(r.count_connectors) {
            let id = r.connectors.offset(i).read()
            let cp = drm.mode_get_connector(f, id)
            guard not cp.is_null() else {
                continue
            }
            let c = cp.read()
            let tname = drm.mode_get_connector_type_name(c.connector_type).unwrap_or("Unknown")
            var con = Connector { id, name: "{tname}-{c.connector_type_id}", connected: c.connection == 1, width_mm: i32(c.mmWidth), height_mm: i32(c.mmHeight) }
            con.internal = tname == "eDP" or tname == "LVDS" or tname == "DSI"
            for k in 0..int(c.count_modes) {
                con.modes.push(c.modes.offset(k).read())
            }
            con.crtcs = drm.mode_connector_get_possible_crtcs(f, cp)
            drm.mode_free_connector(cp)
            con.props = props_of(self.fd, id, u32(uapi.drm_mode_object_connector))
            let (make, model) = edid_names(blob(self.fd, u32(con.props.value("EDID"))))
            con.make = make
            con.model = model
            let cs_id = con.props.id("Colorspace")
            let (has_bt2020, bt2020_v, def_v) = read_colorspace_enums(self.fd, cs_id)
            con.has_colorspace = has_bt2020
            con.bt2020_rgb_val = bt2020_v
            con.default_cs_val = def_v
            con.hdr_capable = con.props.id("HDR_OUTPUT_METADATA") != 0 and has_bt2020
            conns.push(con)
        }
        drm.mode_free_resources(res)
    }
    self.conns = conns
}

fn devnum(path: str) -> u64 {
    guard let Some(u) = udev.new() else {
        return 0
    }
    var name = path.clone()
    if let Some(i) = path.rfind("/") {
        name = path.slice(i + 1, path.len())
    }
    var n: u64 = 0
    if let Some(d) = udev.device_new_from_subsystem_sysname(u, "drm", name) {
        n = udev.device_get_devnum(d)
        discard udev.device_unref(d)
    }
    discard udev.unref(u)
    return n
}

fn to_mode(m: drm.ModeModeInfo) -> types.Mode {
    let refresh = if m.htotal > 0 and m.vtotal > 0 { i32(u64(m.clock) * 1000000 / (u64(m.htotal) * u64(m.vtotal))) } else { i32(m.vrefresh) * 1000 }
    return types.Mode { width: i32(m.hdisplay), height: i32(m.vdisplay), refresh_mhz: refresh, preferred: m.r#type & u32(uapi.drm_mode_type_preferred) != 0 }
}

/// Outputs for connected connectors without one, each given a free CRTC
/// with a primary plane: their indices.
fn Drm.connect(mut self, mut added: List[int]) {
    for ci in 0..self.conns.len() {
        guard self.conns[ci].connected and not self.conns[ci].modes.is_empty() else {
            continue
        }
        guard not self.outputs.any(fn(o) => o.conn == ci) else {
            continue
        }
        var mode = self.conns[ci].modes[0]
        for m in self.conns[ci].modes {
            if m.r#type & u32(uapi.drm_mode_type_preferred) != 0 {
                mode = m
                break
            }
        }
        for k in 0..self.crtcs.len() {
            guard not self.crtcs[k].used and self.conns[ci].crtcs & (u32(1) << u32(k)) != 0 else {
                continue
            }
            var primary = -1
            var cursor = -1
            var overlay_planes: List[int] = []
            for p in 0..self.planes.len() {
                guard self.planes[p].crtcs & (u32(1) << u32(k)) != 0 else {
                    continue
                }
                if self.planes[p].kind == 1 and primary < 0 and not self.outputs.any(fn(o) => o.primary == p) {
                    primary = p
                }
                if self.planes[p].kind == 2 and cursor < 0 and not self.outputs.any(fn(o) => o.cursor == p) {
                    cursor = p
                }
                if self.planes[p].kind == 0 and not self.outputs.any(fn(o) => o.overlay_planes.contains(p)) {
                    overlay_planes.push(p)
                }
            }
            guard primary >= 0 else {
                continue
            }
            self.crtcs[k].used = true
            self.outputs.push(Output { conn: ci, crtc: k, primary, cursor, overlay_planes, mode })
            added.push(self.outputs.len() - 1)
            break
        }
    }
}

fn Drm.desc(self, o: int) -> types.OutputDesc {
    let c = self.outputs[o].conn
    let ki = self.outputs[o].crtc
    let primary = self.outputs[o].primary
    var modes: List[types.Mode] = []
    for m in self.conns[c].modes {
        modes.push(to_mode(m))
    }
    let atomic_gamma = u32(self.crtcs[ki].props.value("GAMMA_LUT_SIZE"))
    let gamma_size = if atomic_gamma > 0 { atomic_gamma } else { self.crtcs[ki].legacy_gamma_size }
    let hdr = self.conns[c].hdr_capable and not self.planes[primary].xrgb10.is_empty()
    return types.OutputDesc {
        name: self.conns[c].name.clone(),
        make: self.conns[c].make.clone(),
        model: self.conns[c].model.clone(),
        width_mm: self.conns[c].width_mm,
        height_mm: self.conns[c].height_mm,
        modes,
        mode: to_mode(self.outputs[o].mode),
        vrr: self.conns[c].props.value("vrr_capable") == 1,
        internal: self.conns[c].internal,
        gamma_size,
        hdr,
    }
}

/// Outputs whose connector went away: their indices (highest first).
fn Drm.disconnected(self) -> List[int] {
    var out: List[int] = []
    var i = self.outputs.len() - 1
    while i >= 0 {
        let c = self.outputs[i].conn
        if c >= self.conns.len() or not self.conns[c].connected {
            out.push(i)
        }
        i -= 1
    }
    return out
}

/// Import a 1..4 plane dmabuf into a KMS framebuffer, deduplicating shared
/// GEM buffer handles before closing them so shared BOs are never double-closed.
fn Drm.add_fb(self, d: types.Dmabuf) -> Result[u32, str] {
    let n = d.planes
    guard d.width > 0 and d.height > 0 and n >= 1 and n <= 4 else {
        return Err("add_fb: invalid dmabuf {d.width}x{d.height} planes {n}")
    }
    let f = i32(self.fd)
    var handles: [4]u32 = [0, 0, 0, 0]
    var pitches: [4]u32 = [0, 0, 0, 0]
    var offsets: [4]u32 = [0, 0, 0, 0]
    var mods: [4]u64 = [0, 0, 0, 0]
    var id: u32 = 0
    var r: i32 = -1
    unsafe {
        for i in 0..n {
            var h: u32 = 0
            guard drm.prime_fd_to_handle(f, i32(d.plane[i].fd), Ptr.of_mut(mut h)) == 0 else {
                for j in 0..i {
                    var seen = false
                    for k in 0..j {
                        if handles[k] == handles[j] {
                            seen = true
                            break
                        }
                    }
                    if not seen {
                        discard drm.close_buffer_handle(f, handles[j])
                    }
                }
                return Err("prime import failed on plane {i}")
            }
            handles[i] = h
            pitches[i] = d.plane[i].stride
            offsets[i] = d.plane[i].offset
            mods[i] = d.modifier
        }
        let use_mods = self.modifiers and d.modifier != uapi.drm_format_mod_invalid
        r = drm.mode_add_fb2_with_modifiers(
            f, u32(d.width), u32(d.height), d.format,
            Ptr.of(handles).cast[u32](), Ptr.of(pitches).cast[u32](), Ptr.of(offsets).cast[u32](),
            if use_mods { Ptr.of(mods).cast[u64]() } else { Ptr.null() },
            Ptr.of_mut(mut id),
            if use_mods { u32(uapi.drm_mode_fb_modifiers) } else { 0 },
        )
        for i in 0..n {
            var seen = false
            for j in 0..i {
                if handles[j] == handles[i] {
                    seen = true
                    break
                }
            }
            if not seen {
                discard drm.close_buffer_handle(f, handles[i])
            }
        }
    }
    guard r == 0 else {
        return Err("addfb2 failed ({r})")
    }
    return Ok(id)
}

fn Drm.get_or_add_fb(mut self, o: int, buf_key: u64, d: types.Dmabuf) -> Result[u32, str] {
    for (k, id) in self.outputs[o].fbs {
        if k == buf_key {
            return Ok(id)
        }
    }
    let id = try self.add_fb(d)
    self.outputs[o].fbs.push((buf_key, id))
    return Ok(id)
}

fn Drm.rm_fb(self, id: u32) {
    if id != 0 {
        discard drm.mode_rm_fb(i32(self.fd), id)
    }
}

fn Drm.rm_dumb(self, handle: u32) {
    if handle != 0 {
        discard drm.mode_destroy_dumb_buffer(i32(self.fd), handle)
    }
}

/// Allocate and mmap a KMS dumb buffer framebuffer for software-Vulkan renderers
/// that cannot export DRM dmabufs (e.g. Mesa llvmpipe on virtio-gpu / UEFI GOP).
fn Drm.make_dumb_fb(self, w: i32, h: i32, fmt: u32) -> Result[(u32, u32, u32, os.Map), str] {
    let f = i32(self.fd)
    var handle: u32 = 0
    var pitch: u32 = 0
    var size: u64 = 0
    var offset: u64 = 0
    var fb: u32 = 0
    unsafe {
        guard drm.mode_create_dumb_buffer(f, u32(w), u32(h), 32, 0, Ptr.of_mut(mut handle), Ptr.of_mut(mut pitch), Ptr.of_mut(mut size)) == 0 else {
            return Err("create dumb buffer {w}x{h} failed")
        }
        let handles: [4]u32 = [handle, 0, 0, 0]
        let pitches: [4]u32 = [pitch, 0, 0, 0]
        let offsets: [4]u32 = [0, 0, 0, 0]
        if drm.mode_add_fb2_with_modifiers(f, u32(w), u32(h), fmt, Ptr.of(handles).cast[u32](), Ptr.of(pitches).cast[u32](), Ptr.of(offsets).cast[u32](), Ptr.null(), Ptr.of_mut(mut fb), 0) != 0 {
            discard drm.mode_destroy_dumb_buffer(f, handle)
            return Err("addfb2 dumb buffer {w}x{h} failed")
        }
        if drm.mode_map_dumb_buffer(f, handle, Ptr.of_mut(mut offset)) != 0 {
            discard drm.mode_rm_fb(f, fb)
            discard drm.mode_destroy_dumb_buffer(f, handle)
            return Err("map dumb buffer {w}x{h} failed")
        }
    }
    let m = match os.map(self.fd, int(size), int(offset), true) {
        Ok(m) => m
        Err(e) => {
            discard drm.mode_rm_fb(f, fb)
            discard drm.mode_destroy_dumb_buffer(f, handle)
            return Err("mmap dumb buffer: {e}")
        }
    }
    return Ok((fb, handle, pitch, m))
}

fn Drm.upload_slot(mut self, o: int, slot_idx: int, px: Slice[u8], stride: int) {
    guard o >= 0 and o < self.outputs.len() else {
        return
    }
    guard let Some(sw) = self.outputs[o].swap.take() else {
        return
    }
    var s = sw
    if slot_idx >= 0 and slot_idx < s.slots.len() {
        let pitch = int(s.slots[slot_idx].dumb_pitch)
        let w = s.width
        let h = s.height
        if let Some(mm) = s.slots[slot_idx].dumb_map.take() {
            var m = mm
            discard pixels.copy_rows(mut m.bytes(), 0, pitch, px, 0, stride, int(w) * 4, int(h))
            s.slots[slot_idx].dumb_map = Some(m)
        }
    }
    self.outputs[o].swap = Some(s)
}

/// What output `o` needs before it can draw: None when its scanout
/// buffers are there (and of the mode's size), else render targets laid
/// out the way its primary plane can scan them out. Old buffers' keys go
/// to `retired`.
fn Drm.prepare(mut self, o: int, count: int, mut retired: List[u64]) -> Option[types.Want] {
    let w = i32(self.outputs[o].mode.hdisplay)
    let h = i32(self.outputs[o].mode.vdisplay)
    let plane = self.outputs[o].primary
    let want_fmt = if self.outputs[o].hdr and not self.planes[plane].xrgb10.is_empty() { types.buffer.xrgb2101010 } else { types.buffer.xrgb8888 }
    // A new mode or HDR format switch needs matching buffers.
    if let Some(sw) = self.outputs[o].swap.take() {
        var old = sw
        if old.width == w and old.height == h and old.format == want_fmt {
            self.outputs[o].swap = Some(old)
            return None
        }
        for sl in old.slots {
            self.rm_fb(sl.id)
            self.rm_dumb(sl.dumb_handle)
        }
        old.close_fds()
        old.keys(mut retired)
        self.outputs[o].shown = -1
        self.outputs[o].queued = -1
    }
    let mods = if want_fmt == types.buffer.xrgb2101010 { self.planes[plane].xrgb10.clone() } else { self.planes[plane].xrgb.clone() }
    return Some(types.Want { width: w, height: h, format: want_fmt, modifiers: mods, count })
}

/// Output `o`'s scanout buffers: framebuffers for the targets made.
fn Drm.give(mut self, o: int, ts: Slice[types.Target]) -> Result[(), str] {
    let w = i32(self.outputs[o].mode.hdisplay)
    let h = i32(self.outputs[o].mode.vdisplay)
    let plane = self.outputs[o].primary
    let fmt = if self.outputs[o].hdr and not self.planes[plane].xrgb10.is_empty() { types.buffer.xrgb2101010 } else { types.buffer.xrgb8888 }
    var s = swap.create(w, h, ts)
    s.format = fmt
    for i in 0..s.slots.len() {
        if s.slots[i].buf.planes > 0 {
            let b = types.Dmabuf { format: fmt, ..s.slots[i].buf }
            s.slots[i].id = try self.add_fb(b)
        } else {
            let (fb, handle, pitch, m) = try self.make_dumb_fb(w, h, fmt)
            s.slots[i].id = fb
            s.slots[i].dumb_handle = handle
            s.slots[i].dumb_pitch = pitch
            s.slots[i].dumb_map = Some(m)
        }
    }
    self.outputs[o].swap = Some(s)
    try self.make_cursor(o)
    return Ok(())
}

/// Install or reset (empty slices) a hardware CRTC gamma LUT on output `o`.
fn Drm.set_gamma(mut self, o: int, r: Slice[u16], g: Slice[u16], b: Slice[u16]) -> bool {
    guard o >= 0 and o < self.outputs.len() else {
        return false
    }
    let ki = self.outputs[o].crtc
    let crtc = self.crtcs[ki].id
    let prop = self.crtcs[ki].props.id("GAMMA_LUT")
    if prop != 0 {
        if r.is_empty() {
            if self.outputs[o].gamma_blob != 0 {
                self.outputs[o].retired_blobs.push(self.outputs[o].gamma_blob)
                self.outputs[o].gamma_blob = 0
            }
            self.outputs[o].gamma_dirty = true
            if not self.outputs[o].modeset {
                self.update(o)
            }
            return true
        }
        let want = int(self.crtcs[ki].props.value("GAMMA_LUT_SIZE"))
        guard r.len() == g.len() and r.len() == b.len() and (want == 0 or r.len() == want) else {
            return false
        }
        var luts: List[uapi.ColorLut] = []
        for i in 0..r.len() {
            luts.push(uapi.ColorLut { red: r[i], green: g[i], blue: b[i], reserved: 0 })
        }
        var bid: u32 = 0
        unsafe {
            guard drm.mode_create_property_blob(i32(self.fd), luts.as_ptr().cast[u8](), u64(luts.len() * size_of[uapi.ColorLut]()), Ptr.of_mut(mut bid)) == 0 and bid != 0 else {
                return false
            }
        }
        if self.outputs[o].gamma_blob != 0 {
            self.outputs[o].retired_blobs.push(self.outputs[o].gamma_blob)
        }
        self.outputs[o].gamma_blob = bid
        self.outputs[o].gamma_dirty = true
        if not self.outputs[o].modeset {
            self.update(o)
        }
        return true
    }
    let leg = int(self.crtcs[ki].legacy_gamma_size)
    guard leg > 0 else {
        return false
    }
    if r.is_empty() {
        var ident: List[u16] = []
        for i in 0..leg {
            let v = if leg > 1 { u16(i * 65535 / (leg - 1)) } else { u16(0) }
            ident.push(v)
        }
        unsafe {
            return drm.mode_crtc_set_gamma(i32(self.fd), crtc, u32(leg), ident.as_ptr(), ident.as_ptr(), ident.as_ptr()) == 0
        }
    }
    guard r.len() == leg and g.len() == leg and b.len() == leg else {
        return false
    }
    unsafe {
        return drm.mode_crtc_set_gamma(i32(self.fd), crtc, u32(leg), r.as_ptr(), g.as_ptr(), b.as_ptr()) == 0
    }
}

/// Enable or disable HDR static metadata (BT.2020 + ST.2084 PQ) and 10-bit
/// scanout on output `o`.
fn Drm.set_hdr(mut self, o: int, enabled: bool, sdr_nits: f32, max_nits: f32) -> bool {
    guard o >= 0 and o < self.outputs.len() else {
        return false
    }
    let ci = self.outputs[o].conn
    let primary = self.outputs[o].primary
    if enabled {
        guard ci < self.conns.len() and self.conns[ci].hdr_capable and not self.planes[primary].xrgb10.is_empty() else {
            return false
        }
        let max_l = u16(int(max_nits).clamp(100, 10000))
        let fall = u16(min(int(max_l), max(int(sdr_nits), 400)))
        var info = uapi.HdrMetadataInfoframe {
            eotf: 2,
            metadata_type: 0,
            display_primaries: [
                uapi.HdrMetadataInfoframeDisplayPrimaries { x: 35400, y: 14600 },
                uapi.HdrMetadataInfoframeDisplayPrimaries { x: 8500, y: 39850 },
                uapi.HdrMetadataInfoframeDisplayPrimaries { x: 6550, y: 2300 },
            ],
            white_point: uapi.HdrMetadataInfoframeWhitePoint { x: 15635, y: 16450 },
            max_display_mastering_luminance: max_l,
            min_display_mastering_luminance: 50,
            max_cll: max_l,
            max_fall: fall,
        }
        var meta = uapi.HdrOutputMetadata { metadata_type: 0 }
        var bid: u32 = 0
        unsafe {
            Ptr.of_mut(mut meta.anon0).cast[uapi.HdrMetadataInfoframe]().write(info)
            guard drm.mode_create_property_blob(i32(self.fd), Ptr.of(meta).cast[u8](), u64(size_of[uapi.HdrOutputMetadata]()), Ptr.of_mut(mut bid)) == 0 and bid != 0 else {
                return false
            }
        }
        if self.outputs[o].hdr_blob != 0 {
            self.outputs[o].retired_blobs.push(self.outputs[o].hdr_blob)
        }
        self.outputs[o].hdr_blob = bid
        self.outputs[o].hdr = true
        self.outputs[o].hdr_dirty = true
        self.outputs[o].modeset = true
        return true
    }
    if self.outputs[o].hdr_blob != 0 {
        self.outputs[o].retired_blobs.push(self.outputs[o].hdr_blob)
        self.outputs[o].hdr_blob = 0
    }
    if self.outputs[o].hdr {
        self.outputs[o].hdr = false
        self.outputs[o].hdr_dirty = true
        self.outputs[o].modeset = true
    }
    return true
}

fn Drm.make_cursor_slot(self, w: u32, h: u32) -> Result[(u32, u32, u32, os.Map), str] {
    let f = i32(self.fd)
    var handle: u32 = 0
    var pitch: u32 = 0
    var size: u64 = 0
    var offset: u64 = 0
    var fb: u32 = 0
    unsafe {
        guard drm.mode_create_dumb_buffer(f, w, h, 32, 0, Ptr.of_mut(mut handle), Ptr.of_mut(mut pitch), Ptr.of_mut(mut size)) == 0 else {
            return Err("cursor create_dumb_buffer failed")
        }
        let handles: List[u32] = [handle, 0, 0, 0]
        let pitches: List[u32] = [pitch, 0, 0, 0]
        let offsets: List[u32] = [0, 0, 0, 0]
        guard drm.mode_add_fb2_with_modifiers(f, w, h, 0x34325241, handles.as_ptr(), pitches.as_ptr(), offsets.as_ptr(), Ptr.null(), Ptr.of_mut(mut fb), 0) == 0 else {
            self.rm_dumb(handle)
            return Err("cursor add_fb2 failed")
        }
        guard drm.mode_map_dumb_buffer(f, handle, Ptr.of_mut(mut offset)) == 0 else {
            self.rm_fb(fb)
            self.rm_dumb(handle)
            return Err("cursor map_dumb_buffer failed")
        }
    }
    match os.map(self.fd, int(size), int(offset), true) {
        Ok(m) => {
            return Ok((fb, handle, pitch, m))
        }
        Err(e) => {
            self.rm_fb(fb)
            self.rm_dumb(handle)
            return Err("{e}")
        }
    }
}

fn Drm.make_cursor(mut self, o: int) -> Result[(), str] {
    let cp = self.outputs[o].cursor
    guard cp >= 0 and self.outputs[o].cursor_fbs[0] == 0 else {
        return Ok(())
    }
    guard self.planes[cp].formats.is_empty() or self.planes[cp].formats.contains(0x34325241) else {
        return Ok(())
    }
    guard let Ok((fb0, h0, p0, m0)) = self.make_cursor_slot(self.cursor_w, self.cursor_h) else {
        return Ok(())
    }
    guard let Ok((fb1, h1, p1, m1)) = self.make_cursor_slot(self.cursor_w, self.cursor_h) else {
        discard m0
        self.rm_fb(fb0)
        self.rm_dumb(h0)
        return Ok(())
    }
    self.outputs[o].cursor_fbs = [fb0, fb1]
    self.outputs[o].cursor_handles = [h0, h1]
    self.outputs[o].cursor_pitches = [p0, p1]
    self.outputs[o].cursor_map0 = Some(m0)
    self.outputs[o].cursor_map1 = Some(m1)
    self.outputs[o].cursor_idx = 0
    return Ok(())
}

/// Copy an ARGB8888 (premultiplied) cursor image into the back cursor buffer
/// and flip to it so drivers that compare `old_fb != new_fb` always upload
/// the updated cursor; false when there is no cursor plane or image is too large.
fn Drm.set_cursor_image(mut self, o: int, px: Slice[u8], width: u32, height: u32) -> bool {
    guard width <= self.cursor_w and height <= self.cursor_h else {
        return false
    }
    let next = 1 - self.outputs[o].cursor_idx
    let pitch = int(self.outputs[o].cursor_pitches[next])
    guard self.outputs[o].cursor_fbs[next] != 0 and pitch >= int(width) * 4 else {
        return false
    }
    guard let Some(mm) = if next == 0 { self.outputs[o].cursor_map0.take() } else { self.outputs[o].cursor_map1.take() } else {
        return false
    }
    var m = mm
    let row = int(width) * 4
    let ok = if width > 0 and height > 0 { pixels.copy_rows(mut m.bytes(), 0, pitch, px, 0, row, row, int(height)) } else { true }
    // Clear only what the image does not cover.
    if row < pitch {
        for y in 0..int(height) {
            pixels.clear(mut m.bytes()[y * pitch + row..(y + 1) * pitch])
        }
    }
    let tail = int(height) * pitch
    if tail < m.len {
        pixels.clear(mut m.bytes()[tail..m.len])
    }
    if next == 0 {
        self.outputs[o].cursor_map0 = Some(m)
    } else {
        self.outputs[o].cursor_map1 = Some(m)
    }
    if ok {
        self.outputs[o].cursor_idx = next
    }
    return ok
}

/// Encode a signed 32-bit KMS property value (such as CRTC_X / CRTC_Y) as the
/// sign-extended 64-bit two's-complement bit pattern expected by DRM's
/// `DRM_MODE_PROP_SIGNED_RANGE` (`U642I64`).
fn signed_prop(v: i32) -> u64 {
    return int(v).bits()
}

fn Drm.pprop(self, p: int, name: str) -> u32 {
    return self.planes[p].props.id(name)
}

/// The atomic request that shows framebuffer `fb` (0: keeps the primary
/// plane) on output `o` with GPU fence `fence` (-1: none; the request owns
/// it) and damage `rects`, plus the cursor, and the mode when it changed.
fn Drm.request(mut self, o: int, fb: u32, fence: int, rects: Slice[uapi.ModeRect], tear: bool) -> commit.Req {
    let ovs = self.outputs[o].queued_overlays.clone()
    return self.request_with_overlays(o, fb, fence, rects, tear, ovs)
}

fn Drm.request_with_overlays(mut self, o: int, fb: u32, fence: int, rects: Slice[uapi.ModeRect], tear: bool, ovs: Slice[OverlaySlot]) -> commit.Req {
    let ci = self.outputs[o].conn
    let ki = self.outputs[o].crtc
    let primary = self.outputs[o].primary
    let cursor = self.outputs[o].cursor
    let mode = self.outputs[o].mode
    let crtc = self.crtcs[ki].id
    let w = u64(mode.hdisplay)
    let h = u64(mode.vdisplay)
    let modeset = self.outputs[o].modeset
    let line_ns = if mode.clock > 0 { i64(mode.htotal) * 1000000 / i64(mode.clock) } else { 0 }
    let refresh = to_mode(mode).refresh_mhz
    var r = commit.Req { crtc, out: o, frame: fb != 0, modeset, now: modeset or tear or self.outputs[o].vrr, refresh: if refresh > 0 { 1000000000000 / int(refresh) } else { 0 }, vblank: int(line_ns) * int(mode.vtotal - mode.vdisplay) }
    if modeset {
        if self.outputs[o].mode_blob == 0 {
            var id: u32 = 0
            unsafe {
                discard drm.mode_create_property_blob(i32(self.fd), Ptr.of(mode).cast[u8](), u64(size_of[drm.ModeModeInfo]()), Ptr.of_mut(mut id))
            }
            self.outputs[o].mode_blob = id
        }
        r.add(self.conns[ci].id, self.conns[ci].props.id("CRTC_ID"), u64(crtc))
        r.add(crtc, self.crtcs[ki].props.id("MODE_ID"), u64(self.outputs[o].mode_blob))
        r.add(crtc, self.crtcs[ki].props.id("ACTIVE"), if self.outputs[o].enabled { 1 } else { 0 })
        r.add(crtc, self.crtcs[ki].props.id("VRR_ENABLED"), if self.outputs[o].vrr { 1 } else { 0 })
        r.flags |= u32(uapi.drm_mode_atomic_allow_modeset)
    }
    if modeset or self.outputs[o].gamma_dirty {
        let gp = self.crtcs[ki].props.id("GAMMA_LUT")
        if gp != 0 {
            r.add(crtc, gp, u64(self.outputs[o].gamma_blob))
        }
    }
    if modeset or self.outputs[o].hdr_dirty {
        let hp = self.conns[ci].props.id("HDR_OUTPUT_METADATA")
        if hp != 0 {
            r.add(self.conns[ci].id, hp, u64(self.outputs[o].hdr_blob))
        }
        let cp = self.conns[ci].props.id("Colorspace")
        if cp != 0 and self.conns[ci].has_colorspace {
            r.add(self.conns[ci].id, cp, if self.outputs[o].hdr { self.conns[ci].bt2020_rgb_val } else { self.conns[ci].default_cs_val })
        }
    }
    let pid = self.planes[primary].id
    if fb != 0 {
        r.add(pid, self.pprop(primary, "FB_ID"), u64(fb))
        r.add(pid, self.pprop(primary, "CRTC_ID"), u64(crtc))
        if modeset or not tear {
            r.add(pid, self.pprop(primary, "SRC_X"), 0)
            r.add(pid, self.pprop(primary, "SRC_Y"), 0)
            r.add(pid, self.pprop(primary, "SRC_W"), w << 16)
            r.add(pid, self.pprop(primary, "SRC_H"), h << 16)
            r.add(pid, self.pprop(primary, "CRTC_X"), 0)
            r.add(pid, self.pprop(primary, "CRTC_Y"), 0)
            r.add(pid, self.pprop(primary, "CRTC_W"), w)
            r.add(pid, self.pprop(primary, "CRTC_H"), h)
        }
        if fence >= 0 {
            r.add(pid, self.pprop(primary, "IN_FENCE_FD"), u64(fence))
        }
        let clips = self.pprop(primary, "FB_DAMAGE_CLIPS")
        if not modeset and not rects.is_empty() and clips != 0 {
            let iw = i32(w)
            let ih = i32(h)
            var clean: List[uapi.ModeRect] = []
            for rc in rects {
                let x1 = max(rc.x1, 0)
                let y1 = max(rc.y1, 0)
                let x2 = min(rc.x2, iw)
                let y2 = min(rc.y2, ih)
                if x1 < x2 and y1 < y2 {
                    clean.push(uapi.ModeRect { x1, y1, x2, y2 })
                }
            }
            if not clean.is_empty() {
                var blob: u32 = 0
                unsafe {
                    discard drm.mode_create_property_blob(i32(self.fd), clean.as_ptr().cast[u8](), u64(clean.len() * size_of[uapi.ModeRect]()), Ptr.of_mut(mut blob))
                }
                if blob != 0 {
                    r.add(pid, clips, u64(blob))
                    r.blobs.push(blob)
                }
            }
        }
        for sl in ovs {
            let oid = self.planes[sl.plane].id
            r.add(oid, self.pprop(sl.plane, "FB_ID"), u64(sl.fb))
            r.add(oid, self.pprop(sl.plane, "CRTC_ID"), u64(crtc))
            r.add(oid, self.pprop(sl.plane, "SRC_X"), sl.src_x)
            r.add(oid, self.pprop(sl.plane, "SRC_Y"), sl.src_y)
            r.add(oid, self.pprop(sl.plane, "SRC_W"), sl.src_w)
            r.add(oid, self.pprop(sl.plane, "SRC_H"), sl.src_h)
            r.add(oid, self.pprop(sl.plane, "CRTC_X"), signed_prop(sl.x))
            r.add(oid, self.pprop(sl.plane, "CRTC_Y"), signed_prop(sl.y))
            r.add(oid, self.pprop(sl.plane, "CRTC_W"), u64(sl.w))
            r.add(oid, self.pprop(sl.plane, "CRTC_H"), u64(sl.h))
        }
        for cur in self.outputs[o].cur_overlays {
            var kept = false
            for s in ovs {
                if s.plane == cur.plane {
                    kept = true
                    break
                }
            }
            if not kept {
                let oid = self.planes[cur.plane].id
                r.add(oid, self.pprop(cur.plane, "FB_ID"), 0)
                r.add(oid, self.pprop(cur.plane, "CRTC_ID"), 0)
            }
        }
    }
    if fence >= 0 {
        r.fences.push(fence)
    }
    if cursor >= 0 and not tear {
        let cid = self.planes[cursor].id
        let cfb = self.outputs[o].cursor_fbs[self.outputs[o].cursor_idx]
        if self.outputs[o].cursor_shown and cfb != 0 {
            r.add(cid, self.pprop(cursor, "FB_ID"), u64(cfb))
            r.add(cid, self.pprop(cursor, "CRTC_ID"), u64(crtc))
            r.add(cid, self.pprop(cursor, "SRC_X"), 0)
            r.add(cid, self.pprop(cursor, "SRC_Y"), 0)
            r.add(cid, self.pprop(cursor, "SRC_W"), u64(self.cursor_w) << 16)
            r.add(cid, self.pprop(cursor, "SRC_H"), u64(self.cursor_h) << 16)
            r.add(cid, self.pprop(cursor, "CRTC_X"), signed_prop(self.outputs[o].cursor_x))
            r.add(cid, self.pprop(cursor, "CRTC_Y"), signed_prop(self.outputs[o].cursor_y))
            r.add(cid, self.pprop(cursor, "CRTC_W"), u64(self.cursor_w))
            r.add(cid, self.pprop(cursor, "CRTC_H"), u64(self.cursor_h))
        } else {
            r.add(cid, self.pprop(cursor, "FB_ID"), 0)
            r.add(cid, self.pprop(cursor, "CRTC_ID"), 0)
        }
    }
    if tear and not modeset and self.async_flip {
        r.flags |= u32(uapi.drm_mode_page_flip_async)
    }
    return r
}

fn overlaps(a: (i32, i32, i32, i32), b: (i32, i32, i32, i32)) -> bool {
    return a.0 < b.0 + b.2 and a.0 + a.2 > b.0 and a.1 < b.1 + b.3 and a.1 + a.3 > b.1
}

/// Probe hardware overlay candidates top-to-bottom on output `o` against
/// `primary_fb` using atomic TEST_ONLY commits; stores accepted slots for
/// the next `present` and returns their placement keys.
fn Drm.test_overlays(mut self, o: int, primary_fb: u32, cands: Slice[types.Overlay]) -> List[u64] {
    var out: List[u64] = []
    guard o >= 0 and o < self.outputs.len() else {
        return out
    }
    self.outputs[o].queued_overlays.clear()
    guard not self.outputs[o].modeset and not self.outputs[o].overlay_planes.is_empty() and primary_fb != 0 and not cands.is_empty() else {
        return out
    }
    let mw = i32(self.outputs[o].mode.hdisplay)
    let mh = i32(self.outputs[o].mode.vdisplay)
    var blocked: List[(i32, i32, i32, i32)] = []
    var accepted: List[OverlaySlot] = []
    var pcur = 0
    for c in cands {
        if pcur >= self.outputs[o].overlay_planes.len() {
            break
        }
        let rect = (c.x, c.y, c.w, c.h)
        var skip = c.w <= 0 or c.h <= 0 or c.x < 0 or c.y < 0 or c.x + c.w > mw or c.y + c.h > mh
        if not skip {
            for b in blocked {
                if overlaps(b, rect) {
                    skip = true
                    break
                }
            }
        }
        if skip {
            blocked.push(rect)
            continue
        }
        let plane = self.outputs[o].overlay_planes[pcur]
        guard self.plane_supports(plane, c.buf.format, c.buf.modifier) else {
            blocked.push(rect)
            continue
        }
        guard let Ok(fb) = self.get_or_add_fb(o, c.buf_key, c.buf) else {
            blocked.push(rect)
            continue
        }
        let has_src = c.src.w > 0.0 and c.src.h > 0.0
        let src_x = if has_src { u64(max(i64(c.src.x * 65536.0), 0)) } else { 0 }
        let src_y = if has_src { u64(max(i64(c.src.y * 65536.0), 0)) } else { 0 }
        let src_w = if has_src { u64(max(i64(c.src.w * 65536.0), 1)) } else { u64(c.buf.width) << 16 }
        let src_h = if has_src { u64(max(i64(c.src.h * 65536.0), 1)) } else { u64(c.buf.height) << 16 }
        accepted.push(OverlaySlot {
            plane,
            fb,
            buf_key: c.buf_key,
            key: c.key,
            x: c.x,
            y: c.y,
            w: c.w,
            h: c.h,
            src_x,
            src_y,
            src_w,
            src_h,
        })
        let empty_clips: List[uapi.ModeRect] = []
        let r = self.request_with_overlays(o, primary_fb, -1, empty_clips, false, accepted)
        let ok = self.probe_commit(r)
        r.release(self.fd)
        if ok {
            pcur += 1
            out.push(c.key)
            blocked.push(rect)
        } else {
            discard accepted.pop()
            blocked.push(rect)
        }
    }
    self.outputs[o].queued_overlays = accepted
    return out
}

fn Drm.clear_overlays(mut self, o: int) {
    if o >= 0 and o < self.outputs.len() {
        self.outputs[o].queued_overlays.clear()
    }
}

/// Whether the display takes `r` now (TEST_ONLY, on this thread).
fn Drm.probe_commit(mut self, r: commit.Req) -> bool {
    self.tests += 1
    return commit.probe(self.fd, r)
}

/// Queue `r` for the commit thread. A frame holds the output until it
/// flips (or its commit fails).
fn Drm.send(mut self, take r: commit.Req) {
    var req = r
    let o = req.out
    if req.frame {
        self.outputs[o].pending = true
        let qov = mem.replace(mut self.outputs[o].queued_overlays, [])
        self.outputs[o].pend_overlays = qov
    }
    for b in self.outputs[o].retired_blobs {
        req.blobs.push(b)
    }
    self.outputs[o].retired_blobs.clear()
    self.outputs[o].modeset = false
    self.outputs[o].gamma_dirty = false
    self.outputs[o].hdr_dirty = false
    match self.thread {
        Some(t) => t.send(commit.Job.Commit(req))
        None => req.release(self.fd)
    }
}

/// A cursor or CRTC change on its own (no frame), folded into the next
/// frame when one comes before its vblank.
fn Drm.update(mut self, o: int) {
    let none: List[uapi.ModeRect] = []
    let r = self.request(o, 0, -1, none, false)
    self.send(r)
}

/// Read page-flip events: (output, sequence, ns, whether it was a frame)
/// per finished flip; the commit thread hears of each.
fn Drm.read_events(mut self, mut out: List[(int, u64, int, bool)]) {
    if self.rbuf.len() < 1024 {
        for _ in self.rbuf.len()..1024 {
            self.rbuf.push(0)
        }
    }
    let n = match os.read_into(self.fd, mut self.rbuf) {
        Ok(n) => n
        Err => 0
    }
    var at = 0
    while at + 8 <= n {
        let kind = rd32(self.rbuf, at)
        let len = int(rd32(self.rbuf, at + 4))
        guard len >= 8 and at + len <= n else {
            break
        }
        if kind == u32(uapi.drm_event_flip_complete) and len >= 32 {
            let sec = int(rd32(self.rbuf, at + 16))
            let usec = int(rd32(self.rbuf, at + 20))
            let frame = (u64(rd32(self.rbuf, at + 12)) << 32) & commit.frame_bit != 0
            let seq = u64(rd32(self.rbuf, at + 24))
            let crtc = rd32(self.rbuf, at + 28)
            let ns = sec * 1000000000 + usec * 1000
            if let Some(t) = self.thread {
                t.send(commit.Job.Flipped(crtc, ns))
            }
            for o in 0..self.outputs.len() {
                if self.crtcs[self.outputs[o].crtc].id == crtc {
                    out.push((o, seq, ns, frame))
                }
            }
        }
        at += len
    }
}

fn rd32(b: List[u8], at: int) -> u32 {
    return u32(b[at]) | (u32(b[at + 1]) << 8) | (u32(b[at + 2]) << 16) | (u32(b[at + 3]) << 24)
}

/// Output `o`'s frame flipped: what was queued is on screen now.
fn Drm.flipped(mut self, o: int) {
    self.outputs[o].pending = false
    let q = self.outputs[o].queued
    let old = self.outputs[o].shown
    if q >= 0 or self.outputs[o].direct_queued != 0 {
        // The buffer that was on screen is free again.
        if old >= 0 and old != q {
            self.free_slot(o, old)
        }
        self.outputs[o].shown = q
        self.outputs[o].queued = -1
        let pov = mem.replace(mut self.outputs[o].pend_overlays, [])
        self.outputs[o].cur_overlays = pov
        if not self.outputs[o].cur_overlays.is_empty() {
            self.overlay_frames += 1
        }
    }
    self.outputs[o].direct_shown = self.outputs[o].direct_queued
}

/// Output `o`'s commit failed: a frame in it never shows, so its buffer
/// is free and every buffer's content is unknown (drawn whole next).
fn Drm.failed(mut self, o: int, frame: bool, modeset: bool) {
    guard o < self.outputs.len() else {
        return
    }
    if modeset {
        self.outputs[o].modeset = true
    }
    guard frame else {
        return
    }
    self.outputs[o].pending = false
    self.outputs[o].pend_overlays.clear()
    let q = self.outputs[o].queued
    if q >= 0 and q != self.outputs[o].shown {
        self.free_slot(o, q)
    }
    self.outputs[o].queued = -1
    self.outputs[o].direct_queued = self.outputs[o].direct_shown
    if let Some(sw) = self.outputs[o].swap.take() {
        var s = sw
        s.forget()
        self.outputs[o].swap = Some(s)
    }
}

fn Drm.free_slot(mut self, o: int, i: int) {
    if let Some(sw) = self.outputs[o].swap.take() {
        var s = sw
        s.free(i)
        self.outputs[o].swap = Some(s)
    }
}

/// Release render targets and cached FBs without tearing down modes/outputs
/// (used on GPU reset).
fn Drm.reset_targets(mut self, mut retired: List[u64]) {
    for o in 0..self.outputs.len() {
        self.outputs[o].queued_overlays.clear()
        self.outputs[o].pend_overlays.clear()
        self.outputs[o].cur_overlays.clear()
        self.outputs[o].direct_queued = 0
        self.outputs[o].direct_shown = 0
        self.outputs[o].queued = -1
        self.outputs[o].shown = -1
        if let Some(sw) = self.outputs[o].swap.take() {
            var s = sw
            for sl in s.slots {
                self.rm_fb(sl.id)
                self.rm_dumb(sl.dumb_handle)
            }
            s.close_fds()
            s.keys(mut retired)
        }
        for (_, fb) in self.outputs[o].fbs {
            self.rm_fb(fb)
        }
        self.outputs[o].fbs.clear()
    }
}

/// Turn every output off (the session ends or the compositor exits).
fn Drm.release(mut self, mut retired: List[u64]) {
    self.reset_targets(mut retired)
    let f = i32(self.fd)
    for o in 0..self.outputs.len() {
        discard self.outputs[o].cursor_map0.take()
        discard self.outputs[o].cursor_map1.take()
        for ci in 0..2 {
            self.rm_fb(self.outputs[o].cursor_fbs[ci])
            self.rm_dumb(self.outputs[o].cursor_handles[ci])
            self.outputs[o].cursor_fbs[ci] = 0
            self.outputs[o].cursor_handles[ci] = 0
            self.outputs[o].cursor_pitches[ci] = 0
        }
        if self.outputs[o].mode_blob != 0 {
            discard drm.mode_destroy_property_blob(f, self.outputs[o].mode_blob)
            self.outputs[o].mode_blob = 0
        }
        if self.outputs[o].gamma_blob != 0 {
            discard drm.mode_destroy_property_blob(f, self.outputs[o].gamma_blob)
            self.outputs[o].gamma_blob = 0
        }
        if self.outputs[o].hdr_blob != 0 {
            discard drm.mode_destroy_property_blob(f, self.outputs[o].hdr_blob)
            self.outputs[o].hdr_blob = 0
        }
        for b in self.outputs[o].retired_blobs {
            discard drm.mode_destroy_property_blob(f, b)
        }
        self.outputs[o].retired_blobs.clear()
    }
}

test "DRM signed_prop encodes negative CRTC_X/CRTC_Y as sign-extended two's complement" {
    assert_eq(signed_prop(0), u64(0))
    assert_eq(signed_prop(123), u64(123))
    assert_eq(signed_prop(-1), ~u64(0))
    assert_eq(signed_prop(-4), ~u64(3))
    assert_eq(signed_prop(-8), ~u64(7))
    assert_eq(signed_prop(-12), ~u64(11))
    assert_eq(signed_prop(-16), ~u64(15))
    assert_eq(signed_prop(-2147483648), ~u64(0x7fffffff))
    assert_eq(signed_prop(2147483647), u64(0x7fffffff))
}
