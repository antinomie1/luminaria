// Headless: outputs that exist only in memory (tests, remote and
// screenshot sessions). Vblanks fall on a fixed grid of the output's
// refresh; a present completes at the next one, paced by a timer fd, and
// reports that vblank's number and time, so frame timing (idle gaps
// included) behaves like a display's.

import std.os
import std.time
import luminaria_types as types

struct Out {
    desc: types.OutputDesc
    /// The renderer's keys of its images.
    slots: List[u64] = []
    drawn: List[u64] = []
    frame: u64 = 0
    timer: int = -1
    pending: int = -1
    shown: int = -1
    /// The vblank grid's origin and the vblank the pending frame shows at.
    t0: int = 0
    at: int = 0
}

struct Headless {
    outs: List[Out] = []
}

fn create(modes: &[types.Mode]) -> Result[Headless, str] {
    var h = Headless {}
    for k in 0..modes.len() {
        let m = modes[k]
        let t = try os.timerfd().map_err(fn(e) => "{e}")
        h.outs.push(Out { desc: types.OutputDesc { name: "HEADLESS-{k + 1}", make: "luminaria", model: "headless", modes: [m], mode: m }, timer: t })
    }
    return Ok(h)
}

fn Headless.drop(mut self) {
    for o in self.outs {
        os.close(o.timer)
    }
}

/// Images output `o` needs before it can draw (None: it has them).
fn Headless.prepare(self, o: int, count: int) -> Option[types.Want] {
    guard self.outs[o].slots.is_empty() else {
        return None
    }
    let m = self.outs[o].desc.mode
    return Some(types.Want { width: m.width, height: m.height, format: types.buffer.xrgb8888, count, export: false })
}

fn Headless.give(mut self, o: int, ts: &[types.Target]) {
    for t in ts {
        self.outs[o].slots.push(t.key)
        self.outs[o].drawn.push(0)
    }
}

fn Headless.release(mut self, mut retired: List[u64]) {
    for o in 0..self.outs.len() {
        for k in self.outs[o].slots {
            retired.push(k)
        }
        self.outs[o].slots.clear()
        self.outs[o].drawn.clear()
        self.outs[o].pending = -1
        self.outs[o].shown = -1
    }
}

fn Headless.acquire(self, o: int) -> Option[(int, u32)] {
    var best = -1
    for i in 0..self.outs[o].slots.len() {
        guard i != self.outs[o].pending and i != self.outs[o].shown else {
            continue
        }
        if best < 0 or self.outs[o].drawn[i] > self.outs[o].drawn[best] {
            best = i
        }
    }
    guard best >= 0 else {
        return None
    }
    let d = self.outs[o].drawn[best]
    return Some((best, if d == 0 { u32(0) } else { u32(self.outs[o].frame - d + 1) }))
}

fn Headless.present(mut self, o: int, i: int) {
    self.outs[o].frame += 1
    self.outs[o].drawn[i] = self.outs[o].frame
    self.outs[o].pending = i
    let period = 1000000000000 / int(max(self.outs[o].desc.mode.refresh_mhz, 1000))
    let now = time.now_ns()
    if self.outs[o].t0 == 0 {
        self.outs[o].t0 = now
    }
    let t0 = self.outs[o].t0
    self.outs[o].at = t0 + ((now - t0) / period + 1) * period
    discard os.timer_arm(self.outs[o].timer, max(self.outs[o].at - now, 1), 0)
}

/// Output `o`'s timer fired: the pending frame is shown.
fn Headless.tick(mut self, o: int) -> Option[(u64, int)] {
    discard os.count(self.outs[o].timer)
    guard self.outs[o].pending >= 0 else {
        return None
    }
    self.outs[o].shown = self.outs[o].pending
    self.outs[o].pending = -1
    let period = 1000000000000 / int(max(self.outs[o].desc.mode.refresh_mhz, 1000))
    let at = self.outs[o].at
    return Some((u64((at - self.outs[o].t0) / period), at))
}

/// The renderer's key of what output `o` shows (screenshots, tests).
fn Headless.shown(self, o: int) -> Option[u64] {
    let s = self.outs[o].shown
    return if s < 0 { None } else { Some(self.outs[o].slots[s]) }
}
